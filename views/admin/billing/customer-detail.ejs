<!DOCTYPE html>
<html lang="id">
<head>
    <%- include('../../partials/hard-reload') %>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Detail Pelanggan - Admin Portal</title>
    <link href="/vendor/bootstrap/css/bootstrap.min.css" rel="stylesheet">
    <link href="/vendor/boxicons/boxicons.min.css" rel="stylesheet">
    <link href="/vendor/bootstrap-icons/bootstrap-icons.css" rel="stylesheet">
    <!-- Admin Mobile Optimizations -->
    <link href="/css/admin-mobile.css" rel="stylesheet">

    <%- include('../../partials/theme-head') %>
</head>
<body>
    <%- include('../../partials/format-jakarta-db') %>
    <div class="container-fluid">
        <div class="row">
            <!-- Include Billing Sidebar -->
            <%- include('../../partials/billing-sidebar') %>

            <!-- Main content -->
            <main class="col-md-10 ms-sm-auto col-lg-10 px-md-4 main-content">
                <div class="d-flex justify-content-between flex-wrap flex-md-nowrap align-items-center pt-3 pb-2 mb-3 border-bottom">
                    <h1 class="h2">
                        <i class="bi bi-person-fill"></i> Detail Pelanggan
                    </h1>
                    <div class="d-flex gap-2 align-items-center">
                        <nav aria-label="breadcrumb">
                            <ol class="breadcrumb mb-0">
                                <li class="breadcrumb-item"><a href="/admin/billing/customers">Pelanggan</a></li>
                                <li class="breadcrumb-item active" aria-current="page"><%= customer.name %></li>
                            </ol>
                        </nav>
                    </div>
                </div>
                
                <!-- Accept Button for Register Status -->
                <% 
                // Debug: Log status untuk troubleshooting
                const customerStatus = customer ? customer.status : null;
                const isRegister = customerStatus === 'register' || customerStatus === 'Register';
                %>
                <% if (customer && isRegister) { %>
                    <div class="alert alert-warning d-flex justify-content-between align-items-center mb-3">
                        <div>
                            <i class="bi bi-info-circle-fill me-2"></i> 
                            <strong>Status: Register</strong> - Pelanggan ini menunggu persetujuan admin. Klik tombol Accept untuk mengaktifkan pelanggan.
                        </div>
                        <button type="button" class="btn btn-success btn-lg" id="acceptCustomerBtn" onclick="acceptCustomer('<%= customer.phone %>')">
                            <i class="bi bi-check-circle-fill me-2"></i> Accept Pelanggan
                        </button>
                    </div>
                <% } else if (customer) { %>
                    <!-- Info: Tombol Accept hanya muncul untuk status 'register' -->
                    <div class="alert alert-info mb-3">
                        <i class="bi bi-info-circle-fill me-2"></i> 
                        <strong>Info:</strong> Tombol "Accept Pelanggan" hanya muncul untuk pelanggan dengan status <strong>Register</strong>. 
                        Status saat ini: <strong><%= customer.status || 'N/A' %></strong>
                    </div>
                <% } %>

                <!-- Customer Info Card -->
                <div class="row">
                    <div class="col-md-4">
                        <div class="card">
                            <div class="card-header">
                                <h5 class="card-title mb-0">
                                    <i class="bi bi-person-circle"></i> Informasi Pelanggan
                                </h5>
                            </div>
                            <div class="card-body">
                                <div class="mb-3">
                                    <strong>Username:</strong> <%= customer ? customer.username : 'N/A' %>
                                </div>
                                <% if (customer && customer.pppoe_username) { %>
                                <div class="mb-3">
                                    <strong>PPPoE Username:</strong> <%= customer.pppoe_username %>
                                </div>
                                <% } %>
                                <% if (typeof pppoePassword !== 'undefined' && pppoePassword) { %>
                                <div class="mb-3">
                                    <strong>PPPoE Password:</strong> 
                                    <div class="input-group">
                                        <input type="password" class="form-control form-control-sm" id="pppoePassword" value="<%= pppoePassword %>" readonly style="font-family: monospace;">
                                        <button class="btn btn-outline-secondary btn-sm" type="button" id="togglePassword" onclick="togglePasswordVisibility()">
                                            <i class="bi bi-eye" id="togglePasswordIcon"></i>
                                        </button>
                                        <button class="btn btn-outline-info btn-sm" type="button" id="copyPasswordBtn" onclick="copyPassword(event)" title="Salin Password">
                                            <i class="bi bi-clipboard"></i>
                                        </button>
                                    </div>
                                    <small class="text-muted">Password untuk koneksi PPPoE client</small>
                                </div>
                                <% } else if (customer && customer.pppoe_username && !(typeof isMasterTenant !== 'undefined' && isMasterTenant) && String(customer.master_origin || '') !== 'copied') { %>
                                <div class="mb-3">
                                    <strong>PPPoE Password:</strong> 
                                    <span class="text-muted">
                                        <i class="bi bi-exclamation-circle"></i> Password tidak ditemukan di <%= typeof authMode !== 'undefined' && authMode === 'radius' ? 'RADIUS' : 'Mikrotik' %>
                                    </span>
                                </div>
                                <% } %>
                                <div class="mb-3">
                                    <strong>Nama:</strong> <%= customer ? customer.name : 'N/A' %>
                                </div>
                                <div class="mb-3">
                                    <strong>Telepon:</strong> <%= customer && customer.phone ? customer.phone : '-' %>
                                </div>
                                <div class="mb-3">
                                    <strong>Email:</strong> <%= customer && customer.email ? customer.email : '-' %>
                                </div>
                                <div class="mb-3">
                                    <strong>Alamat:</strong> <%= customer && customer.address ? customer.address : '-' %>
                                </div>
                                <div class="mb-3">
                                    <strong>Status:</strong> 
                                    <% if (customer && customer.status === 'active') { %>
                                        <span class="badge bg-success">Aktif</span>
                                    <% } else if (customer && customer.status === 'inactive') { %>
                                        <span class="badge bg-secondary">Tidak Aktif</span>
                                    <% } else if (customer && customer.status === 'suspended') { %>
                                        <span class="badge bg-warning">Ditangguhkan</span>
                                    <% } else if (customer && (customer.status === 'register' || customer.status === 'Register')) { %>
                                        <span class="badge" style="background-color: #9900CC; color: white;">Register</span>
                                    <% } else { %>
                                        <span class="badge bg-secondary">Tidak Diketahui (<%= customer ? customer.status : 'N/A' %>)</span>
                                    <% } %>
                                </div>
                                <div class="mb-3">
                                    <strong>Bergabung:</strong> <%= customer && customer.join_date ? formatDbUtcToJakartaDate(customer.join_date) : 'N/A' %>
                                </div>
                            </div>
                        </div>

                        <!-- Password Login Card -->
                        <div class="card mt-3">
                            <div class="card-header">
                                <h5 class="card-title mb-0">
                                    <i class="bi bi-key"></i> Password Login Portal
                                </h5>
                            </div>
                            <div class="card-body">
                                <% if (customer && customer.password) { %>
                                    <div class="alert alert-success py-2 mb-3">
                                        <i class="bi bi-check-circle me-1"></i> Password sudah diatur
                                    </div>
                                <% } else { %>
                                    <div class="alert alert-warning py-2 mb-3">
                                        <i class="bi bi-exclamation-triangle me-1"></i> Password belum diatur (hanya bisa login via OTP)
                                    </div>
                                <% } %>
                                <div class="mb-3">
                                    <label class="form-label small fw-bold">Set Password Baru</label>
                                    <div class="input-group input-group-sm">
                                        <input type="password" class="form-control" id="newCustomerPassword" placeholder="Min. 6 karakter" minlength="6">
                                        <button class="btn btn-outline-secondary" type="button" onclick="toggleNewPasswordVisibility()">
                                            <i class="bi bi-eye" id="toggleNewPwIcon"></i>
                                        </button>
                                    </div>
                                </div>
                                <div class="d-flex gap-2">
                                    <button class="btn btn-primary btn-sm" onclick="setCustomerPassword(<%= customer.id %>)">
                                        <i class="bi bi-save me-1"></i>Simpan Password
                                    </button>
                                    <% if (customer && customer.password) { %>
                                        <button class="btn btn-outline-danger btn-sm" onclick="resetCustomerPassword(<%= customer.id %>)">
                                        <i class="bi bi-trash me-1"></i>Reset
                                    </button>
                                    <% } %>
                                </div>
                            </div>
                        </div>
                        
                        <!-- Mapping Kolektor Card -->
                        <div class="card mt-3">
                            <div class="card-header">
                                <h5 class="card-title mb-0">
                                    <i class="bi bi-person-badge"></i> Mapping Kolektor
                                </h5>
                            </div>
                            <div class="card-body">
                                <div class="mb-3">
                                    <label for="collectorSelect" class="form-label small fw-bold">Pilih Kolektor</label>
                                    <select class="form-select form-select-sm" id="collectorSelect">
                                        <option value="">-- Tidak ada (Bebas) --</option>
                                        <% if (typeof activeCollectors !== 'undefined' && activeCollectors.length > 0) { %>
                                            <% activeCollectors.forEach(function(collector) { %>
                                                <option value="<%= collector.id %>" <%= assignedCollectorId == collector.id ? 'selected' : '' %>><%= collector.name %></option>
                                            <% }); %>
                                        <% } %>
                                    </select>
                                    <small class="text-muted mt-1 d-block" style="font-size: 0.75rem;">Tetapkan kolektor untuk mengelola pembayaran pelanggan ini.</small>
                                </div>
                                <button class="btn btn-primary btn-sm w-100" onclick="assignCollector(<%= customer.id %>)">
                                    <i class="bi bi-save me-1"></i>Simpan Mapping
                                </button>
                            </div>
                        </div>
                    </div>
                    
                    <div class="col-md-8">
                        <div class="card mb-3">
                            <div class="card-header">
                                <h5 class="card-title mb-0">
                                    <i class="bi bi-box-seam-fill"></i> Paket Internet
                                </h5>
                            </div>
                            <div class="card-body">
                                <% if (customer && customer.package_name) { %>
                                    <div class="mb-3">
                                        <strong>Nama Paket:</strong> <%= customer.package_name %>
                                    </div>
                                    <div class="mb-3">
                                        <strong>Kecepatan:</strong> <%= customer.package_speed %>
                                    </div>
                                    <div class="mb-3">
                                        <strong>Harga:</strong> Rp <%= customer.package_price ? parseFloat(customer.package_price).toLocaleString('id-ID') : '0' %>
                                    </div>
                                <% } else { %>
                                    <div class="alert alert-warning">
                                        <i class="bi bi-circle"></i> Pelanggan belum memiliki paket internet
                                    </div>
                                <% } %>
                            </div>
                        </div>
                        
                        <!-- Foto Dokumen Pelanggan -->
                        <div class="card">
                            <div class="card-header">
                                <h5 class="card-title mb-0">
                                    <i class="bi bi-images"></i> Foto Dokumen Pelanggan
                                </h5>
                            </div>
                            <div class="card-body">
                                <div class="row">
                                    <!-- Foto KTP -->
                                    <div class="col-md-6 mb-3">
                                        <h6 class="mb-2"><i class="bi bi-circle"></i> Foto KTP</h6>
                                        <% if (customer && customer.ktp_photo_path) { %>
                                            <div class="text-center">
                                                <img src="<%= customer.ktp_photo_path %>" alt="Foto KTP" class="img-fluid img-thumbnail" style="max-height: 400px; cursor: pointer;" onclick="openImageModal('<%= customer.ktp_photo_path %>', 'Foto KTP')">
                                                <p class="text-muted small mt-2">Klik gambar untuk memperbesar</p>
                                            </div>
                                        <% } else { %>
                                            <div class="alert alert-info">
                                                <i class="bi bi-info-circle-fill"></i> Foto KTP belum diupload
                                            </div>
                                        <% } %>
                                    </div>
                                    
                                    <!-- Foto Rumah Tampak Depan -->
                                    <div class="col-md-6 mb-3">
                                        <h6 class="mb-2"><i class="bi bi-house"></i> Rumah Tampak Depan</h6>
                                        <% if (customer && customer.house_photo_path) { %>
                                            <div class="text-center">
                                                <img src="<%= customer.house_photo_path %>" alt="Foto Rumah Tampak Depan" class="img-fluid img-thumbnail" style="max-height: 400px; cursor: pointer;" onclick="openImageModal('<%= customer.house_photo_path %>', 'Foto Rumah Tampak Depan')">
                                                <p class="text-muted small mt-2">Klik gambar untuk memperbesar</p>
                                            </div>
                                        <% } else { %>
                                            <div class="alert alert-info">
                                                <i class="bi bi-info-circle-fill"></i> Foto Rumah Tampak Depan belum diupload
                                            </div>
                                        <% } %>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- Invoices Table -->
                <div class="row">
                    <div class="col-12">
                        <div class="card">
                            <div class="card-header">
                                <h5 class="card-title mb-0">
                                    <i class="bi bi-receipt"></i> Riwayat Tagihan
                                </h5>
                            </div>
                            <div class="card-body">
                                <div class="table-responsive">
                                    <table class="table table-centered table-nowrap table-hover mb-0">
                                        <thead>
                                            <tr>
                                                <th>No. Tagihan</th>
                                                <th>Paket</th>
                                                <th>Jumlah</th>
                                                <th>Status</th>
                                                <th>Jatuh Tempo</th>
                                                <th>Tanggal Dibuat</th>
                                                <th>Aksi</th>
                                            </tr>
                                        </thead>
                                        <tbody>
                                            <% if (invoices && invoices.length > 0) { %>
                                                <% invoices.forEach(function(invoice) { %>
                                                    <tr>
                                                        <td>
                                                            <span class="text-body fw-bold"><%= invoice ? invoice.invoice_number : 'N/A' %></span>
                                                        </td>
                                                        <td><%= invoice ? invoice.package_name : 'N/A' %></td>
                                                        <td>Rp <%= invoice && invoice.amount ? parseFloat(invoice.amount).toLocaleString('id-ID') : '0' %></td>
                                                        <td>
                                                            <% if (invoice && invoice.status === 'paid') { %>
                                                                <span class="badge bg-success">Lunas</span>
                                                            <% } else if (invoice && invoice.status === 'unpaid') { %>
                                                                <% if (invoice.due_date && new Date(invoice.due_date) < new Date()) { %>
                                                                    <span class="badge bg-warning text-dark">Terlambat</span>
                                                                <% } else { %>
                                                                    <span class="badge bg-warning text-dark">Belum Lunas</span>
                                                                <% } %>
                                                            <% } else { %>
                                                                <span class="badge bg-secondary">Tidak Diketahui</span>
                                                            <% } %>
                                                        </td>
                                                        <td>
                                                            <% if (invoice && invoice.due_date) { %>
                                                                <% if (new Date(invoice.due_date) < new Date() && invoice.status === 'unpaid') { %>
                                                                    <span class="text-danger">
                                                                        <%= new Date(invoice.due_date).toLocaleDateString('id-ID') %>
                                                                    </span>
                                                                <% } else { %>
                                                                    <%= new Date(invoice.due_date).toLocaleDateString('id-ID') %>
                                                                <% } %>
                                                            <% } else { %>
                                                                N/A
                                                            <% } %>
                                                        </td>
                                                        <td><%= invoice && invoice.created_at ? formatDbUtcToJakartaDate(invoice.created_at) : 'N/A' %></td>
                                                        <td>
                                                            <% if (invoice) { %>
                                                                <div class="admin-action-btns">
                                                                    <button type="button" class="btn btn-sm btn-primary view-invoice-btn"
                                                                            data-id="<%= invoice.id %>"
                                                                            data-bs-toggle="tooltip" 
                                                                            data-bs-placement="top" 
                                                                            title="Buka detail tagihan di tab baru"
                                                                            aria-label="Lihat detail tagihan">
                                                                        <i class="bi bi-file-earmark-text-fill"></i>
                                                                    </button>
                                                                    <% if (invoice.status === 'unpaid') { %>
                                                                        <button type="button" class="btn btn-sm btn-success mark-paid-btn"
                                                                                data-id="<%= invoice.id %>"
                                                                                data-invoice-number="<%= invoice.invoice_number %>"
                                                                                data-amount="<%= invoice.amount %>"
                                                                                data-bs-toggle="tooltip" 
                                                                                data-bs-placement="top" 
                                                                                title="Tandai tagihan sebagai lunas"
                                                                                aria-label="Tandai lunas">
                                                                            <i class="bi bi-check-circle-fill"></i>
                                                                        </button>
                                                                    <% } %>
                                                                    <button type="button" class="btn btn-sm btn-info print-invoice-btn"
                                                                            data-id="<%= invoice.id %>"
                                                                            data-bs-toggle="tooltip" 
                                                                            data-bs-placement="top" 
                                                                            title="Buka halaman cetak tagihan"
                                                                            aria-label="Cetak tagihan">
                                                                        <i class="bi bi-printer-fill"></i>
                                                                    </button>
                                                                </div>
                                                            <% } else { %>
                                                                <span class="text-muted">N/A</span>
                                                            <% } %>
                                                        </td>
                                                    </tr>
                                                <% }); %>
                                            <% } else { %>
                                                <tr>
                                                    <td colspan="7" class="text-center text-muted">Belum ada tagihan</td>
                                                </tr>
                                            <% } %>
                                        </tbody>
                                    </table>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
                <!-- Trouble Reports Table -->
                <div class="row mt-4">
                    <div class="col-12">
                        <div class="card">
                            <div class="card-header d-flex align-items-center">
                                <h5 class="card-title mb-0">
                                    <i class="bi bi-exclamation-triangle me-1"></i> Riwayat Laporan Gangguan
                                </h5>
                                <span class="badge bg-light text-dark ms-2"><%= troubleReports && troubleReports.length ? troubleReports.length : 0 %> laporan</span>
                                <a href="/admin/trouble" class="btn btn-sm btn-outline-primary ms-auto">Kelola Semua</a>
                            </div>
                            <div class="card-body">
                                <div class="table-responsive">
                                    <table class="table table-centered table-nowrap table-hover mb-0">
                                        <thead>
                                            <tr>
                                                <th>ID</th>
                                                <th>Tanggal</th>
                                                <th>Kategori</th>
                                                <th>Lokasi</th>
                                                <th>Status</th>
                                                <th>Catatan Terakhir</th>
                                            </tr>
                                        </thead>
                                        <tbody>
                                            <% if (typeof troubleReports !== 'undefined' && troubleReports && troubleReports.length > 0) { %>
                                                <% troubleReports.slice().reverse().forEach(function(rep) { %>
                                                    <tr>
                                                        <td>#<%= rep.id %></td>
                                                        <td><%= rep.created_at ? formatDbUtcToJakartaDateTime(rep.created_at) : '-' %></td>
                                                        <td><%= rep.category || '-' %></td>
                                                        <td><%= rep.location || '-' %></td>
                                                        <td>
                                                            <span class="badge <%= 
                                                                rep.status === 'open' ? 'bg-danger' : 
                                                                rep.status === 'in_progress' ? 'bg-warning text-dark' : 
                                                                rep.status === 'resolved' ? 'bg-success' : 
                                                                'bg-secondary' %>">
                                                                <%= rep.status || '-' %>
                                                            </span>
                                                        </td>
                                                        <td style="max-width: 360px; white-space: nowrap; overflow: hidden; text-overflow: ellipsis;">
                                                            <%= rep.notes && rep.notes.length ? rep.notes[rep.notes.length - 1] : '-' %>
                                                        </td>
                                                    </tr>
                                                <% }); %>
                                            <% } else { %>
                                                <tr>
                                                    <td colspan="6" class="text-center text-muted">Belum ada laporan gangguan</td>
                                                </tr>
                                            <% } %>
                                        </tbody>
                                    </table>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </main>
        </div>
    </div>

    <!-- Mark as Paid Modal -->
    <div class="modal fade" id="markAsPaidModal" tabindex="-1" aria-labelledby="markAsPaidModalLabel" aria-hidden="true">
        <div class="modal-dialog">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title" id="markAsPaidModalLabel">Tandai Sebagai Lunas</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <form id="markAsPaidForm">
                    <div class="modal-body">
                        <input type="hidden" id="paidInvoiceId" name="invoice_id">
                        <div class="mb-3">
                            <label for="paymentMethod" class="form-label">Metode Pembayaran *</label>
                            <select class="form-select" id="paymentMethod" name="payment_method" required>
                                <option value="">Pilih Metode Pembayaran</option>
                                <option value="cash">Tunai</option>
                                <option value="transfer">Transfer Bank</option>
                                <option value="qris">QRIS</option>
                                <option value="ewallet">E-Wallet</option>
                                <option value="other">Lainnya</option>
                            </select>
                        </div>
                        <div class="mb-3">
                            <label for="paymentNotes" class="form-label">Catatan Pembayaran</label>
                            <textarea class="form-control" id="paymentNotes" name="notes" rows="3" placeholder="Catatan pembayaran (opsional)"></textarea>
                        </div>
                    </div>
                    <div class="modal-footer">
                        <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Batal</button>
                        <button type="submit" class="btn btn-success">Tandai Lunas</button>
                    </div>
                </form>
            </div>
        </div>
    </div>

    <script>
    document.addEventListener('DOMContentLoaded', function() {
        // Initialize tooltips
        var tooltipTriggerList = [].slice.call(document.querySelectorAll('[data-bs-toggle="tooltip"]'));
        var tooltipList = tooltipTriggerList.map(function (tooltipTriggerEl) {
            return new bootstrap.Tooltip(tooltipTriggerEl);
        });

        // View Invoice
        document.addEventListener('click', function(e) {
            if (e.target.closest('.view-invoice-btn')) {
                const button = e.target.closest('.view-invoice-btn');
                const id = button.getAttribute('data-id');
                window.open(`/admin/billing/invoices/${id}`, '_blank');
            }
        });
        
        // Print Invoice
        document.addEventListener('click', function(e) {
            if (e.target.closest('.print-invoice-btn')) {
                const button = e.target.closest('.print-invoice-btn');
                const id = button.getAttribute('data-id');
                window.open(`/admin/billing/invoices/${id}/print`, '_blank');
            }
        });
        
        // Mark as Paid
        document.addEventListener('click', function(e) {
            if (e.target.closest('.mark-paid-btn')) {
                const button = e.target.closest('.mark-paid-btn');
                const id = button.getAttribute('data-id');
                const invoiceNumber = button.getAttribute('data-invoice-number');
                const amount = button.getAttribute('data-amount');
                
                document.getElementById('paidInvoiceId').value = id;
                document.getElementById('markAsPaidModalLabel').textContent = `Tandai Sebagai Lunas - ${invoiceNumber}`;
                $('#markAsPaidModal').modal('show');
            }
        });
    });

    // Handle mark as paid form submission
    document.getElementById('markAsPaidForm').addEventListener('submit', function(e) {
        e.preventDefault();
        
        const formData = new FormData(this);
        const data = Object.fromEntries(formData);
        const invoiceId = data.invoice_id;
        const paymentMethod = data.payment_method;
        const notes = data.notes;
        
        // Validate required fields
        if (!paymentMethod) {
            alert('Mohon pilih metode pembayaran');
            return;
        }
        
        // Disable submit button to prevent double submission
        const submitBtn = this.querySelector('button[type="submit"]');
        const originalText = submitBtn.innerHTML;
        submitBtn.disabled = true;
        submitBtn.innerHTML = '<i class="bi bi-circle-fill mdi-spin"></i> Memproses...';
        
        // Get invoice amount first
        fetch(`/admin/billing/api/invoices/${invoiceId}`)
        .then(response => response.json())
        .then(invoiceData => {
            if (!invoiceData.success) {
                throw new Error('Failed to get invoice data');
            }
            
            const invoiceAmount = parseFloat(invoiceData.invoice.amount);
            
            // Record the payment with correct amount
            return fetch('/admin/billing/payments', {
                method: 'POST',
                headers: {
                    'Content-Type': 'application/json',
                },
                body: JSON.stringify({
                    invoice_id: invoiceId,
                    amount: invoiceAmount,
                    payment_method: paymentMethod,
                    reference_number: '',
                    notes: notes || ''
                })
            })
            .then(response => response.json())
            .then(result => {
                if (!result.success) {
                    throw new Error(result.message || 'Gagal mencatat pembayaran');
                }
                // Close modal and reset form
                $('#markAsPaidModal').modal('hide');
                document.getElementById('markAsPaidForm').reset();
                
                // Show success notification
                alert('? Tagihan berhasil ditandai sebagai lunas!');
                
                // Reload page after a short delay
                setTimeout(() => location.reload(), 1500);
            })
            .catch(error => {
                console.error('Error:', error);
                alert('? Terjadi kesalahan saat menandai tagihan sebagai lunas');
            })
            .finally(() => {
                // Re-enable submit button
                submitBtn.disabled = false;
                submitBtn.innerHTML = originalText;
            });
        })
        .catch(error => {
            console.error('Error:', error);
            alert('? Terjadi kesalahan saat menandai tagihan sebagai lunas');
        })
        .finally(() => {
            // Re-enable submit button
            submitBtn.disabled = false;
            submitBtn.innerHTML = originalText;
        });
         });
     </script>
     
     <script>
     // Toggle password visibility
     function togglePasswordVisibility() {
         const passwordInput = document.getElementById('pppoePassword');
         const toggleIcon = document.getElementById('togglePasswordIcon');
         
         if (passwordInput.type === 'password') {
             passwordInput.type = 'text';
             toggleIcon.classList.remove('bi-eye');
             toggleIcon.classList.add('bi-eye-slash');
         } else {
             passwordInput.type = 'password';
             toggleIcon.classList.remove('bi-eye-slash');
             toggleIcon.classList.add('bi-eye');
         }
     }
     
     // Copy password to clipboard
     function copyPassword(event) {
         const passwordInput = document.getElementById('pppoePassword');
         if (!passwordInput) return;
         
         passwordInput.select();
         passwordInput.setSelectionRange(0, 99999); // For mobile devices
         
         try {
             document.execCommand('copy');
             // Show feedback
             const btn = event ? event.target.closest('button') : document.getElementById('copyPasswordBtn');
             if (btn) {
                 const originalHTML = btn.innerHTML;
                 btn.innerHTML = '<i class="bi bi-check"></i>';
                 btn.classList.remove('btn-outline-info');
                 btn.classList.add('btn-success');
                 
                 setTimeout(() => {
                     btn.innerHTML = originalHTML;
                     btn.classList.remove('btn-success');
                     btn.classList.add('btn-outline-info');
                 }, 2000);
             }
         } catch (err) {
             // Fallback: use Clipboard API if available
             if (navigator.clipboard && navigator.clipboard.writeText) {
                 navigator.clipboard.writeText(passwordInput.value).then(() => {
                     const btn = event ? event.target.closest('button') : document.getElementById('copyPasswordBtn');
                     if (btn) {
                         const originalHTML = btn.innerHTML;
                         btn.innerHTML = '<i class="bi bi-check"></i>';
                         btn.classList.remove('btn-outline-info');
                         btn.classList.add('btn-success');
                         setTimeout(() => {
                             btn.innerHTML = originalHTML;
                             btn.classList.remove('btn-success');
                             btn.classList.add('btn-outline-info');
                         }, 2000);
                     }
                 }).catch(() => {
                     alert('Gagal menyalin password. Silakan salin manual.');
                 });
             } else {
                 alert('Gagal menyalin password. Silakan salin manual.');
             }
         }
     }
     
     // Accept customer (generate PPPoE and send notifications)
     async function acceptCustomer(phone) {
         if (!confirm('Yakin ingin accept pelanggan ini?\n\nSistem akan:\n- Generate PPPoE username dan password\n- Mengirim Welcome Message ke pelanggan (WA + Email)\n- Mengirim notifikasi ke teknisi (WA Sales Order)')) {
             return;
         }
         
         const btn = document.getElementById('acceptCustomerBtn');
         const originalHTML = btn.innerHTML;
         btn.disabled = true;
         btn.innerHTML = '<i class="bi bi-circle bx-spin me-2"></i> Memproses...';
         
         try {
             const response = await fetch(`/admin/billing/customers/${phone}/accept`, {
                 method: 'POST',
                 headers: {
                     'Content-Type': 'application/json'
                 }
             });
             
             const data = await response.json();
             
             if (data.success) {
                 alert('Pelanggan berhasil di-accept!\n\n' + (data.message || ''));
                 // Reload page to show updated status
                 window.location.reload();
             } else {
                 alert('Gagal accept pelanggan: ' + (data.message || 'Unknown error'));
                 btn.disabled = false;
                 btn.innerHTML = originalHTML;
             }
         } catch (error) {
             console.error('Error accepting customer:', error);
             alert('Terjadi kesalahan saat accept pelanggan: ' + error.message);
             btn.disabled = false;
             btn.innerHTML = originalHTML;
         }
     }
     
     // Toggle new password visibility
     function toggleNewPasswordVisibility() {
         const pwInput = document.getElementById('newCustomerPassword');
         const icon = document.getElementById('toggleNewPwIcon');
         if (pwInput.type === 'password') {
             pwInput.type = 'text';
             icon.classList.replace('bi-eye', 'bi-eye-slash');
         } else {
             pwInput.type = 'password';
             icon.classList.replace('bi-eye-slash', 'bi-eye');
         }
     }
     
     // Set Customer Password
     async function setCustomerPassword(id) {
         const password = document.getElementById('newCustomerPassword').value;
         if (!password || password.length < 6) {
             alert('Password harus diisi minimal 6 karakter');
             return;
         }
         
         if (!confirm('Yakin ingin menyimpan password baru untuk pelanggan ini?')) return;
         
         const isMember = <%= customer && customer.is_member ? 'true' : 'false' %>;
         const url = isMember ? `/admin/billing/api/members/${id}/set-password` : `/admin/billing/api/customers/${id}/set-password`;
         
         try {
             const res = await fetch(url, {
                 method: 'POST',
                 headers: { 'Content-Type': 'application/json' },
                 body: JSON.stringify({ password })
             });
             const data = await res.json();
             if (data.success) {
                 alert('? ' + data.message);
                 location.reload();
             } else {
                 alert('? Gagal: ' + data.message);
             }
         } catch (err) {
             console.error(err);
             alert('Terjadi kesalahan sistem saat menyimpan password');
         }
     }
     
     // Reset Customer Password
     async function resetCustomerPassword(id) {
         if (!confirm('Yakin ingin mereset/menghapus password pelanggan ini? Pelanggan hanya akan bisa login via OTP.')) return;
         
         try {
             const res = await fetch(`/admin/billing/api/customers/${id}/password`, {
                 method: 'DELETE'
             });
             const data = await res.json();
             if (data.success) {
                 alert('? ' + data.message);
                 location.reload();
             } else {
                 alert('? Gagal: ' + data.message);
             }
         } catch (err) {
             console.error(err);
             alert('Terjadi kesalahan sistem saat mereset password');
         }
     }

     // Mapping Kolektor
     async function assignCollector(customerId) {
         const collectorId = document.getElementById('collectorSelect').value;
         try {
             const response = await fetch(`/admin/billing/api/customers/${customerId}/assign-collector`, {
                 method: 'POST',
                 headers: {
                     'Content-Type': 'application/json'
                 },
                 body: JSON.stringify({ collector_id: collectorId })
             });
             const data = await response.json();
             if (data.success) {
                 alert('? Mapping kolektor berhasil disimpan!');
                 location.reload();
             } else {
                 alert('? Gagal: ' + data.message);
             }
         } catch (err) {
             console.error(err);
             alert('Terjadi kesalahan sistem saat menyimpan mapping kolektor');
         }
     }
     </script>
     
