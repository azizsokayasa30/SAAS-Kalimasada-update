<!DOCTYPE html>
<html lang="id">
<head>
    <%- include('../../partials/hard-reload') %>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Buat Invoice - Admin Portal</title>
    <link href="/vendor/bootstrap/css/bootstrap.min.css" rel="stylesheet">
    <link href="/vendor/boxicons/boxicons.min.css" rel="stylesheet">
    <link href="/vendor/bootstrap-icons/bootstrap-icons.css" rel="stylesheet">
    <link href="/css/admin-mobile.css" rel="stylesheet">
    <style>
        .toast {
            position: fixed;
            top: 20px;
            right: 20px;
            z-index: 9999;
            min-width: 300px;
        }
        .invoice-preview-card {
            position: sticky;
            top: 1rem;
        }
        .preview-row {
            display: flex;
            justify-content: space-between;
            gap: 1rem;
            padding: 0.5rem 0;
            border-bottom: 1px solid var(--bs-border-color, #e9ecef);
        }
        .preview-row:last-child {
            border-bottom: 0;
        }
        .preview-label {
            color: #6c757d;
            font-size: 0.875rem;
        }
        .preview-value {
            font-weight: 600;
            text-align: right;
        }
        #createdInvoiceCard {
            display: none;
        }
    </style>
    <%- include('../../partials/theme-head') %>
</head>
<body>
    <div class="container-fluid">
        <div class="row">
            <%- include('../../partials/billing-sidebar') %>

            <main class="col-md-10 ms-sm-auto col-lg-10 px-md-4 main-content">
                <div class="d-flex justify-content-between flex-wrap flex-md-nowrap align-items-center pt-3 pb-2 mb-3 border-bottom">
                    <h1 class="h2">
                        <i class="bi bi-file-plus"></i> Buat Invoice
                    </h1>
                    <a href="/admin/billing/invoice-list" class="btn btn-outline-secondary">
                        <i class="bi bi-receipt"></i> Semua Invoice
                    </a>
                </div>

                <div class="alert alert-success" id="createdInvoiceCard" role="alert">
                    <div class="d-flex justify-content-between align-items-start flex-wrap gap-2">
                        <div>
                            <h5 class="alert-heading mb-1"><i class="bi bi-check-circle"></i> Tagihan berhasil dibuat</h5>
                            <p class="mb-1">Nomor: <strong id="createdInvoiceNumber">-</strong></p>
                            <p class="mb-1">Jumlah: <strong id="createdInvoiceAmount">-</strong></p>
                            <p class="mb-0">Jatuh tempo: <strong id="createdInvoiceDue">-</strong></p>
                        </div>
                        <div class="d-flex flex-wrap gap-2">
                            <a id="createdInvoiceDetail" href="#" class="btn btn-sm btn-primary">Lihat Detail</a>
                            <a id="createdInvoicePrint" href="#" target="_blank" rel="noopener noreferrer" class="btn btn-sm btn-info">Cetak</a>
                            <a href="/admin/billing/invoice-list" class="btn btn-sm btn-outline-secondary">Semua Invoice</a>
                        </div>
                    </div>
                </div>

                <div class="row">
                    <div class="col-lg-7">
                        <div class="card">
                            <div class="card-header">
                                <h5 class="card-title mb-0">Buat Tagihan Baru</h5>
                            </div>
                            <div class="card-body">
                                <form id="addInvoiceForm">
                                    <div class="mb-3">
                                        <label for="invoice_type_select" class="form-label">Tipe Pelanggan</label>
                                        <select class="form-control" id="invoice_type_select" name="invoice_type_select" required>
                                            <option value="customer">Customer (PPPoE)</option>
                                            <option value="member">Member (Hotspot)</option>
                                        </select>
                                    </div>
                                    <div class="mb-3 position-relative" id="customer_select_group">
                                        <label for="customerSearchInput" class="form-label">Pelanggan</label>
                                        <input type="text" class="form-control" id="customerSearchInput" placeholder="Ketik min. 3 huruf nama/telepon/username…" autocomplete="off">
                                        <input type="hidden" id="customer_id" name="customer_id" value="">
                                        <div id="customerSuggestions" class="list-group position-absolute w-100" style="z-index:1060; max-height:220px; overflow:auto; display:none;"></div>
                                        <div class="form-text">Dropdown rekomendasi muncul setelah mengetik minimal 3 huruf.</div>
                                    </div>
                                    <div class="mb-3" id="member_select_group" style="display: none;">
                                        <label for="member_id" class="form-label">Member</label>
                                        <select class="form-control" id="member_id" name="member_id">
                                            <option value="">Pilih Member</option>
                                            <% if (members && members.length > 0) { %>
                                                <% members.forEach(function(member) { %>
                                                    <option value="<%= member.id %>"
                                                            data-package-id="<%= member.package_id || '' %>">
                                                        <%= member.name %> (<%= member.hotspot_username || member.phone || '-' %>)
                                                    </option>
                                                <% }); %>
                                            <% } %>
                                        </select>
                                    </div>
                                    <div class="mb-3">
                                        <label for="package_id" class="form-label">Paket</label>
                                        <select class="form-control" id="package_id" name="package_id" required>
                                            <option value="">Pilih Paket</option>
                                            <% if (packages && packages.length > 0) { %>
                                                <% packages.forEach(function(package) { %>
                                                    <option value="<%= package.id %>"
                                                            data-package-type="customer"
                                                            data-price="<%= package.price %>"
                                                            data-tax-rate="<%= package.tax_rate !== null && package.tax_rate !== undefined ? package.tax_rate : 11.00 %>">
                                                        [Customer] <%= package.name %> - Rp <%= Math.round(parseFloat(package.price)).toLocaleString('id-ID') %>
                                                        <% if (package.tax_rate === 0) { %>
                                                            (Tidak Ada PPN)
                                                        <% } else if (package.tax_rate) { %>
                                                            (PPN <%= package.tax_rate.toFixed(2) %>%)
                                                        <% } else { %>
                                                            (PPN 11.00%)
                                                        <% } %>
                                                    </option>
                                                <% }); %>
                                            <% } %>
                                            <% if (memberPackages && memberPackages.length > 0) { %>
                                                <% memberPackages.forEach(function(memberPackage) { %>
                                                    <option value="<%= memberPackage.id %>"
                                                            data-package-type="member"
                                                            data-price="<%= memberPackage.price %>"
                                                            data-tax-rate="<%= memberPackage.tax_rate !== null && memberPackage.tax_rate !== undefined ? memberPackage.tax_rate : 11.00 %>"
                                                            style="display: none;">
                                                        [Member] <%= memberPackage.name %> - Rp <%= Math.round(parseFloat(memberPackage.price)).toLocaleString('id-ID') %>
                                                        <% if (memberPackage.tax_rate === 0) { %>
                                                            (Tidak Ada PPN)
                                                        <% } else if (memberPackage.tax_rate) { %>
                                                            (PPN <%= memberPackage.tax_rate.toFixed(2) %>%)
                                                        <% } else { %>
                                                            (PPN 11.00%)
                                                        <% } %>
                                                    </option>
                                                <% }); %>
                                            <% } %>
                                        </select>
                                    </div>
                                    <div class="mb-3">
                                        <label for="base_amount" class="form-label">Harga Dasar (Sebelum PPN)</label>
                                        <input type="number" class="form-control" id="base_amount" min="0" step="1">
                                        <div class="form-text">Otomatis dari paket. Klik kolom ini untuk ubah nominal saja (PPN tetap mengikuti paket).</div>
                                    </div>
                                    <div class="mb-3">
                                        <label for="tax_rate_display" class="form-label">PPN</label>
                                        <input type="text" class="form-control" id="tax_rate_display" readonly>
                                    </div>
                                    <div class="mb-3">
                                        <label for="amount" class="form-label">Jumlah (Setelah PPN)</label>
                                        <input type="number" class="form-control" id="amount" name="amount" required>
                                    </div>
                                    <input type="hidden" id="base_amount_hidden" name="base_amount">
                                    <input type="hidden" id="tax_rate_hidden" name="tax_rate">
                                    <div class="mb-3">
                                        <label for="due_date" class="form-label">Jatuh Tempo</label>
                                        <input type="date" class="form-control" id="due_date" name="due_date" required>
                                    </div>
                                    <div class="mb-3">
                                        <label for="notes" class="form-label">Deskripsi</label>
                                        <textarea class="form-control" id="notes" name="notes" rows="3"></textarea>
                                    </div>
                                    <div class="d-flex gap-2">
                                        <button type="submit" class="btn btn-primary">
                                            <i class="bi bi-plus-lg"></i> Buat Tagihan
                                        </button>
                                        <button type="button" class="btn btn-outline-secondary" id="resetInvoiceForm">Reset</button>
                                    </div>
                                </form>
                            </div>
                        </div>
                    </div>
                    <div class="col-lg-5">
                        <div class="card invoice-preview-card">
                            <div class="card-header">
                                <h5 class="card-title mb-0"><i class="bi bi-eye"></i> Preview Tagihan</h5>
                            </div>
                            <div class="card-body">
                                <div class="preview-row">
                                    <span class="preview-label">Tipe</span>
                                    <span class="preview-value" id="previewType">Customer (PPPoE)</span>
                                </div>
                                <div class="preview-row">
                                    <span class="preview-label">Pelanggan</span>
                                    <span class="preview-value" id="previewCustomer">-</span>
                                </div>
                                <div class="preview-row">
                                    <span class="preview-label">Paket</span>
                                    <span class="preview-value" id="previewPackage">-</span>
                                </div>
                                <div class="preview-row">
                                    <span class="preview-label">Harga dasar</span>
                                    <span class="preview-value" id="previewBase">-</span>
                                </div>
                                <div class="preview-row">
                                    <span class="preview-label">PPN</span>
                                    <span class="preview-value" id="previewTax">-</span>
                                </div>
                                <div class="preview-row">
                                    <span class="preview-label">Total</span>
                                    <span class="preview-value" id="previewAmount">-</span>
                                </div>
                                <div class="preview-row">
                                    <span class="preview-label">Jatuh tempo</span>
                                    <span class="preview-value" id="previewDue">-</span>
                                </div>
                                <div class="preview-row">
                                    <span class="preview-label">Catatan</span>
                                    <span class="preview-value" id="previewNotes">-</span>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </main>
        </div>
    </div>

    <script src="/vendor/bootstrap/js/bootstrap.bundle.min.js"></script>
    <script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
    <script>
        $(document).ready(function() {
            const invoiceCustomerOptions = <%- JSON.stringify((customers || []).map(function(c) {
                return {
                    id: c.id,
                    name: c.name || '',
                    phone: c.phone || '',
                    username: c.username || '',
                    package_id: c.package_id || null
                };
            })) %>;

            function formatRupiah(value) {
                const num = Number(value);
                if (!Number.isFinite(num)) return '-';
                return 'Rp ' + Math.round(num).toLocaleString('id-ID');
            }

            function formatDue(value) {
                if (!value) return '-';
                const parts = String(value).split('-');
                if (parts.length !== 3) return value;
                return parts[2] + '/' + parts[1] + '/' + parts[0];
            }

            function selectedPackageLabel() {
                const opt = document.querySelector('#package_id option:checked');
                if (!opt || !opt.value) return '-';
                return (opt.textContent || '-').replace(/\s+/g, ' ').trim();
            }

            function selectedCustomerLabel() {
                const type = $('#invoice_type_select').val();
                if (type === 'member') {
                    const opt = document.querySelector('#member_id option:checked');
                    if (!opt || !opt.value) return '-';
                    return (opt.textContent || '-').replace(/\s+/g, ' ').trim();
                }
                const typed = ($('#customerSearchInput').val() || '').trim();
                if ($('#customer_id').val() && typed) return typed;
                return '-';
            }

            function updateInvoicePreview() {
                const type = $('#invoice_type_select').val();
                $('#previewType').text(type === 'member' ? 'Member (Hotspot)' : 'Customer (PPPoE)');
                $('#previewCustomer').text(selectedCustomerLabel());
                $('#previewPackage').text(selectedPackageLabel());
                const base = $('#base_amount').val();
                $('#previewBase').text(base ? formatRupiah(base) : '-');
                $('#previewTax').text(($('#tax_rate_display').val() || '').trim() || '-');
                const amount = $('#amount').val();
                $('#previewAmount').text(amount ? formatRupiah(amount) : '-');
                $('#previewDue').text(formatDue($('#due_date').val()));
                const notes = ($('#notes').val() || '').trim();
                $('#previewNotes').text(notes || '-');
            }

            function clearInvoiceCustomerSelection() {
                $('#customer_id').val('');
                $('#customerSearchInput').val('');
                $('#customerSuggestions').hide().empty();
                updateInvoicePreview();
            }

            function renderInvoiceCustomerSuggestions(keyword) {
                const box = document.getElementById('customerSuggestions');
                if (!box) return;
                const q = String(keyword || '').toLowerCase().trim();
                if (q.length < 3) {
                    box.style.display = 'none';
                    box.innerHTML = '';
                    return;
                }
                const matches = invoiceCustomerOptions.filter(function(c) {
                    return String(c.name || '').toLowerCase().includes(q)
                        || String(c.phone || '').toLowerCase().includes(q)
                        || String(c.username || '').toLowerCase().includes(q);
                }).slice(0, 12);

                if (!matches.length) {
                    box.innerHTML = '<div class="list-group-item text-muted">Pelanggan tidak ditemukan</div>';
                    box.style.display = 'block';
                    return;
                }

                box.innerHTML = matches.map(function(c) {
                    const labelName = String(c.name || '-').replace(/"/g, '&quot;');
                    const labelPhone = String(c.phone || '-').replace(/"/g, '&quot;');
                    const pkgId = c.package_id != null ? String(c.package_id) : '';
                    return '<button type="button" class="list-group-item list-group-item-action invoice-customer-suggestion"'
                        + ' data-id="' + c.id + '"'
                        + ' data-name="' + labelName + '"'
                        + ' data-phone="' + labelPhone + '"'
                        + ' data-package-id="' + pkgId + '">'
                        + '<strong>' + (c.name || '-') + '</strong><br>'
                        + '<small>' + (c.phone || '-') + ' | ' + (c.username || '-') + '</small>'
                        + '</button>';
                }).join('');
                box.style.display = 'block';
            }

            $('#customerSearchInput').on('input', function() {
                $('#customer_id').val('');
                renderInvoiceCustomerSuggestions(this.value);
                updateInvoicePreview();
            });

            function applyCustomerPackage(packageId) {
                if (!packageId) return;
                const $opt = $('#package_id option[data-package-type="customer"][value="' + packageId + '"]');
                if (!$opt.length) return;
                $('#package_id').val(String(packageId)).trigger('change');
            }

            $(document).on('click', '.invoice-customer-suggestion', function() {
                const id = $(this).data('id');
                const name = $(this).data('name') || '';
                const phone = $(this).data('phone') || '';
                const packageId = $(this).data('package-id') || '';
                $('#customer_id').val(id);
                $('#customerSearchInput').val(name + (phone ? ' (' + phone + ')' : ''));
                $('#customerSuggestions').hide().empty();
                applyCustomerPackage(packageId);
                updateInvoicePreview();
            });

            $(document).on('click', function(e) {
                if (!$(e.target).closest('#customer_select_group').length) {
                    $('#customerSuggestions').hide();
                }
            });

            function applyBaseAmountToTotal(price) {
                const taxRate = parseFloat($('#tax_rate_hidden').val());
                const rate = Number.isFinite(taxRate) ? taxRate : 0;
                const base = Math.max(0, parseFloat(price) || 0);
                $('#base_amount_hidden').val(base);
                if (rate === 0) {
                    $('#amount').val(base);
                } else {
                    $('#amount').val(Math.round(base * (1 + rate / 100)));
                }
                updateInvoicePreview();
            }

            $('#base_amount').on('focus', function() {
                this.select();
            });

            $('#base_amount').on('input', function() {
                applyBaseAmountToTotal($(this).val());
            });

            $('#invoice_type_select').on('change', function() {
                const invoiceType = $(this).val();
                if (invoiceType === 'customer') {
                    $('#customer_select_group').show();
                    $('#member_select_group').hide();
                    $('#customer_id').prop('required', true);
                    $('#member_id').prop('required', false);
                    $('#member_id').val('');
                    $('#package_id option[data-package-type="customer"]').show();
                    $('#package_id option[data-package-type="member"]').hide();
                    $('#package_id').val('');
                } else if (invoiceType === 'member') {
                    $('#customer_select_group').hide();
                    $('#member_select_group').show();
                    $('#customer_id').prop('required', false);
                    $('#member_id').prop('required', true);
                    clearInvoiceCustomerSelection();
                    $('#package_id option[data-package-type="member"]').show();
                    $('#package_id option[data-package-type="customer"]').hide();
                    $('#package_id').val('');
                }
                $('#base_amount').val('');
                $('#tax_rate_display').val('');
                $('#amount').val('');
                $('#base_amount_hidden').val('');
                $('#tax_rate_hidden').val('');
                updateInvoicePreview();
            });

            $('#member_id').on('change', function() {
                const selectedMember = $(this).find('option:selected');
                const packageId = selectedMember.data('package-id');
                if (packageId) {
                    $('#package_id').val(packageId).trigger('change');
                }
                updateInvoicePreview();
            });

            $('#package_id').on('change', function() {
                const selectedOption = $(this).find('option:selected');
                const price = parseFloat(selectedOption.data('price')) || 0;
                const taxRate = parseFloat(selectedOption.data('tax-rate')) || 0;

                $('#base_amount').val(price);

                if (taxRate === 0) {
                    $('#tax_rate_display').val('0% (Tidak Ada PPN)');
                    $('#amount').val(price);
                } else {
                    $('#tax_rate_display').val(taxRate + '%');
                    const amount = price * (1 + taxRate / 100);
                    $('#amount').val(Math.round(amount));
                }

                $('#base_amount_hidden').val(price);
                $('#tax_rate_hidden').val(taxRate);
                updateInvoicePreview();
            });

            $('#amount, #due_date, #notes').on('input change', updateInvoicePreview);

            const today = new Date();
            const dueDate = new Date(today.getTime() + (30 * 24 * 60 * 60 * 1000));
            $('#due_date').val(dueDate.toISOString().split('T')[0]);
            updateInvoicePreview();

            $('#resetInvoiceForm').on('click', function() {
                document.getElementById('addInvoiceForm').reset();
                clearInvoiceCustomerSelection();
                $('#invoice_type_select').val('customer').trigger('change');
                const nextDue = new Date(Date.now() + (30 * 24 * 60 * 60 * 1000));
                $('#due_date').val(nextDue.toISOString().split('T')[0]);
                updateInvoicePreview();
            });
        });

        $('#addInvoiceForm').on('submit', function(e) {
            e.preventDefault();

            const invoiceType = $('#invoice_type_select').val();
            if (invoiceType === 'customer' && !$('#customer_id').val()) {
                alert('Pilih pelanggan dari rekomendasi (ketik min. 3 huruf lalu klik hasilnya).');
                $('#customerSearchInput').focus();
                return;
            }
            if (invoiceType === 'member' && !$('#member_id').val()) {
                alert('Pilih member terlebih dahulu');
                return;
            }

            const formData = new FormData(this);
            const urlParams = new URLSearchParams();
            for (const [key, value] of formData.entries()) {
                urlParams.append(key, value);
            }

            const $btn = $(this).find('button[type="submit"]');
            const originalText = $btn.html();
            $btn.prop('disabled', true).html('<i class="bi bi-hourglass-split"></i> Memproses...');

            fetch('/admin/billing/invoices', {
                method: 'POST',
                headers: { 'Content-Type': 'application/x-www-form-urlencoded;charset=UTF-8' },
                body: urlParams.toString()
            })
            .then(response => response.json())
            .then(data => {
                if (data.success) {
                    showToast('success', 'Tagihan Berhasil', 'Tagihan berhasil dibuat');
                    const inv = data.invoice || {};
                    const invId = inv.id;
                    document.getElementById('createdInvoiceNumber').textContent = inv.invoice_number || '-';
                    const amount = inv.amount != null ? inv.amount : $('#amount').val();
                    document.getElementById('createdInvoiceAmount').textContent = amount
                        ? ('Rp ' + Math.round(Number(amount)).toLocaleString('id-ID'))
                        : '-';
                    const due = inv.due_date || $('#due_date').val();
                    document.getElementById('createdInvoiceDue').textContent = due || '-';
                    if (invId) {
                        document.getElementById('createdInvoiceDetail').href = '/admin/billing/invoices/' + invId;
                        document.getElementById('createdInvoicePrint').href = '/admin/billing/invoices/' + invId + '/print';
                    }
                    document.getElementById('createdInvoiceCard').style.display = 'block';
                    document.getElementById('createdInvoiceCard').scrollIntoView({ behavior: 'smooth', block: 'start' });
                } else {
                    showToast('error', 'Gagal Membuat Tagihan', data.message || 'Gagal membuat tagihan');
                }
            })
            .catch(error => {
                console.error('Error:', error);
                showToast('error', 'Error', 'Terjadi kesalahan saat membuat tagihan');
            })
            .finally(() => {
                $btn.prop('disabled', false).html(originalText);
            });
        });

        const toastContainer = document.createElement('div');
        toastContainer.id = 'toast-container';
        document.body.appendChild(toastContainer);

        function showToast(type, title, message, duration = 5000) {
            const toastId = 'toast-' + Date.now();
            const iconClass = type === 'success' ? 'bi-check-circle' : type === 'error' ? 'bi-x-circle' : 'bi-info-circle';
            const bgClass = type === 'success' ? 'bg-success' : type === 'error' ? 'bg-danger' : 'bg-primary';

            const toastHtml = `
                <div id="${toastId}" class="toast align-items-center text-white ${bgClass} border-0" role="alert" aria-live="assertive" aria-atomic="true">
                    <div class="d-flex">
                        <div class="toast-body">
                            <i class="bi ${iconClass} me-2"></i>
                            <strong>${title}</strong><br>
                            <small>${message}</small>
                        </div>
                        <button type="button" class="btn-close btn-close-white me-2 m-auto" data-bs-dismiss="toast" aria-label="Close"></button>
                    </div>
                </div>
            `;

            $('#toast-container').append(toastHtml);
            const toastElement = document.getElementById(toastId);
            const toast = new bootstrap.Toast(toastElement, { delay: duration });
            toast.show();

            toastElement.addEventListener('hidden.bs.toast', () => {
                toastElement.remove();
            });
        }
    </script>

    <%- include('../../partials/currency-helper') %>
    <%- include('../../partials/admin-mobile-navbar', { currentPage: 'invoices' }) %>
</body>
</html>
