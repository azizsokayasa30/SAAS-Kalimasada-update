            <input type="text" class="form-control" id="customerSearchInput" placeholder="Cari nama, username, no. hp, alamat..." autocomplete="off" required>
            <input type="hidden" id="selectedCustomerId" required>
            <div id="customerSuggestions" class="list-group position-absolute w-100" style="z-index:1060; max-height:320px; overflow:auto; display:none;"></div>
          </div>

          <div class="mb-3">
            <label class="form-label">Invoice Belum Lunas</label>
            <select class="form-select" id="invoiceSelect" required>
              <option value="">Pilih invoice</option>
            </select>
          </div>

          <div class="mb-3">
            <label class="form-label">Jumlah Invoice</label>
            <input type="number" class="form-control" id="invoiceAmount" readonly>
          </div>

          <div class="mb-3">
            <label class="form-label">Diskon (Rp)</label>
            <input type="number" class="form-control" id="discountAmount" min="0" step="1" value="0" required>
          </div>

          <div class="mb-3">
            <label class="form-label">Metode Pembayaran</label>
            <select class="form-select" id="paymentMethod" required>
              <option value="">Pilih metode pembayaran</option>
              <option value="manual_admin" selected>Admin Kantor (Manual)</option>
              <option value="cash">Tunai</option>
              <option value="transfer_bank">Transfer Bank</option>
              <option value="qris">QRIS</option>
            </select>
          </div>

          <div class="mb-3">
            <label class="form-label">Tanggal Pembayaran</label>
            <input type="date" class="form-control" id="paymentDate" required>
          </div>

          <div class="alert alert-info mb-0">
            Total dibayar: <strong id="finalPaymentText">Rp 0</strong>
          </div>
        </div>
        <div class="modal-footer">
          <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Batal</button>
          <button type="submit" class="btn btn-success">Submit Pembayaran</button>
        </div>
      </form>
    </div>
  </div>
</div>

<script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
<script src="/vendor/bootstrap/js/bootstrap.bundle.min.js"></script>

<script>
        const isAllPaymentsPage = <%= isAllPayments ? 'true' : 'false' %>;

        function resetFilters() {
            window.location.href = isAllPaymentsPage ? '/admin/billing/all-payments' : '/admin/billing/payments';
        }

        function csvNoteDisplay(notes) {
            if (notes == null || notes === '') return '';
            const s = String(notes).trim();
            if (!s) return '';
            if (/^collector\s+\d+(\s|$|\[)/i.test(s)) return '';
            return s.replace(/\n/g, ' ');
        }

        document.getElementById('exportPayments').addEventListener('click', function () {
            if (isAllPaymentsPage) {
                const form = document.getElementById('allPaymentsFilterForm');
                const params = form
                    ? new URLSearchParams(new FormData(form))
                    : new URLSearchParams(window.location.search);
                window.location.href = '/admin/billing/all-payments/export.xlsx?' + params.toString();
                return;
            }
            const paymentsData = <%- JSON.stringify(payments || []) %>;
            const headers = ['Date', 'Collector', 'Customer', 'Phone', 'Amount', 'Commission', 'Method', 'Status', 'Remittance', 'Notes'];
            const rows = paymentsData.map(function (p) {
                return [
                    p.payment_date || '',
                    p.collector_name || 'Admin',
                    p.customer_name || '',
                    p.customer_phone || '',
                    p.amount || 0,
                    p.commission_amount || 0,
                    p.payment_method || '',
                    'completed',
                    p.remittance_status || (!p.collector_id ? 'N/A (Admin)' : 'pending'),
                    csvNoteDisplay(p.notes)
                ];
            });
            const csv = [headers].concat(rows).map(function (r) {
                return r.map(function (x) { return '"' + String(x).replace(/"/g, '""') + '"'; }).join(',');
            }).join('\n');
            const blob = new Blob([csv], { type: 'text/csv;charset=utf-8;' });
            const url = URL.createObjectURL(blob);
            const a = document.createElement('a');
            a.href = url;
            a.download = 'payments.csv';
            a.click();
            URL.revokeObjectURL(url);
        });

        if (isAllPaymentsPage) {
            let cancelPaymentModalInstance = null;
            let cancelPaymentTargetBtn = null;
            let typedCancelPassword = '';
            const cancelModalEl = document.getElementById('cancelPaymentModal');
            const cancelForm = document.getElementById('cancelPaymentForm');
            const cancelPwdInput = document.getElementById('cancelPaymentPassword');
            const cancelIdInput = document.getElementById('cancelPaymentId');
            const cancelSummaryEl = document.getElementById('cancelPaymentSummary');
            const cancelConfirmBtn = document.getElementById('cancelPaymentConfirmBtn');
            const filterForm = document.getElementById('allPaymentsFilterForm');
            const filterFrom = document.getElementById('filterFrom');
            const filterTo = document.getElementById('filterTo');
            const filterMonth = document.getElementById('filterMonth');
            const filterYear = document.getElementById('filterYear');
            const filterTodayBtn = document.getElementById('filterTodayBtn');
            const filterDateTrigger = document.getElementById('filterDateTrigger');
            const filterDateLabel = document.getElementById('filterDateLabel');
            const filterDateClear = document.getElementById('filterDateClear');
            const filterDateModalEl = document.getElementById('filterDateModal');
            const calGrid = document.getElementById('calGrid');
            const calMonthYear = document.getElementById('calMonthYear');
            const calHint = document.getElementById('calHint');
            const calPrevBtn = document.getElementById('calPrevBtn');
            const calNextBtn = document.getElementById('calNextBtn');
            const calTodayPickBtn = document.getElementById('calTodayPickBtn');
            const cal7dBtn = document.getElementById('cal7dBtn');
            const calMonthBtn = document.getElementById('calMonthBtn');
            const calApplyBtn = document.getElementById('calApplyBtn');
            const ID_MONTHS = ['Januari', 'Februari', 'Maret', 'April', 'Mei', 'Juni', 'Juli', 'Agustus', 'September', 'Oktober', 'November', 'Desember'];
            const ID_MONTHS_SHORT = ['Jan', 'Feb', 'Mar', 'Apr', 'Mei', 'Jun', 'Jul', 'Agu', 'Sep', 'Okt', 'Nov', 'Des'];
            let syncingDateToMonth = false;
            let calViewYear = 0;
            let calViewMonth = 0;
            let calFromIso = '';
            let calToIso = '';
            let filterDateModalInstance = null;

            function todayIso() {
                return (filterForm && filterForm.getAttribute('data-today')) || new Date().toISOString().slice(0, 10);
            }

            function parseIsoDate(iso) {
                const m = String(iso || '').match(/^(\d{4})-(\d{2})-(\d{2})$/);
                if (!m) return null;
                return { y: Number(m[1]), m: Number(m[2]), d: Number(m[3]) };
            }

            function toIso(y, m, d) {
                return String(y) + '-' + String(m).padStart(2, '0') + '-' + String(d).padStart(2, '0');
            }

            function addDaysIso(iso, days) {
                const p = parseIsoDate(iso);
                if (!p) return iso;
                const dt = new Date(p.y, p.m - 1, p.d + days);
                return toIso(dt.getFullYear(), dt.getMonth() + 1, dt.getDate());
            }

            function monthBounds(y, m) {
                const last = new Date(y, m, 0).getDate();
                return { from: toIso(y, m, 1), to: toIso(y, m, last) };
            }

            function selectedMonthBounds() {
                const y = parseInt(filterYear && filterYear.value, 10) || new Date().getFullYear();
                const m = parseInt(filterMonth && filterMonth.value, 10) || (new Date().getMonth() + 1);
                return monthBounds(y, m);
            }

            function formatRangeLabel(fromIso, toIso) {
                const a = parseIsoDate(fromIso);
                const b = parseIsoDate(toIso) || a;
                if (!a) return '';
                if (!b || fromIso === toIso) return a.d + ' ' + ID_MONTHS[a.m - 1] + ' ' + a.y;
                if (a.y === b.y && a.m === b.m) return a.d + '-' + b.d + ' ' + ID_MONTHS[a.m - 1] + ' ' + a.y;
                if (a.y === b.y) return a.d + ' ' + ID_MONTHS_SHORT[a.m - 1] + ' – ' + b.d + ' ' + ID_MONTHS_SHORT[b.m - 1] + ' ' + a.y;
                return a.d + ' ' + ID_MONTHS_SHORT[a.m - 1] + ' ' + a.y + ' – ' + b.d + ' ' + ID_MONTHS_SHORT[b.m - 1] + ' ' + b.y;
            }

            function syncMonthYearFromIso(iso) {
                const p = parseIsoDate(iso);
                if (!p || !filterMonth || !filterYear) return;
                syncingDateToMonth = true;
                filterYear.value = String(p.y);
                filterMonth.value = String(p.m);
                syncingDateToMonth = false;
            }

            function isFullMonthRange(fromIso, toIso) {
                const p = parseIsoDate(fromIso);
                if (!p) return false;
                const b = monthBounds(p.y, p.m);
                return fromIso === b.from && toIso === b.to;
            }

            function updateDateTrigger() {
                const fromIso = filterFrom ? String(filterFrom.value || '').trim() : '';
                const toIsoVal = filterTo ? String(filterTo.value || '').trim() : '';
                const label = formatRangeLabel(fromIso, toIsoVal);
                if (filterDateLabel) filterDateLabel.textContent = label;
                if (filterDateTrigger) {
                    if (isFullMonthRange(fromIso, toIsoVal)) filterDateTrigger.classList.remove('is-custom-range');
                    else filterDateTrigger.classList.add('is-custom-range');
                }
            }

            function applyFilterRange(fromIso, toIso, submit) {
                let fromVal = fromIso || '';
                let toVal = toIso || fromVal;
                if (fromVal && toVal && fromVal > toVal) {
                    const swap = fromVal;
                    fromVal = toVal;
                    toVal = swap;
                }
                if (filterFrom) filterFrom.value = fromVal;
                if (filterTo) filterTo.value = toVal;
                if (fromVal) syncMonthYearFromIso(fromVal);
                updateDateTrigger();
                if (submit && filterForm) filterForm.submit();
            }

            function applyFullSelectedMonth(submit) {
                const b = selectedMonthBounds();
                applyFilterRange(b.from, b.to, submit);
            }

            function updateCalHint() {
                if (!calHint) return;
                if (calFromIso && !calToIso) calHint.textContent = 'Pilih tanggal akhir.';
                else if (calFromIso && calToIso) calHint.textContent = formatRangeLabel(calFromIso, calToIso);
                else calHint.textContent = 'Klik tanggal mulai, lalu tanggal akhir.';
            }

            function renderCalendar() {
                if (!calGrid || !calMonthYear) return;
                const today = parseIsoDate(todayIso());
                let startIso = calFromIso;
                let endIso = calToIso || calFromIso;
                if (startIso && endIso && startIso > endIso) {
                    const swap = startIso;
                    startIso = endIso;
                    endIso = swap;
                }
                calMonthYear.textContent = ID_MONTHS[calViewMonth - 1] + ' ' + calViewYear;
                const first = new Date(calViewYear, calViewMonth - 1, 1);
                const startOffset = (first.getDay() + 6) % 7;
                const daysInMonth = new Date(calViewYear, calViewMonth, 0).getDate();
                const prevMonthDays = new Date(calViewYear, calViewMonth - 1, 0).getDate();
                const cells = [];
                for (let i = 0; i < 42; i++) {
                    let y = calViewYear;
                    let m = calViewMonth;
                    let d = i - startOffset + 1;
                    let muted = false;
                    if (d < 1) {
                        m -= 1;
                        if (m < 1) { m = 12; y -= 1; }
                        d = prevMonthDays + d;
                        muted = true;
                    } else if (d > daysInMonth) {
                        d = d - daysInMonth;
                        m += 1;
                        if (m > 12) { m = 1; y += 1; }
                        muted = true;
                    }
                    const iso = toIso(y, m, d);
                    const isToday = today && today.y === y && today.m === m && today.d === d;
                    const isStart = startIso && iso === startIso;
                    const isEnd = endIso && iso === endIso;
                    const inRange = startIso && endIso && iso >= startIso && iso <= endIso && startIso !== endIso;
                    cells.push(
                        '<button type="button" class="cal-day'
                        + (muted ? ' is-muted' : '')
                        + (isToday ? ' is-today' : '')
                        + (inRange ? ' is-in-range' : '')
                        + (isStart ? ' is-range-start is-selected' : '')
                        + (isEnd ? ' is-range-end is-selected' : '')
                        + '" data-iso="' + iso + '">' + d + '</button>'
                    );
                }
                calGrid.innerHTML = cells.join('');
                updateCalHint();
            }

            function openDateModal() {
                const fromIso = filterFrom ? String(filterFrom.value || '').trim() : '';
                const toIsoVal = filterTo ? String(filterTo.value || '').trim() : '';
                const current = parseIsoDate(fromIso) || parseIsoDate(todayIso()) || {
                    y: new Date().getFullYear(),
                    m: new Date().getMonth() + 1,
                    d: 1
                };
                calViewYear = current.y;
                calViewMonth = current.m;
                calFromIso = fromIso;
                calToIso = toIsoVal;
                renderCalendar();
                if (!filterDateModalInstance && filterDateModalEl && window.bootstrap && bootstrap.Modal) {
                    filterDateModalInstance = new bootstrap.Modal(filterDateModalEl);
                }
                if (filterDateModalInstance) filterDateModalInstance.show();
            }

            if (filterDateTrigger) {
                filterDateTrigger.addEventListener('click', function (ev) {
                    if (ev.target && ev.target.closest && ev.target.closest('#filterDateClear')) return;
                    openDateModal();
                });
            }
            if (filterDateClear) {
                filterDateClear.addEventListener('click', function (ev) {
                    ev.preventDefault();
                    ev.stopPropagation();
                    applyFullSelectedMonth(true);
                });
            }
            if (calGrid) {
                calGrid.addEventListener('click', function (ev) {
                    const btn = ev.target && ev.target.closest ? ev.target.closest('.cal-day') : null;
                    if (!btn) return;
                    const iso = btn.getAttribute('data-iso') || '';
                    if (!iso) return;
                    if (!calFromIso || (calFromIso && calToIso)) {
                        calFromIso = iso;
                        calToIso = '';
                        renderCalendar();
                        return;
                    }
                    calToIso = iso;
                    if (calToIso < calFromIso) {
                        const swap = calFromIso;
                        calFromIso = calToIso;
                        calToIso = swap;
                    }
                    renderCalendar();
                    if (filterDateModalInstance) filterDateModalInstance.hide();
                    applyFilterRange(calFromIso, calToIso, true);
                });
            }
            if (calPrevBtn) {
                calPrevBtn.addEventListener('click', function () {
                    calViewMonth -= 1;
                    if (calViewMonth < 1) { calViewMonth = 12; calViewYear -= 1; }
                    renderCalendar();
                });
            }
            if (calNextBtn) {
                calNextBtn.addEventListener('click', function () {
                    calViewMonth += 1;
                    if (calViewMonth > 12) { calViewMonth = 1; calViewYear += 1; }
                    renderCalendar();
                });
            }
            if (calTodayPickBtn) {
                calTodayPickBtn.addEventListener('click', function () {
                    const iso = todayIso();
                    if (filterDateModalInstance) filterDateModalInstance.hide();
                    applyFilterRange(iso, iso, true);
                });
            }
            if (cal7dBtn) {
                cal7dBtn.addEventListener('click', function () {
                    const toVal = todayIso();
                    const fromVal = addDaysIso(toVal, -6);
                    if (filterDateModalInstance) filterDateModalInstance.hide();
                    applyFilterRange(fromVal, toVal, true);
                });
            }
            if (calMonthBtn) {
                calMonthBtn.addEventListener('click', function () {
                    const b = monthBounds(calViewYear, calViewMonth);
                    if (filterDateModalInstance) filterDateModalInstance.hide();
                    applyFilterRange(b.from, b.to, true);
                });
            }
            if (calApplyBtn) {
                calApplyBtn.addEventListener('click', function () {
                    if (!calFromIso) return;
                    if (filterDateModalInstance) filterDateModalInstance.hide();
                    applyFilterRange(calFromIso, calToIso || calFromIso, true);
                });
            }

            if (filterMonth && filterYear) {
                function onMonthYearChange() {
                    if (syncingDateToMonth) return;
                    const b = selectedMonthBounds();
                    if (filterFrom) filterFrom.value = b.from;
                    if (filterTo) filterTo.value = b.to;
                    updateDateTrigger();
                }
                filterMonth.addEventListener('change', onMonthYearChange);
                filterYear.addEventListener('change', onMonthYearChange);
            }
            if (filterTodayBtn && filterForm) {
                filterTodayBtn.addEventListener('click', function () {
                    const iso = todayIso();
                    applyFilterRange(iso, iso, true);
                });
            }

            function unlockCancelPasswordField() {
                if (!cancelPwdInput) return;
                cancelPwdInput.removeAttribute('readonly');
            }

            function readCancelPassword() {
                unlockCancelPasswordField();
                let fromInput = cancelPwdInput ? String(cancelPwdInput.value || '') : '';
                if (!String(fromInput).trim() && cancelPwdInput) {
                    cancelPwdInput.blur();
                    fromInput = String(cancelPwdInput.value || '');
                }
                const fromForm = cancelForm ? String(new FormData(cancelForm).get('confirm_password') || '') : '';
                return String(fromInput || fromForm || typedCancelPassword || '').trim();
            }

            if (cancelPwdInput) {
                cancelPwdInput.addEventListener('focus', unlockCancelPasswordField);
                cancelPwdInput.addEventListener('click', unlockCancelPasswordField);
                cancelPwdInput.addEventListener('input', function () {
                    typedCancelPassword = this.value;
                });
                cancelPwdInput.addEventListener('change', function () {
                    typedCancelPassword = this.value;
                });
                cancelPwdInput.addEventListener('keydown', function (ev) {
                    typedCancelPassword = this.value;
                    if (ev.key === 'Enter') {
                        ev.preventDefault();
                        submitCancelPayment();
                    }
                });
            }

            document.addEventListener('click', function (ev) {
                const btn = ev.target.closest('.btn-cancel-payment');
                if (!btn || !cancelModalEl) return;
                const id = btn.getAttribute('data-payment-id');
                const inv = btn.getAttribute('data-invoice') || '';
                const cust = btn.getAttribute('data-customer') || '';
                const amt = Number(btn.getAttribute('data-amount') || 0);
                const rp = 'Rp ' + Math.round(amt).toLocaleString('id-ID');
                cancelPaymentTargetBtn = btn;
                typedCancelPassword = '';
                cancelIdInput.value = id || '';
                cancelSummaryEl.innerHTML =
                    '<strong>Invoice:</strong> ' + inv + '<br>' +
                    '<strong>Pelanggan:</strong> ' + cust + '<br>' +
                    '<strong>Jumlah:</strong> ' + rp;
                cancelPwdInput.value = '';
                cancelPwdInput.setAttribute('readonly', 'readonly');
                if (!cancelPaymentModalInstance) {
                    cancelPaymentModalInstance = new bootstrap.Modal(cancelModalEl);
                }
                cancelPaymentModalInstance.show();
                setTimeout(function () {
                    unlockCancelPasswordField();
                    cancelPwdInput.focus();
                }, 400);
            });

            async function submitCancelPayment() {
                const id = cancelIdInput.value;
                const pwd = readCancelPassword();
                if (!id) return;
                if (!pwd) {
                    alert('Masukkan password admin.');
                    unlockCancelPasswordField();
                    cancelPwdInput.focus();
                    return;
                }
                cancelConfirmBtn.disabled = true;
                try {
                    const resp = await fetch('/admin/billing/api/payments/' + encodeURIComponent(id) + '/cancel', {
                        method: 'POST',
                        headers: { 'Content-Type': 'application/json', 'Accept': 'application/json' },
                        credentials: 'same-origin',
                        body: JSON.stringify({
                            confirm_password: pwd,
                            super_admin_password: pwd,
                            password: pwd
                        })
                    });
                    const data = await resp.json().catch(function () { return {}; });
                    if (!resp.ok || !data.success) {
                        alert(data.message || 'Gagal membatalkan pembayaran');
                        cancelConfirmBtn.disabled = false;
                        unlockCancelPasswordField();
                        cancelPwdInput.focus();
                        return;
                    }
                    if (cancelPaymentModalInstance) cancelPaymentModalInstance.hide();
                    alert(data.message || 'Pembayaran dibatalkan.');
                    window.location.reload();
                } catch (err) {
                    alert('Gagal membatalkan pembayaran (jaringan atau server).');
                    cancelConfirmBtn.disabled = false;
                }
            }

            if (cancelForm) {
                cancelForm.addEventListener('submit', function (ev) {
                    ev.preventDefault();
                    submitCancelPayment();
                });
            } else if (cancelConfirmBtn) {
                cancelConfirmBtn.addEventListener('click', submitCancelPayment);
            }

            cancelModalEl.addEventListener('hidden.bs.modal', function () {
                cancelConfirmBtn.disabled = false;
                typedCancelPassword = '';
                cancelPwdInput.value = '';
                if (cancelPaymentTargetBtn) cancelPaymentTargetBtn = null;
            });
        }

        let paymentModal;
        let customersCache = [];
        let currentInvoices = [];
        let customerSearchTimer = null;
        let customerSearchSeq = 0;

        function openPaymentInputModal() {
            if (!paymentModal) {
                paymentModal = new bootstrap.Modal(document.getElementById('paymentInputModal'));
            }
            document.getElementById('paymentDate').value = new Date().toISOString().slice(0, 10);
            document.getElementById('customerSearchInput').value = '';
            document.getElementById('selectedCustomerId').value = '';
            document.getElementById('invoiceSelect').innerHTML = '<option value="">Pilih invoice</option>';
            document.getElementById('invoiceAmount').value = '';
            document.getElementById('discountAmount').value = 0;
            document.getElementById('customerSuggestions').style.display = 'none';
            document.getElementById('customerSuggestions').innerHTML = '';
            customersCache = [];
            currentInvoices = [];
            updateFinalPayment();
            paymentModal.show();
        }

        function updateFinalPayment() {
            const invoiceAmount = parseFloat(document.getElementById('invoiceAmount').value || '0');
            const discount = parseFloat(document.getElementById('discountAmount').value || '0');
            const finalAmount = Math.max(invoiceAmount - discount, 0);
            document.getElementById('finalPaymentText').textContent = `Rp ${Math.round(finalAmount).toLocaleString('id-ID')}`;
            return { invoiceAmount, discount, finalAmount };
        }

        async function searchCustomersForPayment(keyword) {
            const q = String(keyword || '').trim();
            const seq = ++customerSearchSeq;
            if (q.length < 1) {
                customersCache = [];
                renderCustomerSuggestions('');
                return;
            }
            const resp = await fetch('/admin/billing/customers/list?q=' + encodeURIComponent(q), {
                credentials: 'same-origin',
                headers: { 'Accept': 'application/json' }
            });
            const data = await resp.json().catch(function () { return {}; });
            if (seq !== customerSearchSeq) return;
            customersCache = Array.isArray(data && data.customers) ? data.customers : [];
            renderCustomerSuggestions(q);
        }

        function escapeHtmlAttr(value) {
            return String(value || '')
                .replace(/&/g, '&amp;')
                .replace(/"/g, '&quot;')
                .replace(/</g, '&lt;')
                .replace(/>/g, '&gt;');
        }

        function renderCustomerSuggestions(keyword) {
            const box = document.getElementById('customerSuggestions');
            const q = String(keyword || '').trim();
            if (q.length < 1) {
                box.style.display = 'none';
                box.innerHTML = '';
                return;
            }
            const matches = customersCache;

            if (!matches.length) {
                box.innerHTML = '<div class="list-group-item text-muted">Pelanggan tidak ditemukan</div>';
                box.style.display = 'block';
                return;
            }

            box.innerHTML = matches.map(c => (
                `<button type="button" class="list-group-item list-group-item-action customer-suggestion" data-id="${c.id}" data-name="${escapeHtmlAttr(c.name)}" data-phone="${escapeHtmlAttr(c.phone)}">` +
                `<strong>${escapeHtmlAttr(c.name || '-')}</strong><br><small>${escapeHtmlAttr(c.phone || '-')} | ${escapeHtmlAttr(c.username || c.pppoe_username || '-')} ${c.customer_id ? '| ID ' + escapeHtmlAttr(c.customer_id) : ''}</small>` +
                `</button>`
            )).join('');
            box.style.display = 'block';
        }

        async function loadUnpaidInvoices(customerId) {
            const select = document.getElementById('invoiceSelect');
            select.innerHTML = '<option value="">Memuat invoice...</option>';
            const resp = await fetch('/admin/billing/api/customer-invoices/' + encodeURIComponent(customerId), {
                credentials: 'same-origin',
                headers: { 'Accept': 'application/json' }
            });
            const data = await resp.json().catch(function () { return {}; });
            currentInvoices = Array.isArray(data && data.data) ? data.data : [];
            if (!currentInvoices.length) {
                select.innerHTML = '<option value="">Tidak ada invoice belum lunas</option>';
                document.getElementById('invoiceAmount').value = '';
                updateFinalPayment();
                return;
            }
            select.innerHTML = '<option value="">Pilih invoice</option>' + currentInvoices.map(inv =>
                `<option value="${inv.id}">${inv.invoice_number || ('INV-' + inv.id)} - Rp ${Math.round(Number(inv.amount || 0)).toLocaleString('id-ID')}</option>`
            ).join('');
        }

        document.getElementById('openPaymentModalBtn').addEventListener('click', function() {
            openPaymentInputModal();
        });

        document.getElementById('customerSearchInput').addEventListener('input', function() {
            document.getElementById('selectedCustomerId').value = '';
            document.getElementById('invoiceSelect').innerHTML = '<option value="">Pilih invoice</option>';
            document.getElementById('invoiceAmount').value = '';
            updateFinalPayment();
            const value = this.value;
            if (customerSearchTimer) clearTimeout(customerSearchTimer);
            customerSearchTimer = setTimeout(function () {
                searchCustomersForPayment(value).catch(function () {
                    customersCache = [];
                    renderCustomerSuggestions(value);
                });
            }, 250);
        });

        document.addEventListener('click', async function(e) {
            const btn = e.target.closest('.customer-suggestion');
            if (btn) {
                const customerId = btn.getAttribute('data-id');
                const customerName = btn.getAttribute('data-name') || '';
                const customerPhone = btn.getAttribute('data-phone') || '';
                document.getElementById('customerSearchInput').value = `${customerName} (${customerPhone})`;
                document.getElementById('selectedCustomerId').value = customerId;
                document.getElementById('customerSuggestions').style.display = 'none';
                await loadUnpaidInvoices(customerId);
                return;
            }
            if (!e.target.closest('#customerSuggestions') && !e.target.closest('#customerSearchInput')) {
                document.getElementById('customerSuggestions').style.display = 'none';
            }
        });

        document.getElementById('invoiceSelect').addEventListener('change', function() {
            const id = String(this.value || '');
            const inv = currentInvoices.find(v => String(v.id) === id);
            document.getElementById('invoiceAmount').value = inv ? Number(inv.amount || 0) : '';
            updateFinalPayment();
        });

        document.getElementById('discountAmount').addEventListener('input', updateFinalPayment);

        document.getElementById('paymentInputForm').addEventListener('submit', async function(e) {
            e.preventDefault();
            const customerId = document.getElementById('selectedCustomerId').value;
            const invoiceId = document.getElementById('invoiceSelect').value;
            const paymentMethod = document.getElementById('paymentMethod').value;
            const paymentDate = document.getElementById('paymentDate').value;
            const { invoiceAmount, discount, finalAmount } = updateFinalPayment();

            if (!customerId) return alert('Silakan pilih pelanggan dari rekomendasi.');
            if (!invoiceId) return alert('Silakan pilih invoice.');
            if (!paymentMethod) return alert('Silakan pilih metode pembayaran.');
            if (!paymentDate) return alert('Silakan pilih tanggal pembayaran.');
            if (discount > invoiceAmount) return alert('Diskon tidak boleh melebihi jumlah invoice.');

            const notes = `Pelunasan oleh Admin Kantor | Diskon: Rp ${Math.round(discount).toLocaleString('id-ID')} | Tanggal Bayar: ${paymentDate}`;

            const resp = await fetch('/admin/billing/payments', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json', 'Accept': 'application/json' },
                credentials: 'same-origin',
                body: JSON.stringify({
                    invoice_id: invoiceId,
                    amount: finalAmount,
                    payment_method: paymentMethod,
                    payment_date: paymentDate,
                    reference_number: '',
                    notes,
                    discount_amount: Math.round(Number(discount) || 0)
                })
            });
            const result = await resp.json();
            if (!result?.success) {
                alert(result?.message || 'Gagal menyimpan pembayaran');
                return;
            }
            if (paymentModal) paymentModal.hide();
            window.location.href = isAllPaymentsPage ? '/admin/billing/all-payments' : '/admin/billing/payments';
        });

        const quickAction = new URLSearchParams(window.location.search).get('quickAction');
        if (quickAction === 'input-pembayaran') {
            openPaymentInputModal();
            const url = new URL(window.location.href);
            url.searchParams.delete('quickAction');
            window.history.replaceState({}, '', url.toString());
        }
    </script>

    <!-- Mobile Bottom Navbar -->
    <%- include('../../partials/admin-mobile-navbar', { currentPage: 'payments' }) %>
</body>
</html>
