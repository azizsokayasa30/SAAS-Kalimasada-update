<% var isAllPayments = (typeof page !== 'undefined' && page === 'all-payments'); %>
<!DOCTYPE html>
<html lang="id">
<head>
    <%- include('../../partials/hard-reload') %>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title><%= title %></title>
    <% if (isAllPayments) { %>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800&display=swap" rel="stylesheet">
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800&family=Outfit:wght@300;400;500;600;700;800&display=swap" rel="stylesheet">
    <% } %>
    <link href="/vendor/bootstrap/css/bootstrap.min.css" rel="stylesheet">
    <% if (isAllPayments) { %>
    <link href="/vendor/bootstrap-icons/bootstrap-icons.css" rel="stylesheet">
    <% } %>
    <link href="/css/admin-mobile.css" rel="stylesheet">
    <% if (isAllPayments) { %>
    <link href="/css/finance-modern.css" rel="stylesheet">
    <style>
        .mini-stat-grid {
            display: grid;
            grid-template-columns: repeat(2, 1fr);
            gap: 0.75rem;
            margin: 1rem 0;
            padding: 0.75rem;
            background-color: var(--f-muted);
            border-radius: var(--f-radius-sm);
        }
        .animate-in { animation: f-in 0.4s ease-out forwards; }
        html[data-theme="light"] .f-card .f-card-title,
        html[data-theme="light"] .f-card .f-card-description,
        html[data-theme="light"] .mini-stat-grid .f-stat-label,
        html[data-theme="light"] .mini-stat-grid .f-mono {
            color: var(--f-foreground) !important;
        }
        html[data-theme="light"] .mini-stat-grid .text-info { color: var(--f-info) !important; }
        html[data-theme="light"] .mini-stat-grid .text-warning { color: var(--f-warning) !important; }
        html[data-theme="light"] .mini-stat-grid .text-success { color: var(--f-success) !important; }

        /* Riwayat pembayaran — toolbar & layout padat */
        .all-payments-header {
            margin: -0.75rem -1rem 1rem -1rem !important;
            padding: 0.75rem 1rem !important;
        }
        .all-payments-header .all-pay-actions {
            display: flex;
            align-items: stretch;
            flex-wrap: wrap;
            gap: 0.5rem;
        }
        .all-pay-btn {
            min-height: 2.75rem;
            height: 2.75rem;
            padding: 0 1rem;
            border: none;
            border-radius: 10px;
            font-weight: 600;
            font-size: 0.875rem;
            color: #fff !important;
            display: inline-flex;
            align-items: center;
            justify-content: center;
            gap: 0.35rem;
            white-space: nowrap;
            transition: filter 0.15s ease, transform 0.1s ease;
        }
        .all-pay-btn:hover { filter: brightness(1.08); color: #fff !important; }
        .all-pay-btn:active { transform: scale(0.98); }
        .all-pay-btn--refresh {
            background: linear-gradient(180deg, #5c6578 0%, #3d4454 100%);
            box-shadow: 0 1px 2px rgba(0,0,0,0.2);
        }
        .all-pay-btn--export {
            background: linear-gradient(180deg, #4f9cf9 0%, #2b7fd9 100%);
            box-shadow: 0 1px 2px rgba(43, 127, 217, 0.35);
        }
        .all-pay-btn--input {
            background: linear-gradient(180deg, #4ade80 0%, #22a34a 100%);
            box-shadow: 0 1px 2px rgba(34, 163, 74, 0.35);
        }
        .all-payments-compact .f-grid.f-grid-4 { margin-bottom: 0.65rem !important; }
        .all-payments-compact .f-stat-card { padding: 0.65rem 0.85rem !important; }
        .all-payments-compact .f-stat-desc { margin-top: 0.15rem !important; font-size: 0.7rem !important; }
        .all-payments-compact .f-stat-value { font-size: 1.15rem !important; line-height: 1.2 !important; }
        .all-payments-compact .all-payments-filter-card { margin-bottom: 0.65rem !important; }
        .all-payments-compact .all-payments-filter-card .f-card-body { padding: 0.85rem 1rem !important; }
        .all-payments-compact .all-payments-filter-card .f-label { margin-bottom: 0.2rem !important; font-size: 0.65rem !important; }
        .all-payments-compact .all-payments-table-card { margin-bottom: 0.5rem !important; overflow: hidden; }
        .all-payments-compact .all-payments-table-card .table { font-size: 0.875rem; }
        .all-payments-compact .all-payments-table-card .table > :not(caption) > * > * { padding-top: 0.45rem; padding-bottom: 0.45rem; }
        .all-payments-compact .all-payments-footer { margin-top: 0.35rem !important; margin-bottom: 0.75rem !important; }

        .all-payments-header {
            border-bottom-color: var(--f-border) !important;
            background: linear-gradient(180deg, rgba(15, 23, 42, 0.35) 0%, transparent 100%);
        }
        html[data-theme="light"] .all-payments-header {
            background: linear-gradient(180deg, rgba(241, 245, 249, 0.9) 0%, transparent 100%);
        }
        .all-pay-btn--export {
            background: linear-gradient(180deg, #217346 0%, #185c38 100%);
            box-shadow: 0 1px 2px rgba(24, 92, 56, 0.4);
        }

        .all-pay-filter-head {
            display: flex;
            align-items: center;
            justify-content: space-between;
            gap: 0.75rem;
            margin-bottom: 0.75rem;
            padding-bottom: 0.55rem;
            border-bottom: 1px solid var(--f-border);
        }
        .all-pay-filter-title {
            font-size: 0.8rem;
            font-weight: 700;
            letter-spacing: 0.02em;
            color: var(--f-foreground);
            display: inline-flex;
            align-items: center;
            gap: 0.4rem;
        }
        .all-pay-filter-title i { color: #60a5fa; }
        .all-pay-filter-period {
            font-size: 0.75rem;
            font-weight: 600;
            color: var(--f-muted-foreground);
            background: var(--f-accent);
            border: 1px solid var(--f-border);
            border-radius: 999px;
            padding: 0.2rem 0.65rem;
        }
        .all-pay-filter-grid {
            display: grid;
            grid-template-columns: minmax(7rem, 0.9fr) minmax(6rem, 0.7fr) minmax(14rem, 1.5fr) minmax(9rem, 1.1fr) minmax(8rem, 1fr);
            gap: 0.65rem 0.75rem;
            align-items: end;
        }
        .all-pay-filter-search { grid-column: 1 / span 3; }
        .all-pay-filter-actions {
            grid-column: 4 / span 2;
            display: flex;
            gap: 0.5rem;
            align-items: stretch;
        }
        .all-pay-filter-btn {
            flex: 1 1 0;
            min-height: 2.6rem;
            height: 2.6rem;
            border-radius: 10px;
            font-weight: 700;
            font-size: 0.82rem;
            letter-spacing: 0.01em;
            display: inline-flex;
            align-items: center;
            justify-content: center;
            gap: 0.4rem;
            text-decoration: none !important;
            border: none;
            cursor: pointer;
            transition: transform 0.12s ease, filter 0.15s ease, box-shadow 0.15s ease;
            white-space: nowrap;
        }
        .all-pay-filter-btn:hover { transform: translateY(-1px); }
        .all-pay-filter-btn:active { transform: scale(0.98); }
        .all-pay-filter-btn--apply {
            background: linear-gradient(180deg, #3b82f6 0%, #1d4ed8 100%);
            color: #fff !important;
            box-shadow: 0 6px 14px -6px rgba(37, 99, 235, 0.65);
        }
        .all-pay-filter-btn--apply:hover { filter: brightness(1.06); color: #fff !important; }
        .all-pay-filter-btn--reset {
            background: transparent;
            color: var(--f-foreground) !important;
            border: 1px solid var(--f-border);
            box-shadow: none;
        }
        .all-pay-filter-btn--reset:hover {
            background: var(--f-accent);
            border-color: #64748b;
            color: var(--f-foreground) !important;
        }
        .all-pay-today-btn {
            min-height: 2.5rem;
            height: 2.5rem;
            padding: 0 0.75rem;
            border-radius: 8px;
            font-weight: 650;
            font-size: 0.75rem;
            border: 1px solid rgba(59, 130, 246, 0.45);
            background: rgba(59, 130, 246, 0.12);
            color: #93c5fd !important;
            white-space: nowrap;
        }
        html[data-theme="light"] .all-pay-today-btn {
            color: #1d4ed8 !important;
            background: #eff6ff;
            border-color: #93c5fd;
        }
        @media (max-width: 991.98px) {
            .all-pay-filter-grid { grid-template-columns: 1fr 1fr; }
            .all-pay-filter-search,
            .all-pay-filter-actions { grid-column: 1 / -1; }
        }

        .all-pay-table-toolbar {
            display: flex;
            align-items: baseline;
            justify-content: space-between;
            gap: 0.75rem;
            padding: 0.75rem 1rem 0.55rem;
            border-bottom: 1px solid var(--f-border);
        }
        .all-pay-table-title {
            margin: 0;
            font-size: 0.92rem;
            font-weight: 700;
            color: var(--f-foreground);
        }
        .all-pay-table-meta {
            font-size: 0.75rem;
            color: var(--f-muted-foreground);
            font-weight: 500;
        }
        .all-payments-compact .all-payments-table-card .table {
            font-size: 0.84rem;
            color: var(--f-foreground);
            --bs-table-bg: transparent;
            --bs-table-color: var(--f-foreground);
        }
        .all-payments-compact .all-payments-table-card thead th {
            font-size: 0.68rem;
            font-weight: 700;
            letter-spacing: 0.04em;
            text-transform: uppercase;
            color: var(--f-muted-foreground);
            background: rgba(15, 23, 42, 0.55) !important;
            border-bottom: 1px solid var(--f-border);
            white-space: nowrap;
            position: sticky;
            top: 0;
            z-index: 1;
        }
        html[data-theme="light"] .all-payments-compact .all-payments-table-card thead th {
            background: #f1f5f9 !important;
            color: #475569;
        }
        .all-payments-compact .all-payments-table-card tbody td {
            color: var(--f-foreground);
            border-color: var(--f-border);
            vertical-align: middle;
        }
        .all-payments-compact .all-payments-table-card tbody tr:hover td {
            background: rgba(59, 130, 246, 0.08) !important;
        }
        .all-pay-customer-name {
            display: block;
            font-weight: 700;
            font-size: 0.9rem;
            letter-spacing: 0.01em;
            color: #ffffff !important;
            line-height: 1.25;
        }
        html[data-theme="light"] .all-pay-customer-name {
            color: #0f172a !important;
        }
        .all-pay-customer-phone {
            display: block;
            margin-top: 0.12rem;
            font-size: 0.72rem;
            font-weight: 500;
            color: #94a3b8 !important;
        }
        html[data-theme="light"] .all-pay-customer-phone { color: #64748b !important; }
        .all-pay-invoice {
            font-family: ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, monospace;
            font-size: 0.75rem;
            color: #cbd5e1 !important;
        }
        html[data-theme="light"] .all-pay-invoice { color: #475569 !important; }
        .all-pay-amount {
            font-weight: 700;
            font-variant-numeric: tabular-nums;
            color: #f8fafc !important;
        }
        html[data-theme="light"] .all-pay-amount { color: #0f172a !important; }
        .pay-method {
            display: inline-flex;
            align-items: center;
            gap: 0.35rem;
            padding: 0.22rem 0.6rem;
            border-radius: 999px;
            font-size: 0.72rem;
            font-weight: 700;
            line-height: 1.2;
            white-space: nowrap;
            border: 1px solid transparent;
        }
        .pay-method i { font-size: 0.85rem; }
        .pay-method--cash { background: rgba(16, 185, 129, 0.16); color: #34d399; border-color: rgba(16, 185, 129, 0.28); }
        .pay-method--transfer { background: rgba(59, 130, 246, 0.16); color: #60a5fa; border-color: rgba(59, 130, 246, 0.28); }
        .pay-method--qris { background: rgba(168, 85, 247, 0.16); color: #c084fc; border-color: rgba(168, 85, 247, 0.28); }
        .pay-method--online { background: rgba(14, 165, 233, 0.16); color: #38bdf8; border-color: rgba(14, 165, 233, 0.28); }
        .pay-method--admin { background: rgba(148, 163, 184, 0.16); color: #cbd5e1; border-color: rgba(148, 163, 184, 0.28); }
        .pay-method--ewallet { background: rgba(245, 158, 11, 0.16); color: #fbbf24; border-color: rgba(245, 158, 11, 0.28); }
        .pay-method--other { background: rgba(100, 116, 139, 0.16); color: #94a3b8; border-color: rgba(100, 116, 139, 0.28); }
        html[data-theme="light"] .pay-method--cash { background: #ecfdf5; color: #047857; }
        html[data-theme="light"] .pay-method--transfer { background: #eff6ff; color: #1d4ed8; }
        html[data-theme="light"] .pay-method--qris { background: #f5f3ff; color: #6d28d9; }
        html[data-theme="light"] .pay-method--online { background: #f0f9ff; color: #0369a1; }
        html[data-theme="light"] .pay-method--admin { background: #f1f5f9; color: #334155; }
        html[data-theme="light"] .pay-method--ewallet { background: #fffbeb; color: #b45309; }
        html[data-theme="light"] .pay-method--other { background: #f8fafc; color: #475569; }
        .all-pay-empty {
            padding: 2.5rem 1rem;
            text-align: center;
            color: var(--f-muted-foreground);
        }
        .all-pay-empty i { font-size: 1.6rem; display: block; margin-bottom: 0.4rem; opacity: 0.7; }
        .btn-cancel-payment {
            border-radius: 8px;
            font-weight: 600;
            font-size: 0.75rem;
        }

        @media (max-width: 767.98px) {
            .all-pay-filter-btn span.btn-text-full { display: none; }
        }

        .all-pay-date-trigger {
            flex: 1 1 auto;
            min-width: 0;
            height: 2.5rem;
            min-height: 2.5rem;
            padding: 0 0.65rem;
            border-radius: var(--f-radius-sm);
            border: 1px solid var(--f-input);
            background-color: var(--f-background);
            color: var(--f-foreground);
            font-size: 0.8rem;
            font-weight: 500;
            display: inline-flex;
            align-items: center;
            gap: 0.4rem;
            text-align: left;
            cursor: pointer;
        }
        .all-pay-date-trigger:hover,
        .all-pay-date-trigger:focus {
            border-color: var(--f-ring);
            outline: none;
            box-shadow: 0 0 0 2px rgba(148, 163, 184, 0.12);
        }
        .all-pay-date-trigger .bi-calendar3 { flex-shrink: 0; opacity: 0.8; }
        .all-pay-date-trigger #filterDateLabel {
            flex: 1 1 auto;
            min-width: 0;
            overflow: hidden;
            text-overflow: ellipsis;
            white-space: nowrap;
        }
        .all-pay-date-clear {
            flex-shrink: 0;
            width: 1.35rem;
            height: 1.35rem;
            padding: 0;
            border: none;
            border-radius: 999px;
            background: transparent;
            color: var(--f-muted-foreground);
            display: none;
            align-items: center;
            justify-content: center;
            line-height: 1;
        }
        .all-pay-date-trigger.is-custom-range .all-pay-date-clear { display: inline-flex; }
        .all-pay-date-clear:hover { background: var(--f-accent); color: var(--f-foreground); }

        #filterDateModal .modal-dialog { max-width: 22rem; }
        #filterDateModal .modal-content {
            background: var(--f-card);
            color: var(--f-foreground);
            border: 1px solid var(--f-border);
        }
        #filterDateModal .modal-header,
        #filterDateModal .modal-footer { border-color: var(--f-border); }
        .cal-nav {
            display: flex;
            align-items: center;
            justify-content: space-between;
            gap: 0.5rem;
            margin-bottom: 0.75rem;
        }
        .cal-nav-title { font-weight: 600; font-size: 0.95rem; }
        .cal-nav-btn {
            width: 2.25rem;
            height: 2.25rem;
            border: 1px solid var(--f-border);
            border-radius: 8px;
            background: transparent;
            color: inherit;
            display: inline-flex;
            align-items: center;
            justify-content: center;
        }
        .cal-nav-btn:hover { background: var(--f-accent); }
        .cal-weekdays,
        .cal-grid {
            display: grid;
            grid-template-columns: repeat(7, 1fr);
            gap: 0.2rem;
        }
        .cal-weekdays span {
            text-align: center;
            font-size: 0.68rem;
            font-weight: 600;
            color: var(--f-muted-foreground);
            padding: 0.2rem 0 0.45rem;
        }
        .cal-day {
            aspect-ratio: 1;
            border: none;
            border-radius: 8px;
            background: transparent;
            color: inherit;
            font-size: 0.8rem;
            font-weight: 500;
            padding: 0;
        }
        .cal-day:hover:not(:disabled) { background: var(--f-accent); }
        .cal-day.is-muted { color: var(--f-muted-foreground); opacity: 0.45; }
        .cal-day.is-today { box-shadow: inset 0 0 0 1px #3b82f6; }
        .cal-day.is-in-range { background: rgba(59, 130, 246, 0.22); border-radius: 0; }
        .cal-day.is-range-start,
        .cal-day.is-range-end,
        .cal-day.is-selected { background: #3b82f6; color: #fff; }
        .cal-day.is-range-start { border-radius: 8px 0 0 8px; }
        .cal-day.is-range-end { border-radius: 0 8px 8px 0; }
        .cal-day.is-range-start.is-range-end,
        .cal-day.is-selected:not(.is-in-range) { border-radius: 8px; }
        .cal-day.is-selected:hover,
        .cal-day.is-range-start:hover,
        .cal-day.is-range-end:hover { background: #2563eb; color: #fff; }
        .cal-hint {
            font-size: 0.75rem;
            color: var(--f-muted-foreground);
            margin: 0.55rem 0 0.35rem;
        }
        .cal-presets {
            display: flex;
            flex-wrap: wrap;
            gap: 0.35rem;
            margin-bottom: 0.15rem;
        }
        .cal-presets .btn { font-size: 0.75rem; }
        [data-theme="dark"] #filterDateModal .btn-close {
            filter: invert(1) grayscale(100%) brightness(200%);
        }
    </style>
    <% } %>

    <%- include('../../partials/theme-head') %>
    <style>
      html[data-theme="light"] #paymentInputModal .modal-content,
      html[data-theme="light"] #paymentInputModal .modal-header,
      html[data-theme="light"] #paymentInputModal .modal-body,
      html[data-theme="light"] #paymentInputModal .modal-footer {
        background-color: #ffffff !important;
        color: #0f172a !important;
      }

      html[data-theme="light"] #paymentInputModal .modal-content {
        border: 1px solid #dee2e6 !important;
        box-shadow: 0 10px 30px rgba(0, 0, 0, 0.15) !important;
      }

      html[data-theme="light"] #filterDateModal .modal-content,
      html[data-theme="light"] #filterDateModal .modal-header,
      html[data-theme="light"] #filterDateModal .modal-body,
      html[data-theme="light"] #filterDateModal .modal-footer {
        background-color: #ffffff !important;
        color: #0f172a !important;
      }
    </style>
</head>
<body class="<%= isAllPayments ? 'finance-content-area' : '' %>">
<% 
  var currentMonth = new Date().getMonth() + 1;
  var currentYear = new Date().getFullYear();
  var filters = (typeof filters !== 'undefined') ? filters : { month: String(currentMonth), year: String(currentYear), date: '', from: '', to: '', collector_id: '', payment_method: '', status: '', q: '' };
  function paymentMethodLabel(raw) {
    var m = String(raw || '').trim().toLowerCase();
    if (!m) return '—';
    if (m === 'manual_admin' || m === 'admin kantor' || m === 'admin') return 'Admin Kantor';
    if (m === 'cash' || m === 'tunai') return 'Tunai';
    if (m.indexOf('transfer') !== -1) return 'Transfer';
    if (m.indexOf('qris') !== -1) return 'QRIS';
    if (m.indexOf('ewallet') !== -1 || m.indexOf('e-wallet') !== -1 || m.indexOf('e wallet') !== -1) return 'E-Wallet';
    if (m === 'online' || m.indexOf('gateway') !== -1) return 'Online';
    return String(raw).trim();
  }
  function paymentMethodMeta(raw) {
    var label = paymentMethodLabel(raw);
    var m = String(raw || '').trim().toLowerCase();
    var icon = 'bi-credit-card-2-front';
    var kind = 'other';
    if (!m) { icon = 'bi-dash-circle'; kind = 'other'; }
    else if (m === 'cash' || m === 'tunai' || (m.indexOf('cash') !== -1 && m.indexOf('transfer') === -1)) { icon = 'bi-cash-stack'; kind = 'cash'; }
    else if (m.indexOf('transfer') !== -1) { icon = 'bi-bank'; kind = 'transfer'; }
    else if (m.indexOf('qris') !== -1) { icon = 'bi-qr-code-scan'; kind = 'qris'; }
    else if (m.indexOf('ewallet') !== -1 || m.indexOf('e-wallet') !== -1 || m.indexOf('e wallet') !== -1) { icon = 'bi-wallet2'; kind = 'ewallet'; }
    else if (m === 'online' || m.indexOf('gateway') !== -1) { icon = 'bi-globe2'; kind = 'online'; }
    else if (m === 'manual_admin' || m === 'admin kantor' || m === 'admin') { icon = 'bi-building'; kind = 'admin'; }
    else if (m === 'other' || m === 'lainnya') { icon = 'bi-three-dots'; kind = 'other'; }
    return { label: label, icon: icon, kind: kind };
  }
  var todayStr = (typeof today !== 'undefined' && today) ? String(today) : new Date().toISOString().slice(0, 10);
  var monthsIdAll = ['Januari', 'Februari', 'Maret', 'April', 'Mei', 'Juni', 'Juli', 'Agustus', 'September', 'Oktober', 'November', 'Desember'];
  var monthsIdShort = ['Jan', 'Feb', 'Mar', 'Apr', 'Mei', 'Jun', 'Jul', 'Agu', 'Sep', 'Okt', 'Nov', 'Des'];
  function pad2(n) { return String(n).padStart(2, '0'); }
  function isoFromParts(y, m, d) { return String(y) + '-' + pad2(m) + '-' + pad2(d); }
  function lastDayOfMonth(y, m) { return new Date(y, m, 0).getDate(); }
  function monthBounds(y, m) {
    return { from: isoFromParts(y, m, 1), to: isoFromParts(y, m, lastDayOfMonth(y, m)) };
  }
  function parseFilterIso(iso) {
    var s = String(iso || '').trim();
    if (!/^\d{4}-\d{2}-\d{2}$/.test(s)) return null;
    return { y: parseInt(s.slice(0, 4), 10), m: parseInt(s.slice(5, 7), 10), d: parseInt(s.slice(8, 10), 10) };
  }
  function formatRangeLabel(fromIso, toIso) {
    var a = parseFilterIso(fromIso);
    var b = parseFilterIso(toIso) || a;
    if (!a) return '';
    if (!b || (a.y === b.y && a.m === b.m && a.d === b.d)) {
      return a.d + ' ' + monthsIdAll[a.m - 1] + ' ' + a.y;
    }
    if (a.y === b.y && a.m === b.m) {
      return a.d + '-' + b.d + ' ' + monthsIdAll[a.m - 1] + ' ' + a.y;
    }
    if (a.y === b.y) {
      return a.d + ' ' + monthsIdShort[a.m - 1] + ' – ' + b.d + ' ' + monthsIdShort[b.m - 1] + ' ' + a.y;
    }
    return a.d + ' ' + monthsIdShort[a.m - 1] + ' ' + a.y + ' – ' + b.d + ' ' + monthsIdShort[b.m - 1] + ' ' + b.y;
  }
  var monthNum = parseInt(String(filters.month || currentMonth), 10) || currentMonth;
  var yearNum = parseInt(String(filters.year || currentYear), 10) || currentYear;
  var monthBound = monthBounds(yearNum, monthNum);
  var filterFromIso = String(filters.from || monthBound.from).trim() || monthBound.from;
  var filterToIso = String(filters.to || monthBound.to).trim() || monthBound.to;
  var isFullMonthRange = filterFromIso === monthBound.from && filterToIso === monthBound.to;
  var filterDateLabelText = formatRangeLabel(filterFromIso, filterToIso);
  var payments = (typeof payments !== 'undefined') ? payments : [];
  var collectors = (typeof collectors !== 'undefined') ? collectors : [];
  var paySummary = (typeof summary !== 'undefined' && summary) ? summary : { transaction_count: 0, total_amount: 0, total_tagihan: 0, total_commission: 0, total_net: 0, total_discount: 0 };
  function displayPaymentNote(notes) {
    if (notes == null || notes === '') return '';
    var s = String(notes).trim();
    if (!s) return '';
    if (/^collector\s+\d+(\s|$|\[)/i.test(s)) return '';
    return s;
  }
%>
<div class="container-fluid">
