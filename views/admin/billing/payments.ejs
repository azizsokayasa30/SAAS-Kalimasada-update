                                        <span id="filterDateLabel"><%= filterDateLabelText %></span>
                                        <span class="all-pay-date-clear" id="filterDateClear" title="Kembali ke 1 bulan" role="button" tabindex="-1"><i class="bi bi-x"></i></span>
