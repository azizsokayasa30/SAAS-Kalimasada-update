                            <span class="all-pay-filter-period"><%= filterDateLabelText %></span>
                        </div>
                        <form method="GET" action="/admin/billing/all-payments" id="allPaymentsFilterForm" class="all-pay-filter-grid" data-today="<%= todayStr %>">
