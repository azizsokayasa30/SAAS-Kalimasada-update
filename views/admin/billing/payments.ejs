                                    <option value="cash" <%= methodFilter === 'cash' ? 'selected' : '' %>>Tunai / Cash</option>
                                    <option value="transfer" <%= methodFilter === 'transfer' ? 'selected' : '' %>>Transfer</option>
                                    <option value="qris" <%= methodFilter === 'qris' ? 'selected' : '' %>>QRIS</option>
                                    <option value="online" <%= methodFilter === 'online' ? 'selected' : '' %>>Online / Gateway</option>
                                    <option value="manual_admin" <%= methodFilter === 'manual_admin' ? 'selected' : '' %>>Admin Kantor</option>
                                    <option value="ewallet" <%= methodFilter === 'ewallet' ? 'selected' : '' %>>E-Wallet</option>
                                    <option value="other" <%= methodFilter === 'other' ? 'selected' : '' %>>Lainnya</option>
                                </select>
                            </div>
                            <div class="all-pay-filter-search">
                                <label class="f-label">CARI</label>
                                <input type="text" class="f-input" name="q" value="<%= filters.q %>" placeholder="Nama, telepon, invoice, atau catatan…" autocomplete="off">
                            </div>
                            <div class="all-pay-filter-actions">
                                <button type="submit" class="all-pay-filter-btn all-pay-filter-btn--apply">
                                    <i class="bi bi-funnel-fill"></i><span class="btn-text-full">Terapkan filter</span>
                                </button>
                                <a href="/admin/billing/all-payments" class="all-pay-filter-btn all-pay-filter-btn--reset">
                                    <i class="bi bi-arrow-counterclockwise"></i><span class="btn-text-full">Reset</span>
                                </a>
                            </div>
                        </form>
                    </div>
                </div>

                <div class="f-card all-payments-table-card mb-2">
                    <div class="all-pay-table-toolbar">
                        <h2 class="all-pay-table-title">Daftar transaksi</h2>
                        <div class="all-pay-table-meta"><%= (payments || []).length.toLocaleString('id-ID') %> pembayaran · <%= filterDateLabelText %></div>
                    </div>
                    <div class="f-card-body p-0">
                        <div class="table-responsive">
                            <table class="table table-hover table-sm mb-0 align-middle">
                                <thead>
                                    <tr>
                                        <th>Tanggal</th>
                                        <th>Invoice</th>
                                        <th>Kolektor</th>
                                        <th>Pelanggan</th>
                                        <th>Tagihan</th>
                                        <th>Komisi</th>
                                        <th>Diskon</th>
                                        <th>Jumlah</th>
                                        <th>Metode</th>
                                        <th>Status</th>
                                        <th>Catatan</th>
                                        <th class="text-end" style="white-space:nowrap;">Aksi</th>
                                    </tr>
                                </thead>
                                <tbody>
                                <% if (!(payments || []).length) { %>
                                    <tr>
                                        <td colspan="12">
                                            <div class="all-pay-empty">
                                                <i class="bi bi-inbox"></i>
                                                Tidak ada transaksi pada periode ini
                                            </div>
                                        </td>
                                    </tr>
                                <% } %>
                                <% (payments || []).forEach(function (p) {
                                    var invSt = String(p.invoice_status || '').toLowerCase();
                                    var statusLabel = invSt === 'paid' ? 'Lunas' : (invSt ? invSt : '—');
                                    var statusClass = invSt === 'paid' ? 'success' : 'secondary';
                                    var cancelTitle = 'Batalkan pembayaran: baris ini dihapus; invoice kembali belum lunas jika tidak ada pembayaran lain yang mencukupi.';
                                    var tagInv = Number(p.invoice_tagihan != null ? p.invoice_tagihan : p.invoice_amount || 0);
                                    var jmlSet = Number(p.jumlah_setelah_diskon != null ? p.jumlah_setelah_diskon : 0);
                                    var rawPayDate = String(p.payment_date || '').trim();
                                    var payDateLabel = rawPayDate;
                                    if (/^\d{4}-\d{2}-\d{2}/.test(rawPayDate)) {
                                        var ds = rawPayDate.slice(0, 10).split('-');
                                        var ts = rawPayDate.length >= 19 ? rawPayDate.slice(11, 16) : '';
                                        payDateLabel = ds[2] + '/' + ds[1] + '/' + ds[0] + (ts ? (' ' + ts) : '');
                                    }
                                    var methodMeta = paymentMethodMeta(p.payment_method);
                                %>
                                    <tr>
                                        <td style="white-space:nowrap;"><%= payDateLabel %></td>
                                        <td><span class="all-pay-invoice"><%= p.invoice_number || ('#' + p.invoice_id) %></span></td>
                                        <td><%= p.collector_name ? p.collector_name : 'Admin kantor' %></td>
                                        <td>
                                            <span class="all-pay-customer-name"><%= p.customer_name %></span>
                                            <% if (p.customer_phone) { %><span class="all-pay-customer-phone"><%= p.customer_phone %></span><% } %>
                                        </td>
                                        <td>Rp <%= tagInv.toLocaleString('id-ID') %></td>
                                        <td>Rp <%= Number(p.commission_amount || 0).toLocaleString('id-ID') %></td>
                                        <td><% var dDisc = Number(p.discount_amount || 0); %><%= dDisc > 0 ? ('Rp ' + dDisc.toLocaleString('id-ID')) : '—' %></td>
                                        <td class="all-pay-amount">Rp <%= jmlSet.toLocaleString('id-ID') %></td>
                                        <td>
                                            <span class="pay-method pay-method--<%= methodMeta.kind %>">
                                                <i class="bi <%= methodMeta.icon %>"></i><%= methodMeta.label %>
                                            </span>
                                        </td>
                                        <td><span class="badge bg-<%= statusClass %>"><%= statusLabel %></span></td>
                                        <td class="text-muted small"><%= displayPaymentNote(p.notes) %></td>
                                        <td class="text-end">
                                            <button type="button"
                                                class="btn btn-sm btn-outline-danger btn-cancel-payment"
                                                data-payment-id="<%= p.id %>"
                                                data-invoice="<%= String(p.invoice_number || ('#' + p.invoice_id)).replace(/"/g, '&quot;') %>"
                                                data-customer="<%= String(p.customer_name || '—').replace(/"/g, '&quot;') %>"
                                                data-amount="<%= jmlSet %>"
                                                title="<%= cancelTitle %>">Batalkan</button>
                                        </td>
                                    </tr>
                                <% }); %>
                                </tbody>
                            </table>
                        </div>
                    </div>
                </div>
            </div>
    </div>

    <div class="modal fade" id="cancelPaymentModal" tabindex="-1" aria-labelledby="cancelPaymentModalLabel" aria-hidden="true">
