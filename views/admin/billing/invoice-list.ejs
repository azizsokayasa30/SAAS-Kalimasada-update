    <div id="toast-container" class="toast-container position-fixed top-0 end-0 p-3" style="z-index: 9999;"></div>

    <script src="/vendor/bootstrap/js/bootstrap.bundle.min.js"></script>
    <script>
        var invoiceListFilterStatus = <%= JSON.stringify(filters.status || '') %>;
        var currentPaymentRow = null;
        var currentNotificationData = null;

        function resetFilters() {
            window.location.href = '/admin/billing/invoice-list';
        }

        function formatRp(value) {
            return 'Rp ' + Math.round(Number(value) || 0).toLocaleString('id-ID');
        }

        function escapeHtml(text) {
            return String(text == null ? '' : text)
                .replace(/&/g, '&amp;')
                .replace(/</g, '&lt;')
                .replace(/>/g, '&gt;')
                .replace(/"/g, '&quot;')
                .replace(/'/g, '&#39;');
        }

        function showInvoiceModal(id) {
            var el = document.getElementById(id);
            if (!el) return;
            if (window.bootstrap && bootstrap.Modal) {
                bootstrap.Modal.getOrCreateInstance(el).show();
                return;
            }
            el.classList.add('show');
            el.style.display = 'block';
        }

        function hideInvoiceModal(id) {
            var el = document.getElementById(id);
            if (!el) return;
            if (window.bootstrap && bootstrap.Modal) {
                var inst = bootstrap.Modal.getInstance(el);
                if (inst) inst.hide();
                return;
            }
            el.classList.remove('show');
            el.style.display = 'none';
        }

        function showToast(type, title, message, duration) {
            duration = duration || 4000;
            var toastId = 'toast-' + Date.now();
            var iconClass = type === 'success' ? 'bi-check-circle' : type === 'error' ? 'bi-x-circle' : 'bi-info-circle';
            var bgClass = type === 'success' ? 'bg-success' : type === 'error' ? 'bg-danger' : 'bg-primary';
            var container = document.getElementById('toast-container');
            if (!container) {
                alert(title + ': ' + message);
                return;
            }
            container.insertAdjacentHTML('beforeend',
                '<div id="' + toastId + '" class="toast align-items-center text-white ' + bgClass + ' border-0" role="alert">' +
                    '<div class="d-flex"><div class="toast-body">' +
                    '<i class="bi ' + iconClass + ' me-2"></i><strong>' + escapeHtml(title) + '</strong><br><small>' + escapeHtml(message) + '</small>' +
                    '</div><button type="button" class="btn-close btn-close-white me-2 m-auto" data-bs-dismiss="toast" aria-label="Close"></button></div></div>'
            );
            var toastElement = document.getElementById(toastId);
            if (window.bootstrap && bootstrap.Toast) {
                var toast = new bootstrap.Toast(toastElement, { delay: duration });
                toast.show();
                toastElement.addEventListener('hidden.bs.toast', function() { toastElement.remove(); });
            } else {
                setTimeout(function() { if (toastElement && toastElement.parentNode) toastElement.remove(); }, duration);
            }
        }

        function rowFromBtn(btn) {
            if (!btn) return null;
            return btn.closest ? btn.closest('tr') : (btn.parentElement && btn.parentElement.closest ? btn.parentElement.closest('tr') : null);
        }

        function readSummary() {
            var el = document.getElementById('invoiceSummaryCards');
            if (!el) return null;
            return {
                total: Number(el.dataset.total) || 0,
                paid: Number(el.dataset.paid) || 0,
                unpaid: Number(el.dataset.unpaid) || 0,
                overdue: Number(el.dataset.overdue) || 0,
                total_amount: Number(el.dataset.totalAmount) || 0,
                paid_amount: Number(el.dataset.paidAmount) || 0,
                unpaid_amount: Number(el.dataset.unpaidAmount) || 0,
                overdue_amount: Number(el.dataset.overdueAmount) || 0
            };
        }

        function writeSummary(data) {
            var el = document.getElementById('invoiceSummaryCards');
            if (!el || !data) return;
            el.dataset.total = data.total;
            el.dataset.paid = data.paid;
            el.dataset.unpaid = data.unpaid;
            el.dataset.overdue = data.overdue;
            el.dataset.totalAmount = data.total_amount;
            el.dataset.paidAmount = data.paid_amount;
            el.dataset.unpaidAmount = data.unpaid_amount;
            el.dataset.overdueAmount = data.overdue_amount;
            var values = [data.total, data.paid, data.unpaid, data.overdue];
            var amounts = [data.total_amount, data.paid_amount, data.unpaid_amount, data.overdue_amount];
            var cards = el.querySelectorAll('.summary-card');
            for (var i = 0; i < cards.length; i++) {
                var countEl = cards[i].querySelector('.summary-card-count');
                var amountEl = cards[i].querySelector('.summary-card-nominal');
                if (countEl) countEl.textContent = values[i];
                if (amountEl) amountEl.textContent = formatRp(amounts[i]);
            }
        }

        function applyPaidToSummary(row) {
            var amount = Number(row.dataset.amount) || 0;
            var overdue = row.dataset.overdue === '1';
            var data = readSummary();
            if (!data) return;
            data.paid += 1;
            data.unpaid = Math.max(0, data.unpaid - 1);
            data.paid_amount += amount;
            data.unpaid_amount = Math.max(0, data.unpaid_amount - amount);
            if (overdue) {
                data.overdue = Math.max(0, data.overdue - 1);
                data.overdue_amount = Math.max(0, data.overdue_amount - amount);
            }
            writeSummary(data);
        }

        function applyDeleteToSummary(row) {
            var amount = Number(row.dataset.amount) || 0;
            var status = row.dataset.status;
            var overdue = row.dataset.overdue === '1';
            var data = readSummary();
            if (!data) return;
            data.total = Math.max(0, data.total - 1);
            data.total_amount = Math.max(0, data.total_amount - amount);
            if (status === 'paid') {
                data.paid = Math.max(0, data.paid - 1);
                data.paid_amount = Math.max(0, data.paid_amount - amount);
            } else if (status === 'unpaid') {
                data.unpaid = Math.max(0, data.unpaid - 1);
                data.unpaid_amount = Math.max(0, data.unpaid_amount - amount);
                if (overdue) {
                    data.overdue = Math.max(0, data.overdue - 1);
                    data.overdue_amount = Math.max(0, data.overdue_amount - amount);
                }
            }
            writeSummary(data);
        }

        function markRowPaid(row) {
            applyPaidToSummary(row);
            row.dataset.status = 'paid';
            row.dataset.overdue = '0';
            var statusCell = row.querySelector('.invoice-status-cell');
            if (statusCell) statusCell.innerHTML = '<span class="badge bg-success">Lunas</span>';
            var paidBtn = row.querySelector('.js-mark-paid');
            if (paidBtn) paidBtn.remove();
            if (invoiceListFilterStatus === 'unpaid' || invoiceListFilterStatus === 'overdue') {
                row.remove();
            }
        }

        function updateFinalPaymentAmount() {
            var amountEl = document.getElementById('pay_invoice_amount');
            var discountEl = document.getElementById('pay_discount');
            var invoiceAmount = parseFloat((amountEl && amountEl.value) || '0');
            var discount = parseFloat((discountEl && discountEl.value) || '0');
            var finalAmount = Math.max(invoiceAmount - discount, 0);
            var finalTextEl = document.getElementById('pay_final_amount_text');
            if (finalTextEl) finalTextEl.textContent = formatRp(finalAmount);
            return { invoiceAmount: invoiceAmount, discount: discount, finalAmount: finalAmount };
        }

        function markInvoicePaid(btn) {
            var row = rowFromBtn(btn);
            if (!row) return false;
            currentPaymentRow = row;
            document.getElementById('pay_invoice_id').value = row.getAttribute('data-invoice-id') || btn.getAttribute('data-invoice-id') || '';
            document.getElementById('pay_customer_name').value = row.getAttribute('data-customer-name') || '-';
            document.getElementById('pay_invoice_amount').value = Number(row.getAttribute('data-amount')) || 0;
            document.getElementById('pay_discount').value = 0;
            document.getElementById('pay_payment_method').value = 'manual_admin';
            document.getElementById('pay_payment_date').value = new Date().toISOString().slice(0, 10);
            updateFinalPaymentAmount();
            showInvoiceModal('paymentConfirmModal');
            return false;
        }

        function deleteInvoiceRow(btn) {
            var row = rowFromBtn(btn);
            if (!row) return false;
            var invoiceId = row.getAttribute('data-invoice-id') || btn.getAttribute('data-invoice-id');
            var number = row.getAttribute('data-invoice-number') || invoiceId;
            if (!confirm('Hapus invoice #' + number + '? Tindakan ini tidak dapat dibatalkan.')) return false;
            showToast('info', 'Memproses...', 'Menghapus tagihan');
            fetch('/admin/billing/invoices/' + invoiceId, {
                method: 'DELETE',
                headers: { 'Content-Type': 'application/json' }
            })
            .then(function(response) {
                return response.json().then(function(data) {
                    return { response: response, data: data || {} };
                }).catch(function() {
                    return { response: response, data: {} };
                });
            })
            .then(function(result) {
                if (!result.response.ok || !result.data.success) {
                    throw new Error(result.data.message || result.data.error || 'Gagal menghapus tagihan');
                }
                applyDeleteToSummary(row);
                row.remove();
                showToast('success', 'Tagihan Dihapus', result.data.message || 'Tagihan berhasil dihapus');
            })
            .catch(function(error) {
                showToast('error', 'Gagal Menghapus', error.message || 'Terjadi kesalahan saat menghapus tagihan');
            });
            return false;
        }

        function sendInvoiceWhatsApp(btn) {
            var row = rowFromBtn(btn);
            if (!row) return false;
            var invoiceId = row.getAttribute('data-invoice-id') || btn.getAttribute('data-invoice-id');
            currentNotificationData = { invoiceId: invoiceId };
            document.getElementById('waPhoneNumber').value = row.getAttribute('data-phone') || '';
            document.getElementById('waCustomerName').value = row.getAttribute('data-customer-name') || '';
            document.getElementById('notificationPreview').innerHTML =
                '<div class="card"><div class="card-body text-muted"><i class="bi bi-hourglass-split"></i> Memuat preview dari template WhatsApp tenant...</div></div>';
            showInvoiceModal('whatsappModal');
            fetch('/admin/billing/invoices/' + invoiceId + '/whatsapp-preview')
                .then(function(response) { return response.json(); })
                .then(function(data) {
                    if (data.success) {
                        if (data.phone) document.getElementById('waPhoneNumber').value = data.phone;
                        if (data.customerName) document.getElementById('waCustomerName').value = data.customerName;
                        var title = data.templateTitle
                            ? '<div class="small text-muted mb-2">Template: <strong>' + escapeHtml(data.templateTitle) + '</strong> <code>' + escapeHtml(data.templateKey || '') + '</code></div>'
                            : '';
                        document.getElementById('notificationPreview').innerHTML =
                            '<div class="card"><div class="card-header"><h6 class="mb-0">Preview Pesan:</h6></div><div class="card-body">' +
                            title + '<pre style="white-space: pre-wrap; font-size: 14px;">' + escapeHtml(data.preview || '') + '</pre></div></div>';
                    } else {
                        document.getElementById('notificationPreview').innerHTML =
                            '<div class="alert alert-warning mb-0">' + escapeHtml(data.message || 'Gagal memuat preview template') + '</div>';
                    }
                })
                .catch(function() {
                    document.getElementById('notificationPreview').innerHTML =
                        '<div class="alert alert-danger mb-0">Gagal memuat preview WhatsApp</div>';
                });
            return false;
        }

        window.markInvoicePaid = markInvoicePaid;
        window.deleteInvoiceRow = deleteInvoiceRow;
        window.sendInvoiceWhatsApp = sendInvoiceWhatsApp;
        window.resetFilters = resetFilters;

        function getUnpaidCheckboxes() {
            var table = document.getElementById('invoiceListTable');
            if (!table) return [];
            var nodes = table.querySelectorAll('tbody input[type="checkbox"]');
            var list = [];
            for (var i = 0; i < nodes.length; i++) {
                if (!nodes[i].disabled) list.push(nodes[i]);
            }
            return list;
        }

        function getSelectedInvoiceRows() {
            if (typeof window.invoiceBulkGetSelectedRows === 'function') {
                return window.invoiceBulkGetSelectedRows();
            }
            return getUnpaidCheckboxes()
                .filter(function(cb) { return cb.checked; })
                .map(function(cb) { return cb.closest('tr'); })
                .filter(Boolean);
        }

        function setAllUnpaidChecked(checked) {
            if (typeof window.invoiceBulkSelectAll === 'function') {
                window.invoiceBulkSelectAll(!!checked);
                return;
            }
            var boxes = getUnpaidCheckboxes();
            for (var i = 0; i < boxes.length; i++) boxes[i].checked = !!checked;
            if (window.invoiceBulkSync) window.invoiceBulkSync();
        }

        function updateInvoiceBulkState() {
            if (typeof window.invoiceBulkSync === 'function') {
                window.invoiceBulkSync();
                return;
            }
            if (typeof window.invoiceBulkRowChanged === 'function') {
                window.invoiceBulkRowChanged();
            }
        }

        // Bind tombol & checkbox via event (tanpa inline onclick)
        (function bindInvoiceBulkUi() {
            var selectAll = document.getElementById('selectAllInvoices');
            if (selectAll) {
                selectAll.addEventListener('change', function() {
                    window.invoiceBulkSelectAll(!!this.checked);
                });
            }
            var selectAllHead = document.getElementById('selectAllInvoicesHead');
            if (selectAllHead) {
                selectAllHead.addEventListener('change', function() {
                    window.invoiceBulkSelectAll(!!this.checked);
                });
            }
            var selectAllBtn = document.getElementById('selectAllInvoicesBtn');
            if (selectAllBtn) {
                selectAllBtn.addEventListener('click', function(e) {
                    e.preventDefault();
                    window.invoiceBulkSelectAll(true);
                });
            }
            var clearAllBtn = document.getElementById('clearAllInvoicesBtn');
            if (clearAllBtn) {
                clearAllBtn.addEventListener('click', function(e) {
                    e.preventDefault();
                    window.invoiceBulkSelectAll(false);
                });
            }
            var table = document.getElementById('invoiceListTable');
            if (table) {
                table.addEventListener('change', function(e) {
                    var t = e.target;
                    if (!t || t.type !== 'checkbox') return;
                    if (t.id === 'selectAllInvoicesHead') return;
                    if (t.disabled) return;
                    if (window.invoiceBulkRowChanged) window.invoiceBulkRowChanged();
                });
                table.addEventListener('click', function(e) {
                    var t = e.target;
                    if (!t || t.type !== 'checkbox') return;
                    if (t.id === 'selectAllInvoicesHead') return;
                    if (t.disabled) return;
                    // Pastikan tombol bulk ikut update meski change event terblokir
                    setTimeout(function() {
                        if (window.invoiceBulkRowChanged) window.invoiceBulkRowChanged();
                    }, 0);
                });
            }
            if (window.invoiceBulkSync) window.invoiceBulkSync();
        })();

        var pendingBulkPayIds = [];
        var pendingBulkPayRows = [];

        var bulkPayBtn = document.getElementById('bulkPayBtn');
        if (bulkPayBtn) {
            bulkPayBtn.disabled = false;
            bulkPayBtn.removeAttribute('disabled');
            // Fallback jika onclick inline tidak jalan
            bulkPayBtn.addEventListener('click', function(e) {
                e.preventDefault();
                if (typeof window.openBulkPayModal === 'function') {
                    window.openBulkPayModal();
                    return;
                }
                showToast('error', 'Error', 'Fungsi bulk lunas belum siap. Refresh halaman.');
            });
        }

        var bulkPayForm = document.getElementById('bulkPayConfirmForm');
        if (bulkPayForm) {
            bulkPayForm.addEventListener('submit', function(e) {
                e.preventDefault();
                var ids = (window.__pendingBulkPayIds && window.__pendingBulkPayIds.length)
                    ? window.__pendingBulkPayIds.slice()
                    : (pendingBulkPayIds.length ? pendingBulkPayIds.slice() : getSelectedInvoiceRows().map(function(row) {
                        return Number(row.getAttribute('data-invoice-id'));
                    }).filter(Boolean));
                if (!ids.length) {
                    showToast('error', 'Belum ada pilihan', 'Centang invoice yang belum lunas terlebih dahulu');
                    return;
                }
                var paymentMethod = (document.getElementById('bulk_pay_payment_method') || {}).value || 'manual_admin';
                var paymentDate = (document.getElementById('bulk_pay_payment_date') || {}).value || '';
                var submitBtn = document.getElementById('bulkPaySubmitBtn');
                var originalText = submitBtn ? submitBtn.innerHTML : '';
                if (submitBtn) {
                    submitBtn.disabled = true;
                    submitBtn.innerHTML = '<i class="bi bi-hourglass-split"></i> Menyimpan...';
                }
                showToast('info', 'Memproses...', 'Melunasi ' + ids.length + ' invoice terpilih');

                var controller = (typeof AbortController !== 'undefined') ? new AbortController() : null;
                var timeoutId = setTimeout(function() {
                    if (controller) controller.abort();
                }, 45000);

                fetch('/admin/billing/invoices/bulk-pay', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json', 'Accept': 'application/json' },
                    credentials: 'same-origin',
                    body: JSON.stringify({
                        ids: ids,
                        payment_method: paymentMethod,
                        payment_date: paymentDate
                    }),
                    signal: controller ? controller.signal : undefined
                })
                .then(function(resp) {
                    return resp.text().then(function(text) {
                        var data = {};
                        try { data = text ? JSON.parse(text) : {}; } catch (_) {
                            throw new Error(resp.redirected || resp.status === 302
                                ? 'Sesi login habis, silakan login ulang'
                                : ('Respon server tidak valid (HTTP ' + resp.status + ')'));
                        }
                        if (!resp.ok) {
                            throw new Error(data.message || data.error || ('Gagal pelunasan massal (HTTP ' + resp.status + ')'));
                        }
                        return data;
                    });
                })
                .then(function(result) {
                    if (!result || !result.success) {
                        throw new Error((result && result.message) || 'Gagal pelunasan massal');
                    }
                    clearTimeout(timeoutId);
                    hideInvoiceModal('bulkPayConfirmModal');
                    showToast('success', 'Bulk Lunas', result.message || 'Pelunasan berhasil');
                    pendingBulkPayIds = [];
                    pendingBulkPayRows = [];
                    window.__pendingBulkPayIds = [];
                    window.__pendingBulkPayRows = [];
                    setTimeout(function() { window.location.reload(); }, 700);
                })
                .catch(function(error) {
                    clearTimeout(timeoutId);
                    var msg = error && error.name === 'AbortError'
                        ? 'Timeout: server terlalu lama merespons. Coba lagi atau lunasi satu per satu.'
                        : (error.message || 'Terjadi kesalahan saat pelunasan massal');
                    showToast('error', 'Gagal', msg);
                })
                .then(function() {
                    if (submitBtn) {
                        submitBtn.disabled = false;
                        submitBtn.innerHTML = originalText;
                    }
                });
            });
        }

        document.querySelectorAll('select[name="status"], select[name="type"]').forEach(function(select) {
            select.addEventListener('change', function() { this.form.submit(); });
        });

        var payDiscount = document.getElementById('pay_discount');
        if (payDiscount) payDiscount.addEventListener('input', updateFinalPaymentAmount);

        var paymentForm = document.getElementById('paymentConfirmForm');
        if (paymentForm) {
            paymentForm.addEventListener('submit', function(e) {
                e.preventDefault();
                if (!paymentForm.checkValidity()) {
                    paymentForm.reportValidity();
                    return;
                }
                var invoiceId = document.getElementById('pay_invoice_id').value;
                var paymentMethod = document.getElementById('pay_payment_method').value;
                var paymentDate = document.getElementById('pay_payment_date').value;
                var calc = updateFinalPaymentAmount();
                if (calc.discount > calc.invoiceAmount) {
                    showToast('error', 'Diskon Tidak Valid', 'Diskon tidak boleh melebihi jumlah invoice');
                    return;
                }
                var notes = 'Pelunasan oleh Admin Kantor | Diskon: Rp ' + Math.round(calc.discount).toLocaleString('id-ID') + ' | Tanggal Bayar: ' + paymentDate;
                var submitBtn = paymentForm.querySelector('button[type="submit"]');
                var originalText = submitBtn.innerHTML;
                submitBtn.disabled = true;
                submitBtn.innerHTML = '<i class="bi bi-hourglass-split"></i> Menyimpan...';
                showToast('info', 'Memproses...', 'Menyimpan pelunasan invoice');
                fetch('/admin/billing/payments', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({
                        invoice_id: invoiceId,
                        amount: calc.finalAmount,
                        payment_method: paymentMethod,
                        payment_date: paymentDate,
                        reference_number: '',
                        notes: notes,
                        discount_amount: Math.round(Number(calc.discount) || 0)
                    })
                })
                .then(function(resp) { return resp.json(); })
                .then(function(result) {
                    if (!result || !result.success) {
                        throw new Error((result && result.message) || 'Gagal menyimpan pelunasan');
                    }
                    hideInvoiceModal('paymentConfirmModal');
                    if (currentPaymentRow) markRowPaid(currentPaymentRow);
                    showToast('success', 'Tagihan Lunas', 'Pelunasan berhasil disimpan');
                })
                .catch(function(error) {
                    showToast('error', 'Gagal', error.message || 'Terjadi kesalahan saat menyimpan pelunasan');
                })
                .then(function() {
                    submitBtn.disabled = false;
                    submitBtn.innerHTML = originalText;
                });
            });
        }

        var confirmSendWA = document.getElementById('confirmSendWA');
        if (confirmSendWA) {
            confirmSendWA.addEventListener('click', function() {
                if (!currentNotificationData) return;
                var btn = this;
                var originalText = btn.innerHTML;
                btn.disabled = true;
                btn.innerHTML = '<i class="bi bi-hourglass-split"></i> Mengirim...';
                fetch('/admin/billing/invoices/send-whatsapp', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify(currentNotificationData)
                })
                .then(function(response) { return response.json(); })
                .then(function(data) {
                    if (data.success) {
                        showToast('success', 'Notifikasi Terkirim', data.message || 'Notifikasi WhatsApp berhasil dikirim');
                        hideInvoiceModal('whatsappModal');
                    } else {
                        showToast('error', 'Gagal Mengirim', data.message || 'Gagal mengirim notifikasi WhatsApp');
                    }
                })
                .catch(function() {
                    showToast('error', 'Error', 'Terjadi kesalahan saat mengirim notifikasi');
                })
                .then(function() {
                    btn.disabled = false;
                    btn.innerHTML = originalText;
                });
            });
        }

        (function forceSolidSummaryCards() {
            var gradients = [
                'linear-gradient(135deg, #6366f1, #4f46e5)',
                'linear-gradient(135deg, #22c55e, #16a34a)',
                'linear-gradient(135deg, #f59e0b, #d97706)',
                'linear-gradient(135deg, #ef4444, #dc2626)'
            ];
            var cards = document.querySelectorAll('.summary-cards-solid .summary-card');
            for (var idx = 0; idx < cards.length; idx++) {
                var card = cards[idx];
                var gradient = gradients[idx % gradients.length];
                card.style.setProperty('background', gradient, 'important');
                card.style.setProperty('background-image', gradient, 'important');
                card.style.setProperty('border', '0', 'important');
                var body = card.querySelector('.card-body');
                if (body) {
                    body.style.setProperty('background', 'transparent', 'important');
                    body.style.setProperty('color', '#fff', 'important');
                }
                var els = card.querySelectorAll('h3, p, i');
                for (var j = 0; j < els.length; j++) {
                    els[j].style.setProperty('color', '#fff', 'important');
                }
            }
        })();
    </script>
</body>
</html>
