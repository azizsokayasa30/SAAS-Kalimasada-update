                                            <th>Pelanggan</th>
                                            <th>Paket</th>
                                            <th>Jumlah</th>
                                            <th>Status</th>
                                            <th>Tipe</th>
                                            <th>Next Due Date</th>
                                            <th>Jatuh Tempo</th>
                                            <th>Aksi</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        <% invoices.forEach(invoice => { %>
                                            <%
                                                const invoiceAmount = Number(invoice.amount) || 0;
                                                const isUnpaid = invoice.status === 'unpaid';
                                                const isOverdue = isUnpaid && invoice.due_date && new Date(invoice.due_date) < new Date();
                                            %>
                                            <tr data-invoice-id="<%= invoice.id %>"
                                                data-invoice-number="<%= invoice.invoice_number || '' %>"
                                                data-customer-name="<%= invoice.customer_name || '' %>"
                                                data-phone="<%= invoice.customer_phone || '' %>"
                                                data-amount="<%= invoiceAmount %>"
                                                data-status="<%= invoice.status || '' %>"
                                                data-overdue="<%= isOverdue ? '1' : '0' %>">
                                                <td class="invoice-check-col">
                                                    <% if (isUnpaid) { %>
                                                        <input type="checkbox"
                                                               class="invoice-check invoice-checkbox"
                                                               name="bulk_invoice_id"
                                                               data-selectable="1"
                                                               value="<%= invoice.id %>"
                                                               aria-label="Pilih invoice #<%= invoice.invoice_number %>"
                                                               onchange="window.invoiceBulkRowChanged && window.invoiceBulkRowChanged()">
                                                    <% } else { %>
                                                        <input type="checkbox" class="invoice-check" disabled
                                                               aria-label="Invoice sudah tidak bisa dilunasi">
                                                    <% } %>
                                                </td>
                                                <td>
                                                    <strong>#<%= invoice.invoice_number %></strong>
                                                </td>
                                                <td>
                                                    <div>
                                                        <strong><%= invoice.customer_name %></strong><br>
                                                        <small class="text-muted">@<%= invoice.username %></small>
                                                    </div>
                                                </td>
                                                <td>
                                                    <span class="badge bg-info">
                                                        <%= invoice.package_name %>
                                                    </span>
                                                </td>
                                                <td>
                                                    <strong>Rp <%= invoiceAmount.toLocaleString('id-ID') %></strong>
                                                </td>
                                                <td class="invoice-status-cell">
                                                    <% if (invoice.status === 'paid') { %>
                                                        <span class="badge bg-success">Lunas</span>
                                                    <% } else if (invoice.status === 'unpaid') { %>
                                                        <% if (isOverdue) { %>
                                                            <span class="badge bg-warning text-dark">Terlambat</span>
                                                        <% } else { %>
                                                            <span class="badge bg-warning">Belum Bayar</span>
                                                        <% } %>
                                                    <% } else if (invoice.status === 'cancelled') { %>
                                                        <span class="badge bg-secondary">Dibatalkan</span>
                                                    <% } else { %>
                                                        <span class="badge bg-secondary"><%= invoice.status %></span>
                                                    <% } %>
                                                </td>
                                                <td>
                                                    <% if (invoice.renewal_type === 'fix_date') { %>
                                                        <span class="badge bg-info">
                                                            <i class="bi bi-calendar3"></i> Fix Date (<%= invoice.fix_date || 15 %>)
                                                        </span>
                                                    <% } else { %>
                                                        <span class="badge bg-primary">
                                                            <i class="bi bi-arrow-clockwise"></i> Renewal
                                                        </span>
                                                    <% } %>
                                                </td>
                                                <td>
                                                    <%= invoice.next_due_date ? new Date(invoice.next_due_date).toLocaleDateString('id-ID') : '-' %>
                                                </td>
                                                <td>
                                                    <%= new Date(invoice.due_date).toLocaleDateString('id-ID') %>
                                                </td>
                                                <td>
                                                    <div class="admin-action-btns">
                                                        <% if (isUnpaid) { %>
                                                            <a href="/admin/billing/invoices/<%= invoice.id %>/pay?next=<%= invoiceListNextEnc %>"
                                                               class="btn btn-sm btn-success js-mark-paid"
                                                               title="Tandai tagihan sebagai lunas" aria-label="Tandai lunas">Lunas</a>
                                                        <% } %>
                                                        <a href="/admin/billing/invoices/<%= invoice.id %>/hapus?next=<%= invoiceListNextEnc %>"
                                                           class="btn btn-sm btn-danger"
                                                           title="Hapus tagihan dari sistem" aria-label="Hapus tagihan">Hapus</a>
                                                        <a href="/admin/billing/invoices/<%= invoice.id %>/notify-whatsapp?next=<%= invoiceListNextEnc %>"
                                                           class="btn btn-sm btn-whatsapp"
                                                           title="Kirim pemberitahuan WhatsApp ke pelanggan" aria-label="Kirim WhatsApp">WA</a>
                                                        <a href="/admin/billing/invoices/<%= invoice.id %>"
                                                           class="btn btn-sm btn-info" title="Lihat detail tagihan" aria-label="Lihat tagihan">Lihat</a>
                                                        <a href="/admin/billing/invoices/<%= invoice.id %>/edit"
                                                           class="btn btn-sm btn-primary" title="Ubah data tagihan" aria-label="Ubah tagihan">Edit</a>
                                                        <a href="/admin/billing/invoices/<%= invoice.id %>/print"
                                                           class="btn btn-sm btn-secondary" title="Buka halaman cetak tagihan" aria-label="Cetak tagihan" target="_blank" rel="noopener noreferrer">Cetak</a>
                                                    </div>
                                                </td>
                                            </tr>
                                        <% }); %>
                                    </tbody>
                                </table>
                            </div>

                            <!-- Pagination -->
                            <% if (pagination.totalPages > 1) { %>
                                <nav aria-label="Invoice pagination">
                                    <ul class="pagination justify-content-center">
                                        <% 
                                            const pageQs = `status=${encodeURIComponent(filters.status || '')}&type=${encodeURIComponent(filters.type || '')}&customer_username=${encodeURIComponent(filters.customer_username || '')}&month=${selectedMonth}&year=${selectedYear}&limit=${encodeURIComponent(pageLimit)}`;
                                        %>
                                        <% if (pagination.currentPage > 1) { %>
                                            <li class="page-item">
                                                <a class="page-link" href="?page=<%= pagination.currentPage - 1 %>&<%= pageQs %>">
                                                    <i class="bi bi-chevron-left"></i>
                                                </a>
                                            </li>
                                        <% } %>
                                        
                                        <% for (let i = Math.max(1, pagination.currentPage - 2); i <= Math.min(pagination.totalPages, pagination.currentPage + 2); i++) { %>
                                            <li class="page-item <%= i === pagination.currentPage ? 'active' : '' %>">
                                                <a class="page-link" href="?page=<%= i %>&<%= pageQs %>">
                                                    <%= i %>
                                                </a>
                                            </li>
                                        <% } %>
                                        
                                        <% if (pagination.currentPage < pagination.totalPages) { %>
                                            <li class="page-item">
                                                <a class="page-link" href="?page=<%= pagination.currentPage + 1 %>&<%= pageQs %>">
                                                    <i class="bi bi-chevron-right"></i>
                                                </a>
                                            </li>
                                        <% } %>
                                    </ul>
                                </nav>
                            <% } %>
                            <div class="text-center text-muted small mt-2">
                                Menampilkan <%= invoices.length %> dari <%= pagination.totalCount %> invoice
                                <% if (pageLimit === 'all') { %>(semua)<% } else { %>(<%= pageLimit %> / halaman)<% } %>
                            </div>
                        <% } else { %>
                            <div class="text-center py-5">
                                <i class="bi bi-receipt fs-1 text-muted"></i>
                                <h5 class="mt-3">Tidak ada invoice ditemukan</h5>
                                <p class="text-muted">Belum ada invoice yang sesuai dengan filter yang dipilih.</p>
                                <a href="/admin/billing/invoices" class="btn btn-primary">
                                    <i class="bi bi-plus-lg"></i> Buat Invoice Baru
                                </a>
                            </div>
                        <% } %>
                    </div>
                </div>
            </main>
        </div>
    </div>

