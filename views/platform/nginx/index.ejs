<%- include('../partials/head', { title }) %>
<%- include('../partials/sidebar', { active, adminName }) %>
<main class="km-main km-set km-infra km-infra--proxy">
  <%
    const pxDisabled = !status.nginx_installed ? ' disabled' : '';
    const pxNginxChip = !status.nginx_installed
      ? { tone: 'muted', dot: true, label: 'Nginx belum terinstall' }
      : (status.nginx_active ? { tone: 'ok', dot: true, label: 'Nginx aktif' } : { tone: 'warn', dot: true, label: 'Nginx tidak aktif' });
    const pxSslChip = config.ssl_enabled
      ? ((typeof sslStatus !== 'undefined' && sslStatus && !sslStatus.ok) ? { tone: 'warn', icon: 'bi-shield-exclamation', label: 'SSL bermasalah' } : { tone: 'ok', icon: 'bi-lock-fill', label: 'HTTPS aktif' })
      : { tone: 'muted', icon: 'bi-unlock', label: 'HTTP saja' };
    const pxCustomCount = (typeof customProxies !== 'undefined' && customProxies) ? customProxies.length : 0;
    const pxTenantCount = (config.tenant_subdomains || []).length;
  %>
  <%- include('../partials/infra-hero', {
    tab: 'proxy',
    icon: 'bi-signpost-split',
    heading: 'Reverse Proxy',
    desc: 'Atur Nginx untuk subdomain tenant, proxy ke server lain, dan sertifikat HTTPS.',
    chips: [
      pxNginxChip,
      pxSslChip,
      { tone: 'info', icon: 'bi-globe2', label: (config.central_subdomain ? config.central_subdomain + '.' : '') + config.base_domain }
    ],
    actions:
      '<form method="POST" action="/management/settings/reverse-proxy/reload" class="d-inline"><button type="submit" class="btn btn-outline-secondary"' + pxDisabled + '><i class="bi bi-arrow-clockwise"></i> Reload</button></form>' +
      '<form method="POST" action="/management/settings/reverse-proxy/sync" class="d-inline"><button type="submit" class="btn btn-km-primary"' + pxDisabled + '><i class="bi bi-arrow-repeat"></i> Sync Tenant</button></form>'
  }) %>

  <% if (flash && flash.success) { %>
    <div class="alert alert-success">
      <% if (flash.success === 'synced') { %>
        Nginx diperbarui — <strong><%= flash.count || config.tenant_subdomains.length %></strong> subdomain tenant aktif.
      <% } %>
      <% if (flash.success === 'subdomain_added') { %>Subdomain <code><%= flash.sub %>.<%= config.base_domain %></code> ditambahkan.<% } %>
      <% if (flash.success === 'subdomain_removed') { %>Subdomain manual dihapus.<% } %>
      <% if (flash.success === 'proxy_added') { %>Proxy <code><%= flash.host %></code> ditambahkan.<% } %>
      <% if (flash.success === 'proxy_removed') { %>Proxy eksternal dihapus.<% } %>
      <% if (flash.success === 'saved' || flash.success === 'applied') { %>Pengaturan disimpan dan diterapkan.<% } %>
      <% if (flash.success === 'reloaded') { %>Nginx berhasil di-reload.<% } %>
      <% if (flash.success === 'test_ok') { %>Test konfigurasi nginx -t berhasil.<% } %>
    </div>
  <% } %>

  <% if (flash && flash.error === 'ssl_missing') { %>
    <div class="alert alert-danger">
      <strong>SSL belum tersedia.</strong> Jalankan certbot di server, lalu aktifkan SSL lagi.
    </div>
  <% } else if (flash && flash.error) { %>
    <div class="alert alert-danger"><%= flash.error %></div>
  <% } %>

  <% const proxyIssues = (typeof diagnostics !== 'undefined' && diagnostics.issues) ? diagnostics.issues : []; %>
  <% if (!status.nginx_installed || proxyIssues.length) { %>
    <div class="km-infra-alert">
      <span class="km-infra-alert__icon"><i class="bi bi-exclamation-triangle"></i></span>
      <div class="min-w-0">
        <strong>Perlu perbaikan</strong>
        <ul>
          <% if (!status.nginx_installed) { %>
            <li>Nginx belum terinstall. Jalankan <code>sudo bash /var/www/billing-kalimasada/scripts/setup-nginx-proxy.sh</code></li>
          <% } %>
          <% proxyIssues.forEach(function(issue) { %><li><%= issue %></li><% }); %>
        </ul>
      </div>
    </div>
  <% } %>

  <%- include('../partials/infra-stats', { stats: [
    {
      tone: !status.nginx_installed ? 'slate' : (status.nginx_active ? 'green' : 'amber'),
      icon: 'bi-server',
      label: 'Status Nginx',
      value: !status.nginx_installed ? 'Belum install' : (status.nginx_active ? 'Aktif' : 'Tidak aktif'),
      small: true,
      meta: config.ssl_enabled ? 'HTTPS diaktifkan' : 'HTTPS nonaktif'
    },
    { tone: 'blue', icon: 'bi-buildings', label: 'Subdomain Tenant', value: pxTenantCount, meta: 'Diproksikan otomatis' },
    { tone: 'amber', icon: 'bi-hdd-network', label: 'Proxy Eksternal', value: pxCustomCount, meta: 'Ke server lain' },
    { tone: 'violet', icon: 'bi-arrow-left-right', label: 'Upstream', value: config.upstream_host + ':' + config.upstream_port, code: true, meta: 'Port listen ' + (config.listen_port || 80) }
  ] }) %>

  <div class="row g-3 mb-4">
  <div class="col-xl-7">
  <div class="km-card h-100">
    <div class="km-vpn-card__head"><h5><i class="bi bi-buildings"></i> Tenant</h5></div>
    <% if (typeof tenantProxyRows !== 'undefined' && tenantProxyRows.length) { %>
    <div class="table-responsive">
      <table class="table table-sm table-hover mb-0">
        <thead>
          <tr><th>Tenant</th><th>URL</th><th>Status</th></tr>
        </thead>
        <tbody>
          <% tenantProxyRows.forEach(function(t) { %>
            <tr>
              <td class="fw-semibold"><%= t.name %></td>
              <td>
                <a href="<%= t.url %>" target="_blank" rel="noopener" class="text-decoration-none" style="color: var(--ix-tone)">
                  <i class="bi bi-box-arrow-up-right me-1 small"></i><%= t.hostname %>
                </a>
              </td>
              <td>
                <% if (t.proxyActive) { %>
                  <span class="km-infra-pill km-infra-pill--ok">Aktif</span>
                <% } else { %>
                  <span class="km-infra-pill km-infra-pill--warn">Pending</span>
                <% } %>
              </td>
            </tr>
          <% }); %>
        </tbody>
      </table>
    </div>
    <% } else { %>
      <div class="km-infra-empty">
        <span class="km-infra-empty__icon"><i class="bi bi-buildings"></i></span>
        <strong>Belum ada tenant</strong>
        <span>Subdomain tenant akan muncul di sini setelah tenant dibuat dan disinkronkan.</span>
      </div>
    <% } %>
  </div>
  </div>

  <div class="col-xl-5">
  <div class="km-card h-100">
    <div class="km-vpn-card__head"><h5><i class="bi bi-hdd-network"></i> Proxy ke Server Lain</h5></div>
    <% if (typeof customProxies !== 'undefined' && customProxies.length) { %>
    <div class="table-responsive mb-3">
      <table class="table table-sm table-hover mb-0">
        <thead>
          <tr><th>Domain</th><th>Target</th><th></th></tr>
        </thead>
        <tbody>
          <% customProxies.forEach(function(p) { %>
            <tr>
              <td><code><%= p.hostname %></code></td>
              <td><code><%= p.upstream_host %>:<%= p.upstream_port %></code></td>
              <td class="text-end">
                <form method="POST" action="/management/settings/reverse-proxy/proxies/remove" class="d-inline"
                      onsubmit="return confirm('Hapus proxy <%= p.hostname %>?');">
                  <input type="hidden" name="proxy_id" value="<%= p.id %>">
                  <button type="submit" class="btn btn-outline-danger btn-sm py-0 px-2">
                    <i class="bi bi-trash"></i>
                  </button>
                </form>
              </td>
            </tr>
          <% }); %>
        </tbody>
      </table>
    </div>
    <% } else { %>
      <p class="small text-muted mb-3"><i class="bi bi-info-circle me-1"></i>Belum ada proxy eksternal. Tambahkan subdomain yang diteruskan ke server lain.</p>
    <% } %>
    <form method="POST" action="/management/settings/reverse-proxy/proxies/add" class="row g-2 align-items-end">
      <div class="col-12">
        <label class="form-label small mb-1">Subdomain</label>
        <div class="input-group input-group-sm flex-nowrap">
          <input type="text" name="hostname" class="form-control" placeholder="bna" required>
          <span class="input-group-text">.<%= config.base_domain %></span>
        </div>
      </div>
      <div class="col-12">
        <label class="form-label small mb-1">Target (IP:port)</label>
        <div class="input-group input-group-sm flex-nowrap">
          <input type="text" name="upstream_host" class="form-control" placeholder="192.168.1.10" required>
          <span class="input-group-text">:</span>
          <input type="number" name="upstream_port" class="form-control" value="3003" min="1" max="65535" required style="max-width:6rem;">
        </div>
      </div>
      <div class="col-sm-8">
        <label class="form-label small mb-1">Label <span class="text-muted">(opsional)</span></label>
        <input type="text" name="label" class="form-control form-control-sm" placeholder="Cabang BNA">
      </div>
      <div class="col-sm-4">
        <button type="submit" class="btn btn-outline-primary btn-sm w-100" <%= !status.nginx_installed ? 'disabled' : '' %>>
          <i class="bi bi-plus-lg"></i> Tambah
        </button>
      </div>
    </form>
  </div>
  </div>
  </div>

  <div class="km-card">
    <div class="km-vpn-card__head"><h5><i class="bi bi-gear"></i> Pengaturan</h5></div>
    <form method="POST" action="/management/settings/reverse-proxy/save">
      <div class="row g-3">
        <div class="col-md-6 col-xl-4">
          <label class="form-label">Domain Utama</label>
          <input type="text" name="base_domain" class="form-control form-control-sm" value="<%= config.base_domain %>" required>
        </div>
        <div class="col-md-6 col-xl-4">
          <label class="form-label">Subdomain Management</label>
          <input type="text" name="central_subdomain" class="form-control form-control-sm" value="<%= config.central_subdomain %>" required>
        </div>
        <div class="col-md-6 col-xl-4">
          <label class="form-label">IP Publik (DNS)</label>
          <input type="text" name="public_ip" class="form-control form-control-sm" value="<%= config.public_ip || '' %>">
        </div>
        <div class="col-md-6 col-xl-4">
          <label class="form-label">Upstream Host</label>
          <input type="text" name="upstream_host" class="form-control form-control-sm" value="<%= config.upstream_host %>" required>
        </div>
        <div class="col-md-6 col-xl-4">
          <label class="form-label">Upstream Port</label>
          <input type="number" name="upstream_port" class="form-control form-control-sm" value="<%= config.upstream_port %>" min="1" max="65535" required>
        </div>
        <div class="col-md-6 col-xl-4">
          <label class="form-label">IP Server (LAN)</label>
          <input type="text" name="server_ip" class="form-control form-control-sm" value="<%= config.server_ip %>">
        </div>
        <div class="col-12">
          <div class="form-check form-switch mb-0">
            <input class="form-check-input" type="checkbox" name="ssl_enabled" id="ssl_enabled" <%= config.ssl_enabled ? 'checked' : '' %>>
            <label class="form-check-label" for="ssl_enabled">Aktifkan HTTPS (SSL)</label>
          </div>
          <% if (typeof sslStatus !== 'undefined' && !sslStatus.ok) { %>
            <div class="form-text text-warning small mt-1"><i class="bi bi-exclamation-triangle me-1"></i><%= sslStatus.error %></div>
          <% } %>
        </div>
      </div>

      <details class="km-infra-details">
        <summary><i class="bi bi-sliders"></i> Pengaturan lanjutan</summary>
        <div class="row g-3 km-infra-details__body">
          <div class="col-md-4">
            <label class="form-label">Listen Port</label>
            <input type="number" name="listen_port" class="form-control form-control-sm" value="<%= config.listen_port %>" min="1" max="65535">
          </div>
          <div class="col-md-8">
            <label class="form-label">Domain Tambahan</label>
            <input type="text" name="custom_hosts" class="form-control form-control-sm"
                   value="<%= (config.custom_hosts || []).join(', ') %>" placeholder="billing.example.com">
          </div>
          <div class="col-12">
            <label class="form-label">Subdomain Manual</label>
            <textarea name="manual_subdomains" class="form-control form-control-sm" rows="2"
                      placeholder="staging, demo"><%= (config.manual_subdomains || []).join('\n') %></textarea>
          </div>
          <div class="col-md-6 ssl-fields" style="<%= config.ssl_enabled ? '' : 'display:none' %>">
            <label class="form-label">SSL Certificate</label>
            <input type="text" name="ssl_cert_path" class="form-control form-control-sm" value="<%= config.ssl_cert_path %>">
          </div>
          <div class="col-md-6 ssl-fields" style="<%= config.ssl_enabled ? '' : 'display:none' %>">
            <label class="form-label">SSL Private Key</label>
            <input type="text" name="ssl_key_path" class="form-control form-control-sm" value="<%= config.ssl_key_path %>">
          </div>
        </div>
      </details>

      <input type="hidden" name="auto_sync_on_tenant_change" value="on">
      <% const sslErr = (typeof sslStatus !== 'undefined' && sslStatus && !sslStatus.ok && sslStatus.error) ? String(sslStatus.error) : ''; %>
      <div class="km-infra-formbar">
        <% if (config.last_apply_message && !(sslErr && String(config.last_apply_message).indexOf(sslErr) === 0)) { %>
          <span class="km-infra-formbar__hint <%= config.last_apply_ok ? 'text-success' : 'text-danger' %>">
            <i class="bi <%= config.last_apply_ok ? 'bi-check-circle' : 'bi-x-circle' %> me-1"></i><%= config.last_apply_message %>
          </span>
        <% } %>
        <div class="km-infra-formbar__end">
          <button type="submit" class="btn btn-km-primary btn-sm px-3" <%= !status.nginx_installed ? 'disabled' : '' %>>
            <i class="bi bi-check-lg"></i> Simpan &amp; Terapkan
          </button>
          <button type="submit" formaction="/management/settings/reverse-proxy/test" class="btn btn-outline-info btn-sm" <%= !status.nginx_installed ? 'disabled' : '' %>>
            <i class="bi bi-clipboard-check"></i> Test nginx -t
          </button>
          <a href="/management/settings/reverse-proxy/preview" target="_blank" class="btn btn-outline-secondary btn-sm"><i class="bi bi-file-earmark-code"></i> Preview config</a>
        </div>
      </div>
    </form>
  </div>
</main>
<%- include('../partials/footer') %>
<script>
document.getElementById('ssl_enabled')?.addEventListener('change', function() {
  document.querySelectorAll('.ssl-fields').forEach(function(el) {
    el.style.display = this.checked ? '' : 'none';
  }.bind(this));
});
</script>
