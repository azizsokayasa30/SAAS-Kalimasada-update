<%- include('../partials/head', { title }) %>
<%- include('../partials/sidebar', { active, adminName }) %>
<link rel="stylesheet" href="/css/infra-modern.css?v=13">
<style>
  /* Solid action buttons — override outline/neon theme styles */
  .km-infra--radius .km-rd-card__actions {
    display: grid !important;
    grid-template-columns: repeat(3, minmax(0, 1fr)) !important;
    gap: 0.45rem !important;
  }
  .km-infra--radius .km-rd-card__actions > form { margin: 0 !important; }
  .km-infra--radius .km-rd-btn {
    display: inline-flex !important;
    align-items: center !important;
    justify-content: center !important;
    gap: 0.35rem !important;
    width: 100% !important;
    min-height: 2.4rem !important;
    padding: 0.5rem 0.55rem !important;
    border: 0 !important;
    border-radius: 10px !important;
    font-size: 0.8rem !important;
    font-weight: 700 !important;
    color: #fff !important;
    text-decoration: none !important;
    box-shadow: none !important;
    background-image: none !important;
  }
  .km-infra--radius .km-rd-btn i,
  .km-infra--radius .km-rd-btn span { color: #fff !important; }
  .km-infra--radius .km-rd-btn--restart { background: #d97706 !important; background-color: #d97706 !important; }
  .km-infra--radius .km-rd-btn--test { background: #059669 !important; background-color: #059669 !important; }
  .km-infra--radius .km-rd-btn--backup { background: #475569 !important; background-color: #475569 !important; }
  .km-infra--radius .km-rd-btn--restore { background: #0f766e !important; background-color: #0f766e !important; }
  .km-infra--radius .km-rd-btn--edit { background: #2563eb !important; background-color: #2563eb !important; }
  .km-infra--radius .km-rd-btn--delete { background: #dc2626 !important; background-color: #dc2626 !important; }
  .km-infra--radius .km-rd-btn:disabled { opacity: 0.42 !important; }
</style>
<main class="km-main km-set km-infra km-infra--radius">
  <% const activePopCount = pops.filter(function(p) { return p.is_active; }).length; %>
  <% const live = typeof radiusLive !== 'undefined' && radiusLive ? radiusLive : { total: 0, up: 0, down: 0 }; %>
  <%
    const rdTotal = live.total || 0;
    const rdUp = live.up || 0;
    const rdDown = live.down || 0;
    const rdHealth = rdTotal ? Math.round((rdUp / rdTotal) * 100) : null;
    const rdChips = [];
    if (!rdTotal) rdChips.push({ tone: 'muted', dot: true, label: 'Belum ada server' });
    else if (rdDown) rdChips.push({ tone: 'bad', dot: true, label: rdDown + ' server down' });
    else rdChips.push({ tone: 'ok', dot: true, label: 'Semua server up' });
    rdChips.push({ tone: 'info', icon: 'bi-geo-alt', label: activePopCount + ' POP aktif' });
    function fmtNum(n) {
      if (n == null || n === '') return '—';
      return Number(n).toLocaleString('id-ID');
    }
  %>
  <%- include('../partials/infra-hero', {
    tab: 'radius',
    icon: 'bi-shield-check',
    heading: 'Radius Manager',
    desc: 'Pantau engine FreeRADIUS per POP/CABANG — uptime, database PPPoE, dan aksi restart/test.',
    chips: rdChips,
    actions: '<button type="button" class="btn btn-km-primary" data-bs-toggle="modal" data-bs-target="#addRadiusModal"><i class="bi bi-plus-lg"></i> Tambah Radius</button>'
  }) %>
  <% if (!activePopCount) { %>
    <div class="alert alert-warning">Buat POP/CABANG aktif terlebih dahulu di <a href="/management/pop" class="alert-link">Daftar POP/CABANG</a>.</div>
  <% } %>

  <% if (flash && flash.success === 'created') { %><div class="alert alert-success">Radius manager berhasil ditambahkan.</div><% } %>
  <% if (flash && flash.success === 'updated') { %><div class="alert alert-success">Radius manager berhasil diperbarui.</div><% } %>
  <% if (flash && flash.success === 'deleted') { %><div class="alert alert-success">Radius manager berhasil dihapus.</div><% } %>
  <% if (flash && flash.success === 'restarted') { %><div class="alert alert-success"><i class="bi bi-arrow-clockwise me-1"></i><%= flash.msg || 'FreeRADIUS berhasil direstart.' %></div><% } %>
  <% if (flash && flash.success === 'restored') { %><div class="alert alert-success"><i class="bi bi-arrow-counterclockwise me-1"></i><%= flash.msg || 'Restore database RADIUS berhasil.' %></div><% } %>
  <% if (flash && flash.error) { %><div class="alert alert-danger"><%= flash.error %></div><% } %>
  <div id="radiusTestFlash" class="alert d-none" role="status"></div>
  <% const backupList = (typeof radiusBackups !== 'undefined' && Array.isArray(radiusBackups)) ? radiusBackups : []; %>

  <%- include('../partials/infra-stats', { stats: [
    { tone: 'blue', icon: 'bi-hdd-stack', label: 'Terdaftar', value: rdTotal, meta: 'Server FreeRADIUS' },
    { tone: 'green', icon: 'bi-arrow-up-circle', label: 'Up', value: rdUp, meta: 'Merespons normal' },
    { tone: 'red', icon: 'bi-arrow-down-circle', label: 'Down', value: rdDown, meta: rdDown ? 'Perlu dicek' : 'Tidak ada gangguan' },
    { tone: 'violet', icon: 'bi-heart-pulse', label: 'Kesehatan', value: rdHealth === null ? '—' : rdHealth + '%', meta: 'Rasio server up' }
  ] }) %>

  <div class="km-card km-card--flush">
    <div class="km-infra-panel-head">
      <h5><i class="bi bi-shield-lock"></i> Engine FreeRADIUS</h5>
      <small><%= radiusServers.length %> server</small>
    </div>

    <% if (!radiusServers.length) { %>
      <div class="km-infra-empty py-5">
        <span class="km-infra-empty__icon"><i class="bi bi-shield-check"></i></span>
        <strong>Belum ada FreeRADIUS terdaftar</strong>
        <span>Daftarkan server FreeRADIUS agar status autentikasi tiap POP bisa dipantau langsung dari sini.</span>
        <button type="button" class="btn btn-km-primary btn-sm px-3" data-bs-toggle="modal" data-bs-target="#addRadiusModal"><i class="bi bi-plus-lg"></i> Tambah Radius</button>
      </div>
    <% } else { %>
      <div class="km-rd-grid">
        <% radiusServers.forEach(function(r) {
          const eng = r.engine || {};
          const statusClass = !r.is_active ? 'is-off' : (r.live_status === 'up' ? 'is-up' : (r.live_status === 'down' ? 'is-down' : 'is-off'));
          const statusLabel = !r.is_active ? 'Nonaktif' : (r.live_status === 'up' ? 'Up' : (r.live_status === 'down' ? 'Down' : '—'));
        %>
          <article class="km-rd-card <%= statusClass %> <%= r.is_active ? '' : 'is-disabled' %>" data-radius-id="<%= r.id %>">
            <header class="km-rd-card__head">
              <div class="km-rd-card__identity">
                <span class="km-rd-card__icon"><i class="bi bi-hdd-stack"></i></span>
                <div>
                  <h3 class="km-rd-card__title"><%= r.name %></h3>
                  <div class="km-rd-card__pop"><code><%= r.pop_code %></code> · <%= r.pop_name %></div>
                </div>
              </div>
              <div class="km-fr-live" <% if (r.live_detail) { %>title="<%= r.live_detail %>"<% } %>>
                <span class="km-fr-badge km-fr-badge--<%= !r.is_active ? 'off' : (r.live_status === 'up' ? 'up' : (r.live_status === 'down' ? 'down' : 'off')) %>"><%= statusLabel.toLowerCase() %></span>
              </div>
            </header>

            <div class="km-rd-card__meta">
              <div><span>Host</span><code><%= r.host %></code></div>
              <div><span>Auth / Acct</span><strong><%= r.auth_port || 1812 %> / <%= r.acct_port || 1813 %></strong></div>
              <div><span>Scope</span><strong><%= r.is_local ? 'Lokal VPS' : 'Remote POP' %></strong></div>
              <% if (eng.version) { %><div><span>Versi</span><strong><%= eng.version %></strong></div><% } %>
            </div>

            <div class="km-rd-metrics">
              <div class="km-rd-metric">
                <span class="km-rd-metric__label"><i class="bi bi-clock-history"></i> Uptime engine</span>
                <strong class="km-rd-metric__value"><%= eng.uptimeLabel || '—' %></strong>
              </div>
              <div class="km-rd-metric">
                <span class="km-rd-metric__label"><i class="bi bi-people"></i> DB PPPoE</span>
                <strong class="km-rd-metric__value"><%= fmtNum(eng.pppoeUsers) %></strong>
                <small>user di radcheck</small>
              </div>
              <div class="km-rd-metric">
                <span class="km-rd-metric__label"><i class="bi bi-broadcast"></i> Sesi aktif</span>
                <strong class="km-rd-metric__value"><%= fmtNum(eng.activeSessions) %></strong>
                <small><%= eng.activeSessionsLabel || (eng.activeSessionsSource === 'mikrotik' ? 'PPPoE online' : 'online') %></small>
              </div>
              <div class="km-rd-metric">
                <span class="km-rd-metric__label"><i class="bi bi-router"></i> NAS</span>
                <strong class="km-rd-metric__value"><%= fmtNum(eng.nasCount) %></strong>
                <small>client terdaftar</small>
              </div>
              <div class="km-rd-metric">
                <span class="km-rd-metric__label"><i class="bi bi-database"></i> Database</span>
                <strong class="km-rd-metric__value"><%= eng.database === 'connected' ? 'OK' : (eng.database === 'remote' ? 'Remote' : (eng.database || '—')) %></strong>
                <small><%= eng.dbSizeLabel || (eng.scope === 'remote' ? 'metrik terbatas' : '—') %></small>
              </div>
              <div class="km-rd-metric">
                <span class="km-rd-metric__label"><i class="bi bi-activity"></i> Service</span>
                <strong class="km-rd-metric__value"><%= eng.service === 'running' ? 'Running' : (eng.service === 'disabled' ? 'Off' : (eng.service || '—')) %></strong>
                <small><%= eng.mainPid ? ('PID ' + eng.mainPid) : (eng.serviceDetail || '') %></small>
              </div>
            </div>

            <div class="km-rd-card__extra">
              <% if (eng.hostUptimeLabel) { %>
                <span><i class="bi bi-pc-display"></i> Host uptime <%= eng.hostUptimeLabel %></span>
              <% } %>
              <% if (eng.restarts != null) { %>
                <span><i class="bi bi-arrow-repeat"></i> Restart <%= eng.restarts %>×</span>
              <% } %>
              <% if (eng.dbPath) { %>
                <span title="<%= eng.dbPath %>"><i class="bi bi-folder2-open"></i> <%= eng.dbPath.split('/').slice(-2).join('/') %></span>
              <% } %>
              <% if (r.description) { %>
                <span><i class="bi bi-chat-left-text"></i> <%= r.description %></span>
              <% } %>
              <% if (eng.note) { %>
                <span class="km-rd-card__note"><i class="bi bi-info-circle"></i> <%= eng.note %></span>
              <% } %>
            </div>

            <footer class="km-rd-card__actions">
              <% if (eng.canRestart) { %>
                <form method="POST" action="/management/pop/radius/<%= r.id %>/restart" onsubmit="return confirm('Restart FreeRADIUS <%= r.name %>? Sesi autentikasi singkat bisa terganggu.');">
                  <button type="submit" class="km-rd-btn km-rd-btn--restart" title="Restart FreeRADIUS">
                    <i class="bi bi-arrow-clockwise"></i><span>Restart</span>
                  </button>
                </form>
              <% } else { %>
                <button type="button" class="km-rd-btn km-rd-btn--restart" disabled title="Restart otomatis hanya untuk FreeRADIUS lokal">
                  <i class="bi bi-arrow-clockwise"></i><span>Restart</span>
                </button>
              <% } %>

              <button type="button" class="km-rd-btn km-rd-btn--test js-radius-test" data-id="<%= r.id %>" data-name="<%= r.name %>" <%= eng.canTest ? '' : 'disabled' %> title="Tes koneksi / Status-Server">
                <i class="bi bi-lightning-charge"></i><span>Test</span>
              </button>

              <% if (eng.canBackup) { %>
                <a href="/management/pop/radius/<%= r.id %>/backup" class="km-rd-btn km-rd-btn--backup" title="Backup database &amp; config FreeRADIUS">
                  <i class="bi bi-download"></i><span>Backup</span>
                </a>
              <% } else { %>
                <button type="button" class="km-rd-btn km-rd-btn--backup" disabled title="Backup DB hanya untuk FreeRADIUS lokal">
                  <i class="bi bi-download"></i><span>Backup</span>
                </button>
              <% } %>

              <% if (eng.canRestore) { %>
                <button type="button" class="km-rd-btn km-rd-btn--restore" data-bs-toggle="modal" data-bs-target="#restoreRadiusModal-<%= r.id %>" title="Restore database RADIUS">
                  <i class="bi bi-upload"></i><span>Restore</span>
                </button>
              <% } else { %>
                <button type="button" class="km-rd-btn km-rd-btn--restore" disabled title="Restore DB hanya untuk FreeRADIUS lokal">
                  <i class="bi bi-upload"></i><span>Restore</span>
                </button>
              <% } %>

              <button type="button" class="km-rd-btn km-rd-btn--edit" data-bs-toggle="modal" data-bs-target="#editRadiusModal-<%= r.id %>" title="Edit">
                <i class="bi bi-pencil"></i><span>Edit</span>
              </button>

              <button type="button" class="km-rd-btn km-rd-btn--delete" data-bs-toggle="modal" data-bs-target="#deleteRadiusModal-<%= r.id %>" title="Hapus (butuh password)">
                <i class="bi bi-trash"></i><span>Hapus</span>
              </button>
            </footer>
          </article>
        <% }); %>
      </div>
    <% } %>
  </div>
</main>

<div class="modal fade km-modal" id="addRadiusModal" tabindex="-1">
  <div class="modal-dialog modal-dialog-centered modal-dialog-scrollable modal-lg">
    <form method="POST" action="/management/pop/radius" class="modal-content km-package-modal">
      <div class="modal-header km-package-modal__header">
        <div>
          <h5 class="modal-title mb-0">Tambah Radius Manager</h5>
        </div>
        <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
      </div>
      <div class="modal-body km-package-modal__body">
        <div class="row g-3">
          <div class="col-md-6">
            <label class="form-label">POP/CABANG</label>
            <select name="pop_id" class="form-select" required>
              <option value="">— Pilih POP —</option>
              <% pops.forEach(function(p) {
                if (!p.is_active) return;
              %>
                <option value="<%= p.id %>" <%= pops.filter(function(x){ return x.is_active; }).length === 1 ? 'selected' : '' %>><%= p.code %> — <%= p.name %></option>
              <% }); %>
            </select>
          </div>
          <div class="col-md-6">
            <label class="form-label">Nama</label>
            <input type="text" name="name" class="form-control" required placeholder="RADIUS POP BNA">
          </div>
          <div class="col-md-6">
            <label class="form-label">Host / IP</label>
            <input type="text" name="host" class="form-control" required placeholder="10.0.0.10">
          </div>
          <div class="col-md-3">
            <label class="form-label">Auth Port</label>
            <input type="number" name="auth_port" class="form-control" value="1812">
          </div>
          <div class="col-md-3">
            <label class="form-label">Acct Port</label>
            <input type="number" name="acct_port" class="form-control" value="1813">
          </div>
          <div class="col-md-6">
            <label class="form-label">RADIUS Secret</label>
            <input type="password" name="radius_secret" class="form-control" autocomplete="new-password">
          </div>
          <div class="col-12">
            <label class="form-label">Keterangan</label>
            <textarea name="description" class="form-control" rows="2"></textarea>
          </div>
          <div class="col-12">
            <div class="form-check form-switch">
              <input class="form-check-input" type="checkbox" name="is_active" value="1" id="addRadiusActive" checked>
              <label class="form-check-label" for="addRadiusActive">Aktif</label>
            </div>
          </div>
        </div>
      </div>
      <div class="modal-footer km-package-modal__footer">
        <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Batal</button>
        <button type="submit" class="btn btn-km-primary">Simpan Radius Manager</button>
      </div>
    </form>
  </div>
</div>

<% radiusServers.forEach(function(r) { %>
<div class="modal fade km-modal" id="editRadiusModal-<%= r.id %>" tabindex="-1">
  <div class="modal-dialog modal-dialog-centered modal-dialog-scrollable modal-lg">
    <form method="POST" action="/management/pop/radius/<%= r.id %>" class="modal-content km-package-modal">
      <div class="modal-header km-package-modal__header">
        <h5 class="modal-title mb-0">Edit <%= r.name %></h5>
        <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
      </div>
      <div class="modal-body km-package-modal__body">
        <div class="row g-3">
          <div class="col-md-6">
            <label class="form-label">POP/CABANG</label>
            <select name="pop_id" class="form-select" required>
              <% pops.forEach(function(p) { %>
                <option value="<%= p.id %>" <%= Number(p.id) === Number(r.pop_id) ? 'selected' : '' %><%= p.is_active ? '' : ' disabled' %>><%= p.code %> — <%= p.name %><%= p.is_active ? '' : ' (nonaktif)' %></option>
              <% }); %>
            </select>
          </div>
          <div class="col-md-6">
            <label class="form-label">Nama</label>
            <input type="text" name="name" class="form-control" value="<%= r.name %>" required>
          </div>
          <div class="col-md-6">
            <label class="form-label">Host / IP</label>
            <input type="text" name="host" class="form-control" value="<%= r.host %>" required>
          </div>
          <div class="col-md-3">
            <label class="form-label">Auth Port</label>
            <input type="number" name="auth_port" class="form-control" value="<%= r.auth_port || 1812 %>">
          </div>
          <div class="col-md-3">
            <label class="form-label">Acct Port</label>
            <input type="number" name="acct_port" class="form-control" value="<%= r.acct_port || 1813 %>">
          </div>
          <div class="col-md-6">
            <label class="form-label">RADIUS Secret <span class="text-muted fw-normal">(kosongkan jika tidak diubah)</span></label>
            <input type="password" name="radius_secret" class="form-control" autocomplete="new-password">
          </div>
          <div class="col-12">
            <label class="form-label">Keterangan</label>
            <textarea name="description" class="form-control" rows="2"><%= r.description || '' %></textarea>
          </div>
          <div class="col-12">
            <div class="form-check form-switch">
              <input class="form-check-input" type="checkbox" name="is_active" value="1" id="editRadiusActive-<%= r.id %>" <%= r.is_active ? 'checked' : '' %>>
              <label class="form-check-label" for="editRadiusActive-<%= r.id %>">Aktif</label>
            </div>
          </div>
        </div>
      </div>
      <div class="modal-footer km-package-modal__footer">
        <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Batal</button>
        <button type="submit" class="btn btn-km-primary">Simpan Perubahan</button>
      </div>
    </form>
  </div>
</div>

<div class="modal fade km-modal" id="deleteRadiusModal-<%= r.id %>" tabindex="-1">
  <div class="modal-dialog modal-dialog-centered">
    <form method="POST" action="/management/pop/radius/<%= r.id %>/delete" class="modal-content km-package-modal">
      <div class="modal-header km-package-modal__header">
        <h5 class="modal-title mb-0 text-danger"><i class="bi bi-exclamation-triangle me-1"></i> Hapus <%= r.name %>?</h5>
        <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
      </div>
      <div class="modal-body km-package-modal__body">
        <p class="mb-3">Penghapusan Radius Manager bersifat permanen. Masukkan <strong>password login management</strong> untuk konfirmasi.</p>
        <div class="alert alert-warning py-2 small mb-3">
          <i class="bi bi-info-circle me-1"></i>
          Host: <code><%= r.host %></code> · POP <code><%= r.pop_code %></code>
        </div>
        <label class="form-label">Password konfirmasi</label>
        <input type="password" name="confirm_password" class="form-control" required autocomplete="current-password" placeholder="Password akun management Anda">
      </div>
      <div class="modal-footer km-package-modal__footer">
        <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Batal</button>
        <button type="submit" class="btn btn-danger"><i class="bi bi-trash me-1"></i> Hapus permanen</button>
      </div>
    </form>
  </div>
</div>

<% if (r.engine && r.engine.canRestore) { %>
<div class="modal fade km-modal" id="restoreRadiusModal-<%= r.id %>" tabindex="-1">
  <div class="modal-dialog modal-dialog-centered modal-lg modal-dialog-scrollable">
    <form method="POST" action="/management/pop/radius/<%= r.id %>/restore" enctype="multipart/form-data" class="modal-content km-package-modal" onsubmit="return confirm('Restore akan menimpa database RADIUS live dan merestart FreeRADIUS. Lanjutkan?');">
      <div class="modal-header km-package-modal__header">
        <h5 class="modal-title mb-0"><i class="bi bi-upload me-1"></i> Restore DB — <%= r.name %></h5>
        <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
      </div>
      <div class="modal-body km-package-modal__body">
        <div class="alert alert-warning py-2 small">
          <i class="bi bi-exclamation-triangle me-1"></i>
          Restore menimpa <strong>seluruh database RADIUS</strong> (user PPPoE, NAS, accounting) dari file backup <code>.tar.gz</code>.
        </div>
        <div class="mb-3">
          <label class="form-label">File backup (.tar.gz)</label>
          <input type="file" name="backupFile" class="form-control" accept=".tar.gz,.gz,application/gzip" required>
        </div>
        <div class="mb-3">
          <label class="form-label">Password konfirmasi</label>
          <input type="password" name="confirm_password" class="form-control" required autocomplete="current-password" placeholder="Password akun management Anda">
        </div>
        <% if (backupList.length) { %>
          <div class="km-rd-backup-list">
            <div class="km-rd-backup-list__head">Backup tersimpan di server</div>
            <ul class="list-unstyled mb-0">
              <% backupList.forEach(function(b) {
                const created = b.created || b.modified;
                const when = created ? new Date(created).toLocaleString('id-ID') : '—';
                const sizeMb = b.size ? (Number(b.size) / (1024 * 1024)).toFixed(1) + ' MB' : '—';
              %>
                <li>
                  <div>
                    <strong><%= b.fileName %></strong>
                    <small><%= when %> · <%= sizeMb %></small>
                  </div>
                  <a class="btn btn-sm btn-outline-secondary" href="/management/pop/radius/backups/<%= encodeURIComponent(b.fileName) %>">
                    <i class="bi bi-download"></i>
                  </a>
                </li>
              <% }); %>
            </ul>
          </div>
        <% } else { %>
          <p class="text-muted small mb-0">Belum ada file backup di server. Gunakan tombol Backup dulu, atau unggah file dari komputer Anda.</p>
        <% } %>
      </div>
      <div class="modal-footer km-package-modal__footer">
        <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Batal</button>
        <button type="submit" class="btn btn-info text-white"><i class="bi bi-upload me-1"></i> Restore sekarang</button>
      </div>
    </form>
  </div>
</div>
<% } %>
<% }); %>

<script>
(function () {
  const flash = document.getElementById('radiusTestFlash');
  function showFlash(ok, html) {
    if (!flash) return;
    flash.classList.remove('d-none', 'alert-success', 'alert-danger');
    flash.classList.add(ok ? 'alert-success' : 'alert-danger');
    flash.innerHTML = html;
    flash.scrollIntoView({ behavior: 'smooth', block: 'nearest' });
  }

  document.querySelectorAll('.js-radius-test').forEach(function (btn) {
    btn.addEventListener('click', async function () {
      const id = btn.getAttribute('data-id');
      const name = btn.getAttribute('data-name') || 'Radius';
      const prev = btn.innerHTML;
      btn.disabled = true;
      btn.innerHTML = '<span class="spinner-border spinner-border-sm me-1"></span> Testing…';
      try {
        const res = await fetch('/management/pop/radius/' + encodeURIComponent(id) + '/test', {
          method: 'POST',
          headers: { 'Accept': 'application/json', 'Content-Type': 'application/json' },
          credentials: 'same-origin',
          body: '{}'
        });
        const data = await res.json();
        const checks = Array.isArray(data.checks) ? data.checks : [];
        const lines = checks.map(function (c) {
          const icon = c.ok ? 'bi-check-circle-fill text-success' : 'bi-x-circle-fill text-danger';
          return '<li><i class="bi ' + icon + ' me-1"></i><strong>' + (c.name || '') + '</strong> — ' + (c.detail || '') + '</li>';
        }).join('');
        showFlash(Boolean(data.success),
          '<div class="fw-semibold mb-1">' + (data.message || ('Hasil tes ' + name)) + '</div>' +
          (lines ? '<ul class="mb-0 ps-3">' + lines + '</ul>' : '')
        );
      } catch (err) {
        showFlash(false, 'Gagal menjalankan tes: ' + (err && err.message ? err.message : err));
      } finally {
        btn.disabled = false;
        btn.innerHTML = prev;
      }
    });
  });
})();
</script>
