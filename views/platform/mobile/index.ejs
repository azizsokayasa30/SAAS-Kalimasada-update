<%- include('../partials/head', { title }) %>
<%- include('../partials/sidebar', { active: 'mobile-app', adminName }) %>
<main class="km-main km-mobile-build">
  <section class="km-mob-hero">
    <div class="km-mob-hero__main">
      <span class="km-mob-hero__icon"><i class="bi bi-phone"></i></span>
      <h2>Mobile App</h2>
    </div>
    <div class="km-mob-chips">
      <span class="km-mob-chip" id="readinessBadge"><i class="bi bi-hourglass-split"></i> Memuat…</span>
      <span class="km-mob-chip" id="flutterStatusBadge"><i class="bi bi-hourglass-split"></i> Flutter…</span>
      <span class="km-mob-chip d-none" id="keystoreStatusBadge"></span>
    </div>
  </section>

  <div class="km-inv-stats mb-4" id="mobileStatsRow">
    <div class="km-inv-stat km-inv-stat--blue">
      <div class="km-inv-stat__icon"><i class="bi bi-tag"></i></div>
      <div class="km-inv-stat__body">
        <div class="km-inv-stat__label">Versi Saat Ini</div>
        <div class="km-inv-stat__value" id="statVersion">—</div>
      </div>
    </div>
    <div class="km-inv-stat km-inv-stat--violet">
      <div class="km-inv-stat__icon"><i class="bi bi-hash"></i></div>
      <div class="km-inv-stat__body">
        <div class="km-inv-stat__label">Build Number</div>
        <div class="km-inv-stat__value" id="statBuild">—</div>
      </div>
    </div>
    <div class="km-inv-stat km-inv-stat--green">
      <div class="km-inv-stat__icon"><i class="bi bi-activity"></i></div>
      <div class="km-inv-stat__body">
        <div class="km-inv-stat__label">Status Build</div>
        <div class="km-inv-stat__value" id="statBuildStatus">—</div>
      </div>
    </div>
    <div class="km-inv-stat km-inv-stat--amber">
      <div class="km-inv-stat__icon"><i class="bi bi-box-seam"></i></div>
      <div class="km-inv-stat__body">
        <div class="km-inv-stat__label">APK Terbit</div>
        <div class="km-inv-stat__value" id="statApkCount">—</div>
      </div>
    </div>
  </div>

  <div class="row g-3 mb-3">
    <div class="col-xl-8">
      <form id="mobileBuildForm" class="km-card km-mob-form h-100">
        <div class="km-mob-card-head">
          <span class="km-mob-card-head__icon" style="--mob-color:#3b82f6"><i class="bi bi-sliders"></i></span>
          <h5>Konfigurasi Build</h5>
        </div>

        <div class="km-mob-section">
          <div class="row g-3">
            <div class="col-md-6">
              <label class="form-label" for="appName">Nama aplikasi</label>
              <input type="text" class="form-control" id="appName" name="app_name" maxlength="40" required>
            </div>
            <div class="col-md-3 col-6">
              <label class="form-label" for="versionName">Versi</label>
              <input type="text" class="form-control" id="versionName" name="version_name" placeholder="5.9.3" required>
            </div>
            <div class="col-md-3 col-6">
              <label class="form-label" for="versionCode">Build number</label>
              <input type="number" class="form-control" id="versionCode" name="version_code" min="1" step="1" required>
            </div>
            <div class="col-md-6">
              <label class="form-label" for="apiUrl">API URL</label>
              <input type="url" class="form-control" id="apiUrl" name="api_url" placeholder="https://mobile.kalimasada-app.com" required>
            </div>
            <div class="col-md-6">
              <label class="form-label" for="flutterPath">Path Flutter SDK</label>
              <input type="text" class="form-control" id="flutterPath" name="flutter_path" placeholder="public/mobile-app/flutter-sdk/bin/flutter">
            </div>
            <div class="col-12">
              <label class="form-label" for="releaseNotes">Catatan rilis</label>
              <textarea class="form-control" id="releaseNotes" name="release_notes" rows="3"></textarea>
            </div>
            <div class="col-12">
              <div class="form-check form-switch km-mob-switch">
                <input class="form-check-input" type="checkbox" role="switch" id="forceUpdate" name="force_update">
                <label class="form-check-label" for="forceUpdate"><strong>Wajib update</strong></label>
              </div>
            </div>
          </div>
        </div>

        <div class="km-mob-actions">
          <button type="button" class="btn btn-outline-danger" id="btnCancelBuild" disabled>
            <i class="bi bi-x-circle"></i> Batalkan build
          </button>
          <div class="km-mob-actions__main">
            <button type="submit" class="btn btn-outline-primary" id="btnSaveConfig">
              <i class="bi bi-save"></i> Simpan
            </button>
            <button type="button" class="btn btn-km-primary" id="btnBuildApk">
              <i class="bi bi-hammer"></i> Build APK Release
            </button>
          </div>
        </div>
      </form>
    </div>

    <div class="col-xl-4 d-flex flex-column gap-3">
      <div class="km-card">
        <div class="km-mob-card-head">
          <span class="km-mob-card-head__icon" style="--mob-color:#10b981"><i class="bi bi-clipboard-check"></i></span>
          <h5>Kesiapan Server</h5>
        </div>
        <div id="readinessPanel" class="km-mob-ready is-loading" role="status">
          <i class="bi bi-hourglass-split" id="readinessIcon" aria-hidden="true"></i>
          <div>
            <strong id="readinessText">Memuat…</strong>
            <span id="readinessCount"></span>
          </div>
        </div>
        <ul class="km-mob-checklist" id="readinessList"></ul>
        <div class="km-mob-ready-actions">
          <button type="button" class="btn btn-sm btn-warning d-none" id="btnBootstrapKeystore">
            <i class="bi bi-shield-plus"></i> Buat keystore
          </button>
          <button type="button" class="btn btn-sm btn-outline-warning d-none" id="btnAdoptKeystore">
            <i class="bi bi-shield-check"></i> Adopsi keystore ini
          </button>
        </div>
      </div>

      <div class="km-card">
        <div class="km-mob-card-head">
          <span class="km-mob-card-head__icon" style="--mob-color:#f59e0b"><i class="bi bi-link-45deg"></i></span>
          <h5>Endpoint OTA</h5>
        </div>
        <div class="km-mob-endpoint">
          <span>Manifest</span>
          <div><code id="otaManifestUrl">—</code><button type="button" class="km-mob-copy" data-copy-target="otaManifestUrl" title="Salin"><i class="bi bi-copy"></i></button></div>
        </div>
        <div class="km-mob-endpoint">
          <span>APK</span>
          <div><code id="otaApkUrl">Belum ada APK terbit</code><button type="button" class="km-mob-copy" data-copy-target="otaApkUrl" title="Salin"><i class="bi bi-copy"></i></button></div>
        </div>
      </div>
    </div>
  </div>

  <div class="km-card mb-3">
    <div class="km-mob-card-head km-mob-card-head--split">
      <div class="d-flex align-items-center gap-3">
        <span class="km-mob-card-head__icon" style="--mob-color:#8b5cf6"><i class="bi bi-terminal"></i></span>
        <h5>Progres &amp; Log Build</h5>
      </div>
      <button type="button" class="btn btn-sm btn-outline-secondary" id="btnClearLogView"><i class="bi bi-eraser"></i> Bersihkan log</button>
    </div>

    <div id="buildProgressPanel" class="km-build-progress mb-3">
      <div id="buildStatusHeadline" class="km-build-status is-idle">
        <i class="bi bi-hourglass-split"></i>
        <span id="buildStatusText">Siap build aplikasi</span>
      </div>
      <div class="progress" role="progressbar" aria-valuemin="0" aria-valuemax="100" aria-valuenow="0">
        <div id="buildProgressBar" class="progress-bar bg-secondary" style="width:0%">0%</div>
      </div>
      <div class="km-build-progress-meta">
        <span id="buildProgressPhase">Menunggu perintah build</span>
        <span id="buildProgressEta">—</span>
      </div>
      <div id="buildDownloadRow" class="d-none mt-2">
        <a id="btnDownloadLatestApk" class="btn btn-success btn-sm" href="#" download>
          <i class="bi bi-download me-1"></i>Unduh APK hasil build
        </a>
        <span id="buildDownloadSize" class="text-muted small ms-2"></span>
      </div>
    </div>

    <div id="buildLog" class="km-build-log text-muted">Belum ada log build.</div>
  </div>

  <div class="km-card">
    <div class="km-mob-card-head">
      <span class="km-mob-card-head__icon" style="--mob-color:#06b6d4"><i class="bi bi-archive"></i></span>
      <h5>APK di Server</h5>
    </div>
    <ul id="apkList" class="km-apk-list mb-0"><li class="km-apk-empty">Memuat…</li></ul>
  </div>
</main>
<%- include('../partials/footer') %>
<script src="/js/management-mobile-app.js?v=9"></script>
