<%- include('../partials/head', { title }) %>
<%- include('../partials/sidebar', { active, adminName }) %>
<%
  const monthFull = ['Januari','Februari','Maret','April','Mei','Juni','Juli','Agustus','September','Oktober','November','Desember'];
  const ps = String(invoice.period_start || '').slice(0, 7).split('-').map(Number);
  const periodLabel = ps[0] && ps[1] ? monthFull[ps[1] - 1] + ' ' + ps[0] : '-';

  const owner = invoice.ownerSnapshot || {};
  const items = Array.isArray(invoice.items) ? invoice.items : [];
  const pokok = Number(invoice.pokok_amount) || 0;
  const pajakTotal = (Number(invoice.tax_amount) || 0) + (Number(invoice.bhp_amount) || 0) + (Number(invoice.uso_amount) || 0);
  const fee = Number(invoice.management_fee_amount) || 0;
  const itemsSum = items.reduce(function (s, it) { return s + (Number(it.amount) || 0); }, 0);
  const totalTagihan = Number(invoice.total_amount) || itemsSum || (pokok + pajakTotal + fee);
  const tenantName = invoice.tenant_name || owner.tenant_name || '-';
  const ownerName = invoice.owner_name || owner.owner_name || '';
  const statusLabels = { draft: 'Draft', sent: 'Terkirim', paid: 'Lunas' };
  const statusIcons = { draft: 'bi-pencil-square', sent: 'bi-send-check', paid: 'bi-check-circle-fill' };
  const st = statusLabels[invoice.status] ? invoice.status : 'draft';
%>
<main class="km-main km-bbs-page">
  <div class="km-topbar">
    <div>
      <h2 class="km-set-title"><span class="km-set-title__icon"><i class="bi bi-receipt"></i></span>Invoice <%= invoice.invoice_number %></h2>
      <p class="km-subtitle"><%= tenantName %> · <%= periodLabel %></p>
    </div>
    <div class="d-flex gap-2 flex-wrap">
      <a href="<%= typeof backUrl !== 'undefined' && backUrl ? backUrl : '/management/finance/invoices' %>" class="btn btn-outline-secondary btn-sm"><i class="bi bi-arrow-left"></i> Kembali</a>
      <a href="/management/finance/invoices/<%= invoice.id %>/print" target="_blank" class="btn btn-km-primary btn-sm"><i class="bi bi-printer"></i> Cetak</a>
    </div>
  </div>

  <%- include('_nav', { financeSection }) %>

  <% if (flash && flash.success === 'created') { %><div class="alert alert-success">Invoice berhasil dibuat.</div><% } %>
  <% if (flash && flash.success === 'updated') { %><div class="alert alert-success">Status invoice diperbarui.</div><% } %>
  <% if (flash && flash.success === 'restored') { %><div class="alert alert-success">Backup finance berhasil di-restore.</div><% } %>
  <% if (flash && flash.error) { %><div class="alert alert-danger"><%= flash.error %></div><% } %>

  <div class="row g-3">
    <div class="col-xxl-8 col-xl-8">
      <div class="km-bbs-wrap">
        <%- include('_statement', { invoice }) %>
      </div>
    </div>

    <div class="col-xxl-4 col-xl-4">
      <div class="km-card km-bbs-side mb-3">
        <div class="km-bbs-side__head">
          <h5>Status Invoice</h5>
          <span class="km-inv-pill km-inv-pill--<%= st %>"><i class="bi <%= statusIcons[st] %>"></i> <%= statusLabels[st] %></span>
        </div>
        <form method="POST" action="/management/finance/invoices/<%= invoice.id %>/status" class="km-bbs-status">
          <% ['draft', 'sent', 'paid'].forEach(function (s) { %>
            <label class="km-bbs-status__opt km-bbs-status__opt--<%= s %>">
              <input type="radio" name="status" value="<%= s %>" <%= invoice.status === s ? 'checked' : '' %>>
              <span><i class="bi <%= statusIcons[s] %>"></i> <%= statusLabels[s] %></span>
            </label>
          <% }); %>
          <button type="submit" class="btn btn-km-primary btn-sm w-100 mt-2"><i class="bi bi-arrow-repeat"></i> Update Status</button>
        </form>
        <% if (invoice.status === 'draft') { %>
          <form method="POST" action="/management/finance/invoices/<%= invoice.id %>/delete" onsubmit="return confirm('Hapus invoice draft ini?')" class="mt-2">
            <button type="submit" class="btn btn-outline-danger btn-sm w-100"><i class="bi bi-trash"></i> Hapus Draft</button>
          </form>
        <% } %>
      </div>

      <div class="km-card km-bbs-side mb-3">
        <div class="km-bbs-side__head"><h5>Ringkasan Tagihan</h5></div>
        <ul class="km-bbs-sum">
          <li><span>Pokok</span><strong><%= formatRupiah(pokok) %></strong></li>
          <li><span>Pajak</span><strong><%= formatRupiah(pajakTotal) %></strong></li>
          <li><span>Mgmt Fee</span><strong><%= formatRupiah(fee) %></strong></li>
          <li class="is-total"><span>Total Tagihan</span><strong><%= formatRupiah(totalTagihan) %></strong></li>
        </ul>
      </div>

      <div class="km-card km-bbs-side">
        <div class="km-bbs-side__head"><h5>Pemilik Tenant</h5></div>
        <ul class="km-bbs-owner">
          <li><i class="bi bi-person"></i><span><%= ownerName || '-' %></span></li>
          <li><i class="bi bi-envelope"></i><span><%= invoice.owner_email || owner.owner_email || '-' %></span></li>
          <li><i class="bi bi-whatsapp"></i><span><%= invoice.owner_phone || owner.owner_phone || '-' %></span></li>
        </ul>
      </div>
    </div>
  </div>
</main>
<%- include('../partials/footer') %>
