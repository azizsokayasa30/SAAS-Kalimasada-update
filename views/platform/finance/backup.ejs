<%- include('../partials/head', { title }) %>
<%- include('../partials/sidebar', { active, adminName }) %>
<main class="km-main km-inv-page km-fin-page km-fin-page--backup">
  <div class="km-topbar">
    <div>
      <h2>Backup &amp; Restore</h2>
    </div>
    <a href="/management/finance/backup/download?return_to=<%= encodeURIComponent(typeof financeReturnTo !== 'undefined' ? financeReturnTo : '/management/finance/backup') %>" class="btn btn-km-primary btn-sm">
      <i class="bi bi-download"></i> Backup Sekarang
    </a>
  </div>

  <%- include('_nav', { financeSection }) %>

  <% if (flash && flash.success === 'restored') { %><div class="alert alert-success"><i class="bi bi-check-circle me-1"></i> Backup finance berhasil di-restore<%= flash.count ? ' (' + flash.count + ' invoice)' : '' %>.</div><% } %>
  <% if (flash && flash.error) { %><div class="alert alert-danger"><i class="bi bi-exclamation-triangle me-1"></i> <%= flash.error %></div><% } %>

  <%- include('_backup-restore') %>
</main>
<script src="/js/platform-finance.js?v=1"></script>
<%- include('../partials/footer') %>
