<%- include('../partials/head', { title }) %>
<%- include('../partials/sidebar', { active, adminName }) %>
<%
  const monthFull = ['Januari','Februari','Maret','April','Mei','Juni','Juli','Agustus','September','Oktober','November','Desember'];
  const periodLabel = monthFull[Number(filters.month) - 1] + ' ' + filters.year;
  const statusLabels = { draft: 'Draft', sent: 'Terkirim', paid: 'Lunas', none: 'Belum dibuat' };
  const statusIcons = { draft: 'bi-pencil-square', sent: 'bi-send', paid: 'bi-check-circle-fill', none: 'bi-hourglass-split' };
  const cy = new Date().getFullYear();
  const sRow = statementRow || null;
  const sInv = statementInvoice || null;
  const sStatus = sRow ? (sRow.has_invoice ? (sRow.status || 'draft') : 'none') : null;
  const locked = !!(sInv && sInv.status === 'paid');
  const company = (typeof platformCompany !== 'undefined' && platformCompany) || {};

  const fmtDate = function (v) {
    const p = String(v || '').slice(0, 10).split('-').map(Number);
    return p.length === 3 && p[0] ? p[2] + ' ' + monthFull[p[1] - 1] + ' ' + p[0] : '-';
  };
  const today = new Date();
  const todayIso = today.getFullYear() + '-' + String(today.getMonth() + 1).padStart(2, '0') + '-' + String(today.getDate()).padStart(2, '0');
  const fmtNum = function (n) { return Math.round(Number(n) || 0).toLocaleString('id-ID'); };

  const startRows = sInv && Array.isArray(sInv.items) && sInv.items.length
    ? sInv.items.map(function (it) { return { description: it.description || '', amount: Number(it.amount) || 0, item_type: it.item_type || 'pokok', qty: it.qty, unit_price: it.unit_price }; })
    : [{ description: '', amount: 0, item_type: 'pokok' }];
  const grandTotal = startRows.reduce(function (s, r) { return s + (Number(r.amount) || 0); }, 0);
  const formAction = sInv ? '/management/finance/invoices/' + sInv.id + '/update' : '/management/finance/invoices/create';
%>
<main class="km-main km-inv-page km-bbs-page">
  <div class="km-topbar">
    <div>
      <h2 class="km-set-title"><span class="km-set-title__icon"><i class="bi bi-receipt"></i></span>Invoice Tenant</h2>
    </div>
    <% if (sInv) { %>
      <a href="/management/finance/invoices/<%= sInv.id %>/print" target="_blank" class="btn btn-outline-primary btn-sm"><i class="bi bi-printer"></i> Cetak</a>
    <% } %>
  </div>

  <%- include('_nav', { financeSection }) %>

  <% if (flash && flash.success === 'created') { %><div class="alert alert-success"><i class="bi bi-check-circle me-1"></i> Invoice berhasil dibuat sebagai draft.</div><% } %>
  <% if (flash && flash.success === 'saved') { %><div class="alert alert-success"><i class="bi bi-check-circle me-1"></i> Perubahan invoice tersimpan.</div><% } %>
  <% if (flash && flash.success === 'updated') { %><div class="alert alert-success"><i class="bi bi-check-circle me-1"></i> Status invoice diperbarui.</div><% } %>
  <% if (flash && flash.success === 'deleted') { %><div class="alert alert-success"><i class="bi bi-trash me-1"></i> Invoice draft dihapus.</div><% } %>
  <% if (flash && flash.success === 'restored') { %><div class="alert alert-success"><i class="bi bi-arrow-counterclockwise me-1"></i> Backup finance berhasil di-restore.</div><% } %>
  <% if (flash && flash.error) { %><div class="alert alert-danger"><i class="bi bi-exclamation-triangle me-1"></i> <%= flash.error %></div><% } %>

  <%
    const pickYear = Number(filters.year) || cy;
    const yearFrom = Math.min(cy - 3, pickYear);
    const yearTo = Math.max(cy + 1, pickYear);
    const tName = sRow ? String(sRow.tenant_name || '-') : '';
    const tInitials = tName.split(/\s+/).filter(Boolean).slice(0, 2).map(function (w) { return w[0]; }).join('').toUpperCase() || 'T';
    const tHue = tName.split('').reduce(function (h, c) { return (h * 31 + c.charCodeAt(0)) % 360; }, 7);
    const tMeta = sRow ? [sRow.owner_name, sRow.subdomain].filter(Boolean).join(' · ') : '';
    const snap = (sInv && sInv.ownerSnapshot) || {};
    const tPhone = (sRow && (sRow.owner_phone || snap.owner_phone)) || '';
    const tEmail = (sRow && (sRow.owner_email || snap.owner_email)) || '';
    const tOwner = (sRow && (sRow.owner_name || snap.owner_name)) || '';
    const tHost = sRow && sRow.subdomain ? (sRow.subdomain + '.kalimasada-app.com') : '';
    const invDone = rows.filter(function (r) { return r.has_invoice; }).length;
    const invPct = rows.length ? Math.round(invDone / rows.length * 100) : 0;
  %>
  <form method="GET" class="km-card km-ipk mb-3" id="invoicePeriodForm">
    <div class="km-ipk__block km-ipk__period">
      <span class="km-ipk__icon km-ipk__icon--period"><i class="bi bi-calendar-week"></i></span>
      <div class="km-ipk__body">
        <span class="km-ipk__label">Periode Tagihan</span>
        <div class="km-ipk__stepper">
          <button type="button" class="km-ipk__nav js-period-step" data-step="-1" title="Bulan sebelumnya" aria-label="Bulan sebelumnya"><i class="bi bi-chevron-left"></i></button>
          <span class="km-ipk__select km-ipk__select--month">
            <select name="month" id="pickMonth" aria-label="Bulan">
              <% for (let m = 1; m <= 12; m++) { %>
                <option value="<%= m %>" <%= Number(filters.month) === m ? 'selected' : '' %>><%= monthFull[m-1] %></option>
              <% } %>
            </select>
          </span>
          <span class="km-ipk__select">
            <select name="year" id="pickYear" aria-label="Tahun">
              <% for (let y = yearFrom; y <= yearTo; y++) { %>
                <option value="<%= y %>" <%= pickYear === y ? 'selected' : '' %>><%= y %></option>
              <% } %>
            </select>
          </span>
          <button type="button" class="km-ipk__nav js-period-step" data-step="1" title="Bulan berikutnya" aria-label="Bulan berikutnya"><i class="bi bi-chevron-right"></i></button>
        </div>
      </div>
    </div>

    <label class="km-ipk__block km-ipk__tenant <%= rows.length ? '' : 'is-empty' %>" for="pickTenant">
      <% if (sRow) { %>
        <span class="km-ipk__avatar" style="--h: <%= tHue %>"><%= tInitials %></span>
      <% } else { %>
        <span class="km-ipk__icon km-ipk__icon--tenant"><i class="bi bi-buildings"></i></span>
      <% } %>
      <span class="km-ipk__body">
        <span class="km-ipk__label">Kepada</span>
        <strong class="km-ipk__name"><%= sRow ? tName : 'Belum ada tenant' %></strong>
        <span class="km-ipk__meta"><%= sRow ? (tMeta || 'Tenant') : 'Tambahkan tenant untuk membuat invoice' %></span>
      </span>
      <% if (rows.length > 1) { %>
        <span class="km-ipk__switch"><i class="bi bi-arrow-left-right"></i> Ganti</span>
      <% } %>
      <select name="view" id="pickTenant" class="km-ipk__overlay" <%= rows.length ? '' : 'disabled' %>>
        <% if (!rows.length) { %><option value="">Belum ada tenant</option><% } %>
        <% rows.forEach(function (r) {
             const st = r.has_invoice ? (r.status || 'draft') : 'none';
        %>
          <option value="<%= r.tenant_id %>" <%= sRow && String(sRow.tenant_id) === String(r.tenant_id) ? 'selected' : '' %>><%= r.tenant_name %> — <%= statusLabels[st] || st %></option>
        <% }); %>
      </select>
    </label>

    <% if (sStatus) { %>
      <div class="km-ipk__block km-ipk__aside">
        <span class="km-inv-pill km-inv-pill--<%= sStatus %>"><i class="bi <%= statusIcons[sStatus] %>"></i> <%= statusLabels[sStatus] %></span>
        <div class="km-ipk__progress" title="<%= invDone %> dari <%= rows.length %> tenant sudah dibuatkan invoice">
          <div class="km-ipk__progress-text"><strong><%= invDone %>/<%= rows.length %></strong> tenant ter-invoice</div>
          <div class="km-ipk__bar"><span style="width: <%= invPct %>%"></span></div>
        </div>
      </div>
    <% } %>
    <noscript><button type="submit" class="btn btn-km-primary btn-sm">Tampilkan</button></noscript>
  </form>

  <% if (!sRow) { %>
    <div class="km-card km-bbs-editor km-bbs-editor--empty">
      <i class="bi bi-buildings"></i>
      <strong>Belum ada tenant</strong>
      <span>Tambahkan tenant terlebih dahulu, lalu buat Branch Billing Statement di halaman ini.</span>
      <a href="/management/tenants/new" class="btn btn-km-primary btn-sm"><i class="bi bi-plus-lg"></i> Tambah Tenant</a>
    </div>
  <% } else { %>
  <div class="km-bbs-modebar <%= locked ? 'is-locked' : (sInv ? 'is-edit' : 'is-new') %>">
    <% if (locked) { %>
      <i class="bi bi-lock-fill"></i><span>Invoice sudah <strong>lunas</strong> — rincian dikunci dan tidak bisa diubah.</span>
    <% } else if (sInv) { %>
      <i class="bi bi-pencil-square"></i><span>Mengedit invoice <strong><%= sInv.invoice_number %></strong> — ubah keterangan atau jumlah, lalu klik <strong>Simpan Perubahan</strong>.</span>
    <% } else { %>
      <i class="bi bi-file-earmark-plus"></i><span>Invoice baru — isi baris tagihan, lalu klik <strong>Simpan Invoice</strong>.</span>
    <% } %>
  </div>

  <form method="POST" action="<%= formAction %>" class="km-card km-bbs-editor km-bbs-paper <%= locked ? 'is-locked' : '' %>" id="statementForm" novalidate>
    <input type="hidden" name="tenant_id" value="<%= sRow.tenant_id %>">
    <input type="hidden" name="period_start" value="<%= filters.startDate %>">
    <input type="hidden" name="period_end" value="<%= filters.endDate %>">

    <div class="km-bbs-paper__kop">
      <div class="km-bbs-paper__brand">
        <span class="km-bbs-paper__logo-wrap"><img class="km-bbs-paper__logo" src="<%= company.logo_path || '/img/logo.png' %>" alt="<%= company.company_name || 'PT Kalimasada Inti Sarana' %>" onerror="this.src='/img/logo.png'"></span>
        <div class="km-bbs-paper__label">Info Invoice</div>
        <dl class="km-bbs-facts km-bbs-facts--brand">
          <div><dt>No. Invoice</dt><dd><%= sInv ? sInv.invoice_number : 'Otomatis' %></dd></div>
          <div><dt>Periode</dt><dd><%= periodLabel %></dd></div>
          <div><dt>Tanggal</dt><dd><%= sInv ? fmtDate(sInv.created_at) : fmtDate(todayIso) %></dd></div>
        </dl>
      </div>
      <div class="km-bbs-paper__doc">
        <h3 class="km-bbs-paper__title">Branch Billing<br>Statement</h3>
        <div class="km-bbs-billto">
          <span class="km-bbs-billto__label">Ditagihkan kepada</span>
          <div class="km-bbs-billto__row">
            <span class="km-bbs-billto__avatar" style="--h: <%= tHue %>"><%= tInitials %></span>
            <div class="km-bbs-billto__who">
              <strong><%= sRow.tenant_name %></strong>
              <% if (tMeta) { %><small><%= tMeta %></small><% } %>
            </div>
          </div>
          <div class="km-bbs-billto__contact">
            <div class="km-bbs-paper__label">Rincian Kontak</div>
            <table class="km-bbs-paper__info">
              <tr><th>Phone</th><td>:</td><td><%= tPhone || '-' %></td></tr>
              <tr><th>Email</th><td>:</td><td><%= tEmail || '-' %></td></tr>
              <tr><th>Owner</th><td>:</td><td><%= tOwner || '-' %></td></tr>
              <% if (tHost) { %><tr><th>Host</th><td>:</td><td><%= tHost %></td></tr><% } %>
            </table>
          </div>
        </div>
      </div>
    </div>

    <div class="table-responsive">
      <table class="km-bbs-grid" id="statementTable">
        <thead>
          <tr>
            <th class="col-no">NO</th>
            <th>KETERANGAN</th>
            <th class="col-amt">JUMLAH</th>
            <% if (!locked) { %><th class="col-act"></th><% } %>
          </tr>
        </thead>
        <tbody id="statementBody">
          <% startRows.forEach(function (r, idx) { %>
            <tr class="js-line">
              <td class="col-no js-line-no"><%= idx + 1 %></td>
              <td>
                <input type="hidden" name="items[<%= idx %>][item_type]" value="<%= r.item_type %>" class="js-type">
                <% if (r.item_type === 'tax') { %>
                  <input type="hidden" name="items[<%= idx %>][qty]" value="<%= r.qty %>">
                  <input type="hidden" name="items[<%= idx %>][unit_price]" value="<%= r.unit_price %>">
                <% } %>
                <input type="text" name="items[<%= idx %>][description]" class="form-control form-control-sm js-desc" value="<%= r.description %>" placeholder="Contoh: Tagihan Fiberstar Oktober" <%= locked ? 'readonly' : '' %>>
              </td>
              <td class="col-amt">
                <div class="km-bbs-money">
                  <span>Rp</span>
                  <input type="text" name="items[<%= idx %>][amount]" class="form-control form-control-sm js-amount" value="<%= r.amount ? fmtNum(r.amount) : '' %>" inputmode="numeric" placeholder="0" <%= locked ? 'readonly' : '' %>>
                </div>
              </td>
              <% if (!locked) { %>
                <td class="col-act"><button type="button" class="km-bbs-del js-del" title="Hapus baris"><i class="bi bi-trash3"></i></button></td>
              <% } %>
            </tr>
          <% }); %>
        </tbody>
        <% if (!locked) { %>
          <tbody>
            <tr class="km-bbs-grid__add">
              <td colspan="4">
                <button type="button" class="km-bbs-addline" id="addLine"><i class="bi bi-plus-lg"></i> Tambah baris</button>
                <span class="km-bbs-grid__tip">atau tekan Enter di kolom jumlah</span>
              </td>
            </tr>
          </tbody>
        <% } %>
        <tfoot>
          <tr>
            <td colspan="2">GRAND TOTAL</td>
            <td class="col-amt" id="grandTotal">Rp <%= fmtNum(grandTotal) %></td>
            <% if (!locked) { %><td class="col-act"></td><% } %>
          </tr>
        </tfoot>
      </table>
    </div>

    <div class="km-bbs-paper__notes">
      <label for="stmtNotes">Catatan</label>
      <input type="text" name="notes" id="stmtNotes" class="form-control form-control-sm" value="<%= sInv && sInv.notes ? sInv.notes : '' %>" placeholder="<%= locked ? '-' : 'Tulis catatan untuk tenant (opsional)' %>" <%= locked ? 'readonly' : '' %>>
    </div>

    <div class="km-bbs-paper__bottom">
      <div class="km-bbs-paper__bank">
        <div><%= company.bank_name || 'BANK NEGARA INDONESIA' %></div>
        <div><span class="text-lowercase">a.n</span> : <%= company.bank_account_name || 'PT KALIMASADA INTI SARANA' %></div>
        <div><%= company.bank_account_number || '1743379325' %></div>
      </div>
      <div class="km-bbs-paper__sign">
        <div class="km-bbs-paper__role">Finance</div>
        <span class="km-bbs-paper__logo-wrap"><img src="<%= company.logo_path || '/img/logo.png' %>" alt="" onerror="this.parentNode.style.display='none'"></span>
        <div class="km-bbs-paper__company"><%= company.company_name || 'PT KALIMASADA INTI SARANA' %></div>
      </div>
    </div>
  </form>

  <div class="km-card km-bbs-actionbar">
    <% if (sInv) { %>
      <form method="POST" action="/management/finance/invoices/<%= sInv.id %>/status" class="km-bbs-actionbar__status">
        <input type="hidden" name="return_to" value="list">
        <span class="km-bbs-actionbar__label">Status</span>
        <div class="km-bbs-status">
          <% ['draft', 'sent', 'paid'].forEach(function (s) { %>
            <label class="km-bbs-status__opt km-bbs-status__opt--<%= s %>">
              <input type="radio" name="status" value="<%= s %>" <%= sInv.status === s ? 'checked' : '' %>>
              <span><i class="bi <%= statusIcons[s] %>"></i> <%= statusLabels[s] %></span>
            </label>
          <% }); %>
        </div>
        <button type="submit" class="btn btn-outline-secondary btn-sm"><i class="bi bi-arrow-repeat"></i> Update</button>
      </form>
    <% } else { %>
      <span class="km-bbs-actionbar__label"><i class="bi bi-info-circle"></i> Invoice tersimpan sebagai Draft, statusnya bisa diubah setelah disimpan.</span>
    <% } %>
    <div class="km-bbs-actionbar__buttons">
      <% if (sInv && sInv.status === 'draft') { %>
        <button type="submit" form="deleteDraftForm" class="btn btn-outline-danger btn-sm"><i class="bi bi-trash"></i> Hapus Draft</button>
      <% } %>
      <% if (!locked) { %>
        <button type="submit" form="statementForm" class="btn btn-km-primary"><i class="bi bi-check2-circle"></i> <%= sInv ? 'Simpan Perubahan' : 'Simpan Invoice' %></button>
      <% } %>
    </div>
  </div>
  <% if (sInv && sInv.status === 'draft') { %>
    <form method="POST" action="/management/finance/invoices/<%= sInv.id %>/delete" id="deleteDraftForm" class="d-none" onsubmit="return confirm('Hapus invoice draft ini?')"></form>
  <% } %>
  <% } %>

  <% if (rows.length) { %>
    <% const listQs = 'month=' + filters.month + '&year=' + filters.year; %>
    <div class="km-card km-card--flush km-inv-roster mt-3">
      <div class="km-inv-roster__head">
        <div>
          <h5>Daftar Invoice Tenant</h5>
          <p>Periode <%= periodLabel %></p>
        </div>
        <div class="km-inv-roster__stats">
          <span><strong><%= invDone %></strong> dibuat</span>
          <span><strong><%= rows.length - invDone %></strong> belum</span>
          <span><strong><%= rows.filter(function (x) { return x.has_invoice && x.status === 'paid'; }).length %></strong> lunas</span>
        </div>
      </div>
      <div class="table-responsive">
        <table class="km-inv-roster__table">
          <thead>
            <tr>
              <th class="col-no">No</th>
              <th>Tenant</th>
              <th>No. Invoice</th>
              <th>Status</th>
              <th class="col-amt">Total</th>
              <th class="col-paid">Pembayaran</th>
              <th class="col-act">Aksi</th>
            </tr>
          </thead>
          <tbody>
            <% rows.forEach(function (r, idx) {
                 const st = r.has_invoice ? (r.status || 'draft') : 'none';
                 const isPaid = st === 'paid';
                 const isDraft = st === 'draft';
                 const isActive = sRow && String(sRow.tenant_id) === String(r.tenant_id);
                 const editHref = '?' + listQs + '&view=' + encodeURIComponent(r.tenant_id);
                 const name = String(r.tenant_name || '-');
                 const initials = name.split(/\s+/).filter(Boolean).slice(0, 2).map(function (w) { return w[0]; }).join('').toUpperCase() || 'T';
                 const hue = name.split('').reduce(function (h, c) { return (h * 31 + c.charCodeAt(0)) % 360; }, 7);
            %>
              <tr class="<%= isActive ? 'is-active' : '' %> <%= isPaid ? 'is-paid' : '' %> <%= st === 'none' ? 'is-pending' : '' %>">
                <td class="col-no"><%= idx + 1 %></td>
                <td>
                  <div class="km-inv-roster__tenant">
                    <span class="km-inv-roster__avatar" style="--h: <%= hue %>"><%= initials %></span>
                    <div>
                      <strong><%= r.tenant_name %></strong>
                      <% if (r.owner_name) { %><small><%= r.owner_name %></small><% } %>
                    </div>
                  </div>
                </td>
                <td>
                  <% if (r.has_invoice && r.invoice_number) { %>
                    <span class="km-inv-roster__num"><%= r.invoice_number %></span>
                  <% } else { %>
                    <span class="km-inv-roster__dash">Belum ada</span>
                  <% } %>
                </td>
                <td>
                  <span class="km-inv-pill km-inv-pill--<%= st %>">
                    <i class="bi <%= statusIcons[st] || 'bi-circle' %>"></i>
                    <%= statusLabels[st] || st %>
                  </span>
                </td>
                <td class="col-amt">
                  <% if (r.has_invoice) { %>
                    <span class="km-inv-roster__money"><%= formatRupiah(r.total_amount) %></span>
                  <% } else { %>
                    <span class="km-inv-roster__dash">—</span>
                  <% } %>
                </td>
                <td class="col-paid">
                  <% if (!r.has_invoice) { %>
                    <span class="km-inv-roster__dash">—</span>
                  <% } else if (isPaid) { %>
                    <span class="km-inv-roster__pay km-inv-roster__pay--yes" title="Status sistem: lunas"><i class="bi bi-check-circle-fill"></i> Lunas</span>
                  <% } else { %>
                    <span class="km-inv-roster__pay km-inv-roster__pay--no" title="Status sistem: <%= statusLabels[st] || st %>"><i class="bi bi-clock-history"></i> Belum Lunas</span>
                  <% } %>
                </td>
                <td class="col-act">
                  <div class="km-inv-roster__actions" role="group" aria-label="Aksi invoice <%= r.tenant_name %>">
                    <% if (r.has_invoice) { %>
                      <a href="/management/finance/invoices/<%= r.invoice_id %>" class="km-inv-act km-inv-act--view" title="Lihat"><i class="bi bi-eye"></i><span>Lihat</span></a>
                      <% if (!isPaid) { %>
                        <form method="POST" action="/management/finance/invoices/<%= r.invoice_id %>/status" class="d-inline">
                          <input type="hidden" name="status" value="paid">
                          <input type="hidden" name="return_to" value="list">
                          <button type="submit" class="km-inv-act km-inv-act--paid" title="Tandai lunas" onclick="return confirm('Tandai invoice <%= r.invoice_number %> sebagai lunas?')"><i class="bi bi-check2-circle"></i><span>Lunas</span></button>
                        </form>
                        <a href="<%= editHref %>" class="km-inv-act km-inv-act--edit" title="Edit"><i class="bi bi-pencil-square"></i><span>Edit</span></a>
                      <% } else { %>
                        <button type="button" class="km-inv-act is-disabled" disabled title="Sudah lunas"><i class="bi bi-check2-circle"></i><span>Lunas</span></button>
                        <button type="button" class="km-inv-act is-disabled" disabled title="Invoice lunas terkunci"><i class="bi bi-pencil-square"></i><span>Edit</span></button>
                      <% } %>
                      <% if (isDraft) { %>
                        <form method="POST" action="/management/finance/invoices/<%= r.invoice_id %>/delete" class="d-inline">
                          <button type="submit" class="km-inv-act km-inv-act--del" title="Hapus" onclick="return confirm('Hapus invoice draft <%= r.invoice_number %>?')"><i class="bi bi-trash3"></i><span>Hapus</span></button>
                        </form>
                      <% } else { %>
                        <button type="button" class="km-inv-act is-disabled" disabled title="Hanya draft yang bisa dihapus"><i class="bi bi-trash3"></i><span>Hapus</span></button>
                      <% } %>
                    <% } else { %>
                      <button type="button" class="km-inv-act is-disabled" disabled title="Belum ada invoice"><i class="bi bi-eye"></i><span>Lihat</span></button>
                      <button type="button" class="km-inv-act is-disabled" disabled title="Belum ada invoice"><i class="bi bi-check2-circle"></i><span>Lunas</span></button>
                      <a href="<%= editHref %>" class="km-inv-act km-inv-act--edit" title="Buat invoice"><i class="bi bi-pencil-square"></i><span>Edit</span></a>
                      <button type="button" class="km-inv-act is-disabled" disabled title="Belum ada invoice"><i class="bi bi-trash3"></i><span>Hapus</span></button>
                    <% } %>
                  </div>
                </td>
              </tr>
            <% }); %>
          </tbody>
        </table>
      </div>
    </div>
  <% } %>
</main>
<script>
(function () {
  var periodForm = document.getElementById('invoicePeriodForm');
  if (periodForm) {
    periodForm.querySelectorAll('select').forEach(function (sel) {
      sel.addEventListener('change', function () { periodForm.submit(); });
    });
    var monthSel = document.getElementById('pickMonth');
    var yearSel = document.getElementById('pickYear');
    periodForm.querySelectorAll('.js-period-step').forEach(function (btn) {
      btn.addEventListener('click', function () {
        var idx = Number(yearSel.value) * 12 + Number(monthSel.value) - 1 + Number(btn.dataset.step);
        var y = Math.floor(idx / 12);
        if (!yearSel.querySelector('option[value="' + y + '"]')) {
          var opt = new Option(String(y), String(y));
          if (y < Number(yearSel.options[0].value)) yearSel.insertBefore(opt, yearSel.options[0]);
          else yearSel.appendChild(opt);
        }
        monthSel.value = String(idx % 12 + 1);
        yearSel.value = String(y);
        periodForm.submit();
      });
    });
  }

  var form = document.getElementById('statementForm');
  var body = document.getElementById('statementBody');
  if (!form || !body || form.classList.contains('is-locked')) return;

  var dirty = false;

  function digits(v) { return String(v || '').replace(/[^\d]/g, ''); }
  function fmt(n) { return (Number(n) || 0).toLocaleString('id-ID'); }

  function renumber() {
    var total = 0;
    body.querySelectorAll('.js-line').forEach(function (tr, idx) {
      tr.querySelector('.js-line-no').textContent = idx + 1;
      tr.querySelectorAll('[name]').forEach(function (input) {
        input.name = input.name.replace(/items\[\d+\]/, 'items[' + idx + ']');
      });
      total += Number(digits(tr.querySelector('.js-amount').value)) || 0;
    });
    document.getElementById('grandTotal').textContent = 'Rp ' + fmt(total);
  }

  function addLine(focus) {
    var idx = body.querySelectorAll('.js-line').length;
    var tr = document.createElement('tr');
    tr.className = 'js-line';
    tr.innerHTML =
      '<td class="col-no js-line-no"></td>' +
      '<td>' +
        '<input type="hidden" name="items[' + idx + '][item_type]" value="pokok" class="js-type">' +
        '<input type="text" name="items[' + idx + '][description]" class="form-control form-control-sm js-desc" placeholder="Keterangan tagihan">' +
      '</td>' +
      '<td class="col-amt"><div class="km-bbs-money"><span>Rp</span>' +
        '<input type="text" name="items[' + idx + '][amount]" class="form-control form-control-sm js-amount" inputmode="numeric" placeholder="0">' +
      '</div></td>' +
      '<td class="col-act"><button type="button" class="km-bbs-del js-del" title="Hapus baris"><i class="bi bi-trash3"></i></button></td>';
    body.appendChild(tr);
    renumber();
    if (focus) tr.querySelector('.js-desc').focus();
    return tr;
  }

  document.getElementById('addLine').addEventListener('click', function () { addLine(true); dirty = true; });

  body.addEventListener('click', function (e) {
    var btn = e.target.closest('.js-del');
    if (!btn) return;
    var tr = btn.closest('.js-line');
    if (body.querySelectorAll('.js-line').length === 1) {
      tr.querySelector('.js-desc').value = '';
      tr.querySelector('.js-amount').value = '';
    } else {
      tr.remove();
    }
    dirty = true;
    renumber();
  });

  body.addEventListener('input', function (e) {
    dirty = true;
    if (e.target.classList.contains('js-amount')) {
      var d = digits(e.target.value);
      e.target.value = d ? fmt(Number(d)) : '';
      renumber();
    }
  });

  body.addEventListener('keydown', function (e) {
    if (e.key !== 'Enter') return;
    e.preventDefault();
    var tr = e.target.closest('.js-line');
    if (e.target.classList.contains('js-desc')) {
      tr.querySelector('.js-amount').focus();
    } else if (e.target.classList.contains('js-amount')) {
      var next = tr.nextElementSibling;
      if (next) next.querySelector('.js-desc').focus();
      else addLine(true);
    }
  });

  form.addEventListener('submit', function (e) {
    var ok = 0;
    var problem = null;
    body.querySelectorAll('.js-line').forEach(function (tr) {
      var desc = tr.querySelector('.js-desc');
      var amt = Number(digits(tr.querySelector('.js-amount').value)) || 0;
      desc.classList.remove('is-invalid');
      if (amt && !desc.value.trim()) { desc.classList.add('is-invalid'); problem = problem || desc; }
      if (amt && desc.value.trim()) ok += 1;
    });
    if (problem) {
      e.preventDefault();
      alert('Keterangan wajib diisi untuk baris yang memiliki jumlah.');
      problem.focus();
      return;
    }
    if (!ok) {
      e.preventDefault();
      alert('Isi minimal satu baris tagihan dengan jumlah lebih dari 0.');
      var first = body.querySelector('.js-desc');
      if (first) first.focus();
      return;
    }
    renumber();
    dirty = false;
  });

  form.addEventListener('input', function () { dirty = true; });
  window.addEventListener('beforeunload', function (e) {
    if (!dirty) return;
    e.preventDefault();
    e.returnValue = '';
  });

  renumber();
})();
</script>
<%- include('../partials/footer') %>
