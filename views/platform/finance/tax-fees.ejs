<%- include('../partials/head', { title }) %>
<%- include('../partials/sidebar', { active, adminName }) %>
<%
  const totals = breakdown.reduce(function (acc, r) {
    acc.tx += Number(r.transaction_count) || 0;
    acc.gross += Number(r.gross) || 0;
    acc.tax += Number(r.tax) || 0;
    acc.bhp += Number(r.bhp_uso_amount) || 0;
    acc.fee += Number(r.management_fee_amount) || 0;
    acc.net += Number(r.net) || 0;
    return acc;
  }, { tx: 0, gross: 0, tax: 0, bhp: 0, fee: 0, net: 0 });
  const isFixed = settings.management_fee_type === 'fixed';
  const feeLabel = isFixed ? formatRupiah(settings.management_fee_value) + ' / tenant per bulan' : settings.management_fee_value + '%';
%>
<main class="km-main km-inv-page km-fin-page km-fin-page--tax">
  <div class="km-topbar">
    <div>
      <h2>Pajak &amp; Fee Management</h2>
    </div>
  </div>

  <%- include('_nav', { financeSection }) %>

  <% if (flash && flash.success === 'saved') { %><div class="alert alert-success"><i class="bi bi-check-circle me-1"></i> Pengaturan fee berhasil disimpan.</div><% } %>
  <% if (flash && flash.success === 'restored') { %><div class="alert alert-success"><i class="bi bi-arrow-counterclockwise me-1"></i> Backup finance berhasil di-restore.</div><% } %>
  <% if (flash && flash.error) { %><div class="alert alert-danger"><i class="bi bi-exclamation-triangle me-1"></i> <%= flash.error %></div><% } %>

  <form method="POST" action="/management/finance/tax-fees" class="km-card km-card--flush mb-3">
    <div class="km-fin-card-head">
      <div class="km-fin-card-head__title">
        <span class="km-fin-icon"><i class="bi bi-sliders"></i></span>
        <div>
          <h5>Pengaturan Rate Global</h5>
          <p>Berlaku untuk perhitungan pajak dan fee di semua tenant.</p>
        </div>
      </div>
    </div>
    <div class="km-fin-card-body">
      <div class="km-fin-settings">
        <div class="km-fin-setting">
          <label for="bhpUso"><i class="bi bi-broadcast"></i> BHP USO</label>
          <small>Kontribusi BHP Telekomunikasi &amp; USO</small>
          <div class="input-group input-group-sm">
            <input type="number" step="0.01" min="0" id="bhpUso" name="bhp_uso_rate" class="form-control" value="<%= settings.bhp_uso_rate %>" required>
            <span class="input-group-text">%</span>
          </div>
        </div>
        <div class="km-fin-setting">
          <label for="taxRate"><i class="bi bi-percent"></i> Default PPN</label>
          <small>Dipakai bila invoice tidak punya tarif pajak</small>
          <div class="input-group input-group-sm">
            <input type="number" step="0.01" min="0" id="taxRate" name="default_tax_rate" class="form-control" value="<%= settings.default_tax_rate %>" required>
            <span class="input-group-text">%</span>
          </div>
        </div>
        <div class="km-fin-setting">
          <label for="feeType"><i class="bi bi-diagram-3"></i> Tipe Management Fee</label>
          <small>Persentase dari gross atau nominal tetap</small>
          <select id="feeType" name="management_fee_type" class="form-select form-select-sm">
            <option value="percent" <%= !isFixed ? 'selected' : '' %>>Persen (%)</option>
            <option value="fixed" <%= isFixed ? 'selected' : '' %>>Nominal Tetap (Rp)</option>
          </select>
        </div>
        <div class="km-fin-setting">
          <label for="feeValue"><i class="bi bi-cash-stack"></i> Nilai Management Fee</label>
          <small>Saat ini: <%= feeLabel %></small>
          <div class="input-group input-group-sm">
            <span class="input-group-text js-fee-prefix <%= isFixed ? '' : 'd-none' %>">Rp</span>
            <input type="number" step="0.01" min="0" id="feeValue" name="management_fee_value" class="form-control" value="<%= settings.management_fee_value %>" required>
            <span class="input-group-text js-fee-suffix <%= isFixed ? 'd-none' : '' %>">%</span>
          </div>
        </div>
      </div>
      <div class="km-fin-settings__foot">
        <button type="submit" class="btn btn-km-primary btn-sm"><i class="bi bi-check-lg"></i> Simpan Pengaturan</button>
      </div>
    </div>
  </form>

  <%- include('_period-filter', { filters: { year: year }, yearOnly: true, extraSelects: [] }) %>

  <div class="km-inv-stats mb-3">
    <div class="km-inv-stat km-inv-stat--blue">
      <span class="km-inv-stat__icon"><i class="bi bi-cash-coin"></i></span>
      <div class="km-inv-stat__body">
        <div class="km-inv-stat__label">Total Gross</div>
        <div class="km-inv-stat__value"><%= formatRupiah(totals.gross) %></div>
        <div class="km-inv-stat__meta"><%= totals.tx %> transaksi · Tahun <%= year %></div>
      </div>
    </div>
    <div class="km-inv-stat km-inv-stat--violet">
      <span class="km-inv-stat__icon"><i class="bi bi-percent"></i></span>
      <div class="km-inv-stat__body">
        <div class="km-inv-stat__label">Total PPN</div>
        <div class="km-inv-stat__value"><%= formatRupiah(totals.tax) %></div>
        <div class="km-inv-stat__meta">Tarif default <%= settings.default_tax_rate %>%</div>
      </div>
    </div>
    <div class="km-inv-stat km-inv-stat--amber">
      <span class="km-inv-stat__icon"><i class="bi bi-broadcast"></i></span>
      <div class="km-inv-stat__body">
        <div class="km-inv-stat__label">Total BHP USO</div>
        <div class="km-inv-stat__value"><%= formatRupiah(totals.bhp) %></div>
        <div class="km-inv-stat__meta">Rate <%= settings.bhp_uso_rate %>%</div>
      </div>
    </div>
    <div class="km-inv-stat km-inv-stat--green">
      <span class="km-inv-stat__icon"><i class="bi bi-wallet2"></i></span>
      <div class="km-inv-stat__body">
        <div class="km-inv-stat__label">Total Management Fee</div>
        <div class="km-inv-stat__value"><%= formatRupiah(totals.fee) %></div>
        <div class="km-inv-stat__meta"><%= feeLabel %></div>
      </div>
    </div>
  </div>

  <div class="km-card km-card--flush">
    <div class="km-inv-list__head">
      <div>
        <h5>Rincian Pajak &amp; Fee per Bulan</h5>
        <p><%= breakdown.length %> baris pada tahun <%= year %></p>
      </div>
      <% if (breakdown.length) { %>
        <div class="km-inv-search">
          <i class="bi bi-search"></i>
          <input type="search" class="form-control form-control-sm" data-fin-search="#taxBody" placeholder="Cari tenant atau bulan…" autocomplete="off">
        </div>
      <% } %>
    </div>

    <% if (!breakdown.length) { %>
      <div class="km-inv-empty">
        <i class="bi bi-percent"></i>
        <strong>Belum ada transaksi di tahun <%= year %></strong>
        <span>Rincian pajak dan fee dihitung otomatis dari pembayaran gateway tenant.</span>
      </div>
    <% } else { %>
      <div class="table-responsive">
        <table class="table table-hover align-middle mb-0 km-tenant-table km-inv-table">
          <thead>
            <tr>
              <th>Bulan</th>
              <th>Tenant</th>
              <th class="text-end">Transaksi</th>
              <th class="text-end">Gross</th>
              <th class="text-end">PPN</th>
              <th class="text-end">BHP USO</th>
              <th class="text-end">Mgmt Fee</th>
              <th class="text-end">Net</th>
            </tr>
          </thead>
          <tbody id="taxBody">
            <% breakdown.forEach(function(row) {
                 const pm = String(row.period_month || '').split('-').map(Number);
                 const mName = pm[1] ? fin.MONTHS[pm[1] - 1] : '';
            %>
              <tr class="js-search-row" data-search="<%= [row.tenant_name, mName, pm[0]].filter(Boolean).join(' ').toLowerCase() %>">
                <td>
                  <% if (pm[1]) { %>
                    <div class="km-fin-date km-fin-date--wide" title="<%= mName %> <%= pm[0] %>">
                      <strong><%= fin.MONTHS_SHORT[pm[1] - 1] %></strong>
                      <span><%= pm[0] %></span>
                    </div>
                  <% } else { %><%= row.period_month %><% } %>
                </td>
                <td>
                  <div class="km-inv-tenant">
                    <span class="km-inv-avatar"><%= fin.initials(row.tenant_name) %></span>
                    <div class="km-fin-desc__title"><%= row.tenant_name %></div>
                  </div>
                </td>
                <td class="text-end km-fin-num"><%= row.transaction_count %></td>
                <td class="text-end km-fin-num"><%= formatRupiah(row.gross) %></td>
                <td class="text-end km-fin-num"><%= formatRupiah(row.tax) %></td>
                <td class="text-end km-fin-num"><%= formatRupiah(row.bhp_uso_amount) %></td>
                <td class="text-end km-fin-num"><%= formatRupiah(row.management_fee_amount) %></td>
                <td class="text-end"><span class="km-inv-total"><%= formatRupiah(row.net) %></span></td>
              </tr>
            <% }); %>
            <tr class="js-search-empty d-none">
              <td colspan="8"><div class="km-inv-empty py-4"><i class="bi bi-search"></i><strong>Tidak ditemukan</strong><span>Tidak ada baris yang cocok dengan pencarian.</span></div></td>
            </tr>
          </tbody>
          <tfoot>
            <tr class="km-inv-foot">
              <td colspan="2">Total Tahun <%= year %></td>
              <td class="text-end"><%= totals.tx %></td>
              <td class="text-end"><%= formatRupiah(totals.gross) %></td>
              <td class="text-end"><%= formatRupiah(totals.tax) %></td>
              <td class="text-end"><%= formatRupiah(totals.bhp) %></td>
              <td class="text-end"><%= formatRupiah(totals.fee) %></td>
              <td class="text-end"><%= formatRupiah(totals.net) %></td>
            </tr>
          </tfoot>
        </table>
      </div>
    <% } %>
  </div>
</main>
<script src="/js/platform-finance.js?v=1"></script>
<script>
  (function () {
    var type = document.getElementById('feeType');
    var prefix = document.querySelector('.js-fee-prefix');
    var suffix = document.querySelector('.js-fee-suffix');
    type.addEventListener('change', function () {
      var fixed = type.value === 'fixed';
      prefix.classList.toggle('d-none', !fixed);
      suffix.classList.toggle('d-none', fixed);
    });
  })();
</script>
<%- include('../partials/footer') %>
