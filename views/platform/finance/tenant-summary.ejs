<%- include('../partials/head', { title }) %>
<%- include('../partials/sidebar', { active, adminName }) %>
<main class="km-main">
  <div class="km-topbar">
    <div>
      <h2>Rekap Pembayaran Per Tenant</h2>
      <p class="km-subtitle">Total tagihan, status pelunasan, dan metode pembayaran (cash, transfer, payment gateway) per tenant</p>
    </div>
  </div>

  <%- include('_nav', { financeSection }) %>

  <% if (flash && flash.error) { %><div class="alert alert-danger"><%= flash.error %></div><% } %>
  <% if (flash && flash.success === 'restored') { %><div class="alert alert-success">Backup finance berhasil di-restore.</div><% } %>

  <div class="km-card mb-3">
    <form method="GET" class="row g-2 align-items-end">
      <div class="col-md-2">
        <label class="form-label small">Bulan</label>
        <select name="month" class="form-select form-select-sm">
          <% const monthNames = ['Jan','Feb','Mar','Apr','Mei','Jun','Jul','Agu','Sep','Okt','Nov','Des']; %>
          <% for (let m = 1; m <= 12; m++) { %>
            <option value="<%= m %>" <%= Number(filters.month) === m ? 'selected' : '' %>><%= monthNames[m-1] %></option>
          <% } %>
        </select>
      </div>
      <div class="col-md-2">
        <label class="form-label small">Tahun</label>
        <% const cy = new Date().getFullYear(); %>
        <select name="year" class="form-select form-select-sm">
          <% for (let y = cy - 3; y <= cy + 1; y++) { %>
            <option value="<%= y %>" <%= Number(filters.year) === y ? 'selected' : '' %>><%= y %></option>
          <% } %>
        </select>
      </div>
      <div class="col-md-2">
        <button type="submit" class="btn btn-km-primary btn-sm"><i class="bi bi-funnel me-1"></i> Filter</button>
      </div>
    </form>
  </div>

  <div class="km-card km-card--flush">
    <div class="table-responsive">
      <table class="table table-hover align-middle mb-0 km-tenant-table km-recap-table">
        <thead>
          <tr>
            <th>Tenant</th>
            <th class="text-end">Total Tagihan</th>
            <th class="text-end">Tagihan Belum Lunas</th>
            <th class="text-end">Tagihan Lunas</th>
            <th class="text-end">Lunas by Cash</th>
            <th class="text-end">Lunas by Transfer</th>
            <th class="text-end">Lunas by PG</th>
          </tr>
        </thead>
        <tbody>
          <% if (!summary.length) { %>
            <tr><td colspan="7" class="text-center py-4" style="color: var(--text-muted)">Tidak ada tenant pada periode ini.</td></tr>
          <% } %>
          <% summary.forEach(function(row) { %>
            <tr>
              <td>
                <div class="fw-semibold"><%= row.tenant_name %></div>
                <% if (row.owner_name) { %><div class="small" style="color: var(--text-muted)"><%= row.owner_name %></div><% } %>
              </td>
              <td class="km-metric-cell km-metric-cell--money"><%= formatRupiah(row.total_tagihan) %></td>
              <td class="km-metric-cell km-metric-cell--money km-metric-cell--warning"><%= formatRupiah(row.unpaid_amount) %></td>
              <td class="km-metric-cell km-metric-cell--money km-metric-cell--success"><%= formatRupiah(row.paid_amount) %></td>
              <td class="km-metric-cell km-metric-cell--money"><%= formatRupiah(row.paid_cash) %></td>
              <td class="km-metric-cell km-metric-cell--money km-metric-cell--accent"><%= formatRupiah(row.paid_transfer) %></td>
              <td class="km-metric-cell km-metric-cell--money"><%= formatRupiah(row.paid_pg) %></td>
            </tr>
          <% }); %>
        </tbody>
        <% if (summary.length) { %>
          <tfoot>
            <tr class="km-recap-table__summary">
              <td>Summary</td>
              <td class="km-metric-cell km-metric-cell--money"><%= formatRupiah(totals.total_tagihan) %></td>
              <td class="km-metric-cell km-metric-cell--money km-metric-cell--warning"><%= formatRupiah(totals.unpaid_amount) %></td>
              <td class="km-metric-cell km-metric-cell--money km-metric-cell--success"><%= formatRupiah(totals.paid_amount) %></td>
              <td class="km-metric-cell km-metric-cell--money"><%= formatRupiah(totals.paid_cash) %></td>
              <td class="km-metric-cell km-metric-cell--money km-metric-cell--accent"><%= formatRupiah(totals.paid_transfer) %></td>
              <td class="km-metric-cell km-metric-cell--money"><%= formatRupiah(totals.paid_pg) %></td>
            </tr>
          </tfoot>
        <% } %>
      </table>
    </div>
  </div>
</main>
<%- include('../partials/footer') %>
