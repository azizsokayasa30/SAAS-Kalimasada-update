<%- include('../partials/head', { title }) %>
<%- include('../partials/sidebar', { active, adminName }) %>
<%
  const periodLabel = fin.periodLabel(filters.month, filters.year);
  const gateways = ['midtrans', 'xendit', 'tripay', 'duitku'];
  const gatewayTone = { midtrans: 'blue', xendit: 'violet', tripay: 'teal', duitku: 'amber' };
  const successRate = summary.total ? Math.round(summary.successCount / summary.total * 100) : 0;
  const avg = summary.total ? summary.totalAmount / summary.total : 0;
  const pageQuery = function (page) {
    return '?page=' + page + '&month=' + filters.month + '&year=' + filters.year
      + '&tenant_id=' + encodeURIComponent(filters.tenantId || '') + '&gateway=' + encodeURIComponent(filters.gateway || '');
  };
  const firstRow = pagination.total ? (pagination.page - 1) * pagination.limit + 1 : 0;
  const lastRow = Math.min(pagination.page * pagination.limit, pagination.total);
%>
<main class="km-main km-inv-page km-fin-page">
  <div class="km-topbar">
    <div>
      <h2 class="km-set-title"><span class="km-set-title__icon"><i class="bi bi-credit-card-2-front"></i></span>Riwayat Pembayaran Gateway</h2>
    </div>
  </div>

  <%- include('_nav', { financeSection }) %>

  <% if (flash && flash.error) { %><div class="alert alert-danger"><i class="bi bi-exclamation-triangle me-1"></i> <%= flash.error %></div><% } %>
  <% if (flash && flash.success === 'restored') { %><div class="alert alert-success"><i class="bi bi-arrow-counterclockwise me-1"></i> Backup finance berhasil di-restore.</div><% } %>

  <%- include('_period-filter', {
    filters,
    yearOnly: false,
    extraSelects: [
      { name: 'tenant_id', label: 'Tenant', allLabel: 'Semua tenant', selected: filters.tenantId, wide: true, icon: 'bi-buildings',
        options: tenants.map(function (t) { return { value: t.id, label: t.name }; }) },
      { name: 'gateway', label: 'Gateway', allLabel: 'Semua gateway', selected: filters.gateway, icon: 'bi-credit-card-2-front',
        options: gateways.map(function (g) { return { value: g, label: g.charAt(0).toUpperCase() + g.slice(1) }; }) }
    ]
  }) %>

  <div class="km-inv-stats mb-3">
    <div class="km-inv-stat km-inv-stat--green">
      <span class="km-inv-stat__icon"><i class="bi bi-cash-coin"></i></span>
      <div class="km-inv-stat__body">
        <div class="km-inv-stat__label">Total Koleksi</div>
        <div class="km-inv-stat__value"><%= formatRupiah(summary.totalAmount) %></div>
        <div class="km-inv-stat__meta"><%= periodLabel %></div>
      </div>
    </div>
    <div class="km-inv-stat km-inv-stat--blue">
      <span class="km-inv-stat__icon"><i class="bi bi-receipt"></i></span>
      <div class="km-inv-stat__body">
        <div class="km-inv-stat__label">Jumlah Transaksi</div>
        <div class="km-inv-stat__value"><%= summary.total %> <small>transaksi</small></div>
        <div class="km-inv-stat__meta">Rata-rata <%= formatRupiah(avg) %></div>
      </div>
    </div>
    <div class="km-inv-stat km-inv-stat--violet">
      <span class="km-inv-stat__icon"><i class="bi bi-buildings"></i></span>
      <div class="km-inv-stat__body">
        <div class="km-inv-stat__label">Tenant Bertransaksi</div>
        <div class="km-inv-stat__value"><%= summary.tenantCount %> <small>tenant</small></div>
        <div class="km-inv-stat__meta">dari <%= tenants.length %> tenant aktif</div>
      </div>
    </div>
    <div class="km-inv-stat km-inv-stat--amber">
      <span class="km-inv-stat__icon"><i class="bi bi-patch-check"></i></span>
      <div class="km-inv-stat__body">
        <div class="km-inv-stat__label">Tingkat Berhasil</div>
        <div class="km-inv-stat__value"><%= summary.total ? successRate + '%' : '-' %></div>
        <div class="km-inv-progress"><span style="width: <%= successRate %>%"></span></div>
        <div class="km-inv-stat__meta"><%= summary.successCount %> dari <%= summary.total %> transaksi</div>
      </div>
    </div>
  </div>

  <div class="km-card km-card--flush">
    <div class="km-inv-list__head">
      <div>
        <h5>Daftar Pembayaran</h5>
        <p><%= pagination.total %> transaksi pada <%= periodLabel %></p>
      </div>
      <% if (payments.length) { %>
        <div class="km-inv-search">
          <i class="bi bi-search"></i>
          <input type="search" class="form-control form-control-sm" data-fin-search="#paymentBody" placeholder="Cari tenant, invoice, pelanggan…" autocomplete="off">
        </div>
      <% } %>
    </div>

    <% if (!payments.length) { %>
      <div class="km-inv-empty">
        <i class="bi bi-credit-card-2-front"></i>
        <strong>Belum ada pembayaran di <%= periodLabel %></strong>
        <span>Pembayaran online dari pelanggan tenant melalui payment gateway akan tampil di sini.</span>
      </div>
    <% } else { %>
      <div class="table-responsive">
        <table class="table table-hover align-middle mb-0 km-tenant-table km-inv-table">
          <thead>
            <tr>
              <th>Tanggal</th>
              <th>Tenant</th>
              <th>Invoice</th>
              <th>Gateway</th>
              <th class="text-end">Nominal</th>
              <th>Status</th>
            </tr>
          </thead>
          <tbody id="paymentBody">
            <% payments.forEach(function(p) {
                 const dp = fin.dateParts(p.payment_date);
                 const st = fin.paymentStatus(p.gateway_status);
                 const gw = String(p.gateway || '').toLowerCase();
            %>
              <tr class="js-search-row" data-search="<%= [p.tenant_name, p.subdomain, p.invoice_number, p.customer_name, p.gateway, p.order_id].filter(Boolean).join(' ').toLowerCase() %>">
                <td>
                  <% if (dp) { %>
                    <div class="km-fin-date" title="<%= fin.fullDate(p.payment_date) %><%= fin.timeOf(p.payment_date) ? ' ' + fin.timeOf(p.payment_date) : '' %>">
                      <strong><%= String(dp.d).padStart(2, '0') %></strong>
                      <span><%= fin.MONTHS_SHORT[dp.m - 1] %></span>
                    </div>
                  <% } else { %>-<% } %>
                </td>
                <td>
                  <div class="km-inv-tenant">
                    <span class="km-inv-avatar"><%= fin.initials(p.tenant_name) %></span>
                    <div>
                      <div class="km-fin-desc__title"><%= p.tenant_name %></div>
                      <div class="km-inv-sub"><%= p.subdomain %></div>
                    </div>
                  </div>
                </td>
                <td>
                  <span class="km-fin-code"><%= p.invoice_number %></span>
                  <div class="km-inv-sub mt-1"><i class="bi bi-person"></i> <%= p.customer_name %></div>
                </td>
                <td>
                  <span class="km-fin-cat km-fin-cat--plain km-fin-cat--<%= gatewayTone[gw] || 'slate' %>"><%= gw ? gw.charAt(0).toUpperCase() + gw.slice(1) : 'Online' %></span>
                  <% if (p.order_id) { %><div class="km-inv-sub mt-1" title="Order ID"><%= p.order_id %></div><% } %>
                </td>
                <td class="text-end"><span class="km-inv-total"><%= formatRupiah(p.amount) %></span></td>
                <td><span class="km-inv-pill km-inv-pill--<%= st.key === 'paid' ? 'paid' : (st.key === 'failed' ? 'failed' : 'none') %>"><i class="bi <%= st.icon %>"></i> <%= st.label %></span></td>
              </tr>
            <% }); %>
            <tr class="js-search-empty d-none">
              <td colspan="6"><div class="km-inv-empty py-4"><i class="bi bi-search"></i><strong>Tidak ditemukan</strong><span>Tidak ada pembayaran yang cocok dengan pencarian di halaman ini.</span></div></td>
            </tr>
          </tbody>
        </table>
      </div>
      <div class="km-fin-pager">
        <span>Menampilkan <%= firstRow %>–<%= lastRow %> dari <%= pagination.total %> transaksi</span>
        <% if (pagination.totalPages > 1) { %>
          <div class="km-fin-pager__nav">
            <a href="<%= pageQuery(pagination.page - 1) %>" class="km-fin-filter__nav <%= pagination.page > 1 ? '' : 'is-disabled' %>" aria-label="Halaman sebelumnya"><i class="bi bi-chevron-left"></i></a>
            <span><%= pagination.page %> / <%= pagination.totalPages %></span>
            <a href="<%= pageQuery(pagination.page + 1) %>" class="km-fin-filter__nav <%= pagination.page < pagination.totalPages ? '' : 'is-disabled' %>" aria-label="Halaman berikutnya"><i class="bi bi-chevron-right"></i></a>
          </div>
        <% } %>
      </div>
    <% } %>
  </div>
</main>
<script src="/js/platform-finance.js?v=3"></script>
<%- include('../partials/footer') %>
