<!DOCTYPE html>
<html lang="id">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= title %></title>
  <style>
    * { box-sizing: border-box; }
    body { font-family: Arial, Helvetica, sans-serif; font-size: 12px; color: #0f172a; margin: 0; background: #f1f5f9; }
    .sheet { max-width: 820px; margin: 24px auto; background: #fff; padding: 36px 40px; border-radius: 12px; box-shadow: 0 10px 30px rgba(15, 23, 42, 0.08); }
    .toolbar { max-width: 820px; margin: 16px auto 0; display: flex; justify-content: flex-end; gap: 8px; }
    .toolbar button { border: 0; border-radius: 8px; padding: 8px 16px; font-size: 13px; cursor: pointer; background: #2563eb; color: #fff; }
    .head { display: flex; justify-content: space-between; align-items: flex-start; gap: 24px; padding-bottom: 20px; border-bottom: 3px solid #2563eb; }
    .brand { display: flex; gap: 14px; align-items: center; }
    .brand img { width: 56px; height: 56px; object-fit: contain; }
    .brand h1 { font-size: 18px; margin: 0 0 4px; }
    .muted { color: #64748b; }
    .doc-title { text-align: right; }
    .doc-title h2 { margin: 0; font-size: 26px; letter-spacing: 0.08em; color: #2563eb; }
    .doc-title .number { font-size: 13px; font-weight: bold; margin-top: 4px; }
    .status { display: inline-block; margin-top: 8px; padding: 3px 10px; border-radius: 999px; font-size: 11px; font-weight: bold; text-transform: uppercase; letter-spacing: 0.06em; }
    .status--paid { background: #dcfce7; color: #166534; }
    .status--sent { background: #dbeafe; color: #1e40af; }
    .status--draft { background: #e2e8f0; color: #334155; }
    .meta { display: flex; justify-content: space-between; gap: 24px; margin: 22px 0; }
    .meta-box h4 { margin: 0 0 6px; font-size: 11px; text-transform: uppercase; letter-spacing: 0.08em; color: #64748b; }
    .meta-box p { margin: 0; line-height: 1.6; }
    .meta-box--right { text-align: right; }
    table { width: 100%; border-collapse: collapse; }
    thead th { background: #0f172a; color: #fff; font-size: 11px; text-transform: uppercase; letter-spacing: 0.05em; padding: 10px; text-align: left; }
    tbody td { padding: 10px; border-bottom: 1px solid #e2e8f0; }
    tbody tr:nth-child(even) td { background: #f8fafc; }
    .text-right { text-align: right; }
    .summary { display: flex; justify-content: flex-end; margin-top: 16px; }
    .summary table { width: 320px; }
    .summary td { padding: 6px 10px; border: 0; background: transparent !important; }
    .summary tr.grand td { border-top: 2px solid #0f172a; font-size: 15px; font-weight: bold; padding-top: 10px; }
    .notes { margin-top: 24px; padding: 12px 14px; border-radius: 8px; background: #f8fafc; border-left: 3px solid #2563eb; }
    .foot { margin-top: 32px; padding-top: 14px; border-top: 1px solid #e2e8f0; font-size: 11px; text-align: center; }
    @media print {
      body { background: #fff; }
      .sheet { box-shadow: none; margin: 0; max-width: none; padding: 0; }
      .no-print { display: none; }
      thead th { -webkit-print-color-adjust: exact; print-color-adjust: exact; }
    }
  </style>
</head>
<body>
  <%
    const pokok = Number(invoice.pokok_amount) || 0;
    const pajakTotal = (Number(invoice.tax_amount) || 0) + (Number(invoice.bhp_amount) || 0) + (Number(invoice.uso_amount) || 0);
    const fee = Number(invoice.management_fee_amount) || 0;
    const totalTagihan = Number(invoice.total_amount) || (pokok + pajakTotal + fee);
    const statusLabels = { draft: 'Draft', sent: 'Terkirim', paid: 'Lunas' };
    const owner = invoice.ownerSnapshot || {};
    const contact = [company.company_address, company.contact_email, company.contact_phone].filter(Boolean).join(' · ');
  %>
  <div class="toolbar no-print">
    <button type="button" onclick="window.print()">Cetak / Simpan PDF</button>
  </div>
  <div class="sheet">
    <div class="head">
      <div class="brand">
        <img src="<%= company.logo_path || '/img/logo.png' %>" alt="Logo">
        <div>
          <h1><%= company.company_name || 'Kalimasada' %></h1>
          <% if (contact) { %><div class="muted"><%= contact %></div><% } %>
        </div>
      </div>
      <div class="doc-title">
        <h2>INVOICE</h2>
        <div class="number"><%= invoice.invoice_number %></div>
        <span class="status status--<%= invoice.status %>"><%= statusLabels[invoice.status] || invoice.status %></span>
      </div>
    </div>

    <div class="meta">
      <div class="meta-box">
        <h4>Ditagihkan kepada</h4>
        <p>
          <strong><%= invoice.tenant_name || owner.tenant_name %></strong><br>
          <%= invoice.owner_name || owner.owner_name || '-' %><br>
          <% if (invoice.owner_email || owner.owner_email) { %><%= invoice.owner_email || owner.owner_email %><br><% } %>
          <% if (invoice.owner_phone || owner.owner_phone) { %><%= invoice.owner_phone || owner.owner_phone %><% } %>
        </p>
      </div>
      <div class="meta-box meta-box--right">
        <h4>Periode Tagihan</h4>
        <p>
          <%= invoice.period_start %> s/d <%= invoice.period_end %><br>
          <span class="muted">Dibuat: <%= String(invoice.created_at || '').slice(0, 10) || '-' %></span>
        </p>
      </div>
    </div>

    <table>
      <thead>
        <tr>
          <th>Item</th>
          <th class="text-right" style="width: 90px;">Qty</th>
          <th class="text-right" style="width: 150px;">Harga</th>
          <th class="text-right" style="width: 150px;">Jumlah</th>
        </tr>
      </thead>
      <tbody>
        <% invoice.items.forEach(function(item) { %>
          <tr>
            <td><%= item.description %></td>
            <td class="text-right">
              <% if (item.item_type === 'tax') { %>
                <%= String(item.qty).replace('.', ',') %>%
              <% } else { %>
                <%= Number(item.qty) || 1 %>
              <% } %>
            </td>
            <td class="text-right"><%= formatRupiah(item.unit_price || item.amount) %></td>
            <td class="text-right"><%= formatRupiah(item.amount) %></td>
          </tr>
        <% }); %>
      </tbody>
    </table>

    <div class="summary">
      <table>
        <tr><td>Pokok</td><td class="text-right"><%= formatRupiah(pokok) %></td></tr>
        <tr><td>Pajak</td><td class="text-right"><%= formatRupiah(pajakTotal) %></td></tr>
        <tr><td>Management Fee</td><td class="text-right"><%= formatRupiah(fee) %></td></tr>
        <tr class="grand"><td>Total Tagihan</td><td class="text-right"><%= formatRupiah(totalTagihan) %></td></tr>
      </table>
    </div>

    <% if (invoice.notes) { %>
      <div class="notes"><strong>Catatan:</strong> <%= invoice.notes %></div>
    <% } %>

    <div class="foot muted">Dokumen ini dibuat oleh Kalimasada Management Portal.</div>
  </div>
</body>
</html>
