<%- include('../partials/head', { title }) %>
<%- include('../partials/sidebar', { active: active || 'settings-mrtg', adminName }) %>
<main class="km-main km-set km-infra km-infra--mrtg">
  <%- include('../partials/infra-hero', {
    tab: 'mrtg',
    icon: 'bi-graph-up',
    heading: 'Pengaturan MRTG',
    desc: 'Pasangkan graph trafik dari NMS ke router tenant, lalu atur di mana graph tersebut ditampilkan.',
    chips: [
      { tone: 'info', icon: 'bi-plug', label: 'Data dari Pengaturan API' }
    ],
    actions: '<a href="/management/settings/api" class="btn btn-outline-secondary"><i class="bi bi-plug"></i> Koneksi API</a>'
  }) %>

  <div id="nmsPageAlert" class="alert d-none" role="status"></div>

  <%- include('../partials/infra-stats', { stats: [
    { tone: 'blue', icon: 'bi-hdd-network', label: 'Perangkat NMS', value: '…', attrs: 'data-ix-rows="#nmsDeviceBody"', meta: 'Siap dipasang' },
    { tone: 'cyan', icon: 'bi-link-45deg', label: 'Pemetaan', value: '…', attrs: 'data-ix-rows="#nmsBindingBody"', meta: 'Graph terpasang' },
    { tone: 'violet', icon: 'bi-buildings', label: 'Tenant Terhubung', value: '…', attrs: 'data-ix-unique="#nmsBindingBody" data-ix-col="0"', meta: 'Punya graph MRTG' }
  ] }) %>

  <div class="km-card mb-3">
    <div class="km-vpn-card__head"><h5><i class="bi bi-diagram-2"></i> Pasang Graph ke Tenant</h5></div>
    <form id="nmsBindingForm" class="row g-3">
      <div class="col-md-6 col-xl-3">
        <label class="form-label" for="nmsTenant"><span class="km-infra-step" aria-hidden="true">1</span>Tenant</label>
        <select id="nmsTenant" class="form-select" required>
          <option value="">Pilih tenant</option>
        </select>
      </div>
      <div class="col-md-6 col-xl-3">
        <label class="form-label" for="nmsRouter"><span class="km-infra-step" aria-hidden="true">2</span>Router <span class="text-muted small">(opsional)</span></label>
        <select id="nmsRouter" class="form-select" disabled>
          <option value="">Pilih tenant dulu</option>
        </select>
        <div class="form-text">Kosongkan jika router tenant belum terdaftar di billing.</div>
      </div>
      <div class="col-md-6 col-xl-3">
        <label class="form-label" for="nmsDevice"><span class="km-infra-step" aria-hidden="true">3</span>Perangkat NMS</label>
        <select id="nmsDevice" class="form-select" required>
          <option value="">Pilih perangkat</option>
        </select>
      </div>
      <div class="col-md-6 col-xl-3">
        <label class="form-label" for="nmsGraph"><span class="km-infra-step" aria-hidden="true">4</span>Graph / interface</label>
        <select id="nmsGraph" class="form-select" required disabled>
          <option value="">Pilih graph</option>
        </select>
      </div>
      <div class="col-12">
        <div class="km-infra-formbar mt-1">
          <div class="form-check form-switch">
            <input class="form-check-input" type="checkbox" role="switch" id="nmsShowManagement" checked>
            <label class="form-check-label" for="nmsShowManagement">Tampil di menu MRTG</label>
          </div>
          <div class="form-check form-switch">
            <input class="form-check-input" type="checkbox" role="switch" id="nmsShowTenant" checked>
            <label class="form-check-label" for="nmsShowTenant">Tampil di dashboard tenant</label>
          </div>
          <div class="km-infra-formbar__end">
            <button type="submit" class="btn btn-km-primary btn-sm px-3"><i class="bi bi-check-lg"></i> Simpan Pemetaan</button>
          </div>
        </div>
      </div>
    </form>
  </div>

  <div class="km-card mb-3">
    <div class="km-vpn-card__head">
      <h5><i class="bi bi-hdd-network"></i> Perangkat NMS</h5>
      <button type="button" class="btn btn-outline-secondary btn-sm" id="nmsReloadDevices"><i class="bi bi-arrow-clockwise me-1"></i> Muat ulang</button>
    </div>
    <div class="table-responsive" style="max-height: 280px;">
      <table class="table table-sm table-hover align-middle mb-0">
        <thead>
          <tr><th>Nama</th><th>IP</th><th>Lokasi</th><th></th></tr>
        </thead>
        <tbody id="nmsDeviceBody">
          <tr><td colspan="4" class="text-center text-muted py-4">Memuat perangkat…</td></tr>
        </tbody>
      </table>
    </div>
  </div>

  <div class="km-card km-card--flush">
    <div class="km-infra-panel-head">
      <h5><i class="bi bi-link-45deg"></i> Pemetaan Tersimpan</h5>
    </div>
    <div class="table-responsive">
      <table class="table table-hover align-middle mb-0">
        <thead>
          <tr>
            <th>Tenant</th>
            <th>Router</th>
            <th>Perangkat</th>
            <th>Graph</th>
            <th>Menu MRTG</th>
            <th>Dashboard tenant</th>
            <th class="text-end">Aksi</th>
          </tr>
        </thead>
        <tbody id="nmsBindingBody">
          <tr><td colspan="7" class="text-center text-muted py-4">Memuat pemetaan…</td></tr>
        </tbody>
      </table>
    </div>
  </div>
</main>
<script src="/js/management-nms.js?v=4"></script>
<script src="/js/infra-modern.js?v=1"></script>
<%- include('../partials/footer') %>
