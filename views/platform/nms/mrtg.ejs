<%- include('../partials/head', { title }) %>
<%- include('../partials/sidebar', { active: active || 'settings-mrtg', adminName }) %>
<main class="km-main km-set">
  <div class="km-topbar">
    <div>
      <h2 class="km-set-title"><span class="km-set-title__icon"><i class="bi bi-graph-up"></i></span>Pengaturan MRTG</h2>
    </div>
  </div>

  <div id="nmsPageAlert" class="alert d-none" role="status"></div>

  <div class="km-card mb-3">
    <div class="km-vpn-card__head"><h5><i class="bi bi-diagram-2"></i> Pasang Graph ke Tenant</h5></div>
    <form id="nmsBindingForm" class="row g-3">
      <div class="col-md-6 col-xl-3">
        <label class="form-label" for="nmsTenant">Tenant</label>
        <select id="nmsTenant" class="form-select" required>
          <option value="">Pilih tenant</option>
        </select>
      </div>
      <div class="col-md-6 col-xl-3">
        <label class="form-label" for="nmsRouter">Router</label>
        <select id="nmsRouter" class="form-select" required disabled>
          <option value="">Pilih router</option>
        </select>
      </div>
      <div class="col-md-6 col-xl-3">
        <label class="form-label" for="nmsDevice">Perangkat NMS</label>
        <select id="nmsDevice" class="form-select" required>
          <option value="">Pilih perangkat</option>
        </select>
      </div>
      <div class="col-md-6 col-xl-3">
        <label class="form-label" for="nmsGraph">Graph / interface</label>
        <select id="nmsGraph" class="form-select" required disabled>
          <option value="">Pilih graph</option>
        </select>
      </div>
      <div class="col-12">
        <div class="km-proxy-actions mt-0 align-items-center">
          <div class="form-check form-switch mb-0">
            <input class="form-check-input" type="checkbox" role="switch" id="nmsShowManagement" checked>
            <label class="form-check-label" for="nmsShowManagement">Tampil di menu MRTG</label>
          </div>
          <div class="form-check form-switch mb-0 ms-3">
            <input class="form-check-input" type="checkbox" role="switch" id="nmsShowTenant" checked>
            <label class="form-check-label" for="nmsShowTenant">Tampil di dashboard tenant</label>
          </div>
          <button type="submit" class="btn btn-km-primary btn-sm ms-auto"><i class="bi bi-check-lg me-1"></i> Simpan Pemetaan</button>
        </div>
      </div>
    </form>
  </div>

  <div class="km-card mb-3">
    <div class="km-vpn-card__head">
      <h5><i class="bi bi-hdd-network"></i> Perangkat NMS</h5>
      <button type="button" class="btn btn-outline-secondary btn-sm" id="nmsReloadDevices"><i class="bi bi-arrow-clockwise me-1"></i> Muat ulang</button>
    </div>
    <div class="table-responsive" style="max-height: 280px;">
      <table class="table table-sm table-hover align-middle mb-0">
        <thead>
          <tr><th>Nama</th><th>IP</th><th>Lokasi</th><th></th></tr>
        </thead>
        <tbody id="nmsDeviceBody">
          <tr><td colspan="4" class="text-center text-muted py-4">Memuat perangkat…</td></tr>
        </tbody>
      </table>
    </div>
  </div>

  <div class="km-card km-card--flush">
    <div class="km-vpn-card__head px-3 pt-3 mb-0">
      <h5><i class="bi bi-link-45deg"></i> Pemetaan Tersimpan</h5>
    </div>
    <div class="table-responsive">
      <table class="table table-hover align-middle mb-0">
        <thead>
          <tr>
            <th>Tenant</th>
            <th>Router</th>
            <th>Perangkat</th>
            <th>Graph</th>
            <th>Menu MRTG</th>
            <th>Dashboard tenant</th>
            <th class="text-end">Aksi</th>
          </tr>
        </thead>
        <tbody id="nmsBindingBody">
          <tr><td colspan="7" class="text-center text-muted py-4">Memuat pemetaan…</td></tr>
        </tbody>
      </table>
    </div>
  </div>
</main>
<script src="/js/management-nms.js?v=3"></script>
<%- include('../partials/footer') %>
