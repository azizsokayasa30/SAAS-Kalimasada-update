<%- include('../partials/head', { title }) %>
<%- include('../partials/sidebar', { active: active || 'settings-api', adminName }) %>
<main class="km-main km-set km-infra km-infra--api">
  <%- include('../partials/infra-hero', {
    tab: 'api',
    icon: 'bi-plug',
    heading: 'Pengaturan API',
    desc: 'Hubungkan billing dengan NMS untuk mengambil daftar perangkat dan graph monitoring.',
    chips: [
      { tone: 'info', icon: 'bi-hdd-network', label: 'Integrasi NMS' },
      { tone: 'info', icon: 'bi-graph-up', label: 'Sumber data MRTG' }
    ]
  }) %>

  <div id="nmsPageAlert" class="alert d-none" role="status"></div>

  <%- include('../partials/infra-stats', { stats: [
    { tone: 'slate', icon: 'bi-key', label: 'Token API', value: 'Memeriksa…', small: true, attrs: 'data-ix-mirror="#nmsTokenState"', meta: 'Status kredensial' },
    { tone: 'blue', icon: 'bi-hdd-network', label: 'Perangkat NMS', value: '…', attrs: 'data-ix-rows="#nmsDeviceBody"', meta: 'Terbaca dari NMS' },
    { tone: 'violet', icon: 'bi-stopwatch', label: 'Timeout', value: '—', small: true, attrs: 'data-ix-input="#nmsTimeout" data-ix-suffix=" ms"', meta: 'Batas waktu permintaan' }
  ] }) %>

  <div class="row g-3 mb-3">
    <div class="col-lg-5">
      <div class="km-card h-100">
        <div class="km-vpn-card__head">
          <h5><i class="bi bi-plug"></i> Koneksi API</h5>
          <span id="nmsTokenState" class="badge bg-secondary">Token belum dicek</span>
        </div>
        <form id="nmsConnectionForm" class="row g-3">
          <div class="col-12">
            <label class="form-label" for="nmsBaseUrl">Alamat NMS</label>
            <input id="nmsBaseUrl" name="baseUrl" class="form-control" placeholder="https://nms.kalimasada-app.com" required>
          </div>
          <div class="col-12">
            <label class="form-label" for="nmsToken">Token API</label>
            <input id="nmsToken" name="token" type="password" class="form-control" autocomplete="new-password" placeholder="Kosongkan jika tidak diubah">
          </div>
          <div class="col-sm-6">
            <label class="form-label" for="nmsTimeout">Timeout (ms)</label>
            <input id="nmsTimeout" name="timeoutMs" type="number" min="1000" max="20000" class="form-control" value="8000">
          </div>
          <div class="col-12">
            <div class="km-infra-formbar mt-0">
              <button type="submit" class="btn btn-km-primary btn-sm px-3"><i class="bi bi-check-lg"></i> Simpan</button>
              <button type="button" class="btn btn-outline-secondary btn-sm px-3" id="nmsTestBtn"><i class="bi bi-lightning-charge"></i> Uji koneksi</button>
              <span id="nmsTestResult" class="km-infra-formbar__hint w-100">Belum diuji.</span>
            </div>
          </div>
        </form>
      </div>
    </div>
    <div class="col-lg-7">
      <div class="km-card h-100">
        <div class="km-vpn-card__head">
          <h5><i class="bi bi-hdd-network"></i> Perangkat NMS</h5>
          <button type="button" class="btn btn-outline-secondary btn-sm" id="nmsReloadDevices"><i class="bi bi-arrow-clockwise me-1"></i> Muat ulang</button>
        </div>
        <div class="table-responsive" style="max-height: 320px;">
          <table class="table table-sm table-hover align-middle mb-0">
            <thead>
              <tr><th>Nama</th><th>IP</th><th>Lokasi</th><th></th></tr>
            </thead>
            <tbody id="nmsDeviceBody">
              <tr><td colspan="4" class="text-center text-muted py-4">Memuat perangkat…</td></tr>
            </tbody>
          </table>
        </div>
      </div>
    </div>
  </div>
</main>
<link rel="stylesheet" href="/css/nms-mrtg.css?v=5">
<script src="/js/management-nms.js?v=3"></script>
<script src="/js/infra-modern.js?v=1"></script>
<%- include('../partials/footer') %>
