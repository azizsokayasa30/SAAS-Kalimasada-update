<%
const activePkgs = packages.filter(function (p) { return p.is_active; });
const billingOnlyCount = packages.filter(function (p) { return p.billing_only === 1; }).length;
const prices = activePkgs.map(function (p) { return Number(p.price) || 0; }).filter(function (n) { return n > 0; });
const priceRange = prices.length
  ? (Math.min.apply(null, prices) === Math.max.apply(null, prices)
      ? formatRupiah(prices[0])
      : formatRupiah(Math.min.apply(null, prices)) + ' – ' + formatRupiah(Math.max.apply(null, prices)))
  : '—';
const fmtDateTime = function (v) {
  const d = new Date(v);
  return Number.isNaN(d.getTime()) ? '—' : d.toLocaleDateString('id-ID', { day: 'numeric', month: 'short', year: 'numeric' }) + ', ' + d.toLocaleTimeString('id-ID', { hour: '2-digit', minute: '2-digit' });
};
%>
<%- include('../partials/head', { title }) %>
<%- include('../partials/sidebar', { active, adminName }) %>
<main class="km-main km-set km-pkgs">
  <div class="km-sx-hero km-sx-hero--teal">
    <div class="km-sx-hero__main">
      <span class="km-sx-hero__icon"><i class="bi bi-box-seam"></i></span>
      <div>
        <div class="km-sx-hero__eyebrow">Pengaturan</div>
        <h2 class="km-sx-hero__title">Master Paket Internet</h2>
        <p class="km-sx-hero__desc">Daftar paket langganan yang bisa dipilih tenant: kecepatan, harga, PPN, dan profil PPPoE.</p>
      </div>
    </div>
    <div class="km-sx-hero__actions">
      <a href="#backup-restore" class="btn btn-outline-secondary px-3">
        <i class="bi bi-cloud-arrow-up me-1"></i> Backup &amp; Restore
      </a>
      <button type="button" class="btn btn-km-primary px-3" data-bs-toggle="modal" data-bs-target="#addMasterPackageModal">
        <i class="bi bi-plus-lg me-1"></i> Tambah Paket
      </button>
    </div>
  </div>

  <% if (flash && flash.success === 'created') { %><div class="alert alert-success alert-dismissible fade show km-sx-alert"><i class="bi bi-check-circle-fill"></i>Master paket berhasil ditambahkan.<button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Tutup"></button></div><% } %>
  <% if (flash && flash.success === 'updated') { %><div class="alert alert-success alert-dismissible fade show km-sx-alert"><i class="bi bi-check-circle-fill"></i>Master paket berhasil diperbarui.<button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Tutup"></button></div><% } %>
  <% if (flash && flash.success === 'deleted') { %><div class="alert alert-success alert-dismissible fade show km-sx-alert"><i class="bi bi-check-circle-fill"></i>Master paket dinonaktifkan.<button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Tutup"></button></div><% } %>
  <% if (flash && flash.success === 'restored') { %><div class="alert alert-success alert-dismissible fade show km-sx-alert"><i class="bi bi-check-circle-fill"></i>Backup berhasil di-restore (<%= flash.count || 0 %> paket).<button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Tutup"></button></div><% } %>
  <% if (flash && flash.error) { %><div class="alert alert-danger alert-dismissible fade show km-sx-alert"><i class="bi bi-exclamation-triangle-fill"></i><%= flash.error %><button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Tutup"></button></div><% } %>

  <div class="row g-3 mb-4">
    <div class="col-6 col-xl-3">
      <div class="km-card km-set-stat h-100">
        <span class="km-set-stat__icon km-tone-teal"><i class="bi bi-box-seam"></i></span>
        <div>
          <div class="km-set-stat__label">Total Paket</div>
          <div class="km-set-stat__value"><%= packages.length %></div>
          <div class="km-set-stat__sub">Terdaftar</div>
        </div>
      </div>
    </div>
    <div class="col-6 col-xl-3">
      <div class="km-card km-set-stat h-100">
        <span class="km-set-stat__icon km-tone-green"><i class="bi bi-check2-circle"></i></span>
        <div>
          <div class="km-set-stat__label">Aktif</div>
          <div class="km-set-stat__value"><%= activePkgs.length %></div>
          <div class="km-set-stat__sub">Bisa dipilih tenant</div>
        </div>
      </div>
    </div>
    <div class="col-6 col-xl-3">
      <div class="km-card km-set-stat h-100">
        <span class="km-set-stat__icon km-tone-cyan"><i class="bi bi-receipt"></i></span>
        <div>
          <div class="km-set-stat__label">Billing Only</div>
          <div class="km-set-stat__value"><%= billingOnlyCount %></div>
          <div class="km-set-stat__sub">Tanpa jaringan</div>
        </div>
      </div>
    </div>
    <div class="col-6 col-xl-3">
      <div class="km-card km-set-stat h-100">
        <span class="km-set-stat__icon km-tone-orange"><i class="bi bi-cash-stack"></i></span>
        <div>
          <div class="km-set-stat__label">Rentang Harga</div>
          <div class="km-set-stat__value km-pkgs-range"><%= priceRange %></div>
          <div class="km-set-stat__sub">Paket aktif</div>
        </div>
      </div>
    </div>
  </div>

  <div class="km-card km-card--flush">
    <div class="km-users-toolbar">
      <div>
        <h5 class="km-users-toolbar__title">Daftar Paket</h5>
        <div class="km-users-toolbar__sub"><%= packages.length %> paket · <%= activePkgs.length %> aktif</div>
      </div>
    </div>
    <% if (!packages.length) { %>
      <div class="km-sx-empty">
        <span class="km-sx-empty__icon km-sx-empty__icon--teal"><i class="bi bi-box-seam"></i></span>
        <h4 class="km-sx-empty__title">Belum ada master paket</h4>
        <p class="km-sx-empty__text">Buat paket pertama agar tenant bisa memilih paket langganan internet. Anda juga bisa memulihkan dari file backup.</p>
        <div class="d-flex flex-wrap justify-content-center gap-2">
          <button type="button" class="btn btn-km-primary px-3" data-bs-toggle="modal" data-bs-target="#addMasterPackageModal"><i class="bi bi-plus-lg me-1"></i> Tambah Paket Pertama</button>
          <a href="#backup-restore" class="btn btn-outline-secondary px-3"><i class="bi bi-arrow-counterclockwise me-1"></i> Restore dari Backup</a>
        </div>
      </div>
    <% } else { %>
    <div class="table-responsive">
      <table class="table table-hover align-middle mb-0 km-tenant-table km-pkgs-table">
        <thead>
          <tr>
            <th>Paket</th>
            <th class="d-none d-md-table-cell">Tipe</th>
            <th class="text-end">Harga</th>
            <th class="text-end d-none d-lg-table-cell">PPN</th>
            <th class="d-none d-xl-table-cell">Profil PPPoE</th>
            <th>Status</th>
            <th class="text-end">Aksi</th>
          </tr>
        </thead>
        <tbody>
          <% packages.forEach(function(pkg) {
            const billingOnly = pkg.billing_only === 1;
            const hasTax = pkg.tax_rate && Number(pkg.tax_rate) !== 0;
          %>
            <tr class="<%= pkg.is_active ? '' : 'km-pkgs-row--off' %>">
              <td>
                <div class="km-pkgs-name">
                  <span class="km-pkgs-name__icon <%= billingOnly ? 'km-tone-cyan' : 'km-tone-teal' %>"><i class="bi <%= billingOnly ? 'bi-receipt' : 'bi-wifi' %>"></i></span>
                  <div class="min-w-0">
                    <div class="fw-semibold"><%= pkg.name %></div>
                    <div class="km-pkgs-speed"><i class="bi bi-speedometer2"></i><%= pkg.speed || '—' %></div>
                  </div>
                </div>
              </td>
              <td class="d-none d-md-table-cell">
                <% if (billingOnly) { %>
                  <span class="km-logs-badge km-logs-badge--cyan"><i class="bi bi-receipt"></i>Billing only</span>
                <% } else { %>
                  <span class="km-logs-badge km-logs-badge--blue"><i class="bi bi-hdd-network"></i>PPPoE + IP Statik</span>
                <% } %>
              </td>
              <td class="text-end">
                <div class="km-pkgs-price"><%= formatRupiah(pkg.price) %></div>
                <% if (hasTax) { %><div class="km-pkgs-price-sub d-lg-none">+ PPN <%= pkg.tax_rate %>%</div><% } %>
              </td>
              <td class="text-end d-none d-lg-table-cell">
                <% if (hasTax) { %><span class="km-pkgs-tax"><%= pkg.tax_rate %>%</span><% } else { %><span class="text-muted small">Tanpa PPN</span><% } %>
              </td>
              <td class="d-none d-xl-table-cell"><% if (billingOnly) { %><span class="text-muted">—</span><% } else { %><code class="km-pkgs-profile"><%= pkg.pppoe_profile || 'default' %></code><% } %></td>
              <td>
                <% if (pkg.is_active) { %><span class="km-users-status km-users-status--on">Aktif</span>
                <% } else { %><span class="km-users-status km-users-status--off">Nonaktif</span><% } %>
              </td>
              <td class="text-end">
                <div class="km-sx-iconbtns">
                  <button type="button" class="btn btn-sm btn-outline-primary" data-bs-toggle="modal" data-bs-target="#editMasterPackageModal-<%= pkg.id %>" title="Edit paket" aria-label="Edit <%= pkg.name %>">
                    <i class="bi bi-pencil"></i>
                  </button>
                  <% if (pkg.is_active) { %>
                    <form method="POST" action="<%= basePath %>/<%= pkg.id %>/delete" class="d-inline" onsubmit="return confirm('Nonaktifkan paket ini? Tenant yang memilih akan ikut dinonaktifkan.')">
                      <button type="submit" class="btn btn-sm btn-outline-danger" title="Nonaktifkan paket" aria-label="Nonaktifkan <%= pkg.name %>"><i class="bi bi-trash"></i></button>
                    </form>
                  <% } %>
                </div>
              </td>
            </tr>
          <% }); %>
        </tbody>
      </table>
    </div>
    <% } %>
  </div>

  <section class="km-card km-sx-section mt-4" id="backup-restore">
    <header class="km-sx-section__head">
      <span class="km-sx-section__icon km-tone-blue"><i class="bi bi-cloud-arrow-up"></i></span>
      <div>
        <h3 class="km-sx-section__title">Backup &amp; Restore Master Paket</h3>
        <p class="km-sx-section__sub">Simpan salinan daftar paket dalam file JSON, atau pulihkan dari file sebelumnya.</p>
      </div>
      <div class="km-sx-section__aside">
        <a href="<%= basePath %>/backup/download" class="btn btn-km-primary px-3">
          <i class="bi bi-download me-1"></i> Backup Sekarang
        </a>
      </div>
    </header>
    <div class="km-sx-section__body">
      <div class="row g-4">
        <div class="col-lg-5">
          <form method="POST" action="<%= basePath %>/backup/restore" enctype="multipart/form-data" class="km-sx-restore">
            <label class="km-sx-drop">
              <input type="file" name="backup_file" accept=".json,application/json" required>
              <span class="km-sx-drop__icon"><i class="bi bi-filetype-json"></i></span>
              <span class="km-sx-drop__title">Tarik file ke sini atau <u>pilih file</u></span>
              <span class="km-sx-drop__sub">Format .json hasil backup master paket</span>
              <span class="km-sx-drop__file"><i class="bi bi-file-earmark-check"></i><span></span></span>
            </label>
            <div>
              <label class="form-label" for="pkgRestoreMode">Mode restore</label>
              <select name="mode" id="pkgRestoreMode" class="form-select">
                <option value="replace">Ganti semua</option>
                <option value="merge">Gabung</option>
              </select>
              <small class="km-sx-hint" id="pkgRestoreHint">Paket yang tidak ada di file backup akan dinonaktifkan.</small>
            </div>
            <button type="submit" class="btn btn-outline-primary w-100" onclick="return confirm('Restore akan menimpa data master paket. Cadangan otomatis dibuat sebelum restore. Lanjutkan?')">
              <i class="bi bi-arrow-counterclockwise me-1"></i> Restore dari File
            </button>
          </form>
        </div>
        <div class="col-lg-7">
          <div class="km-sx-subhead"><i class="bi bi-clock-history"></i> Riwayat Backup di Server</div>
          <% if (!backups || !backups.length) { %>
            <div class="km-sx-empty km-sx-empty--sm km-sx-boxed">
              <span class="km-sx-empty__icon"><i class="bi bi-inbox"></i></span>
              <h4 class="km-sx-empty__title">Belum ada backup</h4>
              <p class="km-sx-empty__text mb-0">Tekan <strong>Backup Sekarang</strong> untuk membuat salinan pertama.</p>
            </div>
          <% } else { %>
            <div class="km-sx-filelist">
              <% (backups || []).forEach(function(b) { %>
                <div class="km-sx-filelist__row">
                  <div class="km-sx-file">
                    <span class="km-sx-file__icon km-tone-blue"><i class="bi bi-filetype-json"></i></span>
                    <div class="min-w-0">
                      <div class="km-sx-file__name"><%= b.filename %></div>
                      <div class="km-sx-file__meta"><%= fmtDateTime(b.created_at) %> · <%= (b.size / 1024).toFixed(1) %> KB</div>
                    </div>
                  </div>
                  <div class="km-sx-iconbtns">
                    <a href="<%= basePath %>/backup/file/<%= encodeURIComponent(b.filename) %>" class="btn btn-sm btn-outline-secondary" title="Unduh" aria-label="Unduh <%= b.filename %>">
                      <i class="bi bi-download"></i>
                    </a>
                    <form method="POST" action="<%= basePath %>/backup/restore/<%= encodeURIComponent(b.filename) %>" class="d-inline">
                      <input type="hidden" name="mode" value="replace">
                      <button type="submit" class="btn btn-sm btn-outline-success" title="Restore" aria-label="Restore <%= b.filename %>" onclick="return confirm('Restore dari <%= b.filename %>? Cadangan otomatis dibuat sebelum restore.')">
                        <i class="bi bi-arrow-counterclockwise"></i>
                      </button>
                    </form>
                  </div>
                </div>
              <% }); %>
            </div>
          <% } %>
        </div>
      </div>
    </div>
  </section>
</main>

<!-- Modal Tambah -->
<div class="modal fade km-modal km-package-modal-wrap" id="addMasterPackageModal" tabindex="-1" aria-hidden="true">
  <div class="modal-dialog modal-dialog-centered modal-dialog-scrollable">
    <form method="POST" action="<%= basePath %>" class="modal-content km-package-modal">
      <%- include('_form-fields', { prefix: 'add', pkg: {} }) %>
    </form>
  </div>
</div>

<% packages.forEach(function(pkg) { %>
<div class="modal fade km-modal km-package-modal-wrap" id="editMasterPackageModal-<%= pkg.id %>" tabindex="-1" aria-hidden="true">
  <div class="modal-dialog modal-dialog-centered modal-dialog-scrollable">
    <form method="POST" action="<%= basePath %>/<%= pkg.id %>" class="modal-content km-package-modal">
      <%- include('_form-fields', { prefix: 'edit-' + pkg.id, pkg: pkg }) %>
    </form>
  </div>
</div>
<% }); %>

<script>
(function () {
  function setPpnState(prefix, enabled) {
    var rateInput = document.getElementById('taxRate-' + prefix);
    var hint = document.querySelector('.km-ppn-hint-' + prefix);
    var priceLabel = document.querySelector('.km-ppn-price-label-' + prefix);
    var ppnBox = document.getElementById('ppnBox-' + prefix);
    if (!rateInput) return;
    rateInput.disabled = !enabled;
    if (ppnBox) ppnBox.classList.toggle('km-ppn-box--off', !enabled);
    if (enabled) {
      if (!rateInput.value || Number(rateInput.value) === 0) rateInput.value = '11';
      if (hint) hint.style.display = 'none';
      if (priceLabel) priceLabel.textContent = 'Harga (sebelum PPN)';
    } else {
      if (hint) hint.style.display = '';
      if (priceLabel) priceLabel.textContent = 'Harga';
    }
  }

  function setBillingOnlyState(prefix, billingOnly) {
    var section = document.getElementById('networkSection-' + prefix);
    var pppoe = document.getElementById('pppoeProfile-' + prefix);
    if (section) section.classList.toggle('km-form-section--dimmed', billingOnly);
    if (section) {
      section.querySelectorAll('input').forEach(function (inp) {
        if (inp.name === 'upload_limit' || inp.name === 'download_limit' || inp.name === 'pppoe_profile') {
          inp.disabled = billingOnly;
        }
      });
    }
    if (pppoe) pppoe.disabled = billingOnly;
  }

  var restoreMode = document.getElementById('pkgRestoreMode');
  var restoreHint = document.getElementById('pkgRestoreHint');
  if (restoreMode && restoreHint) {
    restoreMode.addEventListener('change', function () {
      restoreHint.textContent = restoreMode.value === 'merge'
        ? 'Paket dari file ditambahkan atau diperbarui. Paket lain tetap seperti sekarang.'
        : 'Paket yang tidak ada di file backup akan dinonaktifkan.';
    });
  }

  document.querySelectorAll('.km-ppn-switch').forEach(function (sw) {
    var prefix = sw.getAttribute('data-prefix');
    setPpnState(prefix, sw.checked);
    sw.addEventListener('change', function () { setPpnState(prefix, sw.checked); });
  });

  document.querySelectorAll('[id^="billingOnly-"]').forEach(function (cb) {
    var prefix = cb.getAttribute('data-prefix');
    if (!prefix) return;
    setBillingOnlyState(prefix, cb.checked);
    cb.addEventListener('change', function () { setBillingOnlyState(prefix, cb.checked); });
  });

  document.querySelectorAll('form.km-package-modal').forEach(function (form) {
    form.addEventListener('submit', function () {
      form.querySelectorAll('.km-ppn-switch').forEach(function (sw) {
        var prefix = sw.getAttribute('data-prefix');
        var rateInput = document.getElementById('taxRate-' + prefix);
        if (!rateInput) return;
        if (!sw.checked) {
          rateInput.disabled = false;
          rateInput.value = '0';
        } else if (!rateInput.value) {
          rateInput.value = '11';
        }
      });
      form.querySelectorAll('[id^="billingOnly-"]:checked').forEach(function (cb) {
        var section = document.getElementById('networkSection-' + cb.getAttribute('data-prefix'));
        if (section) section.querySelectorAll('input').forEach(function (inp) { inp.disabled = false; });
      });
    });
  });
})();
</script>

<%- include('../partials/footer') %>
