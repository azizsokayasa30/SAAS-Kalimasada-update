  <% if (typeof financeOverview !== 'undefined' && financeOverview) {
       const fo = financeOverview;
       const delta = function (cur, prev, higherIsGood) {
         if (!prev && !cur) return { cls: 'is-flat', icon: 'bi-dash', text: 'Sama seperti bulan lalu' };
         if (!prev) return { cls: higherIsGood ? 'is-up' : 'is-down', icon: 'bi-stars', text: 'Baru bulan ini' };
         const pct = Math.round(((cur - prev) / Math.abs(prev)) * 100);
         if (pct === 0) return { cls: 'is-flat', icon: 'bi-dash', text: 'Sama seperti bulan lalu' };
         const good = higherIsGood ? pct > 0 : pct < 0;
         return { cls: good ? 'is-up' : 'is-down', icon: pct > 0 ? 'bi-arrow-up-right' : 'bi-arrow-down-right', text: (pct > 0 ? '+' : '') + pct + '% vs bulan lalu' };
       };
       const incDelta = delta(fo.income.total, fo.income.previousTotal, true);
       const expDelta = delta(fo.expense.total, fo.expense.previousTotal, false);
       const netDelta = delta(fo.net, fo.previousNet, true);
       const netPositive = fo.net >= 0;

       const fc = { w: 640, h: 240, l: 64, r: 12, t: 16, b: 30 };
       const fcPlotW = fc.w - fc.l - fc.r;
       const fcPlotH = fc.h - fc.t - fc.b;
       const fcMaxRaw = Math.max.apply(null, fo.income.monthly.concat(fo.expense.monthly).concat([0]));
       const fcStep = fcMaxRaw > 0 ? niceStep(fcMaxRaw / 4) : 1;
       const fcMax = fcStep * 4;
       const fcGroupW = fcPlotW / fo.periods.length;
       const fcBarW = Math.min(26, fcGroupW * 0.3);
       const fcY = function (v) { return fc.t + fcPlotH - (v / fcMax) * fcPlotH; };
       const fcLabel = function (p) { const m = Number(p.split('-')[1]); return fin.MONTHS_SHORT[m - 1]; };
       const fcTotalInc = fo.income.monthly.reduce(function (s, v) { return s + v; }, 0);
       const fcTotalExp = fo.expense.monthly.reduce(function (s, v) { return s + v; }, 0);
       const recentLists = [
         { title: 'Pemasukan Terbaru', mod: 'income', icon: 'bi-arrow-down-left-circle', panel: 'green', items: fo.income.recent, href: '/management/finance/income', empty: 'Belum ada catatan pemasukan.' },
         { title: 'Pengeluaran Terbaru', mod: 'expense', icon: 'bi-arrow-up-right-circle', panel: 'rose', items: fo.expense.recent, href: '/management/finance/expenses', empty: 'Belum ada catatan pengeluaran.' }
       ];
  %>
  <div class="km-dash-section-title">
    <h3><span class="km-dash-section-icon km-dash-section-icon--green"><i class="bi bi-wallet2"></i></span>Ringkasan Keuangan <span class="km-dash-month-chip"><%= monthLabel %></span></h3>
    <a href="/management/finance/reports" class="km-dash-link">Laporan lengkap <i class="bi bi-arrow-right"></i></a>
  </div>
  <div class="row g-3 mb-3">
    <div class="col-xl-4">
      <div class="km-dash-fin-tiles h-100">
        <a href="/management/finance/income" class="km-dash-fin-tile km-dash-fin-tile--income">
          <span class="km-dash-fin-tile__icon"><i class="bi bi-arrow-down-left-circle"></i></span>
          <div class="km-dash-fin-tile__body">
            <span class="km-dash-fin-tile__label" title="Pemasukan <%= monthLabel %>">Pemasukan</span>
            <strong class="km-money"><%= formatRupiah(fo.income.total) %></strong>
            <span class="km-dash-fin-tile__meta">
              <span class="km-dash-delta <%= incDelta.cls %>"><i class="bi <%= incDelta.icon %>"></i> <%= incDelta.text %></span>
              <small><%= fo.income.count %> catatan</small>
            </span>
          </div>
          <i class="bi bi-chevron-right km-dash-fin-tile__arrow"></i>
        </a>
        <a href="/management/finance/expenses" class="km-dash-fin-tile km-dash-fin-tile--expense">
          <span class="km-dash-fin-tile__icon"><i class="bi bi-arrow-up-right-circle"></i></span>
          <div class="km-dash-fin-tile__body">
            <span class="km-dash-fin-tile__label" title="Pengeluaran <%= monthLabel %>">Pengeluaran</span>
            <strong class="km-money"><%= formatRupiah(fo.expense.total) %></strong>
            <span class="km-dash-fin-tile__meta">
              <span class="km-dash-delta <%= expDelta.cls %>"><i class="bi <%= expDelta.icon %>"></i> <%= expDelta.text %></span>
              <small><%= fo.expense.count %> catatan</small>
            </span>
          </div>
          <i class="bi bi-chevron-right km-dash-fin-tile__arrow"></i>
        </a>
        <a href="/management/finance/reports" class="km-dash-fin-tile km-dash-fin-tile--<%= netPositive ? 'net' : 'loss' %>">
          <span class="km-dash-fin-tile__icon"><i class="bi <%= netPositive ? 'bi-wallet2' : 'bi-exclamation-triangle' %>"></i></span>
          <div class="km-dash-fin-tile__body">
            <span class="km-dash-fin-tile__label" title="Selisih pemasukan dan pengeluaran <%= monthLabel %>">Selisih Bersih</span>
            <strong class="km-money <%= netPositive ? 'text-success' : 'text-danger' %>"><%= formatRupiah(fo.net) %></strong>
            <span class="km-dash-fin-tile__meta">
              <span class="km-dash-delta <%= netDelta.cls %>"><i class="bi <%= netDelta.icon %>"></i> <%= netDelta.text %></span>
            </span>
          </div>
          <i class="bi bi-chevron-right km-dash-fin-tile__arrow"></i>
        </a>
      </div>
    </div>
    <div class="col-xl-8">
      <div class="km-card km-dash-panel h-100">
        <div class="km-dash-panel-head">
          <h5 class="mb-0"><span class="km-dash-panel-icon km-dash-panel-icon--blue"><i class="bi bi-bar-chart-line"></i></span>Pemasukan vs Pengeluaran (6 Bulan)</h5>
          <div class="km-dash-fin-legend">
            <span><i style="background:#10b981"></i> Pemasukan <b class="km-money"><%= formatRupiahShort(fcTotalInc) %></b></span>
            <span><i style="background:#f43f5e"></i> Pengeluaran <b class="km-money"><%= formatRupiahShort(fcTotalExp) %></b></span>
          </div>
        </div>
        <svg class="km-line-chart km-dash-fin-chart km-money" viewBox="0 0 <%= fc.w %> <%= fc.h %>" role="img" aria-label="Grafik pemasukan dan pengeluaran 6 bulan terakhir">
          <% [0, 1, 2, 3, 4].forEach(function (k) { const v = fcStep * k; const y = fcY(v); %>
            <line class="km-line-chart__grid" x1="<%= fc.l %>" x2="<%= fc.w - fc.r %>" y1="<%= y %>" y2="<%= y %>"/>
            <text class="km-line-chart__tick" x="<%= fc.l - 8 %>" y="<%= y + 4 %>" text-anchor="end"><%= fcMaxRaw > 0 ? formatRupiahShort(v) : (k === 0 ? 'Rp 0' : '') %></text>
          <% }); %>
          <% fo.periods.forEach(function (p, i) {
               const cx = fc.l + fcGroupW * i + fcGroupW / 2;
               const inc = fo.income.monthly[i];
               const exp = fo.expense.monthly[i];
               const yi = fcY(inc);
               const ye = fcY(exp);
          %>
            <rect class="km-dash-fin-bar km-dash-fin-bar--income" x="<%= (cx - fcBarW - 2).toFixed(1) %>" y="<%= yi.toFixed(1) %>" width="<%= fcBarW.toFixed(1) %>" height="<%= Math.max(fc.t + fcPlotH - yi, inc > 0 ? 2 : 0).toFixed(1) %>" rx="4"><title><%= fcLabel(p) %> · Pemasukan <%= formatRupiah(inc) %></title></rect>
            <rect class="km-dash-fin-bar km-dash-fin-bar--expense" x="<%= (cx + 2).toFixed(1) %>" y="<%= ye.toFixed(1) %>" width="<%= fcBarW.toFixed(1) %>" height="<%= Math.max(fc.t + fcPlotH - ye, exp > 0 ? 2 : 0).toFixed(1) %>" rx="4"><title><%= fcLabel(p) %> · Pengeluaran <%= formatRupiah(exp) %></title></rect>
            <text class="km-line-chart__tick" x="<%= cx.toFixed(1) %>" y="<%= fc.h - 8 %>" text-anchor="middle"><%= fcLabel(p) %></text>
          <% }); %>
        </svg>
      </div>
    </div>
  </div>
  <div class="row g-3 mb-4">
    <% recentLists.forEach(function (list) { %>
      <div class="col-lg-6">
        <div class="km-card km-dash-panel h-100 km-fin-page km-fin-page--<%= list.mod %>">
