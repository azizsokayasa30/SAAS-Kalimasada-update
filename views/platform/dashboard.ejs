        <svg class="km-line-chart" viewBox="0 0 <%= chart.w %> <%= chart.h %>" role="img" aria-label="Grafik jumlah pelanggan 6 bulan terakhir">
          <defs>
            <linearGradient id="kmGrowthFill" x1="0" y1="0" x2="0" y2="1">
