</main>
<script>
(function () {
  var clockHM = document.getElementById('dashClockHM');
  var clockSec = document.getElementById('dashClockSec');
  var clockDay = document.getElementById('dashClockDay');
  var clockDate = document.getElementById('dashClockDate');
  var jakartaParts = new Intl.DateTimeFormat('id-ID', {
    timeZone: 'Asia/Jakarta', hour12: false,
    weekday: 'long', day: 'numeric', month: 'long', year: 'numeric',
    hour: '2-digit', minute: '2-digit', second: '2-digit'
  });
  function pad(v) { return ('0' + (parseInt(v, 10) % 24)).slice(-2); }
  function tick() {
    if (!clockHM) return;
    var t = {};
    jakartaParts.formatToParts(new Date()).forEach(function (p) { t[p.type] = p.value; });
    clockHM.textContent = pad(t.hour) + ':' + ('0' + t.minute).slice(-2);
    if (clockSec) clockSec.textContent = ('0' + t.second).slice(-2);
    if (clockDay) clockDay.textContent = t.weekday;
    if (clockDate) clockDate.textContent = t.day + ' ' + t.month + ' ' + t.year;
  }
  tick();
  setInterval(tick, 1000);

  var KEY = 'km_mgmt_hide_amounts';
  var root = document.getElementById('kmDashboard');
  var btn = document.getElementById('dashPrivacyToggle');
  function apply(hidden) {
    if (root) root.classList.toggle('km-dash-private', hidden);
    if (btn) btn.innerHTML = hidden ? '<i class="bi bi-eye-slash"></i>' : '<i class="bi bi-eye"></i>';
  }
  var hidden = false;
  try { hidden = localStorage.getItem(KEY) === '1'; } catch (_) {}
  apply(hidden);
  if (btn) btn.addEventListener('click', function () {
    hidden = !hidden;
    try { localStorage.setItem(KEY, hidden ? '1' : '0'); } catch (_) {}
    apply(hidden);
  });
})();
</script>
