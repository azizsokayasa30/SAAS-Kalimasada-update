<%- include('partials/head', { title }) %>
<%- include('partials/sidebar', { active: 'dashboard', adminName }) %>
<%
  const company = (typeof platformCompany !== 'undefined' && platformCompany) ? platformCompany : {};
  const companyName = company.company_name || 'PT. KALIMASADA INTI SARANA';
  const now = new Date();
  const hour = Number(new Intl.DateTimeFormat('en-GB', { hour: 'numeric', hourCycle: 'h23', timeZone: 'Asia/Jakarta' }).format(now));
  const greeting = hour < 11 ? 'Selamat pagi' : hour < 15 ? 'Selamat siang' : hour < 18 ? 'Selamat sore' : 'Selamat malam';
  const greetIcon = hour < 11 ? 'bi-sunrise-fill' : hour < 15 ? 'bi-sun-fill' : hour < 18 ? 'bi-cloud-sun-fill' : 'bi-moon-stars-fill';
  const todayLabel = new Intl.DateTimeFormat('id-ID', { weekday: 'long', day: 'numeric', month: 'long', year: 'numeric', timeZone: 'Asia/Jakarta' }).format(now);
  const monthLabel = new Intl.DateTimeFormat('id-ID', { month: 'long', year: 'numeric', timeZone: 'Asia/Jakarta' }).format(now);
  const fmt = function (n) { return new Intl.NumberFormat('id-ID').format(Number(n) || 0); };

  const ts = tenantStatus || { active: 0, suspended: 0, other: 0 };
  const inv = invoiceSummary || { invoiced: 0, pending: 0, paid: 0, sent: 0, draft: 0, total: 0, paidAmount: 0, unpaidAmount: 0 };
  const invTenants = inv.invoiced + inv.pending;
  const ci = customerInsights || { growth: [], newThisMonth: 0, topTenants: [] };
  const statusLabels = { active: 'Aktif', suspended: 'Suspended', provisioning: 'Provisioning', failed: 'Gagal' };
  const initials = function (name) {
    return String(name || '?').trim().split(/\s+/).slice(0, 2).map(function (w) { return w.charAt(0); }).join('').toUpperCase() || '?';
  };

  // Grafik pertumbuhan pelanggan (SVG)
  const chart = { w: 600, h: 220, l: 48, r: 16, t: 16, b: 30 };
  const gValues = ci.growth.map(function (g) { return g.value; });
  const gMaxRaw = gValues.length ? Math.max.apply(null, gValues) : 0;
  const gMinRaw = gValues.length ? Math.min.apply(null, gValues) : 0;
  const niceStep = function (raw) {
    if (raw <= 1) return 1;
    const mag = Math.pow(10, Math.floor(Math.log10(raw)));
    const n = raw / mag;
    return (n <= 1 ? 1 : n <= 2 ? 2 : n <= 2.5 ? 2.5 : n <= 5 ? 5 : 10) * mag;
  };
  const gTickCount = 4;
  let gStep = niceStep(Math.max(gMaxRaw - gMinRaw * 0.9, 1) / gTickCount);
  let gMin = Math.floor((gMinRaw * 0.9) / gStep) * gStep;
  while (gMin + gStep * gTickCount < gMaxRaw * 1.05) {
    gStep = niceStep(gStep * 1.01);
    gMin = Math.floor((gMinRaw * 0.9) / gStep) * gStep;
  }
  if (gMaxRaw === 0) gStep = 1;
  const gMax = gMin + gStep * gTickCount;
  const plotW = chart.w - chart.l - chart.r;
  const plotH = chart.h - chart.t - chart.b;
  const gPoints = ci.growth.map(function (g, i) {
    const x = chart.l + (ci.growth.length > 1 ? (i * plotW) / (ci.growth.length - 1) : plotW / 2);
    const y = chart.t + plotH - ((g.value - gMin) / (gMax - gMin)) * plotH;
    return { x: Math.round(x * 10) / 10, y: Math.round(y * 10) / 10, label: g.label, value: g.value };
  });
  const gLine = gPoints.map(function (p) { return p.x + ',' + p.y; }).join(' ');
  const gArea = gPoints.length
    ? 'M' + gPoints[0].x + ',' + (chart.t + plotH) + ' L' + gPoints.map(function (p) { return p.x + ',' + p.y; }).join(' L') + ' L' + gPoints[gPoints.length - 1].x + ',' + (chart.t + plotH) + ' Z'
    : '';
  const gTicks = [0, 1, 2, 3, 4].map(function (k) {
    const v = gMin + gStep * k;
    return { v: Math.round(v * 10) / 10, y: chart.t + plotH - (plotH * k) / gTickCount };
  });
  const gLast = gValues.length ? gValues[gValues.length - 1] : 0;
  const gFirst = gValues.length ? gValues[0] : 0;
  const gDelta = gLast - gFirst;

  // Donut status invoice
  const donutParts = [
    { key: 'paid', label: 'Lunas', value: inv.paid, color: '#10b981' },
    { key: 'sent', label: 'Terkirim', value: inv.sent, color: '#3b82f6' },
    { key: 'draft', label: 'Draft', value: inv.draft, color: '#a78bfa' },
    { key: 'pending', label: 'Belum dibuat', value: inv.pending, color: '#f59e0b' },
  ];
  let donutAcc = 0;
  const donutStops = invTenants
    ? donutParts.filter(function (p) { return p.value > 0; }).map(function (p) {
        const start = (donutAcc / invTenants) * 100;
        donutAcc += p.value;
        const end = (donutAcc / invTenants) * 100;
        return p.color + ' ' + start.toFixed(2) + '% ' + end.toFixed(2) + '%';
      }).join(', ')
    : 'rgba(148,163,184,0.25) 0% 100%';
  const paidPct = invTenants ? Math.round((inv.paid / invTenants) * 100) : 0;
  const topMax = ci.topTenants.length ? Math.max(1, ci.topTenants[0].total) : 1;
%>
