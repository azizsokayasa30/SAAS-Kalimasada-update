          <% } else { %>
            <ul class="km-fin-mini-list km-dash-fin-list">
              <% list.items.forEach(function (row) { const dp = fin.dateParts(row.transaction_date); %>
                <li>
                  <% if (dp) { %>
                    <div class="km-fin-date" title="<%= fin.fullDate(row.transaction_date) %>">
                      <strong><%= String(dp.d).padStart(2, '0') %></strong>
