                  <div class="km-fin-mini-list__body">
                    <div title="<%= row.description %>"><%= row.description %></div>
                    <span class="km-fin-cat km-fin-cat--<%= fin.toneOf(row.category) %>"><%= row.category || 'Lainnya' %></span>
                  </div>
                  <span class="km-fin-amount km-money"><%= formatRupiah(row.amount) %></span>
                </li>
              <% }); %>
            </ul>
          <% } %>
        </div>
      </div>
    <% }); %>
  </div>
  <% } %>

  <div class="row g-3 mb-4">
    <div class="col-xl-5">
      <div class="km-card km-dash-panel h-100">
        <div class="km-dash-panel-head">
          <h5 class="mb-0"><span class="km-dash-panel-icon km-dash-panel-icon--blue"><i class="bi bi-graph-up-arrow"></i></span>Grafik Pelanggan (6 Bulan)</h5>
