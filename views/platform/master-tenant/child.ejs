<%- include('../partials/head', { title }) %>
<%- include('../partials/sidebar', { active: 'master-tenant', adminName }) %>
<%
  const customersLimit = (typeof listLimit !== 'undefined' && listLimit) ? listLimit : ((typeof customers !== 'undefined' && customers && customers.limit) ? customers.limit : 50);
  const flashCopied = (typeof flash !== 'undefined' && flash) ? (parseInt(flash.copied, 10) || 0) : 0;
  const flashSkipped = (typeof flash !== 'undefined' && flash) ? (parseInt(flash.skipped, 10) || 0) : 0;
  const flashFailed = (typeof flash !== 'undefined' && flash) ? (parseInt(flash.failed, 10) || 0) : 0;
  const flashCancelled = (typeof flash !== 'undefined' && flash) ? (parseInt(flash.cancelled, 10) || 0) : 0;
  const flashCancelSkipped = (typeof flash !== 'undefined' && flash) ? (parseInt(flash.cancelSkipped, 10) || 0) : 0;
  const flashCancelFailed = (typeof flash !== 'undefined' && flash) ? (parseInt(flash.cancelFailed, 10) || 0) : 0;
  const listQuery = (typeof customers !== 'undefined' && customers && customers.query) ? customers.query : {};
  const emptyFilterValue = (typeof customers !== 'undefined' && customers && customers.emptyFilterValue) ? customers.emptyFilterValue : '__none__';
  const listStateKeys = ['sort', 'dir', 'copy_status', 'area', 'package', 'status', 'q'];
  const customersUrl = function (overrides) {
    const params = new URLSearchParams({ tab: 'customers', limit: String(customersLimit) });
    listStateKeys.forEach(function (key) { if (listQuery[key]) params.set(key, listQuery[key]); });
    Object.keys(overrides || {}).forEach(function (key) {
      const value = overrides[key];
      if (value == null || value === '') params.delete(key); else params.set(key, String(value));
    });
    return '/management/master-tenant/children/' + child.id + '?' + params.toString();
  };
  const sortHref = function (key) {
    const defaultDir = (key === 'id' || key === 'join_date' || key === 'copied') ? 'desc' : 'asc';
    const dir = listQuery.sort === key ? (listQuery.dir === 'asc' ? 'desc' : 'asc') : defaultDir;
    return customersUrl({ sort: key, dir: dir, page: null });
  };
  const sortIcon = function (key) {
    if (listQuery.sort !== key) return 'bi-arrow-down-up opacity-50';
    return listQuery.dir === 'asc' ? 'bi-sort-up' : 'bi-sort-down';
  };
  const hasActiveFilter = !!(listQuery.copy_status || listQuery.area || listQuery.package || listQuery.status || listQuery.q);
  const customersAllTotal = (typeof customers !== 'undefined' && customers && customers.allTotal != null) ? customers.allTotal : (usage.customers.total || 0);
  const copiedTotal = (typeof copyStats !== 'undefined' && copyStats) ? (copyStats.copied || 0) : 0;
  const notCopiedTotal = Math.max(0, customersAllTotal - copiedTotal);
  const copiedPercent = customersAllTotal > 0 ? Math.round((copiedTotal / customersAllTotal) * 1000) / 10 : 0;
  const num = function (n) { return (Number(n) || 0).toLocaleString('id-ID'); };
  const invPeriodLabel = typeof period !== 'undefined' && period && period.label ? period.label : 'Bulan Ini';
  const invTotalAmt = Number(usage.invoices.total) || 0;
  const invPaidPct = invTotalAmt > 0 ? Math.round((Number(usage.invoices.paid) || 0) / invTotalAmt * 100) : 0;
  const statusTone = function (s) {
    const v = String(s || '').toLowerCase();
    if (v === 'active' || v === 'aktif') return 'green';
    if (v === 'isolir' || v === 'suspended' || v === 'terminated') return 'red';
    if (v === 'inactive' || v === 'nonaktif') return 'gray';
    return 'blue';
  };
%>
<main class="km-main km-set km-tenants km-mt">
  <div class="km-topbar">
    <div class="km-mt-childhead">
      <span class="km-mt-childhead__avatar"><%= String(child.name || '?').trim().charAt(0).toUpperCase() %></span>
      <div>
        <a href="/management/master-tenant" class="km-mt-childhead__crumb"><i class="bi bi-diagram-3"></i> Master Tenant</a>
        <h2 class="km-mt-childhead__title"><%= child.name %></h2>
        <div class="km-mt-childhead__meta"><code><%= child.subdomain %></code><span>#<%= child.id %></span><% if (child.owner_name) { %><span><i class="bi bi-person"></i> <%= child.owner_name %></span><% } %></div>
      </div>
    </div>
    <a href="/management/master-tenant" class="btn btn-outline-secondary btn-sm px-3"><i class="bi bi-arrow-left me-1"></i> Kembali</a>
  </div>

  <% if (flashCopied > 0) { %>
    <div class="alert alert-success">
      <% if (flashCopied === 1 && !flashSkipped && !flashFailed) { %>
        Pelanggan berhasil disalin ke master tenant.
      <% } else { %>
        <%= flashCopied %> pelanggan berhasil disalin ke master tenant.
        <% if (flashSkipped > 0) { %> <%= flashSkipped %> sudah ada di master.<% } %>
        <% if (flashFailed > 0) { %> <%= flashFailed %> gagal.<% } %>
      <% } %>
    </div>
  <% } else if (flashSkipped > 0 && flashFailed === 0) { %>
    <div class="alert alert-info">Semua pelanggan yang dipilih sudah ada di master tenant.</div>
  <% } %>
  <% if (flashCancelled > 0) { %>
    <div class="alert alert-success">
      <% if (flashCancelled === 1 && !flashCancelSkipped && !flashCancelFailed) { %>
        Salinan pelanggan di master tenant dibatalkan.
      <% } else { %>
        <%= flashCancelled %> salinan dibatalkan dari master tenant.
        <% if (flashCancelSkipped > 0) { %> <%= flashCancelSkipped %> belum ada di master.<% } %>
        <% if (flashCancelFailed > 0) { %> <%= flashCancelFailed %> gagal.<% } %>
      <% } %>
    </div>
  <% } else if (flashCancelSkipped > 0 && flashCancelFailed === 0) { %>
    <div class="alert alert-info">Pelanggan yang dipilih belum ada di master tenant.</div>
  <% } %>
  <% if (typeof flash !== 'undefined' && flash && flash.error) { %>
    <div class="alert alert-danger"><%= flash.error %></div>
  <% } %>

  <div class="row g-3 mb-3">
    <div class="col-sm-6 col-xl-3">
      <div class="km-card km-set-stat h-100">
        <span class="km-set-stat__icon km-tone-blue"><i class="bi bi-people"></i></span>
        <div>
          <div class="km-set-stat__label">Pelanggan</div>
          <div class="km-set-stat__value"><%= num(usage.customers.total) %></div>
          <div class="km-set-stat__sub"><%= num(usage.customers.active) %> aktif · <%= num(usage.customers.isolir) %> isolir · <%= num(usage.customers.inactive) %> nonaktif · <%= num(usage.customers.new) %> baru</div>
        </div>
      </div>
    </div>
    <div class="col-sm-6 col-xl-3">
      <div class="km-card km-set-stat h-100">
        <span class="km-set-stat__icon km-tone-purple"><i class="bi bi-receipt"></i></span>
        <div>
          <div class="km-set-stat__label">Total Tagihan <%= invPeriodLabel %></div>
          <div class="km-set-stat__value"><%= formatRupiah(usage.invoices.total) %></div>
          <div class="km-set-stat__sub"><%= invPaidPct %>% sudah lunas</div>
        </div>
      </div>
    </div>
    <div class="col-sm-6 col-xl-3">
      <div class="km-card km-set-stat h-100">
        <span class="km-set-stat__icon km-tone-green"><i class="bi bi-check2-circle"></i></span>
        <div>
          <div class="km-set-stat__label">Lunas</div>
          <div class="km-set-stat__value"><%= formatRupiah(usage.invoices.paid) %></div>
          <div class="km-set-stat__sub">Sudah dibayar</div>
        </div>
      </div>
    </div>
    <div class="col-sm-6 col-xl-3">
      <div class="km-card km-set-stat h-100">
        <span class="km-set-stat__icon km-tone-orange"><i class="bi bi-hourglass-split"></i></span>
        <div>
          <div class="km-set-stat__label">Belum Lunas</div>
          <div class="km-set-stat__value"><%= formatRupiah(usage.invoices.unpaid) %></div>
          <div class="km-set-stat__sub">Tagihan outstanding</div>
        </div>
      </div>
    </div>
    <div class="col-sm-6 col-xl-3">
      <div class="km-card km-set-stat h-100">
        <span class="km-set-stat__icon km-tone-red"><i class="bi bi-shield-slash"></i></span>
        <div>
          <div class="km-set-stat__label">Isolir</div>
          <div class="km-set-stat__value"><%= formatRupiah(usage.invoices.isolir) %></div>
          <div class="km-set-stat__sub">Belum lunas + pelanggan isolir</div>
        </div>
      </div>
    </div>
  </div>

  <section class="km-card km-mt-copy mb-3">
    <div class="km-mt-copy__ring" style="--p: <%= copiedPercent %>">
      <span><%= copiedPercent %>%</span>
    </div>
    <div class="km-mt-copy__body">
      <div class="km-mt-copy__title">Progres Copy ke Master</div>
      <div class="km-mt-copy__bar"><span style="width: <%= copiedPercent %>%"></span></div>
      <div class="km-mt-copy__legend">
        <a href="<%= customersUrl({ copy_status: 'yes', page: null }) %>" class="km-mt-copy__chip km-mt-copy__chip--done <%= listQuery.copy_status === 'yes' ? 'is-active' : '' %>">
          <i class="bi bi-clipboard-check"></i> Sudah di master <strong><%= num(copiedTotal) %></strong>
        </a>
        <a href="<%= customersUrl({ copy_status: 'no', page: null }) %>" class="km-mt-copy__chip km-mt-copy__chip--todo <%= listQuery.copy_status === 'no' ? 'is-active' : '' %>">
          <i class="bi bi-clipboard"></i> Belum di-copy <strong><%= num(notCopiedTotal) %></strong>
        </a>
        <span class="km-mt-copy__total">dari <%= num(customersAllTotal) %> pelanggan</span>
      </div>
    </div>
  </section>

  <div class="km-mt-tabs mb-3" role="tablist">
    <a class="km-mt-tabs__item <%= tab === 'customers' ? 'is-active' : '' %>" href="/management/master-tenant/children/<%= child.id %>?tab=customers&amp;limit=<%= customersLimit %>"><i class="bi bi-people"></i> Pelanggan</a>
    <a class="km-mt-tabs__item <%= tab === 'invoices' ? 'is-active' : '' %>" href="/management/master-tenant/children/<%= child.id %>?tab=invoices"><i class="bi bi-receipt"></i> Tagihan</a>
  </div>

  <div class="km-card km-card--flush km-mt-list">
    <% if (tab === 'customers' && customers) { %>
    <div class="km-mt-bulk">
      <form id="bulkCopyForm" method="POST" action="/management/master-tenant/children/<%= child.id %>/customers/copy-selected" class="d-flex flex-wrap gap-2 align-items-center mb-0" onsubmit="return window.confirmMasterBulkCopy();">
        <input type="hidden" name="limit" value="<%= customersLimit %>">
        <input type="hidden" name="page" value="<%= customers.page %>">
        <% listStateKeys.forEach(function (key) { if (listQuery[key]) { %>
          <input type="hidden" name="<%= key %>" value="<%= listQuery[key] %>">
        <% } }); %>
        <button type="submit" class="btn btn-sm btn-km-primary">
          <i class="bi bi-clipboard-plus"></i> Copy yang ditandai
        </button>
        <span id="bulkCopyHint" class="km-mt-bulk__hint">0 untuk di-copy</span>
      </form>
      <form id="bulkCancelForm" method="POST" action="/management/master-tenant/children/<%= child.id %>/customers/cancel-selected" class="d-flex flex-wrap gap-2 align-items-center mb-0" onsubmit="return window.confirmMasterBulkCancel();">
        <input type="hidden" name="limit" value="<%= customersLimit %>">
        <input type="hidden" name="page" value="<%= customers.page %>">
        <% listStateKeys.forEach(function (key) { if (listQuery[key]) { %>
          <input type="hidden" name="<%= key %>" value="<%= listQuery[key] %>">
        <% } }); %>
        <button type="submit" class="btn btn-sm btn-outline-danger">
          <i class="bi bi-x-circle"></i> Batalkan yang ditandai
        </button>
        <span id="bulkCancelHint" class="km-mt-bulk__hint km-mt-bulk__hint--danger">0 untuk dibatalkan</span>
      </form>
    </div>
    <form method="GET" action="/management/master-tenant/children/<%= child.id %>" class="km-mt-filters mb-0">
      <input type="hidden" name="tab" value="customers">
      <input type="hidden" name="sort" value="<%= listQuery.sort || 'id' %>">
      <input type="hidden" name="dir" value="<%= listQuery.dir || 'desc' %>">
      <div class="km-mt-filters__search">
        <label for="customerSearch">Cari pelanggan</label>
        <div class="km-tl-search">
          <i class="bi bi-search" aria-hidden="true"></i>
          <input id="customerSearch" type="search" name="q" value="<%= listQuery.q || '' %>" class="form-control" placeholder="Nama, telepon, atau ID — tekan Enter" autocomplete="off">
        </div>
      </div>
      <div>
        <label for="filterCopyStatus">Status copy</label>
        <select id="filterCopyStatus" name="copy_status" class="form-select form-select-sm" onchange="this.form.submit()">
          <option value="" <%= !listQuery.copy_status ? 'selected' : '' %>>Semua</option>
          <option value="no" <%= listQuery.copy_status === 'no' ? 'selected' : '' %>>Belum di-copy (<%= notCopiedTotal %>)</option>
          <option value="yes" <%= listQuery.copy_status === 'yes' ? 'selected' : '' %>>Sudah di master (<%= copiedTotal %>)</option>
        </select>
      </div>
      <div>
        <label for="filterArea">Area</label>
        <select id="filterArea" name="area" class="form-select form-select-sm" onchange="this.form.submit()">
          <option value="">Semua area</option>
          <% (customers.filterOptions.areas || []).forEach(function (opt) {
               const value = opt.area == null ? emptyFilterValue : opt.area; %>
            <option value="<%= value %>" <%= listQuery.area === value ? 'selected' : '' %>><%= opt.area == null ? 'Tanpa area' : opt.area %> (<%= opt.total %>)</option>
          <% }); %>
        </select>
      </div>
      <div>
        <label for="filterPackage">Paket</label>
        <select id="filterPackage" name="package" class="form-select form-select-sm" onchange="this.form.submit()">
          <option value="">Semua paket</option>
          <% (customers.filterOptions.packages || []).forEach(function (opt) {
               const value = opt.id == null ? emptyFilterValue : String(opt.id);
               const label = opt.id == null ? 'Tanpa paket' : (opt.name || ('Paket #' + opt.id)); %>
            <option value="<%= value %>" <%= listQuery.package === value ? 'selected' : '' %>><%= label %> (<%= opt.total %>)</option>
          <% }); %>
        </select>
      </div>
      <div>
        <label for="filterStatus">Status pelanggan</label>
        <select id="filterStatus" name="status" class="form-select form-select-sm" onchange="this.form.submit()">
          <option value="">Semua status</option>
          <% (customers.filterOptions.statuses || []).forEach(function (opt) {
               const value = opt.status == null ? emptyFilterValue : opt.status; %>
            <option value="<%= value %>" <%= listQuery.status === value ? 'selected' : '' %>><%= opt.status == null ? 'Tanpa status' : opt.status %> (<%= opt.total %>)</option>
          <% }); %>
        </select>
      </div>
      <div>
        <label for="customersPerPage">Per halaman</label>
        <select id="customersPerPage" name="limit" class="form-select form-select-sm" onchange="this.form.submit()">
          <option value="50" <%= customersLimit === 50 ? 'selected' : '' %>>50</option>
          <option value="100" <%= customersLimit === 100 ? 'selected' : '' %>>100</option>
        </select>
      </div>
      <% if (hasActiveFilter) { %>
        <a href="<%= customersUrl({ copy_status: null, area: null, package: null, status: null, q: null, page: null }) %>" class="btn btn-sm btn-outline-secondary km-mt-filters__reset">
          <i class="bi bi-x-circle"></i> Reset filter
        </a>
      <% } %>
    </form>
    <div class="table-responsive">
      <table class="table table-hover align-middle mb-0 km-mt-table">
        <thead>
          <tr>
            <th class="km-mt-table__check">
              <input type="checkbox" id="selectAllCustomers" class="form-check-input" title="Tandai semua di halaman ini">
            </th>
            <th>
              <a href="<%= sortHref('name') %>" class="km-mt-sort">Pelanggan <i class="bi <%= sortIcon('name') %>"></i></a>
              <a href="<%= sortHref('id') %>" class="km-mt-sort km-mt-sort--sub">ID <i class="bi <%= sortIcon('id') %>"></i></a>
            </th>
            <th><a href="<%= sortHref('package') %>" class="km-mt-sort">Paket <i class="bi <%= sortIcon('package') %>"></i></a></th>
            <th class="d-none d-xl-table-cell"><a href="<%= sortHref('area') %>" class="km-mt-sort">Area <i class="bi <%= sortIcon('area') %>"></i></a></th>
            <th><a href="<%= sortHref('status') %>" class="km-mt-sort">Status <i class="bi <%= sortIcon('status') %>"></i></a></th>
            <th class="d-none d-xl-table-cell"><a href="<%= sortHref('join_date') %>" class="km-mt-sort">Bergabung <i class="bi <%= sortIcon('join_date') %>"></i></a></th>
            <th class="text-end"><a href="<%= sortHref('copied') %>" class="km-mt-sort">Copy <i class="bi <%= sortIcon('copied') %>"></i></a></th>
          </tr>
        </thead>
        <tbody>
          <% if (!customers.rows.length) { %>
            <tr><td colspan="7">
              <div class="km-tl-empty">
                <span class="km-tl-empty__icon"><i class="bi <%= hasActiveFilter ? 'bi-search' : 'bi-people' %>"></i></span>
                <div class="km-tl-empty__title"><%= hasActiveFilter ? 'Tidak ada pelanggan yang cocok' : 'Tidak ada pelanggan' %></div>
              </div>
            </td></tr>
          <% } %>
          <% customers.rows.forEach(function(row) { %>
            <tr class="<%= row.copied_to_master ? 'is-copied' : '' %>">
              <td class="km-mt-table__check">
                <% if (!row.copied_to_master) { %>
                  <input type="checkbox" class="form-check-input js-copy-customer" name="customer_ids" value="<%= row.id %>" form="bulkCopyForm" title="Tandai untuk di-copy">
                <% } else { %>
                  <input type="checkbox" class="form-check-input js-cancel-customer" name="customer_ids" value="<%= row.id %>" form="bulkCancelForm" title="Tandai untuk dibatalkan dari master">
                <% } %>
              </td>
              <td>
                <div class="km-set-user">
                  <span class="km-set-avatar km-mt-avatar"><%= String(row.name || '?').trim().charAt(0).toUpperCase() %></span>
                  <div class="lh-sm" style="min-width:0">
                    <div class="km-mt-cust-name"><%= row.name %></div>
                    <div class="km-tl-sub text-muted">#<%= row.id %><% if (row.phone) { %> · <%= row.phone %><% } %></div>
                    <% if (row.area) { %><div class="km-tl-sub text-muted d-xl-none"><i class="bi bi-geo-alt-fill"></i> <%= row.area %></div><% } %>
                  </div>
                </div>
              </td>
              <td>
                <% if (row.package_name) { %>
                  <div class="fw-semibold small text-nowrap"><%= row.package_name %></div>
                  <small class="text-muted text-nowrap">
                    <% if (row.package_speed && row.package_speed !== '-') { %><%= row.package_speed %> · <% } %><%= formatRupiah(row.package_price || 0) %>
                  </small>
                <% } else if (row.package_id) { %>
                  <span class="text-muted">Paket #<%= row.package_id %></span>
                <% } else { %>
                  <span class="text-muted">—</span>
                <% } %>
              </td>
              <td class="d-none d-xl-table-cell">
                <% if (row.area) { %>
                  <span class="km-mt-chip"><i class="bi bi-geo-alt-fill"></i><%= row.area %></span>
                <% } else { %>
                  <span class="text-muted">—</span>
                <% } %>
              </td>
              <td><span class="km-mt-status km-mt-status--<%= statusTone(row.status) %>"><i class="km-dot km-dot--<%= statusTone(row.status) %>"></i><%= row.status || '—' %></span></td>
              <td class="d-none d-xl-table-cell small text-muted text-nowrap"><%= row.join_date || row.created_at || '—' %></td>
              <td class="text-end">
                <% if (row.copied_to_master) { %>
                  <div class="d-inline-flex align-items-center justify-content-end gap-2 text-nowrap">
                    <span class="km-mt-status km-mt-status--green"><i class="bi bi-check2-circle"></i> Di master</span>
                    <form method="POST" action="/management/master-tenant/children/<%= child.id %>/customers/<%= row.id %>/cancel" class="d-inline mb-0" onsubmit="return confirm('Batalkan salinan pelanggan ini? Salinan pelanggan, tagihan, dan pembayaran di master akan dihapus.');">
                      <input type="hidden" name="limit" value="<%= customersLimit %>">
                      <input type="hidden" name="page" value="<%= customers.page %>">
                      <% listStateKeys.forEach(function (key) { if (listQuery[key]) { %>
                        <input type="hidden" name="<%= key %>" value="<%= listQuery[key] %>">
                      <% } }); %>
                      <button type="submit" class="btn btn-sm btn-outline-danger km-mt-iconbtn" title="Batalkan salinan di master tenant" aria-label="Batalkan salinan">
                        <i class="bi bi-x-lg"></i>
                      </button>
                    </form>
                  </div>
                <% } else { %>
                  <form method="POST" action="/management/master-tenant/children/<%= child.id %>/customers/<%= row.id %>/copy" class="d-inline" onsubmit="return confirm('Salin pelanggan ini ke master tenant?');">
                    <input type="hidden" name="limit" value="<%= customersLimit %>">
                    <input type="hidden" name="page" value="<%= customers.page %>">
                    <% listStateKeys.forEach(function (key) { if (listQuery[key]) { %>
                      <input type="hidden" name="<%= key %>" value="<%= listQuery[key] %>">
                    <% } }); %>
                    <button type="submit" class="btn btn-sm btn-km-primary text-nowrap" title="Copy ke master tenant">
                      <i class="bi bi-clipboard-plus"></i> Copy
                    </button>
                  </form>
                <% } %>
              </td>
            </tr>
          <% }); %>
        </tbody>
      </table>
      <div class="km-mt-pager">
        <span>
          Menampilkan <strong><%= customers.rows.length %></strong> dari <strong><%= customers.total %></strong> pelanggan<% if (hasActiveFilter) { %> (difilter dari <%= customersAllTotal %>)<% } %>
        </span>
        <div class="km-mt-pager__nav">
          <% if (customers.page > 1) { %>
            <a class="km-mt-pager__btn" href="<%= customersUrl({ page: customers.page - 1 }) %>" title="Sebelumnya"><i class="bi bi-chevron-left"></i></a>
          <% } else { %>
            <span class="km-mt-pager__btn is-disabled"><i class="bi bi-chevron-left"></i></span>
          <% } %>
          <span class="km-mt-pager__page"><%= customers.page %> / <%= customers.totalPages %></span>
          <% if (customers.page < customers.totalPages) { %>
            <a class="km-mt-pager__btn" href="<%= customersUrl({ page: customers.page + 1 }) %>" title="Berikutnya"><i class="bi bi-chevron-right"></i></a>
          <% } else { %>
            <span class="km-mt-pager__btn is-disabled"><i class="bi bi-chevron-right"></i></span>
          <% } %>
        </div>
      </div>
    </div>
    <% } %>

    <% if (tab === 'invoices' && invoices) { %>
    <div class="table-responsive">
      <table class="table table-hover align-middle mb-0 km-mt-table">
        <thead>
          <tr>
            <th>No. Invoice</th>
            <th>Pelanggan</th>
            <th class="text-end">Nominal</th>
            <th>Status</th>
            <th>Jatuh Tempo</th>
          </tr>
        </thead>
        <tbody>
          <% if (!invoices.rows.length) { %>
            <tr><td colspan="5">
              <div class="km-tl-empty">
                <span class="km-tl-empty__icon"><i class="bi bi-receipt"></i></span>
                <div class="km-tl-empty__title">Tidak ada tagihan</div>
              </div>
            </td></tr>
          <% } %>
          <% invoices.rows.forEach(function(row) {
               const paid = row.status === 'paid';
          %>
            <tr>
              <td><code class="km-mt-invno"><%= row.invoice_number %></code></td>
              <td class="fw-semibold small"><%= row.customer_name || '—' %></td>
              <td class="text-end fw-bold text-nowrap"><%= formatRupiah(row.amount) %></td>
              <td><span class="km-mt-status km-mt-status--<%= paid ? 'green' : 'orange' %>"><i class="bi <%= paid ? 'bi-check2-circle' : 'bi-hourglass-split' %>"></i><%= paid ? 'Lunas' : (row.status === 'unpaid' ? 'Belum lunas' : row.status) %></span></td>
              <td class="small text-muted text-nowrap"><%= row.due_date || '—' %></td>
            </tr>
          <% }); %>
        </tbody>
      </table>
      <% if (invoices.totalPages > 1) { %>
      <div class="km-mt-pager">
        <span><strong><%= invoices.total %></strong> tagihan</span>
        <div class="km-mt-pager__nav">
          <% if (invoices.page > 1) { %>
            <a class="km-mt-pager__btn" href="?tab=invoices&page=<%= invoices.page - 1 %>" title="Sebelumnya"><i class="bi bi-chevron-left"></i></a>
          <% } else { %>
            <span class="km-mt-pager__btn is-disabled"><i class="bi bi-chevron-left"></i></span>
          <% } %>
          <span class="km-mt-pager__page"><%= invoices.page %> / <%= invoices.totalPages %></span>
          <% if (invoices.page < invoices.totalPages) { %>
            <a class="km-mt-pager__btn" href="?tab=invoices&page=<%= invoices.page + 1 %>" title="Berikutnya"><i class="bi bi-chevron-right"></i></a>
          <% } else { %>
            <span class="km-mt-pager__btn is-disabled"><i class="bi bi-chevron-right"></i></span>
          <% } %>
        </div>
      </div>
      <% } %>
    </div>
    <% } %>
  </div>
</main>

<script>
(function () {
  var selectAll = document.getElementById('selectAllCustomers');
  var hint = document.getElementById('bulkCopyHint');
  var cancelHint = document.getElementById('bulkCancelHint');
  var copyBoxes = function () { return Array.prototype.slice.call(document.querySelectorAll('.js-copy-customer')); };
  var cancelBoxes = function () { return Array.prototype.slice.call(document.querySelectorAll('.js-cancel-customer')); };
  var boxes = function () { return copyBoxes().concat(cancelBoxes()); };
  function checkedCount(list) {
    return list.filter(function (el) { return el.checked; }).length;
  }
  function updateHint() {
    var copyCount = checkedCount(copyBoxes());
    var cancelCount = checkedCount(cancelBoxes());
    if (hint) hint.textContent = copyCount + ' untuk di-copy';
    if (cancelHint) cancelHint.textContent = cancelCount + ' untuk dibatalkan';
    if (selectAll) {
      var all = boxes();
      var n = copyCount + cancelCount;
      selectAll.checked = all.length > 0 && all.every(function (el) { return el.checked; });
      selectAll.indeterminate = n > 0 && n < all.length;
    }
  }
  if (selectAll) {
    selectAll.addEventListener('change', function () {
      boxes().forEach(function (el) { el.checked = selectAll.checked; });
      updateHint();
    });
  }
  boxes().forEach(function (el) { el.addEventListener('change', updateHint); });
  window.confirmMasterBulkCopy = function () {
    var n = checkedCount(copyBoxes());
    if (!n) {
      alert('Pilih minimal satu pelanggan yang belum di-copy.');
      return false;
    }
    return confirm('Salin ' + n + ' pelanggan ke master tenant?');
  };
  window.confirmMasterBulkCancel = function () {
    var n = checkedCount(cancelBoxes());
    if (!n) {
      alert('Pilih minimal satu pelanggan yang sudah ada di master.');
      return false;
    }
    return confirm('Batalkan salinan ' + n + ' pelanggan? Salinan di master akan dihapus.');
  };
  updateHint();
})();
</script>

<%- include('../partials/footer') %>
