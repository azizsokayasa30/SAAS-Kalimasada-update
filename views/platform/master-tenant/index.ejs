<%
const children = overview.children || [];
const summary = overview.summary || { customers: {}, invoices: {}, routers: 0 };
const sumCust = summary.customers || {};
const sumInv = summary.invoices || {};
const statsFilters = typeof filters !== 'undefined' && filters ? filters : (overview.period || {});
const selectedMonth = statsFilters.month != null ? statsFilters.month : (new Date().getMonth() + 1);
const selectedYear = statsFilters.year != null ? Number(statsFilters.year) : new Date().getFullYear();
const periodLabel = statsFilters.label || (overview.period && overview.period.label) || '';
const monthNamesId = ['Januari','Februari','Maret','April','Mei','Juni','Juli','Agustus','September','Oktober','November','Desember'];
const cyFilter = new Date().getFullYear();
const loginHost = typeof tenantHostname !== 'undefined' ? tenantHostname : 'billing.kalimasada-app.com';
const loginUser = (master.settings && master.settings.admin_username) ? master.settings.admin_username : 'admin';
const loginPass = (master.settings && master.settings.admin_password) ? master.settings.admin_password : '';
const masterInitials = String(master.name || 'M').split(/\s+/).filter(Boolean).slice(0, 2).map(function (w) { return w[0]; }).join('').toUpperCase();
const paidPct = Number(sumInv.total) > 0 ? Math.round((Number(sumInv.paid) || 0) / Number(sumInv.total) * 100) : 0;
const num = function (n) { return (Number(n) || 0).toLocaleString('id-ID'); };
%>
<%- include('../partials/head', { title }) %>
<%- include('../partials/sidebar', { active: 'master-tenant', adminName }) %>
<main class="km-main km-set km-tenants km-mt">
  <div class="km-topbar">
    <div>
      <h2 class="km-set-title"><span class="km-set-title__icon"><i class="bi bi-diagram-3"></i></span>Master Tenant</h2>
    </div>
    <a href="<%= typeof tenantLoginUrl !== 'undefined' ? tenantLoginUrl : '#' %>" class="btn btn-km-primary btn-sm px-3" target="_blank" rel="noopener">
      <i class="bi bi-box-arrow-up-right me-1"></i> Buka Master Tenant
    </a>
  </div>

  <% if (flash && flash.success === 'created') { %>
    <div class="alert alert-success">Master tenant berhasil dibuat.</div>
  <% } %>

  <section class="km-card km-mt-hero mb-3">
    <div class="km-mt-hero__main">
      <span class="km-mt-hero__avatar"><%= masterInitials %></span>
      <div class="km-mt-hero__id">
        <span class="km-mt-hero__badge"><i class="bi bi-patch-check-fill"></i> Master</span>
        <h3 class="km-mt-hero__name"><%= master.name %></h3>
        <div class="km-mt-hero__contacts">
          <% if (master.owner_name) { %><span><i class="bi bi-person"></i><%= master.owner_name %></span><% } %>
          <% if (master.owner_email) { %><span><i class="bi bi-envelope"></i><%= master.owner_email %></span><% } %>
          <% if (master.owner_phone) { %><span><i class="bi bi-whatsapp"></i><%= master.owner_phone %></span><% } %>
        </div>
      </div>
    </div>

    <div class="km-mt-cred">
      <div class="km-mt-cred__item">
        <span class="km-mt-cred__label">Alamat Login</span>
        <div class="km-mt-cred__value"><code><%= loginHost %></code>
          <button type="button" class="km-mt-cred__btn js-copy" data-copy="<%= loginHost %>" title="Salin"><i class="bi bi-copy"></i></button>
        </div>
      </div>
      <div class="km-mt-cred__item">
        <span class="km-mt-cred__label">Username</span>
        <div class="km-mt-cred__value"><code><%= loginUser %></code>
          <button type="button" class="km-mt-cred__btn js-copy" data-copy="<%= loginUser %>" title="Salin"><i class="bi bi-copy"></i></button>
        </div>
      </div>
      <% if (loginPass) { %>
        <div class="km-mt-cred__item">
          <span class="km-mt-cred__label">Password</span>
          <div class="km-mt-cred__value"><code class="js-pass" data-pass="<%= loginPass %>">••••••••</code>
            <button type="button" class="km-mt-cred__btn js-pass-toggle" title="Tampilkan"><i class="bi bi-eye"></i></button>
            <button type="button" class="km-mt-cred__btn js-copy" data-copy="<%= loginPass %>" title="Salin"><i class="bi bi-copy"></i></button>
          </div>
        </div>
      <% } %>
    </div>
  </section>

  <div class="row g-3 mb-3">
    <div class="col-sm-6 col-xl-3">
      <div class="km-card km-set-stat h-100">
        <span class="km-set-stat__icon km-tone-blue"><i class="bi bi-diagram-3"></i></span>
        <div>
          <div class="km-set-stat__label">Tenant Child</div>
          <div class="km-set-stat__value"><%= num(overview.childCount) %></div>
          <div class="km-set-stat__sub"><%= num(summary.routers) %> router / NAS</div>
        </div>
      </div>
    </div>
    <div class="col-sm-6 col-xl-3">
      <div class="km-card km-set-stat h-100">
        <span class="km-set-stat__icon km-tone-green"><i class="bi bi-people"></i></span>
        <div>
          <div class="km-set-stat__label">Pelanggan</div>
          <div class="km-set-stat__value"><%= num(sumCust.total) %></div>
          <div class="km-set-stat__sub"><%= num(sumCust.active) %> aktif · <%= num(sumCust.new) %> baru</div>
        </div>
      </div>
    </div>
    <div class="col-sm-6 col-xl-3">
      <div class="km-card km-set-stat h-100">
        <span class="km-set-stat__icon km-tone-purple"><i class="bi bi-receipt"></i></span>
        <div>
          <div class="km-set-stat__label">Tagihan</div>
          <div class="km-set-stat__value"><%= formatRupiah(sumInv.total) %></div>
          <div class="km-set-stat__sub"><%= paidPct %>% lunas · <%= formatRupiah(sumInv.paid) %></div>
        </div>
      </div>
    </div>
    <div class="col-sm-6 col-xl-3">
      <div class="km-card km-set-stat h-100">
        <span class="km-set-stat__icon km-tone-orange"><i class="bi bi-hourglass-split"></i></span>
        <div>
          <div class="km-set-stat__label">Belum Lunas</div>
          <div class="km-set-stat__value"><%= formatRupiah(sumInv.unpaid) %></div>
          <div class="km-set-stat__sub">Isolir <%= formatRupiah(sumInv.isolir) %></div>
        </div>
      </div>
    </div>
  </div>

  <div class="km-card km-tl-toolbar mb-3">
    <form method="GET" action="/management/master-tenant" class="km-tl-toolbar__form">
      <div class="km-tl-search">
        <i class="bi bi-search" aria-hidden="true"></i>
        <input type="search" id="childSearchInput" class="form-control"
               placeholder="Cari tenant child…" title="Cari nama, subdomain, atau owner" autocomplete="off"
               aria-label="Cari tenant child">
      </div>
      <div class="km-tl-period">
        <span class="km-tl-period__label"><i class="bi bi-calendar3"></i> Periode</span>
        <select name="month" class="form-select" aria-label="Bulan" title="Bulan">
          <option value="all" <%= String(selectedMonth) === 'all' ? 'selected' : '' %>>Satu tahun</option>
          <% for (let m = 1; m <= 12; m++) { %>
            <option value="<%= m %>" <%= String(selectedMonth) === String(m) ? 'selected' : '' %>><%= monthNamesId[m - 1] %></option>
          <% } %>
        </select>
        <select name="year" class="form-select" aria-label="Tahun" title="Tahun">
          <% for (let y = cyFilter - 3; y <= cyFilter + 1; y++) { %>
            <option value="<%= y %>" <%= selectedYear === y ? 'selected' : '' %>><%= y %></option>
          <% } %>
        </select>
        <button type="submit" class="btn btn-km-primary" title="Terapkan periode">
          <i class="bi bi-funnel"></i> Terapkan
        </button>
      </div>
    </form>
  </div>

  <div class="km-card km-card--flush">
    <div class="km-set-head km-tl-head">
      <h5><i class="bi bi-list-ul"></i> Tenant Child <span class="km-tl-count" id="childVisibleCount"><%= children.length %></span></h5>
      <% if (periodLabel) { %><span class="km-tl-period-chip"><i class="bi bi-calendar3"></i> <%= periodLabel %></span><% } %>
    </div>
    <div class="table-responsive">
      <table class="table table-hover align-middle mb-0 km-tl-table">
        <thead>
          <tr>
            <th>Tenant Child</th>
            <th class="d-none d-xl-table-cell">Owner</th>
            <th>Pelanggan</th>
            <th>Tagihan</th>
            <th class="text-end">Aksi</th>
          </tr>
        </thead>
        <tbody>
          <% if (!children.length) { %>
            <tr><td colspan="5">
              <div class="km-tl-empty">
                <span class="km-tl-empty__icon"><i class="bi bi-diagram-3"></i></span>
                <div class="km-tl-empty__title">Belum ada tenant child</div>
              </div>
            </td></tr>
          <% } %>
          <tr id="childSearchEmptyRow" class="d-none"><td colspan="5">
            <div class="km-tl-empty">
              <span class="km-tl-empty__icon"><i class="bi bi-search"></i></span>
              <div class="km-tl-empty__title">Tidak ada tenant child yang cocok</div>
            </div>
          </td></tr>
          <% children.forEach(function(t) {
            const c = t.usage.customers || {};
            const inv = t.usage.invoices || {};
            const invTotal = Number(inv.total) || 0;
            const rowPaidPct = invTotal > 0 ? Math.min(100, Math.round(((Number(inv.paid) || 0) / invTotal) * 100)) : 0;
            const searchBlob = [t.id, t.name, t.subdomain, t.owner_name, t.owner_email].filter(Boolean).join(' ').toLowerCase();
            const pickUrl = '/management/master-tenant/children/' + t.id + '?month=' + selectedMonth + '&year=' + selectedYear;
          %>
            <tr class="child-data-row" data-search="<%= searchBlob.replace(/"/g, '&quot;') %>">
              <td>
                <div class="km-set-user">
                  <span class="km-set-avatar"><%= String(t.name || '?').trim().charAt(0).toUpperCase() %></span>
                  <div class="lh-sm" style="min-width:0">
                    <a href="<%= pickUrl %>" class="km-tl-name"><%= t.name %></a>
                    <div class="km-tl-sub"><code><%= t.subdomain %></code> <span class="text-muted">#<%= t.id %></span></div>
                    <div class="km-tl-sub d-xl-none text-muted"><%= t.owner_email %></div>
                  </div>
                </div>
              </td>
              <td class="d-none d-xl-table-cell">
                <div class="fw-semibold small"><%= t.owner_name %></div>
                <small class="text-muted"><%= t.owner_email %></small>
              </td>
              <td>
                <div class="km-tl-metric"><%= num(c.total) %></div>
                <div class="km-tl-dots">
                  <span title="Aktif"><i class="km-dot km-dot--green"></i><%= c.active || 0 %></span>
                  <span title="Nonaktif"><i class="km-dot km-dot--gray"></i><%= c.inactive || 0 %></span>
                  <span title="Baru"><i class="km-dot km-dot--blue"></i><%= c.new || 0 %></span>
                </div>
              </td>
              <td>
                <div class="km-tl-metric"><%= formatRupiah(inv.total) %></div>
                <div class="km-tl-progress" title="<%= rowPaidPct %>% lunas"><span style="width: <%= rowPaidPct %>%"></span></div>
                <div class="km-tl-dots">
                  <span title="Belum lunas"><i class="km-dot km-dot--orange"></i><%= formatRupiah(inv.unpaid) %></span>
                  <% if (Number(inv.isolir) > 0) { %><span title="Isolir"><i class="km-dot km-dot--red"></i><%= formatRupiah(inv.isolir) %></span><% } %>
                </div>
              </td>
              <td class="text-end text-nowrap">
                <a href="<%= pickUrl %>" class="btn btn-sm btn-km-primary km-mt-pick" title="Pilih pelanggan untuk disalin ke master">
                  <i class="bi bi-person-check"></i><span> Pilih Pelanggan</span>
                </a>
              </td>
            </tr>
          <% }); %>
        </tbody>
      </table>
    </div>
  </div>
</main>

<script>
(function () {
  document.querySelectorAll('.js-copy').forEach(function (btn) {
    btn.addEventListener('click', function () {
      var text = btn.getAttribute('data-copy') || '';
      var done = function () {
        var icon = btn.querySelector('i');
        icon.className = 'bi bi-check2';
        btn.classList.add('is-done');
        setTimeout(function () { icon.className = 'bi bi-copy'; btn.classList.remove('is-done'); }, 1400);
      };
      if (navigator.clipboard && window.isSecureContext) {
        navigator.clipboard.writeText(text).then(done);
      } else {
        var ta = document.createElement('textarea');
        ta.value = text;
        document.body.appendChild(ta);
        ta.select();
        document.execCommand('copy');
        ta.remove();
        done();
      }
    });
  });

  document.querySelectorAll('.js-pass-toggle').forEach(function (btn) {
    var code = btn.parentNode.querySelector('.js-pass');
    btn.addEventListener('click', function () {
      var shown = code.textContent !== '••••••••';
      code.textContent = shown ? '••••••••' : code.getAttribute('data-pass');
      btn.querySelector('i').className = shown ? 'bi bi-eye' : 'bi bi-eye-slash';
      btn.title = shown ? 'Tampilkan' : 'Sembunyikan';
    });
  });

  var input = document.getElementById('childSearchInput');
  if (!input) return;
  var rows = Array.prototype.slice.call(document.querySelectorAll('.child-data-row'));
  var emptySearch = document.getElementById('childSearchEmptyRow');
  var visibleCount = document.getElementById('childVisibleCount');
  function applyFilter() {
    var q = String(input.value || '').trim().toLowerCase();
    var visible = 0;
    rows.forEach(function (row) {
      var match = !q || (row.getAttribute('data-search') || '').indexOf(q) !== -1;
      row.classList.toggle('d-none', !match);
      if (match) visible += 1;
    });
    if (emptySearch) emptySearch.classList.toggle('d-none', !(q && visible === 0 && rows.length > 0));
    if (visibleCount) visibleCount.textContent = visible;
  }
  input.addEventListener('input', applyFilter);
  input.addEventListener('keydown', function (e) {
    if (e.key === 'Enter') { e.preventDefault(); applyFilter(); }
  });
})();
</script>

<%- include('../partials/footer') %>
