<%- include('../partials/head', { title }) %>
<%- include('../partials/sidebar', { active: 'tenants-mrtg', adminName }) %>
<main class="km-main">
  <div class="km-topbar">
    <div>
      <h2>MRTG</h2>
      <p class="km-subtitle">Graph trafik perangkat yang dipetakan untuk portal management</p>
    </div>
      <a href="/management/settings/mrtg" class="btn btn-outline-secondary btn-sm">Kelola pemetaan</a>
  </div>

  <div class="nms-mrtg-toolbar">
    <label class="nms-mrtg-search">
      <i class="bi bi-search" aria-hidden="true"></i>
      <input type="search" id="nmsMrtgSearch" class="form-control form-control-sm" placeholder="Cari nama tenant atau router" autocomplete="off" aria-label="Cari nama tenant atau router">
    </label>
    <div class="btn-group btn-group-sm" role="group" aria-label="Rentang graph MRTG">
      <button type="button" class="btn btn-outline-secondary active" data-nms-range="24h">Harian</button>
      <button type="button" class="btn btn-outline-secondary" data-nms-range="7d">Mingguan</button>
      <button type="button" class="btn btn-outline-secondary" data-nms-range="30d">Bulanan</button>
      <button type="button" class="btn btn-outline-secondary" data-nms-range="custom">Custom</button>
    </div>
    <form id="nmsMrtgCustom" class="nms-mrtg-custom" hidden>
      <label>Mulai
        <input type="date" id="nmsMrtgFrom" class="form-control form-control-sm" required aria-label="Tanggal mulai">
      </label>
      <label>Akhir
        <input type="date" id="nmsMrtgTo" class="form-control form-control-sm" required aria-label="Tanggal akhir">
      </label>
      <button type="submit" class="btn btn-km-primary btn-sm">Tampilkan</button>
    </form>
  </div>

  <div class="km-card">
    <div class="row g-3" id="nmsMrtgGrid">
      <div class="col-12"><div class="nms-mrtg-empty">Memuat graph MRTG…</div></div>
    </div>
  </div>
</main>
<link rel="stylesheet" href="/css/nms-mrtg.css?v=6">
<script src="/js/nms-mrtg-charts.js?v=6"></script>
<script src="/js/management-nms-dashboard.js?v=3"></script>
<%- include('../partials/footer') %>
