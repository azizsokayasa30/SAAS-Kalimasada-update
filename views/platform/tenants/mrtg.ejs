<%- include('../partials/head', { title }) %>
<%- include('../partials/sidebar', { active: 'tenants-mrtg', adminName }) %>
<main class="km-main km-set km-mrtg-page">
  <div class="km-topbar">
    <div>
      <h2 class="km-set-title"><span class="km-set-title__icon"><i class="bi bi-graph-up"></i></span>MRTG Tenant</h2>
    </div>
    <a href="/management/settings/mrtg" class="btn btn-outline-secondary btn-sm px-3">
      <i class="bi bi-sliders me-1"></i> Kelola Pemetaan
    </a>
  </div>

  <div class="km-card km-mrtg-toolbar mb-3">
    <div class="km-mrtg-toolbar__row">
      <label class="km-tl-search mb-0">
        <i class="bi bi-search" aria-hidden="true"></i>
        <input type="search" id="nmsMrtgSearch" class="form-control" placeholder="Cari tenant / router…" autocomplete="off" aria-label="Cari nama tenant atau router">
      </label>
      <div class="km-mrtg-range" role="group" aria-label="Rentang graph MRTG">
        <button type="button" class="active" data-nms-range="24h"><i class="bi bi-clock"></i> Harian</button>
        <button type="button" data-nms-range="7d"><i class="bi bi-calendar-week"></i> Mingguan</button>
        <button type="button" data-nms-range="30d"><i class="bi bi-calendar3"></i> Bulanan</button>
        <button type="button" data-nms-range="custom"><i class="bi bi-calendar-range"></i> Custom</button>
      </div>
    </div>
    <form id="nmsMrtgCustom" class="km-mrtg-custom" hidden>
      <div>
        <label class="form-label" for="nmsMrtgFrom">Mulai</label>
        <input type="date" id="nmsMrtgFrom" class="form-control" required>
      </div>
      <div>
        <label class="form-label" for="nmsMrtgTo">Akhir</label>
        <input type="date" id="nmsMrtgTo" class="form-control" required>
      </div>
      <button type="submit" class="btn btn-km-primary"><i class="bi bi-check2 me-1"></i> Tampilkan</button>
    </form>
  </div>

  <div class="row g-3" id="nmsMrtgGrid">
    <div class="col-12"><div class="nms-mrtg-empty">Memuat graph MRTG…</div></div>
  </div>
</main>
<link rel="stylesheet" href="/css/nms-mrtg.css?v=6">
<script src="/js/nms-mrtg-charts.js?v=6"></script>
<script src="/js/management-nms-dashboard.js?v=3"></script>
<%- include('../partials/footer') %>
