<%
const summary = {
  customers: { total: 0, active: 0, inactive: 0, new: 0 },
  invoices: { total: 0, paid: 0, unpaid: 0, isolir: 0 },
};
tenants.forEach(function(t) {
  const c = t.usage?.customers || {};
  const inv = t.usage?.invoices || {};
  summary.customers.total += Number(c.total) || 0;
  summary.customers.active += Number(c.active) || 0;
  summary.customers.inactive += Number(c.inactive) || 0;
  summary.customers.new += Number(c.new) || 0;
  summary.invoices.total += Number(inv.total) || 0;
  summary.invoices.paid += Number(inv.paid) || 0;
  summary.invoices.unpaid += Number(inv.unpaid) || 0;
  summary.invoices.isolir += Number(inv.isolir) || 0;
});
%>
<%- include('../partials/head', { title }) %>
<%- include('../partials/sidebar', { active: 'tenants', adminName }) %>
<main class="km-main km-set km-tenants">
  <div class="km-topbar">
    <div>
      <h2 class="km-set-title"><span class="km-set-title__icon"><i class="bi bi-buildings"></i></span>Daftar Tenant</h2>
    </div>
    <div class="d-flex flex-wrap gap-2">
      <button type="button" class="btn btn-outline-secondary btn-sm px-3" data-bs-toggle="modal" data-bs-target="#backupRestoreModal">
        <i class="bi bi-cloud-arrow-up me-1"></i> Backup &amp; Restore
      </button>
      <a href="/management/tenants/new" class="btn btn-km-primary btn-sm px-3">
        <i class="bi bi-plus-lg me-1"></i> Tambah Tenant
      </a>
    </div>
  </div>

  <% if (flash && flash.success === 'deleted') { %>
    <div class="alert alert-success">Tenant berhasil dihapus.</div>
  <% } %>
  <% if (flash && flash.success === 'renamed') { %>
    <div class="alert alert-success">Nama tenant berhasil diubah.</div>
  <% } %>
  <% if (flash && flash.success === 'restored') { %>
    <div class="alert alert-success">
      Restore selesai — <%= flash.created || 0 %> dibuat, <%= flash.updated || 0 %> diperbarui, <%= flash.skipped || 0 %> dilewati.
      <% if (flash.warn) { %><span class="d-block small mt-1"><%= flash.warn %></span><% } %>
    </div>
  <% } %>
  <% if (flash && flash.success === 'imported') { %>
    <div class="alert alert-success">
      Import Excel selesai — <%= flash.created || 0 %> dibuat, <%= flash.updated || 0 %> diperbarui, <%= flash.skipped || 0 %> dilewati.
      <% if (flash.warn) { %><span class="d-block small mt-1"><%= flash.warn %></span><% } %>
    </div>
  <% } %>
  <% if (flash && flash.error) { %>
    <div class="alert alert-danger"><%= flash.error %></div>
  <% } %>

  <%
    const statsFilters = typeof filters !== 'undefined' && filters ? filters : {};
    const selectedMonth = statsFilters.month != null ? statsFilters.month : (new Date().getMonth() + 1);
    const selectedYear = statsFilters.year != null ? Number(statsFilters.year) : new Date().getFullYear();
    const periodLabel = statsFilters.label || '';
    const monthNamesId = ['Januari','Februari','Maret','April','Mei','Juni','Juli','Agustus','September','Oktober','November','Desember'];
    const cyFilter = new Date().getFullYear();
  %>
  <%
    const paidPct = summary.invoices.total > 0 ? Math.round((summary.invoices.paid / summary.invoices.total) * 100) : 0;
  %>
  <div class="row g-3 mb-3">
    <div class="col-sm-6 col-xl-3">
      <div class="km-card km-set-stat h-100">
        <span class="km-set-stat__icon km-tone-blue"><i class="bi bi-buildings"></i></span>
        <div>
          <div class="km-set-stat__label">Total Tenant</div>
          <div class="km-set-stat__value"><%= tenants.length %></div>
          <div class="km-set-stat__sub">ISP terdaftar</div>
        </div>
      </div>
    </div>
    <div class="col-sm-6 col-xl-3">
      <div class="km-card km-set-stat h-100">
        <span class="km-set-stat__icon km-tone-green"><i class="bi bi-people"></i></span>
        <div>
          <div class="km-set-stat__label">Pelanggan</div>
          <div class="km-set-stat__value"><%= summary.customers.total.toLocaleString('id-ID') %></div>
          <div class="km-set-stat__sub"><%= summary.customers.active.toLocaleString('id-ID') %> aktif · <%= summary.customers.new.toLocaleString('id-ID') %> baru</div>
        </div>
      </div>
    </div>
    <div class="col-sm-6 col-xl-3">
      <div class="km-card km-set-stat h-100">
        <span class="km-set-stat__icon km-tone-purple"><i class="bi bi-receipt"></i></span>
        <div>
          <div class="km-set-stat__label">Tagihan</div>
          <div class="km-set-stat__value"><%= formatRupiah(summary.invoices.total) %></div>
          <div class="km-set-stat__sub"><%= paidPct %>% lunas</div>
        </div>
      </div>
    </div>
    <div class="col-sm-6 col-xl-3">
      <div class="km-card km-set-stat h-100">
        <span class="km-set-stat__icon km-tone-orange"><i class="bi bi-hourglass-split"></i></span>
        <div>
          <div class="km-set-stat__label">Belum Lunas</div>
          <div class="km-set-stat__value"><%= formatRupiah(summary.invoices.unpaid) %></div>
          <div class="km-set-stat__sub">Isolir <%= formatRupiah(summary.invoices.isolir) %></div>
        </div>
      </div>
    </div>
  </div>

  <div class="km-card km-tl-toolbar mb-3">
    <form method="GET" action="/management/tenants" class="km-tl-toolbar__form">
      <div class="km-tl-search">
        <i class="bi bi-search" aria-hidden="true"></i>
        <input type="search" id="tenantSearchInput" class="form-control"
               placeholder="Cari tenant…" title="Cari nama, subdomain, atau owner" autocomplete="off"
               aria-label="Cari tenant">
      </div>
      <div class="km-tl-period">
        <span class="km-tl-period__label"><i class="bi bi-calendar3"></i> Periode</span>
        <select name="month" class="form-select" aria-label="Bulan" title="Bulan">
          <option value="all" <%= String(selectedMonth) === 'all' ? 'selected' : '' %>>Satu tahun</option>
          <% for (let m = 1; m <= 12; m++) { %>
            <option value="<%= m %>" <%= String(selectedMonth) === String(m) ? 'selected' : '' %>><%= monthNamesId[m - 1] %></option>
          <% } %>
        </select>
        <select name="year" class="form-select" aria-label="Tahun" title="Tahun">
          <% for (let y = cyFilter - 3; y <= cyFilter + 1; y++) { %>
            <option value="<%= y %>" <%= selectedYear === y ? 'selected' : '' %>><%= y %></option>
          <% } %>
        </select>
        <button type="submit" class="btn btn-km-primary" title="Terapkan periode">
          <i class="bi bi-funnel"></i> Terapkan
        </button>
      </div>
    </form>
  </div>

  <div class="km-card km-card--flush">
    <div class="km-set-head km-tl-head">
      <h5><i class="bi bi-list-ul"></i> Semua Tenant <span class="km-tl-count" id="tenantVisibleCount"><%= tenants.length %></span></h5>
      <% if (periodLabel) { %><span class="km-tl-period-chip"><i class="bi bi-calendar3"></i> <%= periodLabel %></span><% } %>
    </div>
    <div class="table-responsive">
      <table class="table table-hover align-middle mb-0 km-tl-table">
        <thead>
          <tr>
            <th>Tenant</th>
            <th class="d-none d-xl-table-cell">Owner</th>
            <th>Pelanggan</th>
            <th>Tagihan</th>
            <th class="text-end">Aksi</th>
          </tr>
        </thead>
        <tbody>
          <% if (!tenants.length) { %>
            <tr id="tenantEmptyRow"><td colspan="5">
              <div class="km-tl-empty">
                <span class="km-tl-empty__icon"><i class="bi bi-buildings"></i></span>
                <div class="km-tl-empty__title">Belum ada tenant</div>
                <a href="/management/tenants/new" class="btn btn-km-primary btn-sm px-3"><i class="bi bi-plus-lg me-1"></i> Tambah Tenant</a>
              </div>
            </td></tr>
          <% } %>
          <tr id="tenantSearchEmptyRow" class="d-none"><td colspan="5">
            <div class="km-tl-empty">
              <span class="km-tl-empty__icon"><i class="bi bi-search"></i></span>
              <div class="km-tl-empty__title">Tidak ada tenant yang cocok</div>
            </div>
          </td></tr>
          <% tenants.forEach(function(t) {
            const c = t.usage.customers || {};
            const inv = t.usage.invoices || {};
            const invTotal = Number(inv.total) || 0;
            const rowPaidPct = invTotal > 0 ? Math.min(100, Math.round(((Number(inv.paid) || 0) / invTotal) * 100)) : 0;
            const searchBlob = [t.id, t.name, t.subdomain, t.owner_name, t.owner_email].filter(Boolean).join(' ').toLowerCase();
          %>
            <tr class="tenant-data-row" data-search="<%= searchBlob.replace(/"/g, '&quot;') %>">
              <td>
                <div class="km-set-user">
                  <span class="km-set-avatar"><%= String(t.name || '?').trim().charAt(0).toUpperCase() %></span>
                  <div class="lh-sm" style="min-width:0">
                    <a href="/management/tenants/<%= t.id %>" class="km-tl-name"><%= t.name %></a>
                    <div class="km-tl-sub"><code><%= t.subdomain %></code> <span class="text-muted">#<%= t.id %></span></div>
                    <div class="km-tl-sub d-xl-none text-muted"><%= t.owner_email %></div>
                  </div>
                </div>
              </td>
              <td class="d-none d-xl-table-cell">
                <div class="fw-semibold small"><%= t.owner_name %></div>
                <small class="text-muted"><%= t.owner_email %></small>
              </td>
              <td>
                <div class="km-tl-metric"><%= (Number(c.total) || 0).toLocaleString('id-ID') %></div>
                <div class="km-tl-dots">
                  <span title="Aktif"><i class="km-dot km-dot--green"></i><%= c.active || 0 %></span>
                  <span title="Nonaktif"><i class="km-dot km-dot--gray"></i><%= c.inactive || 0 %></span>
                  <span title="Baru"><i class="km-dot km-dot--blue"></i><%= c.new || 0 %></span>
                </div>
              </td>
              <td>
                <div class="km-tl-metric"><%= formatRupiah(inv.total) %></div>
                <div class="km-tl-progress" title="<%= rowPaidPct %>% lunas"><span style="width: <%= rowPaidPct %>%"></span></div>
                <div class="km-tl-dots">
                  <span title="Belum lunas"><i class="km-dot km-dot--orange"></i><%= formatRupiah(inv.unpaid) %></span>
                  <% if (Number(inv.isolir) > 0) { %><span title="Isolir"><i class="km-dot km-dot--red"></i><%= formatRupiah(inv.isolir) %></span><% } %>
                </div>
              </td>
              <td class="text-end text-nowrap">
                <a href="/management/tenants/<%= t.id %>" class="btn btn-sm btn-outline-secondary" title="Detail"><i class="bi bi-eye"></i></a>
                <button type="button" class="btn btn-sm btn-outline-info" title="Rename"
                  data-bs-toggle="modal" data-bs-target="#renameModal-<%= t.id %>"><i class="bi bi-input-cursor-text"></i></button>
                <a href="/management/tenants/<%= t.id %>/edit" class="btn btn-sm btn-outline-primary" title="Edit"><i class="bi bi-pencil"></i></a>
                <button type="button" class="btn btn-sm btn-outline-danger" title="Hapus"
                  data-bs-toggle="modal" data-bs-target="#deleteModal-<%= t.id %>"><i class="bi bi-trash"></i></button>
              </td>
            </tr>
          <% }); %>
        </tbody>
      </table>
    </div>
  </div>
</main>

<%- include('_backup-restore', { backups }) %>

<% tenants.forEach(function(t) { %>
  <div class="modal fade km-modal" id="renameModal-<%= t.id %>" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
      <form method="POST" action="/management/tenants/<%= t.id %>/rename" class="modal-content">
        <input type="hidden" name="redirect" value="list">
        <div class="modal-header">
          <h5 class="modal-title"><i class="bi bi-input-cursor-text me-1"></i> Rename Tenant</h5>
          <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Tutup"></button>
        </div>
        <div class="modal-body">
          <label class="form-label" for="renameInput-<%= t.id %>">Nama tenant</label>
          <input type="text" id="renameInput-<%= t.id %>" name="name" class="form-control js-rename-input"
                 value="<%= t.name %>" maxlength="120" required autocomplete="off">
        </div>
        <div class="modal-footer">
          <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Batal</button>
          <button type="submit" class="btn btn-km-primary"><i class="bi bi-check-lg me-1"></i> Simpan Nama</button>
        </div>
      </form>
    </div>
  </div>

  <div class="modal fade km-modal" id="deleteModal-<%= t.id %>" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
      <form method="POST" action="/management/tenants/<%= t.id %>/delete" class="modal-content js-delete-form">
        <input type="hidden" name="redirect" value="list">
        <div class="modal-header">
          <h5 class="modal-title text-danger"><i class="bi bi-exclamation-triangle me-1"></i> Hapus Tenant</h5>
          <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Tutup"></button>
        </div>
        <div class="modal-body">
          <p class="mb-2">Anda akan menghapus tenant berikut:</p>
          <ul class="mb-3">
            <li><strong><%= t.name %></strong></li>
            <li>Subdomain: <code><%= t.subdomain %></code></li>
            <li>Owner: <%= t.owner_email %></li>
          </ul>
          <p class="mb-3" style="color: var(--badge-danger-text, #dc2626); background: var(--badge-danger-bg, rgba(220,38,38,.1)); padding: 0.65rem 0.85rem; border-radius: 8px; font-size: 0.9rem;">
            Data billing tenant ini (pelanggan, tagihan, pembayaran, paket, router, kolektor, dll) ikut dihapus permanen dan tidak bisa dikembalikan. Buat backup dulu jika perlu.
          </p>
          <label class="form-label small" for="deleteConfirm-<%= t.id %>">
            Ketik <strong>YES</strong> untuk konfirmasi
          </label>
          <input type="text" id="deleteConfirm-<%= t.id %>" name="confirm_text" class="form-control js-delete-confirm"
                 placeholder="YES" autocomplete="off" required>
        </div>
        <div class="modal-footer">
          <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Batal</button>
          <button type="submit" class="btn btn-danger js-delete-submit" disabled>Ya, Hapus Tenant</button>
        </div>
      </form>
    </div>
  </div>
<% }); %>

<script>
(function () {
  document.querySelectorAll('.js-delete-form').forEach(function (form) {
    var input = form.querySelector('.js-delete-confirm');
    var submit = form.querySelector('.js-delete-submit');
    input.addEventListener('input', function () {
      submit.disabled = input.value.trim().toUpperCase() !== 'YES';
    });
    form.closest('.modal').addEventListener('hidden.bs.modal', function () {
      input.value = '';
      submit.disabled = true;
    });
    form.closest('.modal').addEventListener('shown.bs.modal', function () { input.focus(); });
  });

  document.querySelectorAll('.js-rename-input').forEach(function (input) {
    var original = input.value;
    var modal = input.closest('.modal');
    modal.addEventListener('shown.bs.modal', function () { input.focus(); input.select(); });
    modal.addEventListener('hidden.bs.modal', function () { input.value = original; });
  });
})();

(function () {
  var input = document.getElementById('tenantSearchInput');
  if (!input) return;

  var rows = Array.prototype.slice.call(document.querySelectorAll('.tenant-data-row'));
  var emptySearch = document.getElementById('tenantSearchEmptyRow');
  var visibleCount = document.getElementById('tenantVisibleCount');
  var totalCount = rows.length;

  function applyFilter() {
    var q = String(input.value || '').trim().toLowerCase();
    var visible = 0;
    rows.forEach(function (row) {
      var hay = row.getAttribute('data-search') || '';
      var match = !q || hay.indexOf(q) !== -1;
      row.classList.toggle('d-none', !match);
      if (match) visible += 1;
    });
    if (emptySearch) emptySearch.classList.toggle('d-none', !(q && visible === 0 && totalCount > 0));
    if (visibleCount) visibleCount.textContent = visible;
  }

  input.addEventListener('input', applyFilter);
  input.addEventListener('keydown', function (e) {
    if (e.key === 'Enter') {
      e.preventDefault();
      applyFilter();
    }
  });
})();
</script>

<%- include('../partials/footer') %>
