<script>
(function () {
  var alertEl = document.getElementById('baileysDisconnectAlert');
  var titleEl = document.getElementById('baileysAlertTitle');
  var msgEl = document.getElementById('baileysAlertMessage');
  var iconEl = document.getElementById('baileysAlertIcon');
  var note = document.getElementById('dashWaStatusNote');

  function setNamedPill(id, kind, text) {
    var el = document.getElementById(id);
    if (!el) return;
    el.className = 'isp-pill isp-pill-' + kind;
    el.textContent = text;
  }

  function setPill(kind, text) {
    setNamedPill('dashWaStatusPill', kind, text);
  }

  function renderSystemStatus(payload) {
    if (!payload || payload.success === false) {
      setNamedPill('dashPayStatusPill', 'unknown', 'Tidak tersedia');
      setNamedPill('dashRadiusStatusPill', 'unknown', 'Tidak tersedia');
      setNamedPill('dashMikrotikStatusPill', 'unknown', 'Tidak tersedia');
      return;
    }
    var pay = payload.payment || {};
    var radius = payload.radius || {};
    var mikrotik = payload.mikrotik || {};
    setNamedPill('dashPayStatusPill', pay.state || 'unknown', pay.label || 'Tidak tersedia');
    setNamedPill('dashRadiusStatusPill', radius.state || 'unknown', radius.label || 'Tidak tersedia');
    setNamedPill('dashMikrotikStatusPill', mikrotik.state || 'unknown', mikrotik.label || 'Tidak tersedia');
    if (note) note.textContent = 'Payment gateway mengikuti pengaturan aktif. RADIUS dan MikroTik dicek langsung.';
  }

  function renderBaileysAlert(payload) {
    var alert = payload && payload.alert;
    if (!payload || payload.success === false || !payload.applicable || !alert) {
      setPill('unknown', 'Tidak tersedia');
      if (alertEl) alertEl.classList.add('d-none');
      return;
    }
    if (alert.connected) {
      setPill('online', 'Online');
      if (alertEl) alertEl.classList.add('d-none');
      return;
    }
    if (!alert.message) {
      setPill('unknown', 'Tidak tersedia');
      if (alertEl) alertEl.classList.add('d-none');
      return;
    }
    var danger = alert.level === 'danger';
    setPill(danger ? 'off' : 'warn', danger ? 'Offline' : 'Warning');
    if (!alertEl) return;
    alertEl.classList.remove('d-none', 'alert-warning', 'alert-danger', 'alert-success');
    alertEl.classList.add(danger ? 'alert-danger' : 'alert-warning');
    if (titleEl) {
      titleEl.textContent = alert.needsScan
        ? 'WhatsApp Baileys terputus — perlu scan QR'
        : 'WhatsApp Baileys terputus';
    }
    if (msgEl) msgEl.textContent = alert.message;
    if (iconEl) {
      iconEl.className = 'bi bi-whatsapp fs-4 mt-1 ' + (danger ? 'text-danger' : 'text-warning');
    }
  }

  function refreshBaileysAlert() {
    if (document.hidden) return;
    fetch('/admin/dashboard/api/baileys-status', { credentials: 'same-origin' })
      .then(function (r) { return r.json(); })
      .then(renderBaileysAlert)
      .catch(function () { setPill('unknown', 'Tidak tersedia'); });
    fetch('/admin/dashboard/api/system-status', { credentials: 'same-origin' })
      .then(function (r) { return r.json(); })
      .then(renderSystemStatus)
      .catch(function () { renderSystemStatus(null); });
  }

  refreshBaileysAlert();
  setInterval(refreshBaileysAlert, 60000);
  document.addEventListener('visibilitychange', function () {
    if (!document.hidden) refreshBaileysAlert();
  });
})();
</script>
<script>
(function () {
  function loadScript(src) {
    return new Promise(function (resolve, reject) {
      var s = document.createElement('script');
      s.src = src;
      s.async = true;
      s.onload = resolve;
      s.onerror = reject;
      document.body.appendChild(s);
    });
  }
  function loadCharts() {
    loadScript('https://cdn.jsdelivr.net/npm/chart.js')
      .then(function () {
        if (typeof window.__renderDashDonut === 'function') window.__renderDashDonut();
        if (typeof window.__renderCustomerTrend === 'function') window.__renderCustomerTrend();
        return loadScript('/js/dashboard-charts.js?v=20260921');
      })
      .catch(function (e) { console.warn('[dashboard] deferred charts:', e); });
    loadScript('/js/nms-mrtg-charts.js?v=6')
      .then(function () { return loadScript('/js/dashboard-mrtg.js?v=2'); })
      .catch(function (e) { console.warn('[dashboard] mrtg:', e); });
  }
  if ('requestIdleCallback' in window) {
    requestIdleCallback(loadCharts, { timeout: 5000 });
  } else {
    window.addEventListener('load', function () { setTimeout(loadCharts, 800); });
  }
})();
</script>
<script>
(function () {
  var dateEl = document.getElementById('ispClockDate');
  var timeEl = document.getElementById('ispClockTime');
  function tick() {
    if (!dateEl || !timeEl) return;
    var now = new Date();
    dateEl.textContent = now.toLocaleDateString('id-ID', {
      weekday: 'long', day: 'numeric', month: 'long', year: 'numeric', timeZone: 'Asia/Jakarta'
    });
    timeEl.textContent = now.toLocaleTimeString('id-ID', {
      hour: '2-digit', minute: '2-digit', second: '2-digit', timeZone: 'Asia/Jakarta'
    });
  }
  tick();
  setInterval(tick, 1000);
})();
</script>
</body>
</html>
