<!DOCTYPE html>
<html lang="id">
<head>
    <%- include('partials/hard-reload') %>
    <meta charset="UTF-8">
    <title><% if (typeof isTechnicianView !== 'undefined' && isTechnicianView) { %>Dashboard Teknisi<% } else { %>Dashboard Admin<% } %></title>
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <link rel="stylesheet" href="/css/fonts-inter-local.css" media="print" onload="this.media='all'">
    <noscript><link rel="stylesheet" href="/css/fonts-inter-local.css"></noscript>
    <link href="/vendor/bootstrap/css/bootstrap.min.css" rel="stylesheet">
    <link href="/vendor/bootstrap-icons/bootstrap-icons.css" rel="stylesheet">
    <link href="/css/responsive-admin.css" rel="stylesheet">
    <% if (typeof deferStatsLoad !== 'undefined' && deferStatsLoad) { %>
    <script>
    window.__dashOverviewPrefetch = fetch('/admin/dashboard/api/overview', { credentials: 'same-origin' })
      .then(function (r) { return r.json(); })
      .catch(function () { return null; });
    </script>
    <% } %>
    <%- include('partials/theme-head') %>
    <link href="/css/dashboard-premium.css?v=10" rel="stylesheet">
    <link href="/css/nms-mrtg.css?v=6" rel="stylesheet">
</head>
<body class="isp-dash">
<% const _greetUser = typeof dashboardGreetingUser !== 'undefined' ? dashboardGreetingUser : (typeof technician !== 'undefined' && technician && technician.name ? technician.name : 'Admin'); %>
<% const _roleLabel = (typeof executiveJabatan !== 'undefined' && executiveJabatan) ? executiveJabatan : ((typeof isAreaManager !== 'undefined' && isAreaManager) ? 'Manager Area' : 'Admin Panel'); %>
<% const _company = (typeof settings !== 'undefined' && settings && (settings.company_header || settings.company_name)) ? (settings.company_header || settings.company_name) : 'PT. Kalimasada Inti Sarana'; %>
<% const _initial = String(_greetUser || 'A').trim().charAt(0).toUpperCase() || 'A'; %>
<div class="container-fluid">
    <div class="row">
        <% if (typeof isTechnicianView !== 'undefined' && isTechnicianView) { %>
        <%- include('partials/technician-responsive-sidebar', { page: page || 'dashboard', settings: settings, technician: technician }) %>
        <% } else { %>
        <%- include('partials/admin-responsive-sidebar', { page: 'dashboard', settings: settings }) %>
        <% } %>

        <main id="pjax-container" class="col-md-10 ms-sm-auto main-content">
            <% if (typeof isTechnicianView === 'undefined' || !isTechnicianView) { %>
            <% const _btc = typeof adminNotifBadgeTotal === 'number' ? adminNotifBadgeTotal : 0; %>
            <header class="isp-topbar">
                <div class="isp-top-meta">
                    <div class="isp-clock">
                        <div class="isp-clock-date" id="ispClockDate">—</div>
                        <div class="isp-clock-time" id="ispClockTime">--:--:--</div>
                    </div>
                    <div class="dropdown">
                        <button class="isp-bell" type="button" id="adminNotifBellBtn" data-bs-toggle="dropdown" data-bs-auto-close="outside" aria-expanded="false" aria-label="Pusat notifikasi">
                            <i class="bi bi-bell"></i>
                            <span id="adminNotifBadge" class="position-absolute top-0 start-100 translate-middle badge rounded-pill bg-danger <%= _btc > 0 ? '' : 'd-none' %>"><%= _btc > 99 ? '99+' : _btc %></span>
                        </button>
                        <div class="dropdown-menu dropdown-menu-end mt-2 p-0 overflow-hidden" style="width:min(440px, 96vw);">
                            <div class="px-3 py-2 border-bottom small fw-bold d-flex justify-content-between align-items-center">
                                <span><i class="bi bi-inboxes me-1"></i>Pratinjau</span>
                                <span class="text-muted fw-normal" style="font-size:0.72rem;">Teknisi · Lunas/isolir · Portal</span>
                            </div>
                            <div id="adminNotifList" style="max-height:min(380px, 58vh); overflow-y: auto;">
                                <div class="px-3 py-4 text-muted small text-center">Buka menu untuk memuat…</div>
                            </div>
                            <div class="border-top py-2 px-3 d-grid gap-2">
                                <a href="/admin/dashboard/notifications" class="btn btn-sm btn-primary w-100">Buka halaman lengkap</a>
                                <button type="button" class="btn btn-sm btn-outline-secondary w-100" onclick="clearAdminNotificationsShell(event)">Bersihkan notifikasi</button>
                            </div>
                        </div>
                    </div>
                    <div class="isp-user">
                        <div class="isp-avatar" title="<%= _greetUser %>"><%= _initial %></div>
                        <div class="isp-user-copy">
                            <div class="isp-user-name"><%= _greetUser %></div>
                            <div class="isp-user-role"><%= _roleLabel %></div>
                        </div>
                    </div>
                </div>
            </header>
            <% } %>

            <div id="baileysDisconnectAlert" class="alert alert-warning border-0 d-none mb-3" role="alert">
                <div class="d-flex flex-wrap align-items-start gap-2 justify-content-between">
                    <div class="d-flex align-items-start gap-2">
                        <i class="bi bi-whatsapp fs-4 mt-1" id="baileysAlertIcon"></i>
                        <div>
                            <div class="fw-semibold" id="baileysAlertTitle">Status WhatsApp (Baileys)</div>
                            <div class="small mb-0" id="baileysAlertMessage"></div>
                        </div>
                    </div>
                    <a href="/admin/billing/whatsapp-settings" class="btn btn-sm btn-danger text-white" id="baileysAlertCta">
                        Buka WhatsApp Settings
                    </a>
                </div>
            </div>

            <section class="isp-hero">
                <img class="isp-hero-bg" src="/img/dashboard-hero-landscape.png?v=8" alt="KALIMASADA INTI SARANA. Internet Untuk Masa Depan Yang Lebih Baik" width="2172" height="303">
                <div class="isp-hello">
                    <h1><span aria-hidden="true">👋</span> Hallo, <%= _greetUser %>!</h1>
                    <p>Selamat datang di sistem manajemen <%= _company %></p>
                    <p class="isp-tagline">Pelayanan internet lebih baik</p>
                </div>
            </section>

            <div class="isp-section-title">Akses Cepat</div>
            <div class="quick-action-grid isp-qa mb-3">
                <a href="/admin/billing/customers?quickAction=add-pppoe-customer" class="qa-card qa-indigo" id="qa-add-customer">
                    <div class="qa-icon" title="Tambah pelanggan"><i class="bi bi-person-fill"></i></div>
                    <div class="qa-copy">
                        <div class="qa-label">Tambah Pelanggan</div>
                        <div class="qa-sub">Input pelanggan baru</div>
                    </div>
                    <i class="bi bi-chevron-right qa-arrow" aria-hidden="true"></i>
                </a>
                <a href="/admin/installations/create" class="qa-card qa-green" id="qa-add-job">
                    <div class="qa-icon" title="Job teknisi"><i class="bi bi-wrench"></i></div>
                    <div class="qa-copy">
                        <div class="qa-label">Tambah Job Teknisi</div>
                        <div class="qa-sub">Penugasan teknisi</div>
                    </div>
                    <i class="bi bi-chevron-right qa-arrow" aria-hidden="true"></i>
                </a>
                <a href="/admin/trouble?quickAction=create-ticket" class="qa-card qa-orange" id="qa-add-ticket">
                    <div class="qa-icon" title="Tiket gangguan"><i class="bi bi-exclamation-triangle-fill"></i></div>
                    <div class="qa-copy">
                        <div class="qa-label">Tambah Tiket Gangguan</div>
                        <div class="qa-sub">Laporan masalah</div>
                    </div>
                    <i class="bi bi-chevron-right qa-arrow" aria-hidden="true"></i>
                </a>
                <a href="/admin/billing/all-payments?quickAction=input-pembayaran" class="qa-card qa-blue" id="qa-payment">
                    <div class="qa-icon" title="Input pembayaran"><i class="bi bi-credit-card-fill"></i></div>
                    <div class="qa-copy">
                        <div class="qa-label">Input Pembayaran</div>
                        <div class="qa-sub">Verifikasi pembayaran</div>
                    </div>
                    <i class="bi bi-chevron-right qa-arrow" aria-hidden="true"></i>
                </a>
                <a href="/admin/billing/collector-remittance" class="qa-card qa-purple" id="qa-setoran">
                    <div class="qa-icon" title="Terima setoran"><i class="bi bi-wallet2"></i></div>
                    <div class="qa-copy">
                        <div class="qa-label">Terima Setoran</div>
                        <div class="qa-sub">Setoran dari kolektor</div>
                    </div>
                    <i class="bi bi-chevron-right qa-arrow" aria-hidden="true"></i>
                </a>
                <a href="/admin/billing/expenses" class="qa-card qa-red" id="qa-expense">
                    <div class="qa-icon" title="Pengeluaran"><i class="bi bi-receipt"></i></div>
                    <div class="qa-copy">
                        <div class="qa-label">Tambah Pengeluaran</div>
                        <div class="qa-sub">Catat pengeluaran baru</div>
                    </div>
                    <i class="bi bi-chevron-right qa-arrow" aria-hidden="true"></i>
                </a>
            </div>

            <% const pkgReqs = typeof portalPackageRequests !== 'undefined' && portalPackageRequests ? portalPackageRequests : []; %>
            <% if (pkgReqs.length > 0) { %>
            <div id="adminPortalPackageRequestsBlock" class="isp-portal">
            <div class="alert alert-primary d-flex align-items-center gap-2 mb-3 py-3" role="alert">
                <i class="bi bi-arrow-left-right fs-4"></i>
                <div>
                    <strong>Portal pelanggan:</strong> Ada <strong><%= pkgReqs.length %></strong> permintaan ubah paket (upgrade/downgrade) menunggu tindakan.
                </div>
            </div>
            <div class="card border-0 mb-4">
                <div class="card-header py-3 d-flex justify-content-between align-items-center flex-wrap gap-2">
                    <span class="fw-bold"><i class="bi bi-box-seam me-2"></i>Permintaan ubah paket (portal)</span>
                    <span class="badge bg-primary rounded-pill"><%= pkgReqs.length %> pending</span>
                </div>
                <div class="card-body p-0">
                    <div class="table-responsive">
                        <table class="table table-hover align-middle mb-0 small">
                            <thead>
                                <tr>
                                    <th class="ps-3">Waktu</th>
                                    <th>Pelanggan</th>
                                    <th>Paket sekarang</th>
                                    <th>Paket diminta</th>
                                    <th class="pe-3 text-end">Aksi</th>
                                </tr>
                            </thead>
                            <tbody>
                                <% pkgReqs.forEach(function(r) { %>
                                <tr>
                                    <td class="ps-3 text-nowrap text-muted"><%= r.created_at ? new Date(r.created_at).toLocaleString('id-ID', { dateStyle: 'short', timeStyle: 'short' }) : '-' %></td>
                                    <td>
                                        <div class="fw-semibold"><%= r.customer_name || r.customer_username || '—' %></div>
                                        <div class="text-muted" style="font-size:0.75rem;"><%= r.customer_phone || '' %></div>
                                    </td>
                                    <td>
                                        <span class="badge bg-secondary"><%= r.current_package_name || '—' %></span>
                                        <% if (r.current_speed) { %><div class="text-muted mt-1" style="font-size:0.75rem;"><%= r.current_speed %></div><% } %>
                                    </td>
                                    <td>
                                        <span class="badge bg-primary"><%= r.target_package_name %></span>
                                        <div class="mt-1" style="font-size:0.75rem;">
                                            <%= r.target_speed || '' %>
                                            <% if (r.target_price_rupiah != null) { %> · <span class="dash-amount" data-amount="Rp <%= Number(r.target_price_rupiah).toLocaleString('id-ID') %>">Rp <%= Number(r.target_price_rupiah).toLocaleString('id-ID') %></span><% } %>
                                        </div>
                                        <% if (r.note) { %><div class="text-muted mt-1 fst-italic" style="font-size:0.72rem;">“<%= r.note %>”</div><% } %>
                                    </td>
                                    <td class="pe-3 text-end text-nowrap">
                                        <% if (r.customer_phone) { %>
                                        <a href="/admin/billing/customers?editPhone=<%= encodeURIComponent(r.customer_phone) %>" class="btn btn-sm btn-primary">Edit pelanggan</a>
                                        <% } else { %>
                                        <a href="/admin/billing/customers" class="btn btn-sm btn-outline-primary">Daftar pelanggan</a>
                                        <% } %>
                                    </td>
                                </tr>
                                <% }); %>
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
            </div>
            <% } %>

            <div id="dashOverviewError" class="isp-error d-none" role="alert">Data dashboard gagal dimuat. Muat ulang halaman untuk mencoba lagi.</div>

            <div class="isp-section-title">
                <span>Statistik Pelanggan &amp; Tagihan</span>
                <button type="button" id="dashAmountToggle" class="isp-amount-btn" title="Tampilkan nominal" aria-label="Tampilkan nominal" aria-pressed="false">
                    <i class="bi bi-eye" id="dashAmountToggleIcon"></i>
                </button>
            </div>
            <% const bs = typeof billingStats !== 'undefined' ? billingStats : {}; %>
            <%
              var tagihanBln = bs.monthly_total_tagihan != null ? bs.monthly_total_tagihan : ((bs.monthly_revenue || 0) + (bs.monthly_unpaid || 0));
              var lunasBln = bs.monthly_lunas_canonical != null ? bs.monthly_lunas_canonical : (bs.monthly_revenue || 0);
              var blmBln = bs.monthly_belum_lunas_canonical != null ? bs.monthly_belum_lunas_canonical : (bs.monthly_unpaid || 0);
              var invBln = bs.monthly_invoice_count_canonical != null ? bs.monthly_invoice_count_canonical : (bs.monthly_invoices || 0);
              var invBlmBln = bs.monthly_belum_lunas_count_canonical != null ? bs.monthly_belum_lunas_count_canonical : (bs.unpaid_monthly_invoices || 0);
              var piutangAll = bs.outstanding_unpaid_total != null ? bs.outstanding_unpaid_total : 0;
              var piutangCnt = bs.outstanding_unpaid_count != null ? bs.outstanding_unpaid_count : 0;
              var loading = typeof deferStatsLoad !== 'undefined' && deferStatsLoad;
            %>
            <div class="isp-kpi-grid stat-grid-6<%= loading ? ' dash-stat-loading' : '' %>" id="dashStatsGrid">
                <a href="/admin/billing/customers" class="stat-card-big stat-indigo" id="sc-total-customer">
                    <div class="sc-header">
                        <span class="sc-label">Total Pelanggan</span>
                        <span class="sc-badge" title="Database pelanggan"><i class="bi bi-people-fill"></i></span>
                    </div>
                    <div class="sc-value"><%= loading ? '…' : (bs.total_customers || 0).toLocaleString('id-ID') %></div>
                    <div class="sc-sub">Pelanggan terdaftar total</div>
                    <span class="sc-spark spark-line" aria-hidden="true"></span>
                    <span class="isp-detail">Lihat Detail <i class="bi bi-chevron-right"></i></span>
                </a>
                <a href="/admin/billing/customers?status=active" class="stat-card-big stat-emerald" id="sc-active">
                    <div class="sc-header">
                        <span class="sc-label">Pelanggan Aktif</span>
                        <span class="sc-badge" title="Aktif"><i class="bi bi-wifi"></i></span>
                    </div>
                    <div class="sc-value"><%= loading ? '…' : (bs.active_customers || 0).toLocaleString('id-ID') %></div>
                    <div class="sc-sub">Status terkoneksi saat ini</div>
                    <span class="sc-spark spark-line" aria-hidden="true"></span>
                    <span class="isp-detail">Lihat Detail <i class="bi bi-chevron-right"></i></span>
                </a>
                <a href="/admin/billing/customers?status=inactive" class="stat-card-big stat-rose" id="sc-inactive">
                    <div class="sc-header">
                        <span class="sc-label">Pelanggan Nonaktif</span>
                        <span class="sc-badge" title="Nonaktif"><i class="bi bi-slash-circle"></i></span>
                    </div>
                    <div class="sc-value"><%= loading ? '…' : Math.max((bs.total_customers || 0) - (bs.active_customers || 0), 0).toLocaleString('id-ID') %></div>
                    <div class="sc-sub">Isolir / berhenti berlangganan</div>
                    <span class="sc-spark spark-line" aria-hidden="true"></span>
                    <span class="isp-detail">Lihat Detail <i class="bi bi-chevron-right"></i></span>
                </a>
                <a href="/admin/billing/invoice-list" class="stat-card-big stat-blue" id="sc-total-invoice">
                    <div class="sc-header">
                        <span class="sc-label">Total Tagihan</span>
                        <span class="sc-badge" title="Invoice bulan ini"><i class="bi bi-receipt"></i></span>
                    </div>
                    <div class="sc-value dash-amount" data-amount="<%= loading ? '' : ('Rp ' + tagihanBln.toLocaleString('id-ID')) %>"><%= loading ? '…' : ('Rp ' + tagihanBln.toLocaleString('id-ID')) %></div>
                    <div class="sc-sub"><span class="sc-count"><%= loading ? '…' : (invBln.toLocaleString('id-ID') + ' Inv') %></span> · Lunas <span class="dash-amount" id="sc-total-invoice-paid" data-amount="<%= loading ? '' : ('Rp ' + lunasBln.toLocaleString('id-ID')) %>"><%= loading ? '…' : ('Rp ' + lunasBln.toLocaleString('id-ID')) %></span></div>
                    <span class="sc-spark spark-bars" aria-hidden="true"></span>
                    <span class="isp-detail">Lihat Detail <i class="bi bi-chevron-right"></i></span>
                </a>
                <a href="/admin/billing/invoice-list?status=unpaid" class="stat-card-big stat-amber" id="sc-unpaid">
                    <div class="sc-header">
                        <span class="sc-label">Belum Lunas</span>
                        <span class="sc-badge" title="Belum lunas bulan ini"><i class="bi bi-clock"></i></span>
                    </div>
                    <div class="sc-value dash-amount" data-amount="<%= loading ? '' : ('Rp ' + blmBln.toLocaleString('id-ID')) %>"><%= loading ? '…' : ('Rp ' + blmBln.toLocaleString('id-ID')) %></div>
                    <div class="sc-sub"><span class="sc-count"><%= loading ? '…' : (invBlmBln.toLocaleString('id-ID') + ' Inv') %></span> · Dari tagihan terbit bulan ini</div>
                    <span class="sc-spark spark-bars" aria-hidden="true"></span>
                    <span class="isp-detail">Lihat Detail <i class="bi bi-chevron-right"></i></span>
                </a>
                <a href="/admin/billing/invoice-list?status=unpaid" class="stat-card-big stat-teal" id="sc-piutang-all" title="Semua invoice belum lunas (termasuk bulan lalu)">
                    <div class="sc-header">
                        <span class="sc-label">Piutang Aktif</span>
                        <span class="sc-badge" title="Piutang semua periode"><i class="bi bi-cash-stack"></i></span>
                    </div>
                    <div class="sc-value dash-amount" data-amount="<%= loading ? '' : ('Rp ' + piutangAll.toLocaleString('id-ID')) %>"><%= loading ? '…' : ('Rp ' + piutangAll.toLocaleString('id-ID')) %></div>
                    <div class="sc-sub"><span class="sc-count"><%= loading ? '…' : (piutangCnt.toLocaleString('id-ID') + ' Inv') %></span> · Total belum lunas</div>
                    <span class="sc-spark spark-bars" aria-hidden="true"></span>
                    <span class="isp-detail">Lihat Detail <i class="bi bi-chevron-right"></i></span>
                </a>
                <a href="/admin/billing/customers" class="stat-card-big stat-purple" id="sc-new-customer">
                    <div class="sc-header">
                        <span class="sc-label">Pelanggan Baru</span>
                        <span class="sc-badge" title="Bulan berjalan"><i class="bi bi-person-plus"></i></span>
                    </div>
                    <div class="sc-value"><%= loading ? '…' : (typeof newCustomersThisMonth !== 'undefined' ? newCustomersThisMonth : 0).toLocaleString('id-ID') %></div>
                    <div class="sc-sub">Bulan berjalan</div>
                    <span class="sc-spark spark-bars" aria-hidden="true"></span>
                    <span class="isp-detail">Lihat Detail <i class="bi bi-chevron-right"></i></span>
                </a>
            </div>

            <div class="isp-charts">
                <section class="isp-panel">
                    <div class="isp-panel-head"><h3>Grafik Pelanggan (6 Bulan Terakhir)</h3></div>
                    <div id="dashCustomerTrend">
                        <div class="isp-empty">
                            <i class="bi bi-graph-up"></i>
                            <div>Memuat grafik pelanggan…</div>
                        </div>
                    </div>
                </section>
                <section class="isp-panel">
                    <div class="isp-panel-head"><h3>Status Tagihan Bulan Ini</h3></div>
                    <div class="isp-donut-wrap">
                        <div class="isp-donut-stage" id="dashDonutStage">
                            <canvas id="dashInvoiceDonut" aria-label="Status tagihan bulan ini"></canvas>
                            <div class="isp-donut-center">
                                <strong id="dashDonutCenterValue">…</strong>
                                <span>Total pelanggan</span>
                            </div>
                        </div>
                        <div>
                            <ul class="isp-legend" id="dashDonutLegend">
                                <li><span class="isp-dot isp-dot-green"></span><span>Lunas</span><b id="dashDonutLunas">…</b></li>
                                <li><span class="isp-dot isp-dot-orange"></span><span>Belum Lunas</span><b id="dashDonutBelum">…</b></li>
                            </ul>
                            <div id="dashDonutEmpty" class="isp-empty d-none"><i class="bi bi-pie-chart"></i><div>Belum ada tagihan bulan ini.</div></div>
                            <p class="isp-note">Kategori lain belum tersedia dari data tagihan.</p>
                        </div>
                    </div>
                </section>
                <section class="isp-panel">
                    <div class="isp-panel-head"><h3>Top 5 Area Pelanggan</h3></div>
                    <div id="dashTopAreas">
                        <div class="isp-empty">
                            <i class="bi bi-hourglass-split"></i>
                            <div>Memuat peringkat area…</div>
                        </div>
                    </div>
                </section>
            </div>

            <% const ops = (typeof operationalStats !== 'undefined' && operationalStats) ? operationalStats : {}; %>
            <%
                const pendingInstallations = Number(ops.pendingInstallations || 0);
                const pendingTroubleTickets = Number(ops.pendingTroubleTickets || 0);
                const employeesAttendedToday = Number(ops.employeesAttendedToday || 0);
            %>
            <div class="isp-section-title">Operasional Hari Ini</div>
            <div class="isp-ops">
                <a href="/admin/installations" class="isp-ops-card ops-blue" id="sc-pending-installations">
                    <span class="ops-icon"><i class="bi bi-wrench"></i></span>
                    <span class="ops-copy">
                        <span class="sc-label">Pending Job Instalasi</span>
                        <span class="sc-value"><%= loading ? '…' : pendingInstallations.toLocaleString('id-ID') %></span>
                        <span class="sc-sub">Scheduled, assigned, dan in progress</span>
                    </span>
                    <i class="bi bi-chevron-right ops-arrow" aria-hidden="true"></i>
                    <i class="bi bi-wrench ops-watermark" aria-hidden="true"></i>
                </a>
                <a href="/admin/trouble" class="isp-ops-card ops-red" id="sc-pending-trouble">
                    <span class="ops-icon"><i class="bi bi-exclamation-triangle-fill"></i></span>
                    <span class="ops-copy">
                        <span class="sc-label">Pending Tiket Gangguan</span>
                        <span class="sc-value"><%= loading ? '…' : pendingTroubleTickets.toLocaleString('id-ID') %></span>
                        <span class="sc-sub">Tiket open, pending, dan in progress</span>
                    </span>
                    <i class="bi bi-chevron-right ops-arrow" aria-hidden="true"></i>
                    <i class="bi bi-exclamation-triangle-fill ops-watermark" aria-hidden="true"></i>
                </a>
                <a href="/admin/employees/attendance" class="isp-ops-card ops-green" id="sc-attendance-today">
                    <span class="ops-icon"><i class="bi bi-people-fill"></i></span>
                    <span class="ops-copy">
                        <span class="sc-label">Karyawan Sudah Absen</span>
                        <span class="sc-value"><%= loading ? '…' : employeesAttendedToday.toLocaleString('id-ID') %></span>
                        <span class="sc-sub">Karyawan unik yang tercatat absen hari ini</span>
                    </span>
                    <i class="bi bi-chevron-right ops-arrow" aria-hidden="true"></i>
                    <i class="bi bi-people-fill ops-watermark" aria-hidden="true"></i>
                </a>
            </div>

            <div class="isp-bottom">
                <section class="isp-panel">
                    <div class="isp-panel-head"><h3>Aktivitas Terbaru</h3></div>
                    <div class="isp-activity-grid">
