                <i class="bi <%= hotspotExpanded ? 'bi-chevron-up' : 'bi-chevron-down' %> toggle-arrow sb-chevron"></i>
            </div>
            <div class="collapse <%= hotspotExpanded ? 'show' : '' %>" id="adminHotspotCollapse">
                <a href="/admin/mikrotik/hotspot-server-profiles" class="sb-item sb-sub <%= typeof page !== 'undefined' && page === 'hotspot-server-profiles' ? 'active' : '' %>">
                    <i class="bi bi-server"></i>
                    <span class="sb-item-text">Server Profile</span>
                </a>
                <a href="/admin/mikrotik/hotspot-profiles" class="sb-item sb-sub <%= typeof page !== 'undefined' && page === 'hotspot-profiles' ? 'active' : '' %>">
                    <i class="bi bi-wifi"></i>
                    <span class="sb-item-text">Voucher Profiles</span>
