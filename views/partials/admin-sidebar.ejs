                 role="button"
                 tabindex="0">
                <span>Infrastruktur</span>
                <i class="bi <%= infraExpanded ? 'bi-chevron-up' : 'bi-chevron-down' %> toggle-arrow sb-chevron"></i>
            </div>
            <div class="collapse <%= infraExpanded ? 'show' : '' %>" id="adminInfraCollapse">
                <a href="/admin/installations" class="sb-item sb-sub <%= typeof page !== 'undefined' && page === 'installations' ? 'active' : '' %>">
                    <i class="bi bi-tools"></i>
                    <span class="sb-item-text">Installation Jobs</span>
                    <span id="sbInstallProgressBadge" class="sb-count-badge d-none" aria-hidden="true">0</span>
                </a>
                <a href="/admin/technicians" class="sb-item sb-sub <%= typeof page !== 'undefined' && page === 'technicians' ? 'active' : '' %>">
                    <i class="bi bi-people-fill"></i>
                    <span class="sb-item-text">Kelola Teknisi</span>
                </a>
                <a href="/admin/cable-network/odp" class="sb-item sb-sub <%= typeof page !== 'undefined' && page === 'cable-network-odp' ? 'active' : '' %>">
                    <i class="bi bi-broadcast"></i>
