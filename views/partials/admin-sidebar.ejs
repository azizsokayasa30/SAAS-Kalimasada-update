                        <span>Dashboard</span>
                        <% if (typeof page !== 'undefined' && page === 'dashboard') { %><i class="bi bi-check2 ms-auto"></i><% } %>
                    </a>
                    <a href="/admin/billing/dashboard" class="sb-app-option <%= typeof page !== 'undefined' && page === 'billing' ? 'active' : '' %>">
                        <i class="bi bi-speedometer2"></i>
                        <span>Billing & Accounting</span>
                        <% if (typeof page !== 'undefined' && page === 'billing') { %><i class="bi bi-check2 ms-auto"></i><% } %>
