                </a>
                <a href="/admin/cable-network/cables" class="sb-item sb-sub <%= typeof page !== 'undefined' && page === 'cable-network-cables' ? 'active' : '' %>">
                    <i class="bi bi-diagram-3"></i>
                    <span class="sb-item-text">Cable Routes</span>
