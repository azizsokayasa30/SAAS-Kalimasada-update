                <a href="/admin/cable-network/analytics" class="sb-item sb-sub <%= typeof page !== 'undefined' && page === 'cable-network-analytics' ? 'active' : '' %>">
                    <i class="bi bi-bar-chart"></i>
                    <span class="sb-item-text">Network Analytics</span>
                </a>
                <a href="/admin/billing/mapping-new" class="sb-item sb-sub <%= typeof page !== 'undefined' && page === 'mapping-new' ? 'active' : '' %>">
                    <i class="bi bi-map"></i>
                    <span class="sb-item-text">Network Mapping</span>
                </a>
                <a href="/admin/genieacs" class="sb-item sb-sub <%= typeof page !== 'undefined' && page === 'genieacs' ? 'active' : '' %>">
                    <i class="bi bi-hdd-network"></i>
                    <span class="sb-item-text">GenieACS</span>
                </a>
            </div>
        </div>

        <!-- SETTINGAN -->
        <% const adminSettingPages = ['setting','setting-radius','cache','trouble']; %>
        <% const adminSettingExpanded = typeof page !== 'undefined' && adminSettingPages.includes(page); %>
        <div class="sb-section">
            <div class="sb-section-title sb-collapsible"
                 data-manual-toggle="collapse"
                 data-target-id="adminSettingCollapse"
                 aria-expanded="<%= adminSettingExpanded ? 'true' : 'false' %>"
                 aria-controls="adminSettingCollapse"
                 role="button"
                 tabindex="0">
                <span>Settingan</span>
                <i class="bi <%= adminSettingExpanded ? 'bi-chevron-up' : 'bi-chevron-down' %> toggle-arrow sb-chevron"></i>
            </div>
            <div class="collapse <%= adminSettingExpanded ? 'show' : '' %>" id="adminSettingCollapse">
                <a href="/admin/trouble" class="sb-item sb-sub <%= typeof page !== 'undefined' && page === 'trouble' ? 'active' : '' %>">
                    <i class="bi bi-exclamation-triangle"></i>
                    <span class="sb-item-text">Trouble Report</span>
                    <span id="sbTroubleProgressBadge" class="sb-count-badge d-none" aria-hidden="true">0</span>
