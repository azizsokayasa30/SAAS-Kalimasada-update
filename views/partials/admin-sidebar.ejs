        <!-- INFRASTRUKTUR -->
        <% const infraPages = ['installations','technicians','cable-network-odp','cable-network-cables','cable-network-analytics','mapping-new','genieacs']; %>
        <% const infraExpanded = typeof page !== 'undefined' && infraPages.includes(page); %>
        <div class="sb-section">
            <div class="sb-section-title sb-collapsible"
                 data-manual-toggle="collapse"
                 data-target-id="adminInfraCollapse"
                 aria-expanded="<%= infraExpanded ? 'true' : 'false' %>"
