<style>
@import url('https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&display=swap');

/* Sidebar styles — variabel dark diset oleh theme-system.css */
.sb {
    height: 100vh;
    overflow-y: auto;
    background: var(--sb-bg, #0f172a);
    border-right: 1px solid var(--sb-border, #1e293b);
    padding-top: 0;
    font-family: 'Inter', -apple-system, BlinkMacSystemFont, 'Segoe UI', sans-serif;
    -webkit-font-smoothing: antialiased;
    color: var(--sb-text, #f8fafc);
}
.sb::-webkit-scrollbar { width: 3px; }
.sb::-webkit-scrollbar-track { background: transparent; }
.sb::-webkit-scrollbar-thumb { background: #1e293b; border-radius: 99px; }

.sb-header { padding: 18px 16px; border-bottom: 1px solid rgba(255,255,255,0.06); display: flex; align-items: center; gap: 12px; background: var(--sb-bg, #0f172a); }
.sb-logo-icon { width: 36px; height: 36px; background: linear-gradient(135deg, #2563eb, #3b82f6); border-radius: 8px; display: flex; align-items: center; justify-content: center; flex-shrink: 0; overflow: hidden; }
.sb-brand { display: flex; flex-direction: column; }
.sb-brand-name { font-size: 14px; font-weight: 700; color: var(--sb-text, #f8fafc); letter-spacing: -0.02em; }
.sb-brand-tag { font-size: 10px; color: var(--sb-section-text, #64748b); font-weight: 500; letter-spacing: 0.04em; text-transform: uppercase; }

.sb-nav { flex: 1; padding: 8px; overflow-y: auto; }
.sb-section { margin-bottom: 16px; }
.sb-section-title { font-size: 10.5px; font-weight: 700; color: var(--sb-section-text, #64748b); text-transform: uppercase; letter-spacing: 0.1em; padding: 0 12px; margin-bottom: 4px; }
.sb-section-title.sb-collapsible { display: flex; justify-content: space-between; align-items: center; cursor: pointer; padding: 6px 12px; border-radius: 8px; transition: all 150ms; outline: none; }
.sb-section-title.sb-collapsible:hover { background: var(--sb-bg-hover, #1e293b); color: var(--sb-muted, #94a3b8); }
.sb-chevron { font-size: 10px; transition: transform 200ms; }

.sb-app-switcher { position: relative; }
.sb-app-switcher-btn { width: 100%; display: flex; align-items: center; justify-content: space-between; gap: 8px; padding: 8px 12px; border-radius: 8px; border: 1px solid rgba(255,255,255,0.08); background: var(--sb-bg-hover, #1e293b); color: var(--sb-text, #f8fafc); font-size: 13px; font-weight: 500; font-family: 'Inter', sans-serif; cursor: pointer; transition: all 150ms; }
.sb-app-switcher-btn:hover { border-color: rgba(59,130,246,0.4); background: rgba(59,130,246,0.1); }
.sb-app-current { display: flex; align-items: center; gap: 8px; }
.sb-app-current i { font-size: 14px; color: var(--sb-primary, #3b82f6); }
.sb-app-dropdown { display: none; position: absolute; top: calc(100% + 4px); left: 0; right: 0; background: #0a1120; border: 1px solid rgba(255,255,255,0.08); border-radius: 8px; box-shadow: 0 8px 24px rgba(0,0,0,0.5); z-index: 20; padding: 4px; }
.sb-app-dropdown.show { display: block; }
.sb-app-option { display: flex; align-items: center; gap: 8px; padding: 8px 10px; border-radius: 6px; color: var(--sb-muted, #94a3b8); font-size: 13px; font-weight: 500; text-decoration: none; transition: all 150ms; }
.sb-app-option:hover { background: var(--sb-bg-hover, #1e293b); color: var(--sb-text, #f8fafc); text-decoration: none; }
.sb-app-option.active { color: var(--sb-primary, #3b82f6); background: rgba(59,130,246,0.12); }
.sb-app-option i { font-size: 14px; }

.sb-item { display: flex; align-items: center; gap: 10px; padding: 8px 12px; border-radius: 8px; color: var(--sb-muted, #94a3b8); font-size: 13px; font-weight: 500; cursor: pointer; transition: all 160ms; border: 1px solid transparent; position: relative; text-decoration: none; white-space: nowrap; margin-bottom: 2px; }
.sb-item i { width: 16px; font-size: 14px; flex-shrink: 0; color: var(--sb-subtle, #475569); transition: color 160ms; }
.sb-item:hover { color: var(--sb-text, #f8fafc); background: var(--sb-bg-hover, #1e293b); text-decoration: none; }
.sb-item:hover i { color: var(--sb-primary, #3b82f6); }
.sb-item.active { color: #fff; background: var(--sb-primary, #3b82f6); border-color: transparent; box-shadow: 0 2px 8px rgba(59,130,246,0.4); }
.sb-item.active i { color: #fff; }
.sb-item.active::before { display: none; }
.sb-item.sb-sub { padding-left: 2.5rem; font-size: 12.5px; }

.sb-footer { padding: 8px; border-top: 1px solid rgba(255,255,255,0.06); background: var(--sb-footer-bg, #0a1120); }
.sb-actions { display: flex; gap: 6px; padding: 4px 0; }
.sb-action-btn { flex: 1; display: inline-flex; align-items: center; justify-content: center; gap: 6px; padding: 7px 10px; border-radius: 8px; font-size: 12px; font-weight: 500; font-family: 'Inter', sans-serif; cursor: pointer; transition: all 150ms; border: 1px solid rgba(255,255,255,0.08); background: transparent; color: var(--sb-muted, #94a3b8); text-decoration: none; white-space: nowrap; }
.sb-action-btn:hover { background: var(--sb-bg-hover, #1e293b); color: var(--sb-primary, #3b82f6); border-color: rgba(59,130,246,0.3); text-decoration: none; }
.sb-action-btn i { font-size: 13px; }
.sb-action-logout:hover { color: #f87171; background: rgba(239,68,68,0.1); border-color: rgba(239,68,68,0.3); }

@media (min-width: 768px) {
    .sb { width: 16.666667%; position: fixed; left: 0; top: 0; }
    .main-content { transition: 0.3s; }
    .main-content.sidebar-expanded { margin-left: 16.666667%; width: 83.333333%; }
}
@media (max-width: 767.98px) {
    .sb { position: fixed; top: 0; left: 0; width: 280px; transform: translateX(-100%); z-index: 1000; overflow-y: auto; }
    .sb.show { transform: translateX(0); }
    .main-content { margin-top: 60px; padding: 15px; }
}
</style>
