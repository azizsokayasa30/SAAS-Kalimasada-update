                <a href="/admin/settings" class="sb-item sb-sub <%= typeof page !== 'undefined' && page === 'setting' ? 'active' : '' %>">
                    <i class="bi bi-gear"></i>
                    <span class="sb-item-text">Setting</span>
                </a>
                <a href="/admin/radius" class="sb-item sb-sub <%= typeof page !== 'undefined' && page === 'setting-radius' ? 'active' : '' %>">
                    <i class="bi bi-gear-wide-connected"></i>
                    <span class="sb-item-text">Setting RADIUS</span>
                </a>
                <a href="/admin/cache" class="sb-item sb-sub <%= typeof page !== 'undefined' && page === 'cache' ? 'active' : '' %>">
